	number = {1},
	urldate = {2025-06-05},
	journal = {BMC Public Health},
	author = {Liu, Jinli and Ren, Zhen-Hu and Qiang, Hua and Wu, Jine and Shen, Mingwang and Zhang, Lei and Lyu, Jun},
