}

@article{lekakis_effect_1997,
	title = {Effect of acute cigarette smoking on endothelium-dependent brachial artery dilatation in healthy individuals},
	volume = {79},
	abstract = {The effect of short-term smoking on endothelium-dependent and endothelium-independent dilatation of the brachial artery was tested in 27 healthy volunteers using high-resolution ultrasound imaging. Short-term smoking led to a significant decrease in endothelium-dependent dilatation},
