	keywords = {Fasting, Glucose, Insulin Resistance, Men, methods, Research, Research Design, Risk, Sex, Syndrome, Women, Middle Aged, Risk Factors, Vascular Diseases, Aged, Female, Male, Disease, epidemiology, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, World Health, Diabetes Mellitus,Type 2, Metabolic Syndrome X, Prevalence, World Health Organization, Glucose Intolerance, Glucose Tolerance Test, Cohort Studies, Finland},
