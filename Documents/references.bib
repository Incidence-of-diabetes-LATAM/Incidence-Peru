	note = {Place: Social and Scientific Systems, Silver Spring, Maryland, USA. ssaydah@s-3.com},
	keywords = {Adult, analysis, blood, Fasting, Glucose, methods, Research, Research Design, diagnosis, Human, United States, Middle Aged, Aged, epidemiology, Blood Glucose, prevention \& control, Plasma, Diabetes Mellitus, history, Reproducibility of Results, Glucose Tolerance Test, Hemoglobin A,Glycosylated, Maryland},
	pages = {1940--1945},
