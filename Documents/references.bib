	journal = {Circulation},
	author = {Aviram, M and Hardak, E and Vaya, J and Mahmood, S and Milo, S and Hoffman, A and Billicke, S and Draganov, D and Rosenblat, M},
	month = may,
	year = {2000},
	note = {Place: Lipid Research Laboratory, Technion Faculty of Medicine, the Rappaport Family Institute for Research in the Medical Sciences, Rambam Medical Center, Haifa, Israel. aviram@tx.technion.ac.il},
	keywords = {blood, methods, Research, Human, biosynthesis, metabolism, Support,Non-U.S.Gov't, physiology, Methionine, 10, Arteriosclerosis, Coronary Arteriosclerosis, Family, Arginine, enzymology, Lipid Peroxides, Israel, genetics, Carotid Artery Diseases, Esterases, Glutamine, Leucine, In Vitro, Protein Isoforms, Laboratories, Carboxylic Ester Hydrolases, Hydrolases, Peroxidase, Linoleic Acid, Linoleic Acids},
