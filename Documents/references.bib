	volume = {7},
	issn = {2077-0383},
	shorttitle = {Pre-{Operative} {Frailty} {Status} {Is} {Associated} with {Cardiac} {Rehabilitation} {Completion}},
	url = {http://www.mdpi.com/2077-0383/7/12/560},
	doi = {10.3390/jcm7120560},
	abstract = {While previous investigations have demonstrated the beneﬁt of cardiac rehabilitation (CR) on outcomes after cardiac surgery, the association between pre-operative frailty and post-operative CR completion is unclear. The purpose of this retrospective cohort study was to determine if pre-operative frailty scores impacted CR completion post-operatively and if CR completion inﬂuenced frailty scores in 114 cardiac surgery patients. Frailty was assessed with the use of the Clinical Frailty Scale (CFS), the Modiﬁed Fried Criteria (MFC), the Short Physical Performance Battery (SPPB), and the Functional Frailty Index (FFI). A Mann-Whitney test was used to compare frailty scores between CR completers and non-completers and changes in frailty scores from baseline to 1-year post-operation. CR non-completers were more frail than CR completers at pre-operative baseline based on the CFS (p = 0.01), MFC (p {\textless} 0.001), SPPB (p = 0.007), and the FFI (p {\textless} 0.001). A change in frailty scores from baseline to 1-year post-operation was not detected in either group using any of the four frailty assessments. However, greater improvements from baseline to 1-year post-operation in two MFC domains (cognitive impairment and low physical activity) and the physical domain of the FFI were found in CR completers as compared to CR non-completers. These data suggest that pre-operative frailty assessments have the potential to identify participants who are less likely to attend and complete CR. The data also suggest that frailty assessment tools need further reﬁnement, as physical domains of frailty function appear to be more sensitive to change following CR than other domains of frailty.},
	language = {en},
	number = {12},
	urldate = {2021-02-13},
	journal = {Journal of Clinical Medicine},
	author = {Kimber, Dustin and Kehler, D. and Lytwyn, James and Boreskie, Kevin and Jung, Patrick and Alexander, Bryce and Hiebert, Brett and Dubiel, Chris and Hamm, Naomi and Stammers, Andrew and Clarke, Mekayla and Fraser, Carly and Pedreira, Brittany and Tangri, Navdeep and Hay, Jacqueline and Arora, Rakesh and Duhamel, Todd},
	month = dec,
	year = {2018},
	pages = {560},
	file = {Kimber e.a. - 2018 - Pre-Operative Frailty Status Is Associated with Ca.pdf:/Users/planetarium/Zotero/storage/3D5PSPH3/Kimber e.a. - 2018 - Pre-Operative Frailty Status Is Associated with Ca.pdf:application/pdf},
}

