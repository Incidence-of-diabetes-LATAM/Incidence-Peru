	keywords = {California, methods, Research, Research Design, Human, Support,Non-U.S.Gov't, physiopathology, drug therapy, therapeutic use, complications, Hypoglycemic Agents, Diabetes Mellitus,Type I, Diabetes Mellitus,Type II, Reproducibility of Results, Exercise, Randomized Controlled Trials, Clinical Trials, Models,Biological, Computer Simulation},
