	pages = {909--911},
	file = {Sullivan e.a. - 2014 - Genetic Risk of Progression to Type 2 Diabetes and.pdf:/Users/planetarium/Zotero/storage/7ZY3NW9J/Sullivan e.a. - 2014 - Genetic Risk of Progression to Type 2 Diabetes and.pdf:application/pdf},
