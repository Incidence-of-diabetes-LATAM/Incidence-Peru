	title = {Longitudinal {Trajectories} of {HbA1c} and {Fasting} {Plasma} {Glucose} {Levels} {During} the {Development} of {Type} 2 {Diabetes}: {The} {Toranomon} {Hospital} {Health} {Management} {Center} {Study} 7 ({TOPICS} 7)},
