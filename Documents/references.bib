	journal = {J.Clin.Invest},
	author = {Schleicher, E D and Wagner, E and Nerlich, A G},
	month = feb,
	year = {1997},
	note = {Place: Department for Internal Medicine, Med. Klinik and Poliklinik IV, Tubingen, Germany},
