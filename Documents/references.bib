	keywords = {analysis, blood, Glucose, Women, diagnosis, therapy, Humans, Time, Blood Glucose, Plasma, Diabetes Mellitus, pathology, Guidelines, Practice Guidelines, Autoantibodies, C-Peptide, Consensus, Disease Management, Laboratories, Laboratory Techniques and Procedures, Proinsulin},
