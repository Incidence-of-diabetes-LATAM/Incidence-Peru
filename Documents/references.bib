	note = {Place: Department of Medicine, Sarah W. Stedman Center for Nutritional Studies, Duke University Medical Center, Durham, NC 27710, USA},
	keywords = {Atherosclerosis, Cholesterol, Lipids, Human, metabolism, Oxidation-Reduction, Support,U.S.Gov't,P.H.S., Lipoproteins, Arteriosclerosis, pathology, chemistry, Stress, Death, Proteins, Complement, Complement Activation, Extracellular Matrix},
