	month = oct,
	year = {2007},
	note = {Place: Department of Clinical and Experimental Medicine, Medical School, University of Padua, Via Giustiniani 2, 35100, Padua, Italy. gianpaolo.fadini@unipd.it},
	keywords = {Adult, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Incidence, methods, Risk, metabolism, Middle Aged, physiology, physiopathology, Risk Factors, Female, Male, Disease, Humans, Body Mass Index, Blood Glucose, Lipoproteins, Diabetes Mellitus, Homeostasis, Glucose Tolerance Test, Italy, Analysis of Variance, Antigens, Prediabetic State, Stem Cells, Antigens,CD34, Erythroid Progenitor Cells},
