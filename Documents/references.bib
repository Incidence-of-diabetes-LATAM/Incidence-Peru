}

@article{norata_leptinadiponectin_2007,
	title = {Leptin:adiponectin ratio is an independent predictor of intima media thickness of the common carotid artery},
	volume = {38},
	abstract = {BACKGROUND AND PURPOSE: The evaluation of the leptin:adiponectin ratio (L:A) has been suggested as an atherosclerotic index in patients with type 2 diabetes and a useful parameter to assess insulin resistance in patients with and without diabetes. METHODS: We investigated, therefore, the relationship between L:A ratio and intima media thickness (IMT), an independent predictor of cardiovascular disease, in 110 healthy males. RESULTS: L:A ratio was significantly correlated to body mass index, waist, hip, waist-to-hip ratio, systolic blood pressure, IMT, high-density lipoprotein, apolipoprotein A-I, glucose, and the homeostasis model of insulin resistance-revised. No significant correlation was observed with age, diastolic blood pressure, low-density lipoprotein, triglycerides, apolipoprotein B, ApoB/ApoA-I ratio, insulin, alanine transaminase, gamma-glutamyl-transferase, and resistin. In addition, when the relationship between IMT and adiponectin or leptin alone was analyzed, only leptin plasma levels significantly associated with IMT (r=0.301, P{\textless}0.01). In a multiple regression analysis including in the statistical model the risk factors known to affect IMT (age, systolic blood pressure, diastolic blood pressure, high-density lipoprotein cholesterol, triglycerides, total cholesterol, body mass index, glucose, and L:A ratio), we observed that only age, L:A, and glucose were independent predictors of IMT. As expected, obese subjects (body mass index {\textgreater}30 kg/m(2)) showed a significantly higher L:A ratio compared with nonobese subjects (1.20 versus 0.42, respectively, P{\textless}0.001); in addition, subjects with the metabolic syndrome showed a significantly higher L:A ratio level (0.79) compared with subjects without (0.52) (P{\textless}0.01). CONCLUSIONS: We show here that the L:A ratio is a powerful independent predictor of IMT in healthy subjects and correlates with several anthropometric, metabolic, and clinical parameters better than each single adipokine},
	number = {1524-4628 (Electronic) LA - eng PT - Journal Article PT - Research Support, Non-U.S. Gov't RN - 0 (Adiponectin) RN - 0 (Biological Markers) RN - 0 (Leptin) SB - IM},
	journal = {Stroke},
	author = {Norata, G D and Raselli, S and Grigore, L and Garlaschelli, K and Dozio, E and Magni, P and Catapano, A L},
	month = oct,
	year = {2007},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Glucose, Insulin, Insulin Resistance, methods, Pressure, Research, Risk, Syndrome, Triglycerides, Middle Aged, Risk Factors, Aged, Male, Disease, Humans, Body Mass Index, Arteries, Plasma, Regression Analysis, pathology, Predictive Value of Tests, Tunica Media, Biological Markers, Homeostasis, Carotid Arteries, Research Support, Leptin, Carotid Artery,Common, Carotid Stenosis, Apolipoprotein A-I, Adiponectin, Resistin, Alanine Transaminase},
	pages = {2844--2846},
