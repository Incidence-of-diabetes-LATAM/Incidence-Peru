}

@article{noauthor_consequences_1999,
	title = {Consequences of the new diagnostic criteria for diabetes in older men and women. {DECODE} {Study} ({Diabetes} {Epidemiology}: {Collaborative} {Analysis} of {Diagnostic} {Criteria} in {Europe})},
	volume = {22},
	abstract = {OBJECTIVE: To evaluate the prevalence of diabetes and the risk of death in older European men and women aged between 60 and 79 years at baseline using the new American Diabetes Association diagnostic criteria for diabetes. RESEARCH DESIGN AND METHODS: The analysis involved existing population-based European studies from the DECODE Study Group (Diabetes Epidemiology: Collaborative Analysis of Diagnostic Criteria in Europe) and involved baseline measures of fasting and 2-h glucose concentrations after a 75-g oral glucose tolerance test (OGTT) and follow-up to determine deaths. This analysis included 4,032 men and 2,207 women who were not previously known to have diabetes and 383 men and 319 women who had established diabetes. RESULTS: More than half of the diabetic subjects had already been diagnosed, one sixth had a fasting hyperglycemia {\textgreater} or = 7.8 mmol/l (140 mg/dl), one-sixth had a fasting glucose level of 7.0-7.8 mmol/l (126-140 mg/dl), and one-sixth had an isolated postchallenge hyperglycemia (fasting glucose {\textless} 7.0 mmol/l and 2-h glucose {\textgreater} or = 11.1 mmol/l [200 g/dl]). Compared with non-diabetic subjects, the hazard ratios for death in diabetic subjects were close to 2 and did not differ significantly according to the method of diagnosis of diabetes, age-group, or sex. CONCLUSIONS: One-third of the older diabetic subjects who were undiagnosed at baseline had isolated postchallenge hyperglycemia. OGTT screening of the subjects with impaired fasting glucose (6.1-6.9 mmol/l) would reduce this fraction by half. The group with isolated postchallenge hyperglycemia had an elevated risk of mortality similar to that of other diabetic subjects},
	number = {0149-5992 LA - eng PT - Journal Article PT - Multicenter Study RN - 0 (Blood Glucose) SB - IM},
	journal = {Diabetes Care},
	month = oct,
	year = {1999},
	keywords = {analysis, blood, Fasting, Glucose, Men, methods, Research, Research Design, Risk, Sex, Women, diagnosis, Human, metabolism, Support,Non-U.S.Gov't, Middle Aged, Risk Factors, Aged, Female, Male, Age Factors, epidemiology, Multicenter Studies, Blood Glucose, Hyperglycemia, Diabetes Mellitus, Europe, mortality, Prevalence, Glucose Tolerance Test, Sex Factors, Death},
	pages = {1667--1671},
	annote = {DA - 19991116},
