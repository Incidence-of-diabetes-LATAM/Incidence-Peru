	note = {Place: Department of Clinical Physics and Informatics, Vrije Universiteit, Amsterdam, the Netherlands},
	keywords = {Glucose, methods, Pressure, Research, Research Design, Risk, diagnosis, Human, Support,Non-U.S.Gov't, Middle Aged, Cardiovascular Diseases, Hypertension, Risk Factors, Aged, Female, Male, Disease, complications, Myocardial Infarction, Heart, Diabetes Mellitus, mortality, history, Netherlands, Heart Rate, Autonomic Nervous System Diseases, Rest, Baroreflex, Respiration, Supination},
