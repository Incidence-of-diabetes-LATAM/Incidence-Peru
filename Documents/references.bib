	pages = {121--125},
	file = {de Miguel-Yanes e.a. - 2011 - Genetic Risk Reclassification for Type 2 Diabetes .pdf:/Users/planetarium/Zotero/storage/DAINT9LI/de Miguel-Yanes e.a. - 2011 - Genetic Risk Reclassification for Type 2 Diabetes .pdf:application/pdf},
