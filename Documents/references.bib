	doi = {10.1007/s00125-016-3887-6},
	abstract = {Aims/hypothesis Screening programmes for type 2 diabetes inevitably find more people at high risk of developing diabetes than people with undiagnosed prevalent diabetes. We describe the incidence of diabetes for risk groups according to advancement in a screening process.},
	language = {en},
