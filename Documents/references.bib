	author = {Ruiz, J and Blanche, H and James, R W and Garin, M C and Vaisse, C and Charpentier, G and Cohen, N and Morabia, A and Passa, P and Froguel, P},
	month = sep,
	year = {1995},
	note = {Place: Division d'Epidemiologie Clinique, Geneva University Hospital, Switzerland},
	keywords = {analysis, Odds Ratio, Risk, Human, metabolism, Support,Non-U.S.Gov't, Case-Control Studies, Risk Factors, Female, Male, Middle Age, Disease, complications, Arteries, Heart, Coronary Disease, Lipoproteins, Multivariate Analysis, Diabetes Mellitus,Non-Insulin-Dependent, Regression Analysis, history, Arginine, enzymology, Lipid Peroxides, genetics, Esterases, Genotype, Glutamine, Polymorphism (Genetics)},
	pages = {869--872},
