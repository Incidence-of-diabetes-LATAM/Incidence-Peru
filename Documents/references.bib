	pages = {818--826},
	file = {García-Ortiz e.a. - 2015 - The role of retinal vessels caliber as a marker of.pdf:/Users/planetarium/Zotero/storage/35H43CX2/García-Ortiz e.a. - 2015 - The role of retinal vessels caliber as a marker of.pdf:application/pdf},
