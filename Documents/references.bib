	note = {Place: Medizinische Poliklinik, University of Bonn, Germany},
	keywords = {Adult, analysis, methods, drug effects, metabolism, Nitric Oxide, pharmacology, Support,Non-U.S.Gov't, Animal, Female, Myocardial Infarction, analogs \& derivatives, chemistry, enzymology, Cells,Cultured, Estradiol, Nitric-Oxide Synthase, Rats, Myocardium, Fluorescent Antibody Technique, Blotting,Western, Enzyme Induction, Estrogen Antagonists, Ovariectomy, Rats,Inbred WKY, Receptors,Estrogen, Stimulation,Chemical},
