	keywords = {Adult, blood, Blood Pressure, Cholesterol, Men, methods, Pressure, Research, Research Design, Syndrome, Women, Aged, Disease, Hypertriglyceridemia, Prevalence, Nutrition},
	pages = {2444--2449},
