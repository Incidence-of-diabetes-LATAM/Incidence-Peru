@article{urbina_brachial_2002,
	title = {Brachial artery distensibility and relation to cardiovascular risk factors in healthy young adults ({The} {Bogalusa} {Heart} {Study})},
	volume = {89},
	abstract = {Arterial distensibility decreases with age and atherosclerosis leading to increased pulse pressure (PP) and increased left ventricular work, resulting in left ventricular hypertrophy, a risk factor for cardiovascular morbidity. Brachial artery pulse curve data were collected using the DynaPulse 2000A. Distensibility measured in 920 healthy young adults (40\% men, 70\% white, age range 18 to 38 years) was compared with levels of cardiovascular risk factors. Laboratory, anthropometric, blood pressure (BP), and heart rate measurements were also obtained. Distensibility tended to decrease with age, reaching significance in women (p {\textless}0.05). Whites had greater distensibility adjusted for age than blacks, with women more than men (p {\textless}0.05). Distensibility adjusted for PP was negatively correlated with measures of body size, BP, glucose, insulin, low-density lipoprotein cholesterol, very low density lipoprotein cholesterol, and age (p {\textless}0.05). When distensibility was plotted as a function of PP to control for distending pressure, the lowest quintiles of systolic, diastolic, and mean arterial BPs tended to have greater distensibility. No differences were seen by quintiles of lipids. In multivariate analyses, BP, age, anthropometric measures, gender, and very low density lipoprotein cholesterol entered the model (r(2) = 0.56; p {\textless}0.02). Thus, brachial artery distensibility, which includes a normalization factor to control for body size, showed race and gender differences (whites and women had greater distensibility than blacks and men, respectively), even after adjustment for age. Stiffer vessels with decreased distensibility were seen in subjects with higher levels of cardiovascular risk factors across the range of normal PP. Therefore, noninvasive measures of distensibility are useful in measuring subclinical vascular changes related to arteriosclerosis},
	number = {0002-9149 LA - eng},
	journal = {Am.J.Cardiol.},
	author = {Urbina, E M and Brinton, T J and Elkasabany, A and Berenson, G S},
	month = apr,
	year = {2002},
	note = {Place: Tulane University Medical Center, Section of Pediatric Cardiology, New Orleans, Louisiana 70112-7103, USA},
	keywords = {Adult, blood, Blood Pressure, Cholesterol, Glucose, Insulin, Lipids, Risk, Human, Support,U.S.Gov't,P.H.S., United States, Cardiovascular Diseases, physiology, Risk Factors, Brachial Artery, Female, Male, Time Factors, epidemiology, Linear Models, Arteries, Heart, Body Constitution, Arteriosclerosis, Vasodilation, Cardiology, Morbidity, Sex Factors, Heart Rate, Pulse, Work},
	pages = {946--951},
