}

@article{folsom_association_2001,
	title = {Association of {C}-reactive protein with markers of prevalent atherosclerotic disease},
	volume = {88},
	abstract = {Recent prospective studies have demonstrated that elevated C-reactive protein (CRP) is a marker of increased risk of atherothrombotic clinical events. We examined in a large, cross-sectional family-based study (n = 875 men, 948 women) whether serum CRP was associated with prevalent coronary heart disease (CHD), the ankle/brachial blood pressure index, or carotid intima-media thickness, an indicator of subclinical atherosclerosis as assessed by B-mode ultrasound. CRP was associated with many other cardiovascular risk factors, particularly markers of obesity and insulin resistance, markers of inflammation and acute phase reaction, and hormone replacement therapy. Adjusted for age and family type, there was a weak positive association of CRP with carotid intima-media thickness in both genders and with prevalent CHD in women. However, adjustment for other risk factors completely eliminated the associations. For example, among women, the risk factor-adjusted mean values of intima-media thickness across quartiles of CRP were 0.76, 0.74, 0.75, and 0.76 mm (p {\textgreater}0.5). In men there was a weak inverse association between CRP and ankle/brachial blood pressure index, independent of other risk factors, but no such association in women. Our findings indicate that CRP is not strongly and independently associated with prevalent atherosclerosis. Because CRP has been associated with clinical events, it could be that elevated CRP may be a stronger marker of thrombotic risk than of the degree of atherosclerosis},
	number = {0002-9149 LA - eng},
	journal = {Am.J.Cardiol.},
	author = {Folsom, A R and Pankow, J S and Tracy, R P and Arnett, D K and Peacock, J M and Hong, Y and Djousse, L and Eckfeldt, J H},
	month = jul,
	year = {2001},
	note = {Place: Division of Epidemiology, School of Public Health, University of Minnesota, Minneapolis, Minnesota 55454-1015, USA. folsom@epi.umn.edu},
	keywords = {analysis, blood, Blood Pressure, Insulin, Insulin Resistance, Obesity, Risk, diagnosis, Human, therapy, Support,U.S.Gov't,P.H.S., United States, Inflammation, Risk Factors, Aged, Female, Male, Middle Age, Age Factors, epidemiology, Heart, Prospective Studies, ultrasonography, Coronary Arteriosclerosis, Family, Prevalence, C-Reactive Protein, Thrombosis, Cross-Sectional Studies, Sex Factors, genetics, Carotid Arteries, Minnesota},
	pages = {112--117},
	annote = {UI - 21341348},
}

@article{bergholm_intense_1999,
	title = {Intense physical training decreases circulating antioxidants and endothelium-dependent vasodilatation in vivo},
	volume = {145},
	abstract = {Physical training increases free radical production and consumes antioxidants. It has previously been shown that acute exercise markedly increases the susceptibility of LDL to oxidation but whether such changes are observed during physical training is unknown. We measured circulating antioxidants, lipids and lipoproteins, and blood flow responses to intrabrachial infusions of endothelium-dependent (acetylcholine, ACh, L-N-monomethyl-arginine, L-NMMA) and -independent (sodium nitroprusside, SNP) vasoactive agents, before and after 3 months of running in 9 fit male subjects. Maximal aerobic power increased from 53 +/- 1 to 58 +/- 2 ml/kg min (P {\textless} 0.02). All circulating antioxidants (uric acid, SH-groups, alpha-tocopherol, beta-carotene, retinol) except ascorbate decreased significantly during training. Endothelium-dependent vasodilatation in forearm vessels decreased by 32-35\% (P {\textless} 0.05), as determined from blood flow responses to both a low (10.8 +/- 2.1 vs. 7.3 +/- 1.5 ml/dl min, 0 vs. 3 months) and a high (14.8 +/- 2.6 vs. 9.6 +/- 1.8) ACh dose. The \% endothelium-dependent blood flow (\% decrease in basal flow by L-NMMA), decreased through training from 37 +/- 3 to 22 +/- 7\% (P {\textless} 0.05). Blood flow responses to SNP remained unchanged. The decrease in uric acid was significantly correlated with the change in the \% decrease in blood flow by L-NMMA (r = 0.74, P {\textless} 0.05). The lag time for the susceptibility of plasma LDL to oxidation in vitro, LDL size and the concentration of LDL cholestetol remained unchanged. We conclude that relatively intense aerobic training decreases circulating antioxidant concentrations and impairs endothelial function in forearm vessels},
	number = {0021-9150 LA - eng PT - Journal Article},
	journal = {Atherosclerosis},
	author = {Bergholm, R and Makimattila, S and Valkonen, M and Liu, M L and Lahdenpera, S and Taskinen, M R and Sovijarvi, A and Malmberg, P and Yki-Jarvinen, H},
	month = aug,
	year = {1999},
	note = {Place: Department of Medicine, University of Helsinki, Finland},
	keywords = {Adult, blood, Lipids, Human, Antioxidants, Comparative Study, drug effects, Endothelium,Vascular, metabolism, pharmacology, Support,Non-U.S.Gov't, physiology, Blood Flow Velocity, Brachial Artery, Male, Oxidative Stress, Lipoproteins, Vasodilation, Acetylcholine, omega-N-Methylarginine, Vasodilator Agents, In Vitro, Exercise, Forearm, Lipoproteins,LDL, Nitroprusside, Finland, Injections,Intra-Arterial, Free Radicals},
	pages = {341--349},
