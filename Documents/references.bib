	note = {Place: Section on Genetics and Epidemiology, Research Division, Joslin Diabetes Center, One Joslin Place, Boston, MA 02215, USA},
	keywords = {Adult, methods, Research, Human, Dna, Case-Control Studies, physiopathology, Female, Male, Oxidative Stress, Disease, epidemiology, Diabetes Mellitus, Reference Values, Stress, genetics, Esterases, Genotype, Polymorphism (Genetics), Diabetic Nephropathies, Age of Onset, Non-U.S.Gov't, Support, Genetic Predisposition to Disease, Amino Acid Substitution, Mutation, P.H.S., U.S.Gov't, Insulin-Dependent, Promoter Regions (Genetics), Missense},
