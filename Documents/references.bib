	journal = {Arterioscler.Thromb.},
	author = {Laurent, S and Girerd, X and Mourad, J J and Lacolley, P and Beck, L and Boutouyrie, P and Mignot, J P and Safar, M},
	month = jul,
	year = {1994},
	note = {Place: Department of Internal Medicine, Hopital Broussais, Paris, France},
	keywords = {Adult, blood, Blood Pressure, Human, Support,Non-U.S.Gov't, United States, Hypertension, physiology, physiopathology, Aged, Female, Male, Middle Age, Arteries, pathology, Carotid Arteries, Compliance, Elasticity, France, Radial Artery, Cell Wall, Elastic Tissue},
