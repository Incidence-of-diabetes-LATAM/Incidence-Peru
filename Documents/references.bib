	pages = {74--90},
	file = {Proust-Lima e.a. - 2014 - Joint latent class models for longitudinal and tim.pdf:/Users/planetarium/Zotero/storage/2EPUY5DB/Proust-Lima e.a. - 2014 - Joint latent class models for longitudinal and tim.pdf:application/pdf},
