	note = {Place: Department of General Practice, University of Aarhus, Denmark},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, methods, Pressure, Risk, diagnosis, therapy, Denmark, Middle Aged, Risk Factors, Vascular Diseases, Aged, Female, Male, epidemiology, Humans, complications, etiology, Blood Glucose, Diabetes Mellitus,Type 2, Hyperglycemia, England, mortality, Prevalence, Netherlands, Aspirin, Morbidity, Guidelines, Mass Screening, Capillaries, Cost-Benefit Analysis, economics, Health Status, Practice Guidelines as Topic, Randomized Controlled Trials as Topic, Physicians, Intervention Studies, Primary Health Care, Multicenter Studies as Topic},
