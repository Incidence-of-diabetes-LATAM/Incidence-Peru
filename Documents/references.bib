	note = {Place: Julius Center for Patient Oriented Research, University Hospital Utrecht, The Netherlands},
	keywords = {analysis, blood, Blood Pressure, methods, Research, Risk, Human, Support,Non-U.S.Gov't, Risk Factors, Female, Male, Middle Age, Time Factors, Linear Models, Arteries, Regression Analysis, ultrasonography, England, Peripheral Vascular Diseases, Netherlands, Carotid Artery Diseases, Carotid Arteries, Cohort Studies, Carotid Artery,Common, Pulse, Blood Pressure Determination, Intracranial Arteriosclerosis},
	pages = {1285--1289},
