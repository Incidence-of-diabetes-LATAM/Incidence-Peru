	note = {Place: Division of Internal Medicine, University of Minnesota, Minneapolis 55455, USA},
	keywords = {Adult, blood, methods, Human, drug effects, Endothelium, Endothelium,Vascular, metabolism, Nitric Oxide, United States, physiology, physiopathology, adverse effects, Brachial Artery, Female, Male, Middle Age, Time Factors, Arteries, Vasodilation, Smoking, blood supply, omega-N-Methylarginine, Vasodilator Agents, diagnostic use, Vascular Resistance, Forearm, Minnesota, Nitroprusside, Plethysmography, Infusions,Intra-Arterial, Methacholine Chloride, Carboxyhemoglobin},
