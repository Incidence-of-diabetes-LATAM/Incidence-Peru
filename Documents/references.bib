	keywords = {Adult, Blood Pressure, methods, Research, Risk, Human, Endothelium,Vascular, United States, Cardiovascular Diseases, physiology, physiopathology, Risk Factors, Brachial Artery, Male, Arteries, Japan, ultrasonography, Vasodilation, Regional Blood Flow, Hyperemia, Circadian Rhythm, Vascular Resistance, Heart Rate},
	pages = {417--421},
