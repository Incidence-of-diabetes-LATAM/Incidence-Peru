	number = {11},
	urldate = {2021-02-14},
	journal = {Diabetes Care},
	author = {Petropoulos, I. N. and Alam, U. and Fadavi, H. and Asghar, O. and Green, P. and Ponirakis, G. and Marshall, A. and Boulton, A. J. M. and Tavakoli, M. and Malik, R. A.},
	month = nov,
	year = {2013},
	pages = {3646--3651},
	file = {Petropoulos e.a. - 2013 - Corneal Nerve Loss Detected With Corneal Confocal .pdf:/Users/planetarium/Zotero/storage/3B4WHWU2/Petropoulos e.a. - 2013 - Corneal Nerve Loss Detected With Corneal Confocal .pdf:application/pdf},
}

@article{petrie_implications_2011,
	title = {Implications of genome wide association studies for the understanding of type 2 diabetes pathophysiology},
	volume = {81},
	issn = {00062952},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0006295210008099},
	doi = {10.1016/j.bcp.2010.11.010},
	abstract = {The rapid rise in prevalence of type 2 diabetes mellitus (T2DM) has been driven by changes in environmental factors – primarily increased caloric intake and reduced energy expenditure – resulting in reduced whole body insulin sensitivity (often termed insulin resistance). Insulin resistance has been proposed to be a major driver of progression to T2DM. However, of 38 individual susceptibility loci for T2DM recently identiﬁed by genome wide association studies, by far the majority code for proteins involved in b-cell function. In this review, we discuss the possible reasons for the paucity of insulin resistance genes and ask whether the new genetic susceptibility data should focus attention on b-cell targets in the development of therapies for T2DM.},
	language = {en},
	number = {4},
	urldate = {2021-02-14},
	journal = {Biochemical Pharmacology},
	author = {Petrie, John R. and Pearson, Ewan R. and Sutherland, Calum},
	month = feb,
	year = {2011},
	pages = {471--477},
	file = {Petrie e.a. - 2011 - Implications of genome wide association studies fo.pdf:/Users/planetarium/Zotero/storage/J7M255XK/Petrie e.a. - 2011 - Implications of genome wide association studies fo.pdf:application/pdf},
}

