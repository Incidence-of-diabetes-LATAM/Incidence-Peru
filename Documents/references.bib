	abstract = {Objective: Iron has been suggested to play a role in the etiology of type 2 diabetes mellitus (T2DM). Except for ferritin, evidence is sparse for other markers of iron metabolism that are regulated differently and might act through independent pathways. We therefore investigated the associations of serum ferritin, transferrin, soluble transferrin receptor (sTfR), transferrin saturation (TSAT), sTfR-to-log10ferritin (sTfR-F) index, and iron with impaired glucose metabolism (IGM/‘prediabetes’), T2DM, and four continuous glucose and insulin traits. Design and methods: Data from 2893 participants of the population-based Cooperative Health Research in the Region of Augsburg (KORA) F4 study (Germany) was investigated through regression analysis. The results were adjusted for sociodemographic, life-style, and obesity measures as well as metabolic, inﬂammatory, and other iron biomarkers following a step-wise approach. Non-linearity was tested by adding a non-linear spline component to the model. Results: Ferritin and transferrin were positively associated with IGM (fourth vs ﬁrst sex-speciﬁc quartile: ferritin odds ratio (OR)Z2.08 (95\% CI 1.43–3.04) and transferrin ORZ1.89 (95\% CI 1.32–2.70)), T2DM (ferritin ORZ1.98 (95\% CI 1.22–3.22) and transferrin ORZ2.42 (95\% CI 1.54–3.81)), and fasting as well as 2-h glucose. TSAT (ORZ0.55 (95\% CI 0.34–0.88)) and iron (ORZ0.61 (95\% CI 0.38–0.97)) were inversely associated with T2DM, sTfR-F-index was inversely associated with IGM (ORZ0.67 (95\% CI 0.48–0.95)). There was no strong evidence for non-linear relationships.},
	language = {en},
	number = {5},
	urldate = {2021-02-13},
	journal = {European Journal of Endocrinology},
	author = {Huth, Cornelia and Beuerle, Simon and Zierer, Astrid and Heier, Margit and Herder, Christian and Kaiser, Thorsten and Koenig, Wolfgang and Kronenberg, Florian and Oexle, Konrad and Rathmann, Wolfgang and Roden, Michael and Schwab, Sigrid and Seissler, Jochen and Stöckl, Doris and Meisinger, Christa and Peters, Annette and Thorand, Barbara},
	month = nov,
	year = {2015},
	pages = {643--653},
	file = {Huth e.a. - 2015 - Biomarkers of iron metabolism are independently as.pdf:/Users/planetarium/Zotero/storage/4EHLTYF3/Huth e.a. - 2015 - Biomarkers of iron metabolism are independently as.pdf:application/pdf},
}

@article{hutcheson_metabolic_2012,
	title = {The {Metabolic} {Syndrome}, {Oxidative} {Stress}, {Environment}, and {Cardiovascular} {Disease}: {The} {Great} {Exploration}},
	volume = {2012},
	issn = {1687-5214, 1687-5303},
	shorttitle = {The {Metabolic} {Syndrome}, {Oxidative} {Stress}, {Environment}, and {Cardiovascular} {Disease}},
	url = {http://www.hindawi.com/journals/jdr/2012/271028/},
	doi = {10.1155/2012/271028},
	abstract = {The metabolic syndrome affects 30\% of the US population with increasing prevalence. In this paper, we explore the relationship between the metabolic syndrome and the incidence and severity of cardiovascular disease in general and coronary artery disease (CAD) in particular. Furthermore, we look at the impact of metabolic syndrome on outcomes of coronary revascularization therapies including CABG, PTCA, and coronary collateral development. We also examine the association between the metabolic syndrome and its individual component pathologies and oxidative stress. Related, we explore the interaction between the main external sources of oxidative stress, cigarette smoke and air pollution, and metabolic syndrome and the effect of this interaction on CAD. We discuss the apparent lack of positive effect of antioxidants on cardiovascular outcomes in large clinical trials with emphasis on some of the limitations of these trials. Finally, we present evidence for successful use of antioxidant properties of pharmacological agents, including metformin, statins, angiotensin II type I receptor blockers (ARBs), and angiotensin II converting enzyme (ACE) inhibitors, for prevention and treatment of the cardiovascular complications of the metabolic syndrome.},
	language = {en},
	urldate = {2021-02-13},
	journal = {Experimental Diabetes Research},
	author = {Hutcheson, Rebecca and Rocic, Petra},
	year = {2012},
	pages = {1--13},
	file = {Hutcheson en Rocic - 2012 - The Metabolic Syndrome, Oxidative Stress, Environm.pdf:/Users/planetarium/Zotero/storage/9FT2VWIC/Hutcheson en Rocic - 2012 - The Metabolic Syndrome, Oxidative Stress, Environm.pdf:application/pdf},
}

