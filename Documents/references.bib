	keywords = {blood, Glucose, Insulin, methods, Research, Research Design, Risk, Middle Aged, Disease Progression, Female, Male, Disease, Humans, etiology, 10, Diabetes Mellitus,Type 2, Prospective Studies, Homeostasis, Glucose Tolerance Test, genetics, Cohort Studies, Research Support, Germany, Evolution, Variation (Genetics), Gene Frequency, Haplotypes, Adiponectin, Polymorphism,Single Nucleotide, Promoter Regions (Genetics)},
