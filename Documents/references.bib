	keywords = {Risk, Middle Aged, Female, Male, Humans, Myocardial Infarction, Peripheral Vascular Diseases, Cause of Death, Prognosis, Diabetic Angiopathies, Stroke, Survival Rate, Diabetes Mellitus, Type 2, Diabetes Mellitus, Type 2: complications, Myocardial Infarction: etiology, Stroke: etiology, Stroke: mortality, Diabetes Mellitus, Type 2: mortality, Coronary Artery Disease, Myocardial Infarction: mortality, Diabetic Angiopathies: mortality, Diabetic Angiopathies: complications, Coronary Artery Disease: complications, Ankle Brachial Index, Coronary Artery Disease: mortality, Peripheral Vascular Diseases: complications, Peripheral Vascular Diseases: mortality},
