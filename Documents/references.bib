	year = {2003},
	note = {Place: Graduate Studies Program in Epidemiology, School of Medicine, Federal University of Rio Grande do Sul, Porto Alegre, Brazil. bbduncan@orion.ufrgs.br},
	keywords = {Atherosclerosis, blood, Fasting, Glucose, Incidence, Insulin, Research, Risk, Sex, Comparative Study, metabolism, United States, Case-Control Studies, Middle Aged, Hypertension, Inflammation, physiopathology, Risk Factors, Female, Male, epidemiology, Humans, Multicenter Studies, Blood Glucose, Diabetes Mellitus,Type 2, Plasma, Reference Values, history, Smoking, C-Reactive Protein, Fibrinogen, Cohort Studies, Research Support, African Continental Ancestry Group, European Continental Ancestry Group, Interleukin-6, African Americans, Whites, Cell Count, Brazil},
