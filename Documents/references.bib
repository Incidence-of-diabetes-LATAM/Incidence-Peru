	number = {12},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Cereda, E. and Barichella, M. and Pedrolli, C. and Klersy, C. and Cassani, E. and Caccialanza, R. and Pezzoli, G.},
