	note = {Place: Section of Cardiology, Department of Medicine (MC 715), University of Illinois at Chicago College of Medicine, 840 S Wood St, Chicago, IL 60612, USA. gtkondos@uic.edu},
	keywords = {Adult, blood, methods, Risk, Human, metabolism, United States, Disease Progression, Hypercholesterolemia, Hypertension, physiopathology, Risk Factors, Aged, Female, Male, Middle Age, Disease, epidemiology, Arteries, Follow-Up Studies, Multivariate Analysis, Risk Assessment, mortality, Cardiology, Coronary Angiography, Coronary Arteriosclerosis, history, Predictive Value of Tests, Smoking, Prevalence, Age Distribution, Sex Distribution, Calcinosis, radiography, Tomography,X-Ray Computed, Coronary Vessels, Medical Records, Death, Death Certificates, Calcium, Cohort Studies, Comorbidity, Illinois},
