	keywords = {Epidemiology, Registry-based research, Genetic disorders},
	pages = {249},
	file = {Nguyen-Nielsen e.a. - 2013 - Existing data sources for clinical epidemiology D.pdf:/Users/planetarium/Zotero/storage/UKNPYLIG/Nguyen-Nielsen e.a. - 2013 - Existing data sources for clinical epidemiology D.pdf:application/pdf},
}

@article{nguyen_retinal_2008,
	title = {Retinal {Arteriolar} {Narrowing} {Predicts} {Incidence} of {Diabetes}: {The} {Australian} {Diabetes}, {Obesity} and {Lifestyle} ({AusDiab}) {Study}},
	volume = {57},
	issn = {0012-1797, 1939-327X},
	shorttitle = {Retinal {Arteriolar} {Narrowing} {Predicts} {Incidence} of {Diabetes}},
	url = {http://diabetes.diabetesjournals.org/lookup/doi/10.2337/db07-1376},
	doi = {10.2337/db07-1376},
	abstract = {OBJECTIVE—To examine the relationship of retinal vascular caliber to incident diabetes in a population-based cohort. RESEARCH DESIGN AND METHODS—The Australian Diabetes, Obesity and Lifestyle (AusDiab) Study recruited adults aged 25ϩ years across Australia in 1999 –2000, with a follow-up 5 years later in 2004 –2005. Participants’ glycemic status was classiﬁed using fasting plasma glucose (FPG) and 2-h oral glucose tolerance (2-h plasma glucose [2hPG]) tests. Diabetes was diagnosed if FPG was Ն7.0 mmol/l or 2hPG was Ն11.1 mmol/l. Retinal vascular caliber was measured from baseline retinal photographs using a computer-assisted program.
RESULTS—Of the 803 participants without diabetes at baseline, 108 (13.4\%) developed diabetes at follow-up: 7 (2.8\%) of 246 participants with normal glucose tolerance, 9 (13.6\%) of 66 participants with impaired fasting glucose, and 92 (18.7\%) of 491 participants with impaired glucose tolerance. After multivariate analysis, participants with narrower retinal arteriolar caliber had a higher risk of diabetes (odds ratio 2.21 [95\% CI 1.02– 4.80], comparing smallest versus highest arteriolar caliber tertiles, P ϭ 0.04 for trend). There was no association between retinal venular caliber and incident diabetes.
CONCLUSIONS—Narrower retinal arteriolar caliber predicted risk of diabetes. These data provide further evidence that microvascular changes may contribute to the pathogenesis of diabetes. Diabetes 57:536–539, 2008},
	language = {en},
	number = {3},
	urldate = {2021-02-14},
	journal = {Diabetes},
	author = {Nguyen, Thanh T. and Wang, Jie Jin and Islam, F.M. Amirul and Mitchell, Paul and Tapp, Robyn J. and Zimmet, Paul Z. and Simpson, Richard and Shaw, Jonathan and Wong, Tien Y.},
	month = mar,
	year = {2008},
	pages = {536--539},
	file = {Nguyen e.a. - 2008 - Retinal Arteriolar Narrowing Predicts Incidence of.pdf:/Users/planetarium/Zotero/storage/H63F3B8R/Nguyen e.a. - 2008 - Retinal Arteriolar Narrowing Predicts Incidence of.pdf:application/pdf},
}

