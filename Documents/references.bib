@article{murphy_impact_2001,
	title = {Impact of preexisting statin use on adhesion molecule expression in patients presenting with acute coronary syndromes},
	volume = {87},
	abstract = {Of 147 patients admitted with acute coronary syndromes, 17 were taking statins at the time of presentation. These were matched with 17 subjects not taking statins. We found that statin therapy was associated with lower levels of sP-selectin, a marker of platelet and vascular endothelial activation. This provides further insight into the extralipid effect of statins in clinical practice and may help explain the greater-than-expected benefits of statin therapy in ischemic heart disease},
