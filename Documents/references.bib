Publication Title: The New England journal of medicine
Volume: 344},
	keywords = {11, Glucose, Incidence, Men, methods, Obesity, Risk, Women, diagnosis, Human, therapy, Middle Aged, administration \& dosage, Female, Male, Disease, epidemiology, Body Mass Index, complications, Multicenter Studies, Life Style, prevention \& control, Diabetes Mellitus, Prevalence, Glucose Intolerance, Glucose Tolerance Test, Diet, diet therapy, Exercise, Weight Loss, Finland, Non-U.S.Gov't, Support, Type II, Health Promotion, Dietary Fiber, Fat-Restricted},
