}

@article{sarabi_effects_1999,
	title = {Effects of age, gender and metabolic factors on endothelium-dependent vasodilation: a population-based study},
	volume = {246},
	abstract = {OBJECTIVES: A progressive decline in endothelium-dependent vasodilation (EDV) in the human forearm with age has previously been reported. The aim of this study was to evaluate the interplay between age, gender and metabolic factors on EDV in healthy subjects in a population-based study. SETTING: Tertiary university hospital. SUBJECTS AND DESIGN: Thirty-six healthy men and 30 women, aged 20-69 years, underwent measurements of forearm blood flow (FBF) at rest and during local infusions of 2 and 4 microg min-1 of metacholine (evaluating EDV) and 5 and 10 microg min-1 of sodium nitroprusside (evaluating endothelium-independent vasodilation, EIDV) and during reactive hyperaemia by venous occlusion plethysmography. RESULTS: Age was inversely related to EDV (r = - 0.41, P {\textless} 0.05 in men; r = - 0.61, P {\textless} 0.01 in women) and maximal FBF during reactive hyperaemia in both men and women. EIDV was significantly related to age in an inverse way in women only. EDV was more pronounced in females than in males before menopause (48 +/- 3 SD years, 635 +/- 186 vs. 502 +/- 269\% in males, P {\textless} 0.05), but similar in women and men thereafter (374 +/- 141 vs. 370 +/- 185\% in men). The slope of the regression line for the relationship between age and EDV was flatter in premenopausal than in postmenopausal women (- 2.3 vs. - 6.4), whilst this slope was similar in younger and older men (- 5.5 vs. - 5.3). In multiple regression analysis, fasting blood glucose levels and the waist/hip ratio remained the only significant predictors of EDV in men (P {\textless} 0.01 for both), whilst age was the only significant independent predictor of EDV in women (P {\textless} 0.01). CONCLUSION: The interplay between age and metabolic factors as determinants of endothelial function is different in healthy men and women},
	number = {0954-6820 LA - eng PT - Journal Article},
	journal = {J.Intern.Med.},
	author = {Sarabi, M and Millgard, J and Lind, L},
	month = sep,
	year = {1999},
	note = {Place: Department of Internal Medicine, University Hospital, Uppsala, Sweden},
	keywords = {Adult, analysis, blood, Fasting, Glucose, methods, Human, drug effects, Endothelium,Vascular, metabolism, physiology, physiopathology, Aged, Blood Flow Velocity, Female, Male, Middle Age, Blood Glucose, Aging, Reference Values, Regression Analysis, Vasodilation, England, blood supply, Sex Characteristics, Vasodilator Agents, diagnostic use, Hyperemia, Forearm, Analysis of Variance, Nitroprusside, Plethysmography, Sweden, Methacholine Chloride, Menopause, Parasympathomimetics},
	pages = {265--274},
