	author = {Karasawa, K and Harada, A and Satoh, N and Inoue, K and Setaka, M},
	month = mar,
	year = {2003},
	note = {Place: Faculty of Pharmaceutical Sciences, Teikyo University, Sagamiko, Kanagawa, Japan. karasawa@pharm.teikyo-u.ac.jp},
	keywords = {blood, Risk, diagnosis, Human, metabolism, Animal, Vascular Diseases, Disease, Kidney Diseases, Lipoproteins, Plasma, Arteriosclerosis, Diabetes Mellitus, Japan, pathology, Family, chemistry, Phospholipases A, Phospholipids, abnormalities, genetics, Polymorphism (Genetics), deficiency, Hydrolysis, Mutation, Anaphylaxis, Asthma},
