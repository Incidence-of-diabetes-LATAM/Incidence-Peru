	note = {Place: University of Manchester Department of Medicine, Manchester Royal Infirmary, Manchester, England. pdurrington@hq.cmht.nwest.nhs.uk},
	keywords = {Atherosclerosis, Cholesterol, Human, Antioxidants, drug effects, Lipid Peroxidation, metabolism, pharmacology, Support,Non-U.S.Gov't, Mice, physiology, physiopathology, Oxidative Stress, Disease, Heart, prevention \& control, Coronary Disease, Lipoproteins, Lipoproteins,HDL Cholesterol, Arteriosclerosis, England, Esterases, Clinical Trials},
