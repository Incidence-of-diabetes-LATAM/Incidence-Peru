	note = {Place: Cardiothoracic Unit, Great Ormond Street Hospital for Children NHS Trust, London, United Kingdom},
	keywords = {methods, Human, Endothelium, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, physiopathology, Vasculitis, Blood Flow Velocity, Brachial Artery, Female, Male, Time Factors, complications, Myocardial Infarction, Arteries, Multivariate Analysis, ultrasonography, Vasodilation, abnormalities, Hyperemia, Child, Death, Adolescent, Electrocardiography, Mucocutaneous Lymph Node Syndrome},
