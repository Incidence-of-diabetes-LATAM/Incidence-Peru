	month = jun,
	year = {1998},
	note = {Place: Department of Epidemiology and Public Health, UCL Medical School, London},
	keywords = {Adult, Insulin, Men, Odds Ratio, Risk, Triglycerides, Women, Middle Aged, physiology, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, London, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., Time, Body Mass Index, 10, Follow-Up Studies, Regression Analysis, Smoking, Sex Factors, Fibrinogen, Questionnaires, Analysis of Variance, Health Status Indicators, Eating, Physical Fitness},
