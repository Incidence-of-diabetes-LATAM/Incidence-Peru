@article{hingorani_acute_2000,
	title = {Acute systemic inflammation impairs endothelium-dependent dilatation in humans},
	volume = {102},
	abstract = {BACKGROUND: We tested the hypothesis that endothelial dysfunction underlies the association between an acute inflammatory episode and the transiently increased risk of a cardiovascular event by examining the effects of an experimental inflammatory stimulus on endothelium-dependent vasodilation. METHODS AND RESULTS: Salmonella typhi vaccine was used to generate a systemic inflammatory response in healthy volunteers. In 12 subjects, dilatation of the brachial artery to flow and to sublingual nitroglycerin (NTG) was recorded (conduit vessel response), and in 6 subjects, venous occlusion plethysmography was used to measure forearm blood flow during intrabrachial infusion of the endothelium-dependent dilators acetylcholine (ACh) and bradykinin (BK) and the endothelium-independent dilators NTG and verapamil (resistance vessel response). Responses were assessed 16 hours before and 8 and 32 hours after vaccination. Vaccination resulted in elevations in white cell count and serum levels of interleukin-6 and interleukin-1 receptor antagonist. Eight hours after vaccination, resistance vessel responses to BK (P:=0.0099) and ACh (P:=0.0414) were markedly attenuated, and brachial artery flow-mediated dilatation was depressed. Resistance vessel responses to verapamil and NTG were unchanged, as was the conduit vessel response to NTG. Thirty-two hours after vaccination, resistance vessel responses to BK and ACh had returned to normal. CONCLUSIONS: S typhi vaccine generates a mild inflammatory reaction associated with temporary but profound dysfunction of the arterial endothelium in both resistance and conduit vessels to both physical and pharmacological dilator stimuli. This finding might explain the association between infection and inflammation and the enhanced risk of an acute cardiovascular event},
	number = {1524-4539 LA - eng PT - Clinical Trial PT - Journal Article},
	journal = {Circulation},
	author = {Hingorani, A D and Cross, J and Kharbanda, R K and Mullen, M J and Bhagat, K and Taylor, M and Donald, A E and Palacios, M and Griffin, G E and Deanfield, J E and MacAllister, R J and Vallance, P},
	month = aug,
	year = {2000},
	note = {Place: Centre for Clinical Pharmacology, University College London, UK. a.hingorani@ucl.ac.uk},
	keywords = {Adult, analysis, blood, methods, Risk, Human, drug effects, Endothelium, Endothelium,Vascular, Necrosis, pharmacology, Support,Non-U.S.Gov't, United States, Inflammation, physiopathology, administration \& dosage, adverse effects, Blood Flow Velocity, Brachial Artery, drug therapy, Female, Male, therapeutic use, Time Factors, Arteries, prevention \& control, Dilatation, Nitroglycerin, Vasodilation, Regional Blood Flow, Acetylcholine, Bradykinin, Vasodilator Agents, Infection, Forearm, Analysis of Variance, Tumor Necrosis Factor, Plethysmography, chemically induced, Interleukin-6, Verapamil, Interleukin-1, Bacterial Vaccines, Typhoid Fever, Vaccines,Attenuated},
