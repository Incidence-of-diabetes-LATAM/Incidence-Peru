	publisher = {IEEE},
	author = {Tellioglu, Hilda},
	month = may,
	year = {2008},
	keywords = {Coordination and cooperation mechanisms, Distributed team management and issues, Frameworks and methodologies for collaboration},
	pages = {357--366},
