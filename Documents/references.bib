	note = {Place: Department of Epidemiology, Graduate School of Public Health, University of Pittsburgh, PA, USA},
	keywords = {Adult, analysis, Cholesterol, Incidence, methods, Risk, Triglycerides, Diabetic Neuropathies, Human, Comparative Study, Support,U.S.Gov't,P.H.S., Cardiovascular Diseases, Hypertension, physiopathology, Risk Factors, Female, Male, Time Factors, epidemiology, complications, etiology, Follow-Up Studies, Diabetes Mellitus,Insulin-Dependent, mortality, Smoking, Prevalence, Cohort Studies, Hemoglobin A,Glycosylated, Analysis of Variance, Proportional Hazards Models, Autonomic Nervous System, Autonomic Nervous System Diseases, Polyneuropathies},
