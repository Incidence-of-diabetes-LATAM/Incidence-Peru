	month = may,
	year = {2002},
	note = {Place: International Diabetes Institute, Melbourne, Australia. ddunstan@idi.org.au},
	keywords = {Adult, Fasting, Glucose, Men, methods, Obesity, Research, Research Design, Women, Comparative Study, Middle Aged, Risk Factors, Aged, Female, Male, epidemiology, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, World Health, Plasma, Diabetes Mellitus, Logistic Models, Prevalence, World Health Organization, Glucose Intolerance, Glucose Tolerance Test, Australia, Health Surveys},
