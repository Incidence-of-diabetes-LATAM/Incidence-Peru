	file = {Janghorbani en Amini - 2015 - Progression from optimal blood glucose and pre-dia.pdf:/Users/planetarium/Zotero/storage/5TJTAN2V/Janghorbani en Amini - 2015 - Progression from optimal blood glucose and pre-dia.pdf:application/pdf},
}

