	pages = {126--133},
	file = {Soriguer e.a. - 2008 - Incidence of type 2 diabetes in southern Spain (Pi.pdf:/Users/planetarium/Zotero/storage/6YAU68HH/Soriguer e.a. - 2008 - Incidence of type 2 diabetes in southern Spain (Pi.pdf:application/pdf},
}

@article{hall_impact_2016,
