	keywords = {Adult, analysis, blood, Fasting, Glucose, methods, Odds Ratio, Research, Research Design, diagnosis, United States, Middle Aged, Hypertension, Aged, Female, Male, epidemiology, Humans, Body Mass Index, Blood Glucose, Multivariate Analysis, Washington, Diabetes Mellitus, Sensitivity and Specificity, Family, Predictive Value of Tests, Glucose Intolerance, Glucose Tolerance Test, genetics, Continental Population Groups, Health Surveys, Nutrition},
