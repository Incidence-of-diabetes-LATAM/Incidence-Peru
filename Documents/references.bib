@article{laaksonen_metabolic_2002,
	title = {Metabolic syndrome and development of diabetes mellitus: application and validation of recently suggested definitions of the metabolic syndrome in a prospective cohort study},
	volume = {156},
	abstract = {The World Health Organization (WHO) and the National Cholesterol Education Program (NCEP) recently proposed definitions for the metabolic syndrome. Little is known of their validity, however. The authors assessed the sensitivity and specificity of the definitions of the metabolic syndrome for prevalent and incident diabetes mellitus in a Finnish population-based cohort of middle-aged men (n = 1,005) followed for 4 years since the late 1980s. Four definitions based on the WHO and NCEP recommendations were compared. All definitions identified persons at high risk for developing diabetes during the 4-year follow-up (odds ratios = 5.0-8.8). The WHO definition including waist-hip ratio {\textgreater} 0.90 or body mass index {\textgreater}or= 30 kg/m(2) was the most sensitive (0.83 and 0.67) and least specific (0.78 and 0.80) in detecting the 47 prevalent and 51 incident cases of diabetes. The NCEP definition in which adiposity was defined as waist girth {\textgreater} 102 cm detected only 61\% of prevalent and 41\% of incident diabetes, although it was the most specific (0.89 and 0.90). The WHO definition seems valid as judged by its relatively high sensitivity and specificity in predicting diabetes. The NCEP definition including waist {\textgreater} 102 cm also identifies persons at high risk for diabetes, but it is relatively insensitive in predicting diabetes},
	number = {0002-9262 LA - eng PT - Journal Article SB - IM},
	journal = {Am.J.Epidemiol.},
	author = {Laaksonen, D E and Lakka, H M and Niskanen, L K and Kaplan, G A and Salonen, J T and Lakka, T A},
	month = dec,
	year = {2002},
	note = {Place: Department of Medicine, Kuopio University Hospital, Kuopio, Finland},
	keywords = {Adult, Cholesterol, Insulin Resistance, Men, Odds Ratio, Risk, Syndrome, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Middle Aged, Male, epidemiology, Body Mass Index, complications, etiology, World Health, Metabolic Syndrome X, Body Constitution, Prospective Studies, Diabetes Mellitus, Sensitivity and Specificity, Diabetes Mellitus,Type II, World Health Organization, Cohort Studies, Finland},
	pages = {1070--1077},
