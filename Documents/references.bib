	keywords = {Adult, analysis, blood, Cholesterol, Insulin, Insulin Resistance, Lipids, methods, Obesity, Sex, Syndrome, Triglycerides, Human, Support,Non-U.S.Gov't, Cardiovascular Diseases, Hypercholesterolemia, Hypertension, physiopathology, Female, Male, Disease, epidemiology, complications, Multicenter Studies, prevention \& control, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Multivariate Analysis, Plasma, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Smoking, Prevalence, Hyperlipidemia, Exercise, Diabetic Angiopathies, Age of Onset, Hemoglobin A,Glycosylated, Lipoproteins,VLDL, Questionnaires},
