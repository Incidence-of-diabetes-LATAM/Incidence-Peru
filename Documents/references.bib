	month = apr,
	year = {1999},
	note = {Place: Department of Obstetrics and Gynecology, Institute for Cardiovascular Research, University Hospital Vrije Universiteit, Amsterdam, The Netherlands},
	keywords = {blood, Human, drug effects, E-Selectin, Endothelium,Vascular, metabolism, Support,Non-U.S.Gov't, United States, Inflammation, physiology, administration \& dosage, Brachial Artery, Female, Middle Age, Prospective Studies, Fibrinogen, von Willebrand Factor, Endothelin-1, Estrogen Replacement Therapy, Postmenopause, Estradiol, Solubility, Thrombomodulin, Dydrogesterone},
