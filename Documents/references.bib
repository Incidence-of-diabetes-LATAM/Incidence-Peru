@article{kato_impairment_2000,
	title = {Impairment of endothelium-dependent vasodilation of resistance vessels in patients with obstructive sleep apnea},
	volume = {102},
	abstract = {BACKGROUND: Patients with obstructive sleep apnea (OSA) experience repetitive episodic hypoxemia with consequent sympathetic activation and marked blood pressure surges, each of which may impair endothelial function. We tested the hypothesis that patients with OSA have impaired endothelium-dependent vasodilation, even in the absence of overt cardiovascular disease. METHODS AND RESULTS: We studied 8 patients with OSA (age 44+/-4 years) and 9 obese control subjects (age 48+/-3 years). Patients with OSA were newly diagnosed, never treated for OSA, on no medications, and free of any other known diseases. All obese control subjects underwent complete overnight polysomnographic studies to exclude occult OSA. Resistance-vessel function was tested by use of forearm blood flow responses to intra-arterial infusions of acetylcholine (a vasodilator that stimulates endothelial release of nitric oxide), sodium nitroprusside (an exogenous nitric oxide donor), and verapamil (a calcium channel blocker). Conduit-vessel function was also evaluated by ultrasonography. Brachial artery diameter was measured under baseline conditions, during reactive hyperemia (with flow increase causing endothelium-dependent dilatation), and after sublingual administration of nitroglycerin (an endothelium-independent vasodilator). Patients with OSA had a blunted vasodilation in response to acetylcholine (P:{\textless}0.007), but responses to sodium nitroprusside and verapamil were not significantly different from those of control subjects. No significant difference in conduit-vessel dilation was evident between OSA patients and obese control subjects. CONCLUSIONS: Patients with OSA have an impairment of resistance-vessel endothelium-dependent vasodilation. This may be implicated in the pathogenesis of hypertension and heart failure in this condition},
	number = {1524-4539 LA - eng},
	journal = {Circulation},
	author = {Kato, M and Roberts-Thomson, P and Phillips, B G and Haynes, W G and Winnicki, M and Accurso, V and Somers, V K},
	month = nov,
	year = {2000},
	note = {Place: Division of Clinical and Administrative Pharmacy, University of Iowa Colleges of Medicine and Pharmacy, Iowa City, USA},
	keywords = {Adult, blood, Blood Pressure, methods, Obesity, Human, drug effects, Endothelium,Vascular, Nitric Oxide, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, Hypertension, physiopathology, administration \& dosage, Blood Flow Velocity, Brachial Artery, Male, Middle Age, Disease, complications, Arteries, Heart, Dilatation, Nitroglycerin, ultrasonography, Vasodilation, Acetylcholine, blood supply, Vasodilator Agents, Hyperemia, Calcium, Vascular Resistance, Forearm, Cities, Nitroprusside, Heart Rate, Dose-Response Relationship,Drug, Verapamil, Infusions,Intra-Arterial, Electrocardiography, Polysomnography, Sleep, Sleep Apnea,Obstructive},
