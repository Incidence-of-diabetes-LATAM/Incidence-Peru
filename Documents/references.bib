	keywords = {methods, Human, Comparative Study, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, physiopathology, administration \& dosage, adverse effects, Aged, Blood Flow Velocity, Brachial Artery, drug therapy, Female, Male, Middle Age, Arteries, Coronary Disease, Vasodilation, Coronary Circulation, Genotype, Calcium, Drug Therapy,Combination, Enzyme Inhibitors, Angiotensin-Converting Enzyme Inhibitors, Angiotensin II, Losartan, Isoquinolines, Calcium Channel Blockers, Enalapril, Amlodipine},
