	note = {Place: Cardiovascular Sciences Research Group, University of Wales College of Medicine, Heath Park, Cardiff, UK},
	keywords = {Adult, Blood Pressure, Insulin, Insulin Resistance, methods, Research, Syndrome, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, Case-Control Studies, Hypertension, physiopathology, Brachial Artery, Female, Male, Disease, Arteries, Heart, Prospective Studies, Dilatation, Nitroglycerin, Statistics,Nonparametric, ultrasonography, Pregnancy, Regional Blood Flow, Wales, Netherlands, Hand, Vasodilator Agents, diagnostic use, Hyperemia, Birth Weight, Fetal Growth Retardation},
