	keywords = {analysis, methods, Odds Ratio, Human, Disease Progression, Female, Male, Disease, epidemiology, complications, etiology, Myocardial Infarction, Arteries, prevention \& control, Follow-Up Studies, Sensitivity and Specificity, pathology, Cardiology, Coronary Angiography, Coronary Arteriosclerosis, chemistry, Calcinosis, radiography, Coronary Vessels, Mass Screening, Roc Curve, Death, Death,Sudden,Cardiac, Calcium, statistics \& numerical data, Brain Ischemia, Coronary Artery Bypass, Angioplasty},
