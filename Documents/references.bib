	note = {Place: Evans Department of Medicine, Cardiology Section, and Whitaker Cardiovascular Institute, Boston University School of Medicine, Boston, Massachusetts, USA},
	keywords = {Human, drug effects, Endothelium, Endothelium,Vascular, pharmacology, United States, physiopathology, Aged, Brachial Artery, Female, Male, Middle Age, Disease, Arteries, Life Style, Nitroglycerin, Cardiology, Coronary Arteriosclerosis, blood supply, Massachusetts, Stress, rehabilitation, Coronary Circulation, Exercise, Arm, Leg, Exercise Tolerance, Physical Endurance, Tibial Arteries},
