	journal = {Circulation},
	author = {Yim, S F and Lau, T K and Sahota, D S and Chung, T K and Chang, A M and Haines, C J},
	month = oct,
	year = {1998},
	note = {Place: Department of Obstetrics and Gynaecology, Chinese University of Hong Kong, Prince of Wales Hospital, Shatin, New Territories, Hong Kong},
	keywords = {Adult, methods, Sex, Human, therapy, drug effects, Endothelium,Vascular, United States, Brachial Artery, Female, Arteries, Prospective Studies, Wales, Vasomotor System, Hyperemia, Hormone Replacement Therapy, Menopause, agonists, Receptors,LHRH},
