	note = {Place: University Department of Medicine, City Hospital, Birmingham, United Kingdom. a.blann@bham.ac.uk},
	keywords = {Human, E-Selectin, Endothelium, Endothelium,Vascular, Intercellular Adhesion Molecule-1, metabolism, United States, Female, Male, Middle Age, Arteries, Arteriosclerosis, pathology, Biological Markers, Carotid Artery Diseases, Carotid Arteries, von Willebrand Factor, Carotid Stenosis, Thrombomodulin, Intermittent Claudication},
	pages = {209--216},
