	note = {Place: Department of Cardiology, Second Affiliated Hospital, Hunan Medical University, Changsha 410011, China},
	keywords = {analysis, methods, Human, drug effects, Endothelium,Vascular, pharmacology, Hypertension, physiopathology, Aged, Brachial Artery, Female, Male, Middle Age, complications, Arteries, Multivariate Analysis, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Nitroglycerin, Vasodilation, pathology, Cardiology, Reproducibility of Results, Vasodilator Agents, Hyperemia, China, Muscle,Smooth,Vascular, Dose-Response Relationship,Drug},
	pages = {563--567},
