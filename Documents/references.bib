	month = mar,
	year = {2001},
	note = {Place: Division of Endocrinology and Metabolism, Taichung Veterans General Hospital, No. 160, Section 3, Chung Kang Road, Taichung, Taiwan, ROC},
	keywords = {blood, Blood Pressure, Human, Endothelium,Vascular, metabolism, Support,Non-U.S.Gov't, Hypertension, physiology, physiopathology, Aged, Brachial Artery, Male, Arteries, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Vasodilation, Regional Blood Flow, Prevalence, Hyperemia, Diabetic Angiopathies, Case Report},
