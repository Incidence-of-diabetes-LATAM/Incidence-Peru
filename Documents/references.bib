	keywords = {Atherosclerosis, blood, Human, metabolism, Oxidation-Reduction, Animal, Cardiovascular Diseases, therapeutic use, Disease, Myocardial Infarction, Arteries, Lipoproteins, Plasma, Arteriosclerosis, Japan, pathology, Carotid Arteries, Antibodies, Lipoproteins,LDL, Foam Cells, Receptors,Immunologic, Free Radical Scavengers},
