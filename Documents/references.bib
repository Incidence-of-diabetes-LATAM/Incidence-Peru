	year = {2017},
}

@article{kraja_new_2017,
	title = {New {Blood} {Pressure}-{Associated} {Loci} {Identified} in {Meta}-{Analyses} of 475 000 {Individuals}},
	volume = {10},
	doi = {10.1161/CIRCGENETICS.117.001778},
	abstract = {© 2017 American Heart Association, Inc. Background - Genome-wide association studies have recently identified {\textgreater} 400 loci that harbor DNA sequence variants that influence blood pressure (BP). Our earlier studies identified and validated 56 single nucleotide variants (SNVs) associated with BP from meta-analyses of exome chip genotype data. An additional 100 variants yielded suggestive evidence of association. Methods and Results - Here, we augment the sample with 140 886 European individuals from the UK Biobank, in whom 77 of the 100 suggestive SNVs were available for association analysis with systolic BP or diastolic BP or pulse pressure. We performed 2 meta-analyses, one in individuals of European, South Asian, African, and Hispanic descent (pan-ancestry, ≈475 000), and the other in the subset of individuals of European descent (≈423 000). Twenty-one SNVs were genome-wide significant (P {\textless} 5×10 -8 ) for BP, of which 4 are new BP loci: rs9678851 (missense, SLC4A1AP), rs7437940 (AFAP1), rs13303 (missense, STAB1), and rs1055144 (7p15.2). In addition, we identified a potentially independent novel BP-associated SNV, rs3416322 (missense, SYNPO2L) at a known locus, uncorrelated with the previously reported SNVs. Two SNVs are associated with expression levels of nearby genes, and SNVs at 3 loci are associated with other traits. One SNV with a minor allele frequency {\textless} 0.01, (rs3025380 at DBH) was genome-wide significant. Conclusions - We report 4 novel loci associated with BP regulation, and 1 independent variant at an established BP locus. This analysis highlights several candidate genes with variation that alter protein function or gene expression for potential follow-up.},
	number = {5},
	journal = {Circulation: Cardiovascular Genetics},
	author = {Kraja, A.T. and Cook, J.P. and Warren, H.R. and Surendran, P. and Liu, C. and Evangelou, E. and Manning, A.K. and Grarup, N. and Drenos, F. and Sim, X. and Smith, A.V. and Amin, N. and Blakemore, A.I.F. and Bork-Jensen, J. and Brandslund, I. and Farmaki, A.-E. and Fava, C. and Ferreira, T. and Herzig, K.-H. and Giri, A. and Giulianini, F. and Grove, M.L. and Guo, X. and Harris, S.E. and Have, C.T. and Havulinna, A.S. and Zhang, H. and Jørgensen, M.E. and Käräjämäki, A. and Kooperberg, C. and Linneberg, A. and Little, L. and Liu, Y. and Bonnycastle, L.L. and Lu, Y. and Mägi, R. and Mahajan, A. and Malerba, G. and Marioni, R.E. and Mei, H. and Menni, C. and Morrison, A.C. and Padmanabhan, S. and Palmas, W. and Poveda, A. and Rauramaa, R. and Rayner, N.W. and Riaz, M. and Rice, K. and Richard, M.A. and Smith, J.A. and Southam, L. and Stančáková, A. and Stirrups, K.E. and Tragante, V. and Tuomi, T. and Tzoulaki, I. and Varga, T.V. and Weiss, S. and Yiorkas, A.M. and Young, R. and Zhang, W. and Barnes, M.R. and Cabrera, C.P. and Gao, H. and Boehnke, M. and Boerwinkle, E. and Chambers, J.C. and Connell, J.M. and Christensen, C.K. and De Boer, R.A. and Deary, I.J. and Dedoussis, G. and Deloukas, P. and Dominiczak, A.F. and Dörr, M. and Joehanes, R. and Edwards, T.L. and Esko, T. and Fornage, M. and Franceschini, N. and Franks, P.W. and Gambaro, G. and Groop, L. and Hallmans, G. and Hansen, T. and Hayward, C. and Heikki, O. and Ingelsson, E. and Tuomilehto, J. and Jarvelin, M.-R. and Kardia, S.L.R. and Karpe, F. and Kooner, J.S. and Lakka, T.A. and Langenberg, C. and Lind, L. and Loos, R.J.F. and Laakso, M. and McCarthy, M.I. and Melander, O. and Mohlke, K.L. and Morris, A.P. and Palmer, C.N.A. and Pedersen, O. and Polasek, O. and Poulter, N.R. and Province, M.A. and Psaty, B.M. and Ridker, P.M. and Rotter, J.I. and Rudan, I. and Salomaa, V. and Samani, N.J. and Sever, P.J. and Skaaby, T. and Stafford, J.M. and Starr, J.M. and Van Der Harst, P. and Van Der Meer, P. and Van Duijn, C.M. and Vergnaud, A.-C. and Gudnason, V. and Wareham, N.J. and Wilson, J.G. and Willer, C.J. and Witte, D.R. and Zeggini, E. and Saleheen, D. and Butterworth, A.S. and Danesh, J. and Asselbergs, F.W. and Wain, L.V. and Ehret, G.B. and Chasman, D.I. and Caulfield, M.J. and Elliott, P. and Lindgren, C.M. and Levy, D. and Newton-Cheh, C. and Munroe, P.B. and Howson, J.M.M.},
