@article{lindblad_metabolic_2001,
	title = {Metabolic syndrome and ischemic heart disease in elderly men and women},
	volume = {153},
	abstract = {Associations between metabolic syndrome components and prevalent ischemic heart disease (IHD) were investigated in a cross-sectional, community-based study of elderly men (n = 1,015) and women (n = 1,259) in Rancho Bernardo, California, in 1984-1987. In both sexes, there were significant positive associations between IHD defined by resting electrocardiogram criteria and age, systolic blood pressure, fasting and postchallenge hyperglycemia, total cholesterol/high density lipoprotein cholesterol (HDL cholesterol) ratio, and triglycerides and an inverse significant association with HDL cholesterol. High collinearity and interactions between serum insulin and metabolic syndrome variables were accounted for by uncorrelated principal components identified by factor analysis. In both men and women, three uncorrelated principal components were identified, representing a central metabolic factor (body mass index, fasting and 2-hour serum insulin, high serum triglycerides, and low HDL cholesterol), a glucose factor, and a blood pressure factor. In a multivariate model with age and sex, all three factors were significantly associated with IHD by electrocardiogram criteria; central metabolic factor (odds ratio (OR) = 1.6, p = 0.001), glucose factor (OR = 1.4, p {\textless} 0.001), blood pressure factor (OR = 1.2, p = 0.005), age (10 years) (OR = 1.8, p {\textless} 0.001), and female sex (OR = 0.5, p {\textless} 0.02). Similar results were obtained in analyses using clinically manifest IHD as the outcome. These results support the thesis that the metabolic syndrome exerts effects through different risk factors by different mechanisms},
	number = {0002-9262 LA - eng PT - Journal Article RN - 0 (Lipoproteins, HDL Cholesterol) RN - 0 (Lipoproteins, LDL Cholesterol) RN - 0 (Triglycerides) RN - 11061-68-0 (Insulin) SB - IM},
	journal = {Am.J.Epidemiol.},
	author = {Lindblad, U and Langer, R D and Wingard, D L and Thomas, R G and Barrett-Connor, E L},
	month = mar,
	year = {2001},
	note = {Place: Department of Community Medicine, Malmo University Hospital, Malmo, Sweden},
	keywords = {analysis, blood, Blood Pressure, California, Cholesterol, Fasting, Glucose, Insulin, Men, Odds Ratio, Pressure, Risk, Sex, Syndrome, Triglycerides, Women, Middle Aged, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., Body Mass Index, etiology, 10, Heart, Hyperglycemia, Community Medicine, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Prevalence, Aged,80 and over, Cross-Sectional Studies, Cohort Studies, Myocardial Ischemia, Sweden, Electrocardiography},
	pages = {481--489},
