	note = {Place: Vascular Physiology Unit, Great Ormond Street Hospital for Children, London, United Kingdom. MichaelJMullen@cs.com},
	keywords = {Adult, analysis, Cholesterol, methods, Risk, Human, therapy, drug effects, Endothelium,Vascular, pharmacology, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, physiology, physiopathology, Brachial Artery, Female, Male, Middle Age, Arteries, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Vasodilation, Arginine, Double-Blind Method, Adolescent, Heptanoic Acids, Pyrroles, Hydroxymethylglutaryl-CoA Reductase Inhibitors},
