	note = {Place: Department of Clinical Pharmacology, Henri Mondor's Hospital, Creteil, France},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Insulin, Men, methods, Obesity, Pressure, Research, Research Design, Risk, Sex, Syndrome, Triglycerides, Women, Human, therapy, metabolism, pharmacology, Middle Aged, Hypertension, physiology, Risk Factors, Aged, Female, Male, Time, Body Mass Index, complications, Blood Glucose, Metabolic Syndrome X, Body Constitution, Hypertriglyceridemia, Lipoproteins, Lipoproteins,HDL Cholesterol, Prospective Studies, Glucose Intolerance, Glucose Tolerance Test, Cross-Sectional Studies, Cohort Studies, Food, France},
