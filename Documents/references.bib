	month = apr,
	year = {2005},
	note = {Place: Division of Clinical Epidemiology, Geneva University Hospitals, Geneva, Switzerland},
	keywords = {11, Adult, blood, Cholesterol, Lipids, Men, Obesity, Risk, Triglycerides, Women, Middle Aged, Hypercholesterolemia, Risk Factors, administration \& dosage, Aged, Female, Male, epidemiology, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, 10, Life Style, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Smoking, genetics, Switzerland, Questionnaires, Alcohol Drinking, trends, Educational Status, Environment, Dietary Fats, Environmental Exposure, Polymorphism,Single Nucleotide},
