	keywords = {analysis, blood, Cholesterol, Fasting, Glucose, Incidence, Men, methods, Risk, Women, Middle Aged, Disease Progression, physiology, Risk Factors, Aged, Female, Male, epidemiology, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, 10, Blood Glucose, Body Constitution, Lipoproteins, Lipoproteins,HDL Cholesterol, Diabetes Mellitus, Prevalence, Age Distribution, Sex Distribution, Glucose Tolerance Test, Roc Curve, Prognosis, Finland, Area Under Curve, Health Promotion},
