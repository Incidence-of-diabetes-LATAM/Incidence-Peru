	author = {Schargrodsky, Herman and Hernández-Hernández, Rafael and Champagne, Beatriz Marcet and Silva, Honorio and Vinueza, Raúl and Silva Ayçaguer, Luis Carlos and Touboul, Pierre-Jean and Boissonnet, Carlos Pablo and Escobedo, Jorge and Pellegrini, Fabio and Macchia, Alejandro and Wilson, Elinor},
