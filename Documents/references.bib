}

@article{tsai_reduced_1994,
	title = {Reduced plasma peroxyl radical trapping capacity and increased susceptibility of {LDL} to oxidation in poorly controlled {IDDM}},
	volume = {43},
	abstract = {Oxidation of low-density lipoproteins (LDLs) has been postulated to play an important role in atherogenesis. Because oxidant stress may be increased and antioxidant defenses reduced in diabetes, the susceptibility of LDL to oxidative modification and total peroxyl radical trapping potential (TRAP) of plasma were evaluated in subjects with poorly controlled insulin-dependent diabetes mellitus (IDDM). The lag phase of conjugated diene formation after initiation of LDL oxidation by the addition of copper was shorter in diabetic subjects than in normal control subjects (126 +/- 11 vs. 165 +/- 15 min [means +/- SE], P {\textless} 0.05). This could not be attributed to the presence of oxidation-susceptible, small, dense LDL particles in the diabetic subjects, whose lipoprotein particle distribution did not differ from the control subjects. However, the total TRAP of plasma, a measure of antioxidant defense, was reduced (626 +/- 34 vs. 877 +/- 41 microM, P {\textless} 0.0001) in diabetes. Of the plasma antioxidants measured, only uric acid and vitamin A were decreased in diabetes (P {\textless} 0.01), and both levels correlated with TRAP (r = 0.75, P {\textless} 0.001; r = 0.54, P {\textless} 0.001, respectively). The correlation between uric acid levels and TRAP persisted when the diabetes and control groups were analyzed separately. The reduced TRAP of plasma and the increased susceptibility of LDL to oxidative modification observed is consistent with a role for lipoprotein oxidation in the pathogenesis of atherosclerosis in IDDM},
	number = {0012-1797 LA - eng PT - Journal Article RN - 0 (Antioxidants) RN - 0 (Blood Glucose) RN - 0 (Free Radical Scavengers) RN - 0 (Lipoproteins, LDL) RN - 0 (Peroxides) RN - 3170-83-0 (perhydroxyl radical) SB - AIM SB - IM},
	journal = {Diabetes},
	author = {Tsai, E C and Hirsch, I B and Brunzell, J D and Chait, A},
	month = aug,
	year = {1994},
	note = {Place: Department of Medicine, University of Washington, Seattle 98195},
	keywords = {11, Adult, Atherosclerosis, blood, Glucose, Human, Antioxidants, metabolism, Oxidation-Reduction, Support,U.S.Gov't,P.H.S., Female, Male, Blood Glucose, Lipoproteins, Plasma, Washington, Diabetes Mellitus, Diabetes Mellitus,Type I, Stress, Uric Acid, Lipoproteins,LDL, Peroxides, Vitamin A, Copper, Free Radical Scavengers},
	pages = {1010--1014},
