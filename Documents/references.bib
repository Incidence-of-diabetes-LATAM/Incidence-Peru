	pages = {1069--1076},
	file = {Witte e.a. - 2004 - Study of agreement between LDL size as measured by.pdf:/Users/planetarium/Zotero/storage/5LNWY99S/Witte e.a. - 2004 - Study of agreement between LDL size as measured by.pdf:application/pdf},
