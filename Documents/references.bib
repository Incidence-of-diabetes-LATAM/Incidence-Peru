	month = may,
	year = {2005},
	note = {Place: Kaiser Permanente, Division of Research, Northern California Region, Oakland, CA, USA. andy.j.karter@kp.org},
	keywords = {Adult, analysis, Atherosclerosis, California, Glucose, Insulin, Insulin Resistance, methods, Obesity, Research, Risk, Sex, Syndrome, metabolism, Middle Aged, Aged, Female, Male, Humans, Linear Models, Longitudinal Studies, Body Mass Index, Multicenter Studies, Body Constitution, Follow-Up Studies, Prospective Studies, Aging, Arteriosclerosis, Glucose Tolerance Test, Cross-Sectional Studies, ethnology, Research Support, European Continental Ancestry Group, Overweight, Abdomen, African Americans, Hispanic Americans},
