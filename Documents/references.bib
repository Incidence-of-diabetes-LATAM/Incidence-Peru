	keywords = {blood, Risk, Human, Risk Factors, Disease, epidemiology, complications, Myocardial Infarction, Arteries, Hypertriglyceridemia, Lipoproteins, Arteriosclerosis, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Japan, Coronary Arteriosclerosis, abnormalities, Hyperlipidemia, Diet, Diabetic Nephropathies, Diabetic Angiopathies, Albuminuria, Lipoproteins,LDL, Laboratories, Obesity in Diabetes},
