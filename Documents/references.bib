	keywords = {Adult, blood, Cholesterol, Lipids, Men, methods, Obesity, Research, Risk, Sex, Triglycerides, Women, Comparative Study, Body Weight, Middle Aged, physiology, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, Linear Models, Body Mass Index, Community Medicine, Smoking, Age Distribution, Sex Factors, Cohort Studies, Research Support, Cholesterol,HDL, Norway},
