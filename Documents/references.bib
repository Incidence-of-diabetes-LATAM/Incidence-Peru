@article{lak_secular_2012-1,
	title = {Secular trends in lung function and its relation to survival in {Swedish} 75 year olds 1976-2006},
	volume = {41},
	issn = {0002-0729, 1468-2834},
	url = {https://academic.oup.com/ageing/article-lookup/doi/10.1093/ageing/afs098},
	doi = {10.1093/ageing/afs098},
	abstract = {Background: several studies have found that lung function correlates with survival in older people. We examined secular trends in lung function and its relation to survival in Swedish 75 year olds.
Method: representative samples from the general population in Gothenburg, Sweden, were examined at the age of 75 in 1976–77 (n = 743) and 2005–06 (n = 765) with comprehensive somatic and psychiatric examinations. Lung function was measured as peak expiratory ﬂow (PEF).
Results: the mean PEF was higher in 75 year olds examined 2005–06 compared with those examined 1976–77 both among women (339 versus 307 l/min; P {\textless} 0.001) and men (490 versus 400 l/min, P {\textless} 0.001). The birth cohort effect was still signiﬁcant after adjusting for a number of confounders. PEF correlated with survival between age 75 and 78 years among those examined in 1976–77 both in women (OR per 10 l/min increase in PEF = 1.112, 95\% CI: 1.047–1.182) and in men (OR = 1.040, 95\% CI: 1.015–1.066), but not in those examined 2005–06 (women: OR = 1.071, 95\% CI: 0.965–1.188; men: OR = 1.000, 95\% CI: 0.957–1.046).
Conclusion: we found better lung function in the later-born cohort of 75 year olds, which was only partially explained by changes in smoking, height and weight, physical activity, socio-economic/educational factors and pulmonary/cardiovascular morbidity. The association between better lung function and short-term survival was strong in 1976–77, but had disappeared in 2005–06. More studies are needed to elucidate the role of lung function for long-term survival and identify other factors that explain the secular trends in lung function.},
	language = {en},
	number = {6},
	urldate = {2021-02-13},
	journal = {Age and Ageing},
	author = {Lak, V. W.-M. and Skoog, I. and Guo, X.},
	month = nov,
	year = {2012},
	pages = {735--740},
	file = {Lak e.a. - 2012 - Secular trends in lung function and its relation t.pdf:/Users/planetarium/Zotero/storage/XBDL94Z8/Lak e.a. - 2012 - Secular trends in lung function and its relation t.pdf:application/pdf},
}

@article{laiteerapong_ten-year_2017-1,
	title = {Ten-year hemoglobin {A1c} trajectories and outcomes in type 2 diabetes mellitus: {The} {Diabetes} \& {Aging} {Study}},
	volume = {31},
	issn = {10568727},
	shorttitle = {Ten-year hemoglobin {A1c} trajectories and outcomes in type 2 diabetes mellitus},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1056872716303026},
	doi = {10.1016/j.jdiacomp.2016.07.023},
	abstract = {Methods: A longitudinal follow-up of 28,016 patients newly diagnosed with type 2 diabetes was conducted. Latent growth mixture modeling was used to identify ten-year HbA1c trajectories. Cox proportional hazards models were used to assess how HbA1c trajectories were associated with events (microvascular and macrovascular) and mortality.
Results: We identiﬁed 5 HbA1c trajectories: “low stable” (82.5\%), “moderate increasing late” (5.1\%), “high decreasing early” (4.9\%), “moderate peaking late” (4.1\%) and “moderate peaking early” (3.3\%). After adjusting for average HbA1c, compared to the low stable trajectory, all non-stable trajectories were associated with higher incidences of microvascular events (hazard ratio (HR) range, 1.28 (95\% CI, 1.08–1.53) (high decreasing early) to 1.45 (95\% CI, 1.20–1.75) (moderate peaking early)). The high decreasing early trajectory was associated with an increased mortality risk (HR, 1.27 (95\% CI, 1.03–1.58)). Trajectories were not associated with macrovascular events.
Conclusions: Non-stable HbA1c trajectories were associated with greater risk of microvascular events and mortality. These ﬁndings suggest a potential beneﬁt of early diabetes detection, prioritizing good glycemic control, and maintaining control over time.},
	language = {en},
	number = {1},
	urldate = {2021-02-13},
	journal = {Journal of Diabetes and its Complications},
	author = {Laiteerapong, Neda and Karter, Andrew J. and Moffet, Howard H. and Cooper, Jennifer M. and Gibbons, Robert D. and Liu, Jennifer Y. and Gao, Yue and Huang, Elbert S.},
	month = jan,
	year = {2017},
	pages = {94--100},
	file = {Laiteerapong e.a. - 2017 - Ten-year hemoglobin A1c trajectories and outcomes .pdf:/Users/planetarium/Zotero/storage/8NY74EJ9/Laiteerapong e.a. - 2017 - Ten-year hemoglobin A1c trajectories and outcomes .pdf:application/pdf},
