@article{groza_automatic_2015,
	title = {Automatic concept recognition using the human phenotype ontology reference and test suite corpora.},
	volume = {2015},
	issn = {17580463 (Electronic)},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/25725061},
	doi = {10.1093/database/bav005},
	abstract = {Concept recognition tools rely on the availability of textual corpora to assess their performance and enable the identification of areas for improvement. Typically, corpora are developed for specific purposes, such as gene name recognition. Gene and protein name identification are longstanding goals of biomedical text mining, and therefore a number of different corpora exist. However, phenotypes only recently became an entity of interest for specialized concept recognition systems, and hardly any annotated text is available for performance testing and training. Here, we present a unique corpus, capturing text spans from 228 abstracts manually annotated with Human Phenotype Ontology (HPO) concepts and harmonized by three curators, which can be used as a reference standard for free text annotation of human phenotypes. Furthermore, we developed a test suite for standardized concept recognition error analysis, incorporating 32 different types of test cases corresponding to 2164 HPO concepts. Finally, three established phenotype concept recognizers (NCBO Annotator, OBO Annotator and Bio-LarK CR) were comprehensively evaluated, and results are reported against both the text corpus and the test suites. The gold standard and test suites corpora are available from http://bio-lark.org/hpo\_res.html. Database URL: http://bio-lark.org/hpo\_res.html.},
	journal = {Database : the journal of biological databases and curation},
	author = {Groza, Tudor and Köhler, Sebastian and Doelken, Sandra and Collier, Nigel and Oellrich, Anika and Smedley, Damian and Couto, Francisco M. and Baynam, Gareth and Zankl, Andreas and Robinson, Peter N.},
	year = {2015},
	pages = {1--13},
}

@article{the_lancet_diabetes_endocrinology_diabetes_2018,
	title = {Diabetes: mapping the titanic struggle ahead.},
	volume = {6},
	url = {http://dx.doi.org/10.1016/S2213-8587(17)30414-X},
	doi = {10.1016/S2213-8587(17)30414-X},
	abstract = {The eighth edition of the International Diabetes Federation (IDF) Diabetes Atlas, published on Nov 14, 2017, paints a bleak picture: 425 million people around the globe have diabetes in 2017; that figure is projected to rise to 629 million by 2045, with 80\% of the burden carried by low-income and middle-income countries. The Atlas also estimates that in 2017, 4 million people will have died from diabetes and 21·3 million livebirths are predicted to have been affected by maternal hyperglycaemia. In accord with previous editions of the Atlas, the global rise in diabetes shows no sign of abating. Perhaps unsurprising, in view of population ageing and the increased prevalence of diabetes, is the estimate that one in three people with diabetes in 2017 are now older than 65 years. As older people are more vulnerable to complications and are at high risk of developing geriatric syndromes (eg, frailty, falls, and functional decline), this shift in age demographics will have a major knock-on effect on worldwide health-care expenditure for diabetes. Deaths from diabetes in this age group are estimated at 3·2 million, accounting for more than 60\% of all adult deaths due to diabetes. By 2045, the number of adults older than 65 years with diabetes is predicted to double to 253 million, with China, the USA, and India having the greatest burden in this age group. Worryingly, total worldwide health-care expenditure for diabetes in the 60–99 years age group is predicted to rise from US\$527 billion in 2017 to only US\$615 billion by 2045, suggesting that spending will not keep pace with the rising disease burden. With each update of the Atlas, the consequences of diabetes and the challenges they pose become more evident. New in the 2017 edition is a chapter on the growing burden of diabetes complications, which can be life-threatening and are associated with both increased health-care costs and reduced quality of life. Complications reviewed include cardiovascular disease; nephropathy, retinopathy, and neuropathy (microvascular disease); and diabetic foot disease, oral health, and pregnancy-related com plications. Risk of cardiovascular disease in people with diabetes is raised by two to three times; risk of lower-limb amputation is increased by ten to 20 times, and that for development of end-stage renal disease (ESRD) is raised by ten times. One in three people with diabetes will develop retinopathy. The cost of treating diabetes complications is all too evident: for example, in the USA, the costs are estimated at US\$10 322 annually to treat a person with diabetes and ESRD (and 2·8 times higher if dialysis is required) and US\$15 593 to treat a pregnant woman for hyperglycaemia. Although the inclusion of diabetes complications is a welcome addition to the Atlas, the lack of comprehensive global estimates for complications hampers our ability to manage and plan for this growing burden. Hopefully it will be possible to address this deficit in the future. While prevention and control of diabetes is undoubtedly key to reducing the burden of complications in the long term, new therapies—beyond gly caemic and blood pressure control—are needed to improve the care of people with diabetes complications. A recent Endocrine Society Scientific Statement on diabetic microvascular disease highlights that although much progress has been made in understanding the underlying pathogenesis and risk factors for these complications, this knowledge has not yet been translated into new therapies. By summarising current knowledge on the biochemical and cellular pathways involved in mediating and preventing microvascular damage to the eyes, kidneys, and peripheral nervous system (as well as other organs), the Statement lays the groundwork for future research, potential target identification, and ultimately the development of new therapies that can prevent or reverse diabetic microvascular disease, and thus reduce the disease and economic burden. Although the estimates provided in the latest IDF Diabetes Atlas are alarming, halting the global rise in type 2 diabetes and related complications is achievable if we advocate lifestyle change (a healthy diet, physical activity, and healthy environments) and both re-energise and re-equip primary health-care professionals to prevent and care for diabetes in our communities. Ultimately though, stemming the burgeoning diabetes epidemic will require a unified global response that will only be possible if all nations implement the goals set out by the UN in their 2030 Agenda for Sustainable Development. Unlike the task bestowed on the titan Atlas—that of holding up the sky for eternity—tackling the global health emergency that diabetes represents, while titanic in proportions, requires mere human intervention.},
	number = {1},
	journal = {The lancet. Diabetes \& endocrinology},
	publisher = {Elsevier Ltd},
	author = {{The Lancet Diabetes Endocrinology}},
	month = jan,
	year = {2018},
	pages = {1--1},
}

