}

@article{de_kleijn_hormone_2001,
	title = {Hormone replacement therapy and endothelial function. {Results} of a randomized controlled trial in healthy postmenopausal women},
	volume = {159},
	abstract = {OBJECTIVE: To compare the effects of 3 months treatment with tibolone (a single entity synthetic steroid hormone with estrogenic, progestanic and androgenic activities), or continuous combined conjugated equine estrogens (CEE) plus medroxyprogesterone acetate (MPA), with placebo, on endothelial function. DESIGN: A single center, randomized, double-blind, placebo-controlled study. SETTING: Research center as part of the University Medical Center Utrecht. SUBJECTS: One hundred and five healthy postmenopausal women, sampled from the general population. Interventions: Three months treatment with tibolone or CEE+MPA or placebo. MAIN OUTCOME MEASURE: At baseline and after 3 months, endothelial function was assessed non-invasively by measuring percent lumen diameter change in the brachial artery after reactive hyperemia and sublingual nitroglycerine spray. RESULTS: Results are presented as mean differences between treatment groups of endothelium dependent flow mediated dilatation (fmd) and endothelium independent nitroglycerine induced dilatation with 95\% confidence intervals (95\% CI). After treatment, there was a significant difference in mean fmd between the CEE+MPA group and the placebo group of 2.5\% (95\% CI: 0.3-4.6) while the tibolone group and the placebo group did not differ significantly (0.6\%; 95\% CI: 1.6-2.8). Nitroglycerine induced dilatation did not differ significantly between the groups. CONCLUSIONS: Hormone replacement therapy with CEE+MPA for 3 months increases endothelium dependent fmd of the brachial artery in healthy postmenopausal women. Tibolone did not alter fmd. The clinical significance of this improvement in fmd for cardiovascular disease risk needs to be established},
	number = {0021-9150 LA - eng PT - Clinical Trial PT - Journal Article PT - Randomized Controlled Trial},
	journal = {Atherosclerosis},
	author = {de Kleijn, M J and Wilmink, H W and Bots, M L and Bak, A A and van der Schouw, Y T and Planellas, J and Engelen, S and Banga, J D and Grobbee, D E},
	month = dec,
	year = {2001},
	note = {Place: Julius Center for General Practice and Patient Oriented Research, University Medical Center Utrecht, HP D01.335, PO Box 85500, 3508 GA, Utrecht, The Netherlands},
	keywords = {methods, Research, Risk, Human, therapy, drug effects, Endothelium, Endothelium,Vascular, Support,Non-U.S.Gov't, Cardiovascular Diseases, Aged, Brachial Artery, Female, Middle Age, therapeutic use, Arteries, prevention \& control, Reference Values, pathology, Netherlands, Hyperemia, Double-Blind Method, Drug Therapy,Combination, Hormone Replacement Therapy, Postmenopause, Drug Administration Schedule, Estrogens, Estrogens,Conjugated, Confidence Intervals, Dose-Response Relationship,Drug, Medroxyprogesterone, Norpregnenes},
