	author = {Kekalainen, P and Sarlund, H and Pyorala, K and Laakso, M},
	month = jan,
	year = {1999},
	note = {Place: Department of Medicine, Kuopio University Hospital, Finland. pkekalai@messi.uku.fi},
	keywords = {Adult, blood, Blood Pressure, Glucose, Insulin, Lipids, methods, Odds Ratio, Pressure, Research, Research Design, Risk, Triglycerides, Human, metabolism, Support,Non-U.S.Gov't, Middle Aged, Hypertension, Risk Factors, Aged, Female, Male, epidemiology, Body Mass Index, Blood Glucose, Hyperinsulinism, Lipoproteins, Prospective Studies, Family, history, Predictive Value of Tests, Diabetes Mellitus,Type II, Glucose Tolerance Test, genetics, Hyperinsulinemia, Analysis of Variance, Cluster Analysis, Finland, Nuclear Family},
