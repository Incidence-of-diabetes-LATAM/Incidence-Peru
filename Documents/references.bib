	keywords = {Adult, Risk, Sex, Human, Endothelium,Vascular, Case-Control Studies, physiology, physiopathology, Risk Factors, Aged, Brachial Artery, Female, Male, Middle Age, complications, Arteries, Nitroglycerin, ultrasonography, Vasodilation, England, Cardiology, Vasodilator Agents, diagnostic use, Platelet Count, Polycythemia Vera},
	pages = {354--359},
