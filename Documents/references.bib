@article{taylor_remission_2018,
	title = {Remission of {Human} {Type} 2 {Diabetes} {Requires} {Decrease} in {Liver} and {Pancreas} {Fat} {Content} but {Is} {Dependent} upon {Capacity} for β {Cell} {Recovery}},
	volume = {28},
	issn = {15504131},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1550413118304467},
	doi = {10.1016/j.cmet.2018.07.003},
	abstract = {The Diabetes Remission Clinical Trial reported return and persistence of non-diabetic blood glucose control in 46\% of people with type 2 diabetes of up to 6 years duration. Detailed metabolic studies were performed on a subgroup (intervention, n = 64; control, n = 26). In the intervention group, liver fat content decreased (16.0\% ± 1.3\% to 3.1\% ± 0.5\%, p {\textless} 0.0001) immediately after weight loss. Similarly, plasma triglyceride and pancreas fat content decreased whether or not glucose control normalized. Recovery of ﬁrst-phase insulin response (0.04[À0.05–0.32] to 0.11[0.0005–0.51] nmol/min/m2, p {\textless} 0.0001) deﬁned those who returned to non-diabetic glucose control and this was durable at 12 months (0.11[0.005–0.81] nmol/min/m2, p = 0.0001). Responders were similar to non-responders at baseline but had shorter diabetes duration (2.7 ± 0.3 versus 3.8 ± 0.4 years; p = 0.02). This study demonstrates that b cell ability to recover long-term function persists after diagnosis, changing the previous paradigm of irreversible loss of b cell function in type 2 diabetes.},
	language = {en},
	number = {4},
	urldate = {2021-02-14},
	journal = {Cell Metabolism},
	author = {Taylor, Roy and Al-Mrabeh, Ahmad and Zhyzhneuskaya, Sviatlana and Peters, Carl and Barnes, Alison C. and Aribisala, Benjamin S. and Hollingsworth, Kieren G. and Mathers, John C. and Sattar, Naveed and Lean, Michael E.J.},
	month = oct,
	year = {2018},
	pages = {547--556.e3},
	file = {Taylor e.a. - 2018 - Remission of Human Type 2 Diabetes Requires Decrea.pdf:/Users/planetarium/Zotero/storage/3R9LHXUX/Taylor e.a. - 2018 - Remission of Human Type 2 Diabetes Requires Decrea.pdf:application/pdf},
}

