@article{mackness_paraoxonase_2001,
	title = {Paraoxonase status in coronary heart disease: are activity and concentration more important than genotype?},
	volume = {21},
	abstract = {Human serum paraoxonase (PON1) hydrolyzes oxidized lipids in low density lipoprotein (LDL) and could therefore retard the development of atherosclerosis. In keeping with this hypothesis, several case-control studies have shown a relationship between the presence of coronary heart disease (CHD) and polymorphisms at amino acid positions 55 and 192 of PON1, which we associated with a decreased capacity of PON1 to protect LDL against the accumulation of lipid peroxides, but some other studies have not. However, the PON1 polymorphisms are only 1 factor in determining the activity and concentration of the enzyme. Only 3 of the previous 18 studies directly determined PON1 activity and concentration. Therefore, we studied PON1 activity, concentration, and gene distribution in 417 subjects with angiographically proven CHD and in 282 control subjects. We found that PON1 activity and concentration were significantly lower in subjects with CHD than in control subjects (activity to paraoxon 122.8 [3.3 to 802.8] versus 214.6 [26.3 to 620.8] nmol. min(-1). mL(-1), P{\textless}0.001; concentration 71.6 [11.4 to 489.3] versus 89.1 [16.8 to 527.4] microg/mL, P{\textless}0.001). There were no differences in the PON1-55 and -192 polymorphisms or clusterin concentration between patients with CHD and control subjects. These results indicate that lower PON1 activity and concentration and, therefore, the reduced ability to prevent LDL lipid peroxidation may be more important in determining the presence of CHD than paraoxonase genetic polymorphisms},
	number = {1524-4636 LA - eng PT - Journal Article RN - 0 (Biological Markers) RN - 0 (Glycoproteins) RN - 0 (Molecular Chaperones) RN - 0 (clusterin) RN - 311-45-5 (Paraoxon) RN - EC 3.1. (Esterases) RN - EC 3.1.8.1 (aryldialkylphosphatase) SB - IM},
	journal = {Arterioscler.Thromb.Vasc.Biol.},
	author = {Mackness, B and Davies, G K and Turkie, W and Lee, E and Roberts, D H and Hill, E and Roberts, C and Durrington, P N and Mackness, M I},
	month = sep,
	year = {2001},
	note = {Place: University Department of Medicine, School of Epidemiology and Health Sciences, University of Manchester, Manchester, UK. bmack@central.cmht.nwest.nhs.uk},
	keywords = {Adult, analysis, Atherosclerosis, Lipids, diagnosis, Human, Lipid Peroxidation, metabolism, Case-Control Studies, Glycoproteins, Female, Male, Middle Age, Disease, epidemiology, Heart, Meta-Analysis, Coronary Arteriosclerosis, Biological Markers, enzymology, Lipid Peroxides, genetics, Esterases, Genotype, Polymorphism (Genetics), Paraoxon, Molecular Chaperones},
	pages = {1451--1457},
