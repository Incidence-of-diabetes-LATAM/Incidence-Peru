	file = {Soulimane e.a. - 2011 - Comparing incident diabetes as defined by fasting .pdf:/Users/planetarium/Zotero/storage/CEAM5KQS/Soulimane e.a. - 2011 - Comparing incident diabetes as defined by fasting .pdf:application/pdf},
