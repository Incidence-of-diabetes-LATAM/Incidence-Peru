	keywords = {blood, Blood Pressure, California, Glucose, Incidence, methods, Research, Research Design, diagnosis, Human, metabolism, Support,Non-U.S.Gov't, physiopathology, Risk Factors, drug therapy, therapeutic use, epidemiology, Time, Blood Glucose, Hypoglycemic Agents, Diabetes Mellitus,Type I, Diabetes Mellitus,Type II, Glucose Tolerance Test, Guidelines, Practice Guidelines, Clinical Trials, Hemoglobin A,Glycosylated, Models,Biological, Computer Simulation},
