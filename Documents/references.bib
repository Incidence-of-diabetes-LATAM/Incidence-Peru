	note = {Place: Cardiovascular Sciences Research Group, Wales Heart Research Institute, University of Wales College of Medicine, Cardiff, UK},
	keywords = {Adult, blood, methods, Research, Risk, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, physiology, Risk Factors, Vascular Diseases, administration \& dosage, Blood Flow Velocity, Brachial Artery, Homocysteine, etiology, Arteries, Heart, prevention \& control, Dilatation, Vasodilation, England, Wales, Double-Blind Method, Folic Acid, Cross-Over Studies, Administration,Oral},
