	number = {11},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Lim, S. W. and Cheung, N. and Wang, J. J. and Donaghue, K. C. and Liew, G. and Islam, F.M. A. and Jenkins, A. J. and Wong, T. Y.},
