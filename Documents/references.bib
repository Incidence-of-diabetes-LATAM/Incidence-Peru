	month = dec,
	year = {1995},
	note = {Place: Division of Cardiology, Department of Medicine, Baylor College of Medicine, Houston, Texas 77030, USA},
	keywords = {Adult, Atherosclerosis, blood, Risk, Human, Base Sequence, Dna, Molecular Sequence Data, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Alleles, Risk Factors, Aged, Female, Male, Middle Age, Disease, epidemiology, Myocardial Infarction, Arteries, Coronary Disease, Arteriosclerosis, Cardiology, Arginine, chemistry, enzymology, genetics, Esterases, Genotype, Glutamine, Polymerase Chain Reaction, isolation \& purification, Variation (Genetics), Gene Frequency, DNA Primers, Caucasoid Race},
