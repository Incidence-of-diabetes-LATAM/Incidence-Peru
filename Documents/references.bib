@article{staa_pragmatic_2012-1,
	title = {Pragmatic randomised trials using routine electronic health records: putting them to the test},
	volume = {55},
	url = {http://dx.doi.org/10.1136/bmj.e55},
	doi = {10.1136/bmj.e55},
	abstract = {What to prescribe for a patient in general practice when the choice of treatments has a limited evidence base? Tjeerd-Pieter van Staa and colleagues argue that using electronic health records to enter patients into randomised trials of treatments in real time could provide the answer.},
