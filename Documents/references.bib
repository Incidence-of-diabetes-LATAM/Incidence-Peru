	keywords = {Adult, analysis, blood, Risk, Human, United States, Aged, Middle Age, C-Reactive Protein, Netherlands, Angina Pectoris, Aged,80 and over, Fibrinogen, Genotype, Tissue Plasminogen Activator, Plasminogen Inactivators},
