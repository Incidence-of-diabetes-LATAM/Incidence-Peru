	keywords = {analysis, blood, Blood Pressure, Cholesterol, methods, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, physiology, physiopathology, Brachial Artery, Female, Male, Middle Age, therapeutic use, Arteries, Prospective Studies, Nitroglycerin, ultrasonography, Vasodilation, Regional Blood Flow, Fatty Acids, Hyperemia, Double-Blind Method, Compliance, Germany, Postoperative Period, Hydroxymethylglutaryl-CoA Reductase Inhibitors, Fatty Acids,Monounsaturated, Indoles, Kidney Transplantation, Ultrasonography,Doppler,Pulsed},
