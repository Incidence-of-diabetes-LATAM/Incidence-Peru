}

@article{eid_increased_2003,
	title = {Increased levels of asymmetric dimethylarginine in populations at risk for atherosclerotic disease. {Effects} of pravastatin},
	volume = {166},
	abstract = {The aim of the present study was to investigate plasma levels of asymmetric dimethylarginine (ADMA), an important endogenous inhibitor of nitric oxide synthase, in populations at high risk for atherosclerosis as compared to healthy controls, and furthermore to evaluate the effect of cholesterol lowering therapy in individuals with hypercholesterolemia. The present study consisted of 32 men with untreated hypercholesterolemia (HC group), 38 individuals with well-controlled insulin-dependent diabetes mellitus (DM group) and 20 healthy individuals (controls). The HC subjects were randomly allocated into a double blinded, placebo-controlled cross-over designed study with 8 weeks treatment with pravastatin (40 mg/day) or matching placebo. ADMA levels were statistically significantly higher in DM and HC individuals as compared to controls (P{\textless}0.001 for both), and the L-arginine/ADMA ratios were significantly lower in both groups (P{\textless}0.001 and P{\textless}0.005, respectively). Significant reductions in total cholesterol (TC) and LDL-C levels on pravastatin were obtained (P{\textless}0.001 for both), whereas no changes were observed in the levels of ADMA or the L-arginine/ADMA ratios. Statistically significant correlations between ADMA and TC and LDL-C were found (r=0.41, P{\textless}0.001 for both). In conclusion, significantly elevated ADMA levels and reduced L-arginine/ADMA ratios were found in individuals with diabetes type-1 as well as in hypercholesterolemia. Treatment with pravastatin 40 mg/day for 8 weeks had no effect on the levels of ADMA in hypercholesterolemic men},
	number = {0021-9150 LA - eng PT - Clinical Trial PT - Controlled Clinical Trial PT - Journal Article RN - 0 (Lipoproteins, LDL Cholesterol) RN - 30315-93-6 (N,N-dimethylarginine) RN - 74-79-3 (Arginine) RN - 81093-37-0 (Pravastatin) SB - IM},
	journal = {Atherosclerosis},
	author = {Eid, H M and Eritsland, J and Larsen, J and Arnesen, H and Seljeflot, I},
	month = feb,
	year = {2003},
	note = {Place: Center for Clinical Research, Ullevaal University Hospital, Oslo, Norway. hilde.olsen@ioks.uio.no},
	keywords = {Atherosclerosis, blood, Cholesterol, Incidence, Research, Risk, Human, therapy, Comparative Study, drug effects, Nitric Oxide, Support,Non-U.S.Gov't, Hypercholesterolemia, drug therapy, Female, Male, therapeutic use, Disease, complications, etiology, Lipoproteins, Lipoproteins,LDL Cholesterol, Plasma, Diabetes Mellitus,Insulin-Dependent, Arteriosclerosis, Diabetes Mellitus, Probability, Reference Values, Risk Assessment, Sensitivity and Specificity, Predictive Value of Tests, analogs \& derivatives, Arginine, Pravastatin},
