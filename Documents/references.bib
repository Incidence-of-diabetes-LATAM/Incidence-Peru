	note = {Place: Department of Surgery, Johns Hopkins University School of Medicine, Johns Hopkins Bayview Medical Center, Baltimore, Maryland 21224, USA},
	keywords = {Adult, methods, Human, therapy, Comparative Study, drug effects, Endothelium,Vascular, pharmacology, United States, Brachial Artery, Female, Middle Age, Time Factors, Time, Arteries, Nitroglycerin, Vasodilation, surgery, Estrogen Replacement Therapy, Hormone Replacement Therapy, Postmenopause, Estrogens, Maryland, Medroxyprogesterone, Premenopause},
