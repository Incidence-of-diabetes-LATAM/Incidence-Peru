@article{carstensen_accelerated_2010,
	title = {Accelerated {Increase} in {Serum} {Interleukin}-1 {Receptor} {Antagonist} {Starts} 6 {Years} {Before} {Diagnosis} of {Type} 2 {Diabetes}: {Whitehall} {II} {Prospective} {Cohort} {Study}},
	volume = {59},
	issn = {0012-1797, 1939-327X},
	shorttitle = {Accelerated {Increase} in {Serum} {Interleukin}-1 {Receptor} {Antagonist} {Starts} 6 {Years} {Before} {Diagnosis} of {Type} 2 {Diabetes}},
	url = {http://diabetes.diabetesjournals.org/cgi/doi/10.2337/db09-1199},
	doi = {10.2337/db09-1199},
	abstract = {OBJECTIVE—Although interleukin-1 receptor antagonist (IL1Ra) treatment is associated with improved ␤-cell function and glycemic control in patients with type 2 diabetes, its role in the development of type 2 diabetes remains unclear. We used repeated measurements to characterize IL-1Ra trajectories in individuals who developed type 2 diabetes. RESEARCH DESIGN AND METHODS—This case-cohort study, nested within the Whitehall II cohort, was based on 335 incident type 2 diabetes cases and 2,475 noncases. We measured serum IL-1Ra levels at up to three time points per individual and estimated retrospective trajectories of IL-1Ra before diabetes diagnosis (case subjects) or end of follow-up (control subjects) using multilevel analysis. Models were adjusted for age, sex, and ethnicity.
RESULTS—IL-1Ra levels were already higher in the case than control subjects 13 years before diabetes diagnosis/end of follow-up (mean [95\% CI] 302 [290 –314] vs. 244 [238 –249] pg/ml). In control subjects, IL-1Ra levels showed a modest linear increase throughout the study period. In case subjects, IL-1Ra trajectories were parallel to those in control subjects until 6 years (95\% CI 7.5– 4.5) before diagnosis and then rose steeply to 399 (379 – 420) pg/ml at the time of diagnosis (P Ͻ 0.0001 for slope difference). Adjustment for BMI and waist circumference as time-varying covariates had little impact on these trajectories.
CONCLUSIONS—We show elevated IL-1Ra levels for 13 years and an accelerated increase during the last 6 years before type 2 diabetes diagnosis, indicating the presence of an anti-inﬂammatory response that may act to counterbalance the metabolic and immunologic disturbances that precede type 2 diabetes. Diabetes 59:1222–1227, 2010},
	language = {en},
	number = {5},
	urldate = {2021-02-13},
	journal = {Diabetes},
	author = {Carstensen, M. and Herder, C. and Kivimaki, M. and Jokela, M. and Roden, M. and Shipley, M. J. and Witte, D. R. and Brunner, E. J. and Tabak, A. G.},
	month = may,
	year = {2010},
	keywords = {Adult, Middle Aged, Female, Male, Humans, Enzyme-Linked Immunosorbent Assay, Cohort Studies, Interleukin 1 Receptor Antagonist Protein, Diabetes Mellitus, Type 2, Diabetes Mellitus, Type 2: diagnosis, Interleukin 1 Receptor Antagonist Protein: blood, Diabetes Mellitus, Type 2: blood},
	pages = {1222--1227},
	file = {Carstensen e.a. - 2010 - Accelerated Increase in Serum Interleukin-1 Recept.pdf:/Users/planetarium/Zotero/storage/KEDS93UW/Carstensen e.a. - 2010 - Accelerated Increase in Serum Interleukin-1 Recept.pdf:application/pdf;Carstensen e.a. - 2010 - Accelerated Increase in Serum Interleukin-1 Recept.pdf:/Users/planetarium/Zotero/storage/L77ZKYLZ/Carstensen e.a. - 2010 - Accelerated Increase in Serum Interleukin-1 Recept.pdf:application/pdf},
