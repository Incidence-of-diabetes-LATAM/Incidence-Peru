	month = dec,
	year = {2000},
	note = {Place: Department of Clinical Pharmacology, Ninewells Hospital and Medical School, University of Dundee, UK. peterd@memo.dundee.ac.uk},
	keywords = {Adult, methods, Research, Research Design, Risk, Human, therapy, Comparative Study, pharmacology, Support,Non-U.S.Gov't, Risk Factors, Female, Male, Middle Age, complications, etiology, Myocardial Infarction, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus,Non-Insulin-Dependent, Hospitalization, Cohort Studies, Cerebrovascular Accident, Kidney Failure, Retrospective Studies, Scotland, Eye Diseases, Length of Stay, Cataract},
