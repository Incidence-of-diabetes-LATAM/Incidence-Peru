	title = {Relation between blood glucose and coronary mortality over 33 years in the {Whitehall} study},
	volume = {29},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/16373891},
	abstract = {Glucose intolerance is a risk factor for coronary disease, but there is uncertainty about the shape of the dose-response relationship between glucose level and risk of coronary mortality. We examined the prospective relation of 2-h postload blood glucose (2hBG) with coronary and other major causes of mortality over 33 years.},
