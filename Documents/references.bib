@article{fuss_isolation_2009,
	title = {Isolation of whole mononuclear cells from peripheral blood and cord blood.},
	volume = {Chapter 7},
	issn = {0471142735},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/19347849},
	doi = {10.1002/0471142735.im0701s85},
	abstract = {Peripheral blood is the primary source of lymphoid cells for investigation of the human immune system. Its use is facilitated by Ficoll-Hypaque density gradient centrifugation-a simple and rapid method of purifying peripheral blood mononuclear cells (PBMC) that takes advantage of the density differences between mononuclear cells and other elements found in the blood sample. Thus, cells are distributed in the solution in layers based on the differences in their density/size. Additional purification methods can be employed as the mononuclear cell sample can be purified from monocytes by adherence or by exposure to L-leucine methyl ester; these methods are described for both procedures. Cord blood and peripheral blood from infants contain immature cells, including nucleated red cells, which can result in significant contamination of the mononuclear cell layer, and removal of these cells requires additional steps that are described. The isolation procedures presented here can also be applied to cell populations derived from tissues.},
	number = {April},
	journal = {Current protocols in immunology / edited by John E. Coligan ... [et al.]},
	author = {Fuss, Ivan J and Kanof, Marjorie E and Smith, Phillip D and Zola, Heddy},
	month = apr,
	year = {2009},
	keywords = {Humans, Leucine, Macrophages, Fetal Blood, Infant, Newborn, Cell Separation, Cell Separation: instrumentation, Cell Separation: methods, Centrifugation, Density Gradient, Erythroblasts, Erythroblasts: cytology, Fetal Blood: cytology, Ficoll, Immunologic Techniques, Leukocytes, Mononuclear, Leukocytes, Mononuclear: cytology, Macrophages: cytology, Methyl Ethers},
	pages = {Unit7.1--Unit7.1},
}

@article{zhao_identification_2006,
	title = {Identification of stem cells from human umbilical cord blood with embryonic and hematopoietic characteristics.},
	volume = {312},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/16716296},
	doi = {10.1016/j.yexcr.2006.04.008},
	abstract = {We identified stem cells from the umbilical cord blood, designated cord blood-stem cells (CB-SC). CB-SC displayed important embryonic stem (ES) cell characteristics including expression of ES-cell-specific molecular markers including transcription factors OCT-4 and Nanog, along with stage-specific embryonic antigen (SSEA)-3 and SSEA-4. CB-SC also expressed hematopoietic cell antigens including CD9, CD45 and CD117, but were negative for CD34. CB-SC displayed very low immunogenicity as indicated by expression of a very low level of major histocompatibility complex (MHC) antigens and failure to stimulate the proliferation of allogeneic lymphocytes. CB-SC could give rise to cells with endothelial-like and neuronal-like characteristics in vitro, as demonstrated by expression of lineage-associated markers. Notably, CB-SC could be stimulated to differentiate into functional insulin-producing cells in vivo and eliminated hyperglycemia after transplantation into a streptozotocin-induced diabetic mouse model. These findings may have significant potential to advance stem-cell-based therapeutics.},
	number = {13},
	journal = {Experimental cell research},
	author = {Zhao, Yong and Wang, Honglan and Mazzone, Theodore},
	month = aug,
	year = {2006},
	keywords = {Mice, Humans, Biological Markers, Phenotype, Animals, Fetal Blood, Insulin-Secreting Cells, Endothelial Cells, Cell Differentiation, Fetal Blood: cytology, Cell Differentiation: drug effects, Cell Transplantation, Cells, Cultured, Diabetes Mellitus, Experimental, Embryo, Mammalian, Embryo, Mammalian: cytology, Endothelial Cells: cytology, Flow Cytometry, Hematopoietic System, Hematopoietic System: cytology, Insulin-Secreting Cells: cytology, Nerve Growth Factor, Nerve Growth Factor: pharmacology, Neurons, Neurons: cytology, Stem Cells, Stem Cells: cytology, Stem Cells: drug effects, Stem Cells: immunology, Vascular Endothelial Growth Factor A, Vascular Endothelial Growth Factor A: pharmacology},
	pages = {2454--64},
}

@article{lucas_how_2013,
