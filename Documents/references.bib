}

@article{gao_likelihood_2008,
	title = {The likelihood of diabetes based on the proposed definitions for impaired fasting glucose},
	volume = {79},
	abstract = {The current study aimed to evaluate whether individuals with fasting plasma glucose (FPG) of 5.6-6.0 mmol/l has a similar risk profiles for diabetes or impaired glucose tolerance (IGT) to those with FPG of 6.1-6.9 mmol/l. A community-based cross-sectional survey in Chinese adults (20-74 years) was conducted during April-July in 2002. Participants without a prior history of diabetes underwent a standardized 2-h 75 g oral glucose tolerance test. Positive likelihood ratios were calculated to estimate the odds of having diabetes or IGT for subjects with different FPG levels. Among 1856 participants, prevalence of IFG increased from 12.4 to 28.2\% with the cut-off value of FPG lowered from 6.1 to 5.6 mmol/l. Individuals with FPG of 6.1-6.9 mmol/l were more obese and insulin resistant than those with FPG of 5.6-6.0 mmol/l. The positive likelihood ratio for diabetes and IGT were 1.83 (1.28-2.61) and 2.60 (1.96-3.44) in subjects with FPG of 6.1-6.9 mmol/l, and 0.54 (0.30-0.95) and 1.47 (1.11-1.95) for those with FPG of 5.6-6.0 mmol/l, respectively. In conclusion, the likelihood of diabetes and IGT was lower in subjects with FPG of 5.6-6.0 mmol/l than in those with FPG of 6.1-6.9 mmol/l. The clinical and social implication of labelling more individuals with impaired fasting glucose needs to be further studied},
	number = {1872-8227 (Electronic) LA - eng PT - Journal Article PT - Research Support, Non-U.S. Gov't SB - IM},
	journal = {Diabetes Res.Clin.Pract.},
	author = {Gao, W and Dong, Y and Nan, H and Tuomilehto, J and Qiao, Q},
	month = jan,
	year = {2008},
	note = {Place: Department of Public Health, University of Helsinki, Helsinki, Finland. aambaam@yahoo.com},
	keywords = {Adult, Fasting, Glucose, Insulin, Research, Risk, Public Health, Plasma, history, Prevalence, Glucose Tolerance Test, Research Support, Finland},
	pages = {151--155},
	annote = {DA - 20080107},
}

@article{daniel_diabetes_2002,
	title = {Diabetes and impaired glucose tolerance in {Aboriginal} {Australians}: prevalence and risk},
	volume = {57},
	abstract = {The prevalence and risk of having impaired glucose tolerance (IGT) and diabetes was estimated relative to body mass index (BMI) among Australian Aboriginal people. A stratified analysis was undertaken of community screening data. Measures included fasting and 2-h glucose concentrations, and BMI (five strata: {\textless}22, 22-24.9, 25-29.9, 30-34.9 and {\textgreater}/=35 kg/m(2)). Age was stratified into three groups: 15-34.9, 35-44.9, and {\textgreater}/=45 years. Participants were men and women, ages 15-94 years (n=2626). The prevalence of IGT and diabetes, respectively, adjusted for age and BMI, was 139 and 142 cases/1000 persons among men, and 157 and 152 cases/1000 persons among women. Odds ratios (95\% CI) for IGT and diabetes for increasing BMI strata {\textgreater}/=22 kg/m(2) ranged from 1.7 (1.0 to 2.9) to 5.1 (2.4-10.5) for IGT, and from 2.0 (1.2-3.5) to 6.1 (3.3-11.1) for diabetes. For IGT and diabetes, across genders, the population attributable risk percentages (95\% CI) for BMI {\textgreater}/=22 kg/m(2) were 34.1\% (26.2-41.9\%) for IGT, and 46.4\% (38.5-54.5\%) for diabetes. Diabetes and IGT have reached epidemic proportions among Australian Aboriginal people. An urgent need exists for programmes to reduce the prevalence of diabetes risk factors, especially BMI of 22 kg/m(2) or more, a limit lower than advocated for Euro-American populations},
	number = {0168-8227 LA - eng PT - Journal Article RN - 0 (Blood Glucose) SB - IM},
	journal = {Diabetes Res.Clin.Pract.},
	author = {Daniel, M and Rowley, K G and McDermott, R and O'Dea, K},
	month = jul,
	year = {2002},
	note = {Place: School of Public Health, University of North Carolina at Chapel Hill, CB \#7440, Rosenau Hall, Room 306, Chapel Hill, NC 27599-7440, USA. danielm@email.unc.edu},
	keywords = {Adult, analysis, blood, Fasting, Glucose, Men, Obesity, Odds Ratio, Risk, Women, metabolism, Middle Aged, Risk Factors, Aged, Female, Male, epidemiology, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, Blood Glucose, Body Constitution, Diabetes Mellitus, Prevalence, Age Distribution, Glucose Intolerance, statistics \& numerical data, Adolescent, Australia, North Carolina, Oceanic Ancestry Group},
