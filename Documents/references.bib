	keywords = {blood, methods, Risk, Human, therapy, drug effects, E-Selectin, Endothelium,Vascular, Intercellular Adhesion Molecule-1, metabolism, United States, Vascular Cell Adhesion Molecule-1, Cell Adhesion, Hemostasis, Inflammation, administration \& dosage, Female, Middle Age, Vasodilation, Cardiology, Hyperemia, Monocyte Chemoattractant Protein-1, Double-Blind Method, Cross-Over Studies, Drug Therapy,Combination, Postmenopause, Progesterone, Drug Administration Schedule, Estrogens, Estrogens,Conjugated, Progestational Hormones, Progestational Hormones,Synthetic, Plasminogen Activator Inhibitor 1, Menopause, chemical synthesis, Fibrinolysis, Medroxyprogesterone, Medroxyprogesterone 17-Acetate, Thromboplastin},
