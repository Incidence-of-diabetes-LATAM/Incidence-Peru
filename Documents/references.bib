@article{shield_study_group_perceived_2009,
	title = {Perceived body image in men and women with type 2 diabetes mellitus: correlation of body mass index with the figure rating scale},
	volume = {8},
	issn = {1475-2891},
	shorttitle = {Perceived body image in men and women with type 2 diabetes mellitus},
	url = {https://nutritionj.biomedcentral.com/articles/10.1186/1475-2891-8-57},
	doi = {10.1186/1475-2891-8-57},
	abstract = {Background: Body mass index (BMI) is often used as an objective surrogate estimate of body fat. Increased BMI is directly associated with an increase in metabolic disease, such as type 2 diabetes mellitus (T2DM). The Stunkard Figure Rating Scale (FRS) is a subjective measure of body fat, and self-perceptions of body image conceivably impact the development and treatment of T2DM. This study examined the self-perception of body image to various levels of BMI among those with T2DM.
Methods: Respondents (n = 13,887) to the US Study to Help Improve Early evaluation and management of risk factors Leading to Diabetes (SHIELD) 2006 survey self-reported their weight and height for BMI calculation. On the gender-specific Stunkard FRS, respondents selected the figure most closely resembling their body image. Spearman correlation was computed between perceived body image and BMI for men and women separately. Student's t-test analysis compared the mean BMI differences between respondents with and without T2DM.
Results: Men with T2DM did not significantly differ from men without diabetes mellitus in mean BMI per body image figure except at the extremes in body figures. Women with T2DM had a significantly higher BMI for the same body figure compared with women without diabetes mellitus for most figures (p {\textless} 0.05).
Conclusions: Individuals, particularly women, with T2DM may differ in their perception of body image compared with those without diabetes mellitus. It is unclear if these perceived differences increase the risk of T2DM, or if the diagnosis of T2DM alters body image perceptions.},
	language = {en},
	number = {1},
	urldate = {2021-02-13},
	journal = {Nutrition Journal},
	author = {{SHIELD Study Group} and Bays, Harold E and Bazata, Debbra D and Fox, Kathleen M and Grandy, Susan and Gavin, James R},
	month = dec,
	year = {2009},
	pages = {57},
	file = {SHIELD Study Group e.a. - 2009 - Perceived body image in men and women with type 2 .pdf:/Users/planetarium/Zotero/storage/2GT5CQVP/SHIELD Study Group e.a. - 2009 - Perceived body image in men and women with type 2 .pdf:application/pdf;SHIELD Study Group e.a. - 2009 - Perceived body image in men and women with type 2 .pdf:/Users/planetarium/Zotero/storage/N7FAKWMN/SHIELD Study Group e.a. - 2009 - Perceived body image in men and women with type 2 .pdf:application/pdf},
}

