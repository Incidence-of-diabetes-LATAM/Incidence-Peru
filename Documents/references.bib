	keywords = {Adult, analysis, Atherosclerosis, Blood Pressure, Cholesterol, Risk, Human, metabolism, Middle Aged, Cardiovascular Diseases, Hypertension, Risk Factors, Aged, Female, Male, Disease, epidemiology, Body Mass Index, Arteries, Coronary Disease, Regression Analysis, ultrasonography, pathology, Coronary Arteriosclerosis, Family, Smoking, Prevalence, Uric Acid, Calcinosis, Tomography,X-Ray Computed, Coronary Vessels, Echocardiography, Calcium, Hypertrophy,Left Ventricular},
