@article{von_euler-chelpin_register-based_2011-1,
	title = {Register-based studies of cancer screening effects},
	volume = {39},
	issn = {1403-4948, 1651-1905},
	url = {http://journals.sagepub.com/doi/10.1177/1403494811401479},
	doi = {10.1177/1403494811401479},
	abstract = {Introduction: There are two organised cancer screening programmes in Denmark, against cervical and breast cancers. The aim with this study was to give an overview of the available register-based research regarding these two programmes, to demonstrate the usefulness of data from the national registers. Research topics: The register-based studies on cancer screening in Denmark could be grouped into research concerning effectiveness, in terms of mortality and incidence reduction, shortterm indicators, e.g. in relation to recommended quality assurance indicators, and side effects, e.g. as false-positive results and overdiagnosis. Conclusion: The results indicate that registers have proven to be a valuable tool in evaluating the effects of ongoing screening activities. As they cannot be systematically used to test new screening technologies, register-based studies should not be seen as an alternative to randomised controlled trials, but as a supplement.},
	language = {en},
	number = {7\_suppl},
	urldate = {2021-02-14},
	journal = {Scandinavian Journal of Public Health},
	author = {Von Euler-Chelpin, My and Lynge, Elsebeth and Rebolj, Matejka},
