@article{rao_light_2003,
	title = {Light, but not heavy alcohol drinking, stimulates paraoxonase by upregulating liver {mRNA} in rats and humans},
	volume = {52},
	abstract = {Paraoxonase 1 (PON) may contribute to the cardioprotective action of high-density lipoprotein (HDL) because it inhibits low-density lipoprotein (LDL) oxidation, a prerequisite for the onset of atherosclerosis. Because light drinking and heavy drinking have diametrically opposite effects on cardioprotection, we have determined the effects of ethanol dosage on rat serum PON activity and its hepatic expression. Furthermore, we have investigated PON activity and polymorphism in human light and heavy drinkers. Our results confirm that HDL-PON inhibited LDL oxidation, destroyed oxidized LDL, and inhibited its uptake by macrophages. Light ethanol feeding caused a 20\% to 25\% (P {\textless}.05) increase in PON activity in both serum and liver and a 59\% (P {\textless}.001) increase in the level of liver PON mRNA compared with pair-fed control rats. In contrast, heavy ethanol feeding caused a 25\% (P {\textless}.05) decrease in serum and liver PON activities with a 51\% (P {\textless}.01) decrease in liver PON mRNA level. Light drinkers had a 395\% (P {\textless}.001) higher, whereas heavy drinkers had a 45\% (P {\textless}.001) lower serum PON activity compared with nondrinkers. Significantly, the number of homozygotes versus heterozygotes with respect to high or low activity PON phenotype was similar in all the groups. Therefore, we conclude that light drinking upregulates, whereas heavy drinking downregulates PON activity and its expression, irrespective of its genetic polymorphism},
	number = {0026-0495 LA - eng PT - Journal Article RN - 0 (Cardiotonic Agents) RN - 0 (Lipoproteins, LDL) RN - 0 (RNA, Messenger) RN - 64-17-5 (Ethanol) RN - EC 3.1. (Esterases) RN - EC 3.1.8.1 (Aryldialkylphosphatase) RN - EC 3.1.8.1 (paraoxonase 1, human) SB - IM},
	journal = {Metabolism},
	author = {Rao, M N and Marmillot, P and Gong, M and Palmer, D A and Seeff, L B and Strader, D B and Lakshman, M R},
	month = oct,
	year = {2003},
