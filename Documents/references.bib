	pages = {991--995},
	file = {Andres e.a. - 2012 - Body Fat Mass of Exclusively Breastfed Infants Bor.pdf:/Users/planetarium/Zotero/storage/BTGDCW9L/Andres e.a. - 2012 - Body Fat Mass of Exclusively Breastfed Infants Bor.pdf:application/pdf;Andres e.a. - 2012 - Body Fat Mass of Exclusively Breastfed Infants Bor.pdf:/Users/planetarium/Zotero/storage/23PYDC7T/Andres e.a. - 2012 - Body Fat Mass of Exclusively Breastfed Infants Bor.pdf:application/pdf},
