	note = {Place: Department of Internal Medicine, Kiruna District Hospital, Kiruna, Sweden. torbjorn.messner@nll.se},
	keywords = {Incidence, Middle Aged, Female, Male, Disease, epidemiology, Humans, Time, etiology, Myocardial Infarction, Regression Analysis, mortality, Death, Death,Sudden,Cardiac, trends, Temperature, Weather, Sweden, Meteorological Factors, Humidity, Arctic Regions},
