	keywords = {blood, Cholesterol, Lipids, Human, Cell Adhesion Molecules, Cytokines, Gene Expression, Intercellular Adhesion Molecule-1, metabolism, pharmacology, Support,U.S.Gov't,P.H.S., United States, Animal, Leukocytes, Mice, physiopathology, administration \& dosage, Female, prevention \& control, Arteriosclerosis, Diet, genetics, Disease Susceptibility, Homozygote, deficiency, P-Selectin, Antigens,CD18, Dietary Fats, Mutation, Animal Feed, Cholesterol,Dietary, Leukocyte-Adhesion Deficiency Syndrome, Mice,Inbred C57BL},
