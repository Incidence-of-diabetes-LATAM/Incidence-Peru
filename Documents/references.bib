@article{yuan_identification_2002,
	title = {Identification of fibrous cap rupture with magnetic resonance imaging is highly associated with recent transient ischemic attack or stroke},
	volume = {105},
	abstract = {BACKGROUND: High-resolution MRI has been shown to be capable of distinguishing intact, thick fibrous caps from thin and ruptured caps in human carotid atherosclerosis in vivo. The aim of this study was to determine whether MRI identification of fibrous cap thinning or rupture is associated with a history of recent transient ischemic attack (TIA) or stroke. METHODS AND RESULTS: Fifty-three consecutive patients (mean age, 71 years; 49 male) scheduled for carotid endarterectomy were recruited after obtaining informed consent. Twenty-eight subjects had a recent history of TIA or stroke on the side appropriate to the index carotid lesion, and 25 were asymptomatic. Preoperative carotid MRI was performed in a 1.5-T GE Signa scanner that generated T(1)-, PD-, and T(2)-weighted and three-dimensional time-of-flight images. Using previously reported MRI criteria, the fibrous cap was categorized as intact-thick, intact-thin, or ruptured for each carotid plaque by blinded review. There was a strong and statistically significant trend showing a higher percentage of symptomatic patients for ruptured caps (70\%) compared with thick caps (9\%) (P=0.001 Mann-Whitney test for cap status versus symptoms). Compared with patients with thick fibrous caps, patients with ruptured caps were 23 times more likely to have had a recent TIA or stroke (95\% CI=3, 210). CONCLUSIONS: MRI identification of a ruptured fibrous cap is highly associated with a recent history of TIA or stroke. Ongoing prospective studies will determine the predictive value fibrous cap characteristics, as visualized by MRI, for risk of subsequent ischemic events},
	number = {1524-4539 LA - eng PT - Clinical Trial PT - Journal Article SB - AIM SB - IM},
	journal = {Circulation},
	author = {Yuan, C and Zhang, S X and Polissar, N L and Echelard, D and Ortiz, G and Davis, J W and Ellington, E and Ferguson, M S and Hatsukami, T S},
	month = jan,
	year = {2002},
	note = {Place: Department of Radiology, University of Washington, Seattle 98195, USA. cyuan@u.washington.edu},
	keywords = {Atherosclerosis, methods, Risk, Human, Support,U.S.Gov't,P.H.S., Aged, Male, Time Factors, Time, complications, Prospective Studies, Washington, Arteriosclerosis, pathology, history, Carotid Artery Diseases, Cerebrovascular Accident, Magnetic Resonance Imaging, Endarterectomy, Ischemic Attack,Transient},
	pages = {181--185},
