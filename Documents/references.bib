@article{pereira_long-term_2008,
	title = {Long-term stability of endogenous {B}-type natriuretic peptide after storage at –20°{C} or –80°{C}},
	volume = {46},
	issn = {1437-4331, 1434-6621},
	url = {https://www.degruyter.com/view/j/cclm.2008.46.issue-8/cclm.2008.223/cclm.2008.223.xml},
	doi = {10.1515/CCLM.2008.223},
	abstract = {Background: B-type natriuretic peptide (BNP) is a biomarker used in the investigation of heart failure and other cardiovascular diseases. Our aim was to analyze the degradation of BNP in plasma samples kept at –208C or at –808C after 3 months or 1 year of storage.
Methods: Using a Biosite assay-Triage BNP test, we evaluated 20 subjects with plasma BNP concentrations ranging from normal to high. Plasma aliquots were separated in five eppendorfs, one for immediate measurement after centrifugation, two for storage at –208C and two at –808C. We measured BNP after 3 months and 1 year. The significance level was set at p-0.05 (one-tailed test).
Results: There was a significant decrease of 1\% per month in BNP concentration. However, there was a significant interaction between time and group (high vs. low BNP). Low BNP values did not change over time, while high BNP decreased by 2\% per month. The decrease over time did not depend on the storage temperature.
Conclusions: The storage of the samples at –208C or at –808C did not prevent BNP degradation, especially for high BNP values. For low BNP values, we did not observe a significant decay at either 3 months or 1 year. These results are valid for the Biosite assayTriage BNP test.},
	language = {en},
	number = {8},
	urldate = {2021-02-14},
	journal = {Clinical Chemistry and Laboratory Medicine},
	author = {Pereira, Marta and Azevedo, Ana and Severo, Milton and Barros, Henrique},
	month = jan,
	year = {2008},
	file = {Pereira e.a. - 2008 - Long-term stability of endogenous B-type natriuret.pdf:/Users/planetarium/Zotero/storage/MHH2ZNEQ/Pereira e.a. - 2008 - Long-term stability of endogenous B-type natriuret.pdf:application/pdf},
}

