	note = {Place: Brigham and Women's Hospital/Harvard Medical School, Boston, Massachusetts, USA},
	keywords = {Cholesterol, Odds Ratio, Risk, Syndrome, Women, therapy, Intercellular Adhesion Molecule-1, Risk Factors, Disease, Myocardial Infarction, Arteries, Smoking, C-Reactive Protein, Massachusetts, Hospitalization, Death},
	pages = {861--865},
