	note = {Place: Vascular Physiology Unit, Great Ormond Street Hospital for Children NHS Trust, and the Institute of Child Health, London, UK},
	keywords = {Adult, methods, Risk, diagnosis, Human, drug effects, Support,Non-U.S.Gov't, United States, Hypertension, physiology, physiopathology, Vascular Diseases, adverse effects, Aged, Blood Flow Velocity, Brachial Artery, Female, Male, Age Factors, Time, etiology, Arteries, Dilatation, Nitroglycerin, Regression Analysis, ultrasonography, Vasodilation, Vasodilator Agents, diagnostic use, Child, Infant, Phenotype, surgery, Aorta, Vascular Patency, Tibial Arteries, Aortic Coarctation, Cardiovascular Surgical Procedures},
