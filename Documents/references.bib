	month = may,
	year = {2002},
	note = {Place: Department of Epidemiology and Biostatistics, Erasmus Medical Centre Rotterdam, Rotterdam, The Netherlands},
	keywords = {Odds Ratio, diagnosis, Human, Cell Adhesion Molecules, Intercellular Adhesion Molecule-1, metabolism, Support,Non-U.S.Gov't, United States, Vascular Cell Adhesion Molecule-1, Cell Adhesion, Inflammation, Aged, Female, Male, epidemiology, Multivariate Analysis, Prospective Studies, Arteriosclerosis, C-Reactive Protein, Netherlands, diagnostic use, Cohort Studies, Solubility, Interleukin-6, Inflammation Mediators, Severity of Illness Index, Population Surveillance},
