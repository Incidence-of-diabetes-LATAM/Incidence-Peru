	month = sep,
	year = {2001},
	note = {Place: Department of Human Movement and Exercise Science, The University of Western Australia, Crawley, Australia},
	keywords = {analysis, blood, methods, Human, therapy, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, physiopathology, Brachial Artery, Female, Male, Middle Age, Arteries, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Vasodilation, Regional Blood Flow, Acetylcholine, blood supply, Exercise, Forearm, Analysis of Variance, Nitroprusside, Plethysmography, Australia, Exercise Therapy},
