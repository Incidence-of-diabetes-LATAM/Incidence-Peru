	keywords = {Research, Human, Endothelium,Vascular, Nitric Oxide, Support,Non-U.S.Gov't, United States, Hypertension, physiology, Brachial Artery, Arteries, Heart, ultrasonography, Vasodilation, Image Processing,Computer-Assisted, Maryland},
	pages = {257--265},
