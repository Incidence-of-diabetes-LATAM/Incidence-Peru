	keywords = {analysis, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., physiopathology, Disease, London, Arteries, Heart, Coronary Disease, pathology, Statistics, radiography, Angiography, Coronary Vessels, Prognosis, surgery, Heart Ventricles, Ventricular Function},
	pages = {1854--1866},
