	number = {5},
	urldate = {2021-02-13},
	journal = {The Journal of Clinical Endocrinology \& Metabolism},
	author = {Bianchi, Cristina and Miccoli, Roberto and Trombetta, Maddalena and Giorgino, Francesco and Frontoni, Simona and Faloia, Emanuela and Marchesini, Giulio and Dolci, Maria A. and Cavalot, Franco and Cavallo, Gisella and Leonetti, Frida and Bonadonna, Riccardo C. and Del Prato, Stefano and {on behalf of the GENFIEV Investigators}},
	month = may,
	year = {2013},
	pages = {2100--2105},
	file = {Bianchi e.a. - 2013 - Elevated 1-Hour Postload Plasma Glucose Levels Ide.pdf:/Users/planetarium/Zotero/storage/V3HVBBTE/Bianchi e.a. - 2013 - Elevated 1-Hour Postload Plasma Glucose Levels Ide.pdf:application/pdf;Bianchi e.a. - 2013 - Elevated 1-Hour Postload Plasma Glucose Levels Ide.pdf:/Users/planetarium/Zotero/storage/EYXEBY35/Bianchi e.a. - 2013 - Elevated 1-Hour Postload Plasma Glucose Levels Ide.pdf:application/pdf},
