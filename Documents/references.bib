	pages = {157--164},
	file = {Dyck e.a. - 2010 - Signs and symptoms versus nerve conduction studies.pdf:/Users/planetarium/Zotero/storage/RLYJQGCU/Dyck e.a. - 2010 - Signs and symptoms versus nerve conduction studies.pdf:application/pdf},
