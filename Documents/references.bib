@article{haberl_correlation_2001,
	title = {Correlation of coronary calcification and angiographically documented stenoses in patients with suspected coronary artery disease: results of 1,764 patients},
	volume = {37},
	abstract = {OBJECTIVES: This study correlated the electron beam computed tomographic (EBCT) calcium scores with the results of coronary angiography in symptomatic patients in order to assess its value to predict or exclude significant coronary artery disease (CAD). BACKGROUND: Electron beam computed tomography is a sensitive method to detect coronary calcium. However, it is unclear whether it may play a role as a filter before invasive procedures in symptomatic patients. METHODS: A total of 1,764 patients (1,225 men and 539 women) with suspected CAD from a single center were included in our study. All patients underwent calcium screening with EBCT (C150XP Imatron) and conventional coronary angiography. RESULTS: Fifty-six percent of men and 47\% of women revealed significant coronary stenoses ({\textgreater} or =50\%). Total exclusion of coronary calcium (14\% of the study group) was associated with an extremely low probability of stenosis ({\textless}1\%). With calcium scores {\textgreater} or =20th, {\textgreater} or =100th or {\textgreater} or =75th percentile of age groups, the sensitivity to detect stenoses decreased to 97\%, 93\% and 81\%, respectively, in men and to 98\%, 82\% and 76\%, respectively, in women. At the same time, the specificity increased up to 77\% in men and women. There was a significant difference in coronary calcium between men and women in all age groups; however, receiver-operating characteristic curves indicated that the test can be performed with equal accuracy in all of these subgroups. CONCLUSIONS: Calcium screening with EBCT is a highly sensitive and moderately specific test to predict stenotic disease. Exclusion of coronary calcium defines a substantial subgroup of patients, albeit symptomatic, with a very low probability of significant stenoses},
	number = {0735-1097 LA - eng PT - Journal Article SB - AIM SB - IM},
	journal = {J.Am.Coll.Cardiol.},
	author = {Haberl, R and Becker, A and Leber, A and Knez, A and Becker, C and Lang, C and Bruning, R and Reiser, M and Steinbeck, G},
	month = feb,
	year = {2001},
	note = {Place: Medical Hospital I, University of Munich, Germany. Haberlralph@web.de},
	keywords = {Adult, methods, Human, Risk Factors, Aged, Female, Male, Middle Age, Disease, Time, Arteries, Probability, Coronary Angiography, Coronary Arteriosclerosis, Predictive Value of Tests, Calcinosis, Coronary Calcification, radiography, Tomography,X-Ray Computed, Angiography, Roc Curve, Sex Factors, Calcium, Germany},
	pages = {451--457},
