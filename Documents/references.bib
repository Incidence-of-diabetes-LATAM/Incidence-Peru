	author = {Mertens, A and Holvoet, P},
	month = oct,
	year = {2001},
	note = {Place: Center for Experimental Surgery and Anesthesiology, Katholieke Universiteit Leuven, Belgium},
	keywords = {Atherosclerosis, blood, Cholesterol, Risk, Human, biosynthesis, Endothelium, metabolism, Animal, Hypertension, Mice, physiology, Disease, etiology, Arteries, Lipoproteins, Risk Assessment, Coronary Arteriosclerosis, Smoking, Thrombosis, Phospholipases A, Phospholipids, Esterases, Lipoproteins,HDL, Lipoproteins,LDL, surgery, Models,Cardiovascular, antagonists \& inhibitors, Apoptosis, Tissue-factor, Receptors,Immunologic},
	pages = {2073--2084},
