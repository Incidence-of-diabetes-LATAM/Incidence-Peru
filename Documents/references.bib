@article{duffy_iron_2001,
	title = {Iron chelation improves endothelial function in patients with coronary artery disease},
	volume = {103},
	abstract = {BACKGROUND: Some epidemiological studies have shown that increased iron stores are associated with increased cardiovascular events. Redox-active iron may contribute to lipid peroxidation, endothelial cell activation, and generation of reactive oxygen species (especially hydroxyl radical, via Fenton chemistry). Increased oxidative stress is associated with impaired action of endothelium-derived nitric oxide in patients with atherosclerosis. METHODS AND RESULTS: To test the hypothesis that reducing vascular iron stores would reverse endothelial dysfunction, we examined the effects of the iron chelator deferoxamine (500 mg intra-arterially over 1 hour) on vasomotor function in forearm resistance vessels of patients with coronary artery disease by venous occlusion plethysmography. Patients with coronary artery disease had impaired endothelium-dependent vasodilation in response to methacholine compared with healthy control subjects (P{\textless}0.001). Deferoxamine infusion decreased serum iron levels (P{\textless}0.001). Deferoxamine improved the blood flow response to methacholine in patients with coronary artery disease (P{\textless}0.01 by 2-way repeated-measures ANOVA) but had no effect on the response to sodium nitroprusside. In normal volunteers, deferoxamine had no effect on the response to methacholine. The nitric oxide synthase inhibitor N(G)-monomethyl-L-arginine abolished augmentation of the methacholine response associated with deferoxamine. The hydroxyl radical scavenger mannitol had no effect on the methacholine response. CONCLUSIONS: Deferoxamine improved nitric oxide-mediated, endothelium-dependent vasodilation in patients with coronary artery disease. These results suggest that iron availability contributes to impaired nitric oxide action in atherosclerosis},
	number = {1524-4539 LA - eng},
	journal = {Circulation},
	author = {Duffy, S J and Biegelsen, E S and Holbrook, M and Russell, J D and Gokce, N and Keaney Jr., J F and Vita, J A},
	month = jun,
	year = {2001},
	note = {Place: Evans Department of Medicine and Whitaker Cardiovascular Institute, Boston University School of Medicine, Boston, MA, USA},
	keywords = {Adult, blood, methods, Human, drug effects, Endothelium,Vascular, Lipid Peroxidation, Nitric Oxide, pharmacology, Reactive Oxygen Species, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, physiopathology, administration \& dosage, Blood Flow Velocity, Female, Male, Middle Age, Oxidative Stress, Arteries, Coronary Disease, Vasodilation, blood supply, omega-N-Methylarginine, chemistry, Stress, Vasomotor System, diagnostic use, Forearm, Oxygen, Nitroprusside, Plethysmography, Enzyme Inhibitors, Nitric-Oxide Synthase, antagonists \& inhibitors, Infusions,Intra-Arterial, Methacholine Chloride, Iron, Free Radical Scavengers, Deferoxamine, Iron Chelating Agents},
	pages = {2799--2804},
	annote = {UI - 21294922},
}

@article{goldhammer_circadian_1999,
	title = {Circadian fluctuations in the efficacy of thrombolysis with streptokinase},
	volume = {75},
	abstract = {This study was designed to investigate possible diurnal fluctuations in the efficacy of thrombolysis with streptokinase and whether they follow the circadian periodicity which has already been well documented for the time of onset of acute myocardial infarction, transient myocardial ischaemia, sudden cardiac death, thrombotic stroke, and for the efficacy of thrombolysis with tissue-type plasminogen and urokinase. A total of 156 consecutive patients treated with streptokinase were studied retrospectively; success or failure of thrombolysis was determined according to accepted clinical and angiographic criteria. A definite time peak for successful thrombolysis could be detected at the late afternoon and early evening hours; between 16.00 and 20.00 h, 30.2\% of all successful thrombolysis cases were observed compared with 7.0\% between 20.00 and 24.00 (p {\textless} 0.05) or 10.5\% between 00.00 and 04.00 (p {\textless} 0.05). Between 16.00 and 20.00 h, 75.8\% of treated patients had successful thrombolysis compared to 15.2\% of failed treatments and 9\% equivocal results (p {\textless} 0.001). Multiple regression analysis showed that the independent factor with the major impact on successful reperfusion was the actual time of thrombolysis (p = 0.037), followed by the time delay from pain onset to streptokinase administration (p = 0.020), while age and gender had much lesser impact (p = 0.328 and 0.215, respectively) and the individual risk factors even less. These findings may have several clinical implications; dose adjustment for the time of day may be required, with higher doses during morning hours, or preference for primary coronary angioplasty in order to avoid the increase in bleeding complications related to higher doses of thrombolytic agents},
	number = {0032-5473 LA - eng PT - Journal Article},
	journal = {Postgrad.Med.J.},
	author = {Goldhammer, E and Kharash, L and Abinader, E G},
	month = nov,
	year = {1999},
	note = {Place: Department of Cardiology, Bnei-Zion Medical Center, Haifa, Israel},
	keywords = {Adult, analysis, Risk, Human, Risk Factors, Aged, drug therapy, Female, Male, Middle Age, therapeutic use, Time Factors, Time, complications, Myocardial Infarction, Regression Analysis, England, Cardiology, Aspirin, Aged,80 and over, Israel, Death, Circadian Rhythm, Periodicity, Chi-Square Distribution, Drug Administration Schedule, Platelet Aggregation, Thrombolytic Therapy, Platelet Aggregation Inhibitors, Streptokinase},
	pages = {667--671},
	annote = {UI - 20087757},
}

@article{kempler_blood_2001,
	title = {Blood pressure response to standing in the diagnosis of autonomic neuropathy: the {EURODIAB} {IDDM} {Complications} {Study}},
	volume = {109},
	abstract = {Autonomic neuropathy is associated with poor prognosis. Cardiovascular reflexes are essential for the diagnosis of autonomic nerve dysfunction. Blood pressure response to standing is the most simple test for the evaluation of sympathetic integrity, however it is still discussed which diagnostic criteria of abnormal response should be considered as optimal. The EURODIAB IDDM Complications Study involved the examination of randomly selected Type 1 diabetic patients from 31 centres in 16 European counties. Data from 3007 patients were available for the present evaluation. Two tests of autonomic function (response of heart rate /R-R ratio/ and blood pressure from lying to standing) just as the frequency of feeling faint on standing up were assessed. R-R ratio was abnormal in 24\% of patients. According to different diagnostic criteria of abnormal BP response to standing ({\textgreater}30 mmHg, {\textgreater}20 mmHg, and {\textgreater}10 mmHg fall in systolic BP), the frequency of abnormal results was 5.9\%, 18\% and 32\%, respectively (p {\textless} 0.001). The frequency of feeling faint on standing was 18\%, thus, it was identical with the prevalence of abnormal blood pressure response to standing when {\textgreater}20 mmHg fall in systolic blood pressure was considered as abnormal. Feeling faint on standing correlated significantly with both autonomic test results (p {\textless} 0.001). A fall {\textgreater}20 mmHg in systolic blood pressure after standing up seems to be the most reliable criterion for the assessment of orthostatic hypotension in the diagnosis of autonomic neuropathy in patients with Type 1 diabetes mellitus},
	number = {1381-3455 LA - eng PT - Journal Article PT - Multicenter Study SB - IM},
	journal = {Arch.Physiol Biochem.},
	author = {Kempler, P and Tesfaye, S and Chaturvedi, N and Stevens, L K and Webb, D J and Eaton, S and Kerenyi, Z and Tamas, G and Ward, J D and Fuller, J H},
	month = jul,
	year = {2001},
	note = {Place: First Department of Medicine, Semmelweis University, Budapest, Hungary},
	keywords = {Adult, blood, Blood Pressure, Pressure, Diabetic Neuropathies, diagnosis, Human, Support,Non-U.S.Gov't, physiopathology, Risk Factors, Female, Male, Middle Age, complications, etiology, Multicenter Studies, Heart, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Prevalence, Prognosis, Adolescent, Heart Rate, Cardiovascular System, innervation, Hypotension,Orthostatic, Posture},
