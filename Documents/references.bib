	note = {Place: Department of Epidemiology and Public Health, Faculty of Medicine, 67085 Strasbourg, France. monica@medecine.u-strasbg.fr},
	keywords = {Adult, Incidence, Men, methods, Women, Middle Aged, Aged, Female, Male, Disease, epidemiology, Humans, Public Health, Research Support,Non-U.S.Gov't, Time, Heart, mortality, Coronary Arteriosclerosis, Morbidity, Sex Factors, Registries, statistics \& numerical data, trends, France, Evolution},
