	file = {Jaacks e.a. - 2014 - Long-term changes in dietary and food intake behav.pdf:/Users/planetarium/Zotero/storage/IALNDQYR/Jaacks e.a. - 2014 - Long-term changes in dietary and food intake behav.pdf:application/pdf},
