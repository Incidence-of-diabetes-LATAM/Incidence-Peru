	pages = {1343--1350},
	file = {Tuomilehto e.a. - 2001 - Prevention of Type 2 Diabetes Mellitus by Changes .pdf:/Users/planetarium/Zotero/storage/K6XXBK58/Tuomilehto e.a. - 2001 - Prevention of Type 2 Diabetes Mellitus by Changes .pdf:application/pdf},
