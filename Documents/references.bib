	keywords = {Adult, analysis, blood, Cholesterol, Fasting, Glucose, Insulin Resistance, Men, methods, Obesity, Research, Research Design, Risk, Syndrome, Triglycerides, Women, Human, metabolism, Support,Non-U.S.Gov't, Middle Aged, Cardiovascular Diseases, Hypertension, physiology, Risk Factors, Aged, Female, Male, Age Factors, Disease, epidemiology, complications, Multicenter Studies, World Health, 10, Blood Glucose, Heart, Lipoproteins, Lipoproteins,HDL Cholesterol, mortality, Family, Diabetes Mellitus,Type II, Prevalence, World Health Organization, Glucose Intolerance, Morbidity, Hyperlipidemia, Sex Factors, Death, Albuminuria, Hemoglobin A,Glycosylated, Finland, Sweden},
