	note = {Place: International Centre for Health and Society, Department of Epidemiology and Public Health, University College London Medical School, UK},
	keywords = {Adult, analysis, blood, Cholesterol, Glucose, Insulin, Insulin Resistance, Men, Obesity, Odds Ratio, Risk, Syndrome, Triglycerides, Women, Human, metabolism, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Middle Aged, Aged, Female, Male, epidemiology, London, Body Mass Index, Blood Glucose, Body Constitution, Lipoproteins, Lipoproteins,HDL Cholesterol, Plasma, Regression Analysis, Smoking, Prevalence, Glucose Tolerance Test, Fibrinogen, Exercise, Social Class, Employment},
