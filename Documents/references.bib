	keywords = {Adult, blood, Blood Pressure, methods, Risk, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, physiology, Blood Flow Velocity, Brachial Artery, Female, Male, Arteries, Heart, Reference Values, ultrasonography, Vasodilation, Sex Factors, Hyperemia, Forearm, Hemodynamics, Heart Rate, Intelligence Tests, Problem Solving},
