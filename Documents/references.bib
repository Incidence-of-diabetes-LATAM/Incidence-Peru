	keywords = {blood, Glucose, Lipids, methods, Risk, Human, Antioxidants, drug effects, Endothelium, Endothelium,Vascular, metabolism, pharmacology, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, physiopathology, administration \& dosage, Brachial Artery, Female, Male, Middle Age, Oxidative Stress, Arteries, Blood Glucose, Coronary Disease, ultrasonography, Vasodilation, Stress, Vasodilator Agents, Vasomotor System, Cross-Over Studies, Hemodynamics, Administration,Oral, Tea, Bioflavonoids, Caffeine, Plant Extracts},
