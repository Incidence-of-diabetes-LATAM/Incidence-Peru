	note = {Place: Wolfson Unit for Prevention of Peripheral Vascular Diseases, School of Medicine and Veterinary Medicine, University of Edinburgh, Teviot Place, Edinburgh EH8 9AG, Scotland, UK. I.Tzoulaki@sms.ed.ac.uk},
