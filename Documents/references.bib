@article{carter_trajectories_2012-1,
	title = {Trajectories of {Childhood} {Weight} {Gain}: {The} {Relative} {Importance} of {Local} {Environment} versus {Individual} {Social} and {Early} {Life} {Factors}},
	volume = {7},
	url = {http://dx.plos.org/10.1371/journal.pone.0047065},
	doi = {10.1371/journal.pone.0047065},
	abstract = {Objective
To determine the association between local environmental factors with child weight status in a longitudinal study, using a semi-parametric, group-based method, while also considering social and early life factors.


Methods
Standardized, directly measured BMI from 4–10 y of age, and group-based trajectory modeling (PROC TRAJ) were used to estimate developmental trajectories of weight change in a Québec birth cohort (n = 1,566). Associations between the weight trajectories and living location, social cohesion, disorder, and material and social deprivation were estimated after controlling for social and early life factors.


Results
Four weight trajectory groups were estimated: low-increasing (9.7\%); low-medium, accelerating (36.2\%); medium-high, increasing (43.0\%); and high-stable (11.1\%). In the low-increasing and medium-high trajectory groups, living in a semi-urban area was inversely related to weight, while living in a rural area was positively related to weight in the high-stable group. Disorder was inversely related to weight in the low-increasing group only. Other important risk factors for high-stable weight included obesity status of the mother, smoking during pregnancy, and overeating behaviors.


Conclusions
In this study, associations between local environment factors and weight differed by trajectory group. Early life factors appear to play a more consistent role in weight status. Further work is needed to determine the influence of place on child weight.},
	number = {10},
	journal = {PLoS ONE},
	publisher = {Public Library of Science},
	author = {Carter, Megan A. and Dubois, Lise and Tremblay, Mark S. and Taljaard, Monica and Jones, Bobby L.},
	editor = {Newton, Robert L.},
	month = oct,
	year = {2012},
	keywords = {Obesity, Epidemiology, Sociology, Nutrition, Medicine, Research Article, Social epidemiology, Social networks, Public health, Pediatrics, Behavioral and social aspects of health, Child development, Child health, Environmental epidemiology, Environmental health, Pediatric epidemiology, Pediatrics and Child Health, Public Health and Epidemiology, Social and behavioral sciences, Socioeconomic aspects of health},
	pages = {e47065--e47065},
}

@article{charles_impact_2012,
	title = {Impact of early detection and treatment of diabetes on the 6-year prevalence of cardiac autonomic neuropathy in people with screen-detected diabetes: {ADDITION}-{Denmark}, a cluster-randomised study.},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/23064291},
	doi = {10.1007/s00125-012-2744-5},
	abstract = {AIMS/HYPOTHESIS: There is limited evidence on how multifactorial treatment improves outcomes of diabetes when initiated in the lead time between detection by screening and diagnosis in routine clinical practice. Cardiac autonomic neuropathy (CAN) in people with diabetes indicates widespread damage to the autonomic nervous system, which may severely affect health and quality of life. We examined effects of early detection and subsequent intensive treatment of type 2 diabetes in primary care on the prevalence of CAN at the 6-year follow-up examination in a pragmatic cluster-randomised parallel group trial. METHODS: One hundred and ninety general practices were randomised to deliver either intensive multifactorial treatment (IT) or routine care (RC) as recommended by national guidelines to patients with type 2 diabetes, identified through a stepwise screening programme in the primary care setting. 1533 people (IT, n = 910; RC, n = 623) were identified and included. At the 6-year follow-up examination, measures of CAN were applied in an unselected subsample of 777 participants using heart rate variability analysis and standard tests of CAN. RESULTS: At the 6-year follow-up examination, the prevalence of early CAN was 15.1\% in the RC group and 15.5\% in the IT group, while manifest CAN was present in 7.1\% and 7.3\%, respectively. We found no statistically significant effect of intensive treatment on the prevalence of CAN compared with routine care. CONCLUSIONS/INTERPRETATION: In the Danish arm of the ADDITION Study, signs of CAN were highly prevalent 6 years after a screening-based diagnosis of type 2 diabetes. Intensive multifactorial treatment did not significantly affect the prevalence of CAN compared with routine care. However, at follow-up the level of medication was also high in the RC group.},
	journal = {Diabetologia},
	author = {Charles, M and Fleischer, J and Witte, D R and Ejskjaer, N and Borch-Johnsen, K and Lauritzen, T and Sandbaek, a},
	month = oct,
	year = {2012},
	keywords = {prevalence, heart rate variability, addition, cardiac autonomic neuropathy, diabetic neuropathy, screen-detected diabetes, trial},
}

@article{wang_metabolite_2011-1,
	title = {Metabolite profiles and the risk of developing diabetes.},
	volume = {17},
	url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=3126616&tool=pmcentrez&rendertype=abstract},
	doi = {10.1038/nm.2307},
	abstract = {Emerging technologies allow the high-throughput profiling of metabolic status from a blood specimen (metabolomics). We investigated whether metabolite profiles could predict the development of diabetes. Among 2,422 normoglycemic individuals followed for 12 years, 201 developed diabetes. Amino acids, amines and other polar metabolites were profiled in baseline specimens by liquid chromatography-tandem mass spectrometry (LC-MS). Cases and controls were matched for age, body mass index and fasting glucose. Five branched-chain and aromatic amino acids had highly significant associations with future diabetes: isoleucine, leucine, valine, tyrosine and phenylalanine. A combination of three amino acids predicted future diabetes (with a more than fivefold higher risk for individuals in top quartile). The results were replicated in an independent, prospective cohort. These findings underscore the potential key role of amino acid metabolism early in the pathogenesis of diabetes and suggest that amino acid profiles could aid in diabetes risk assessment.},
	number = {4},
	journal = {Nature medicine},
	author = {Wang, Thomas J and Larson, Martin G and Vasan, Ramachandran S and Cheng, Susan and Rhee, Eugene P and McCabe, Elizabeth and Lewis, Gregory D and Fox, Caroline S and Jacques, Paul F and Fernandez, Céline and O'Donnell, Christopher J and Carr, Stephen a and Mootha, Vamsi K and Florez, Jose C and Souza, Amanda and Melander, Olle and Clish, Clary B and Gerszten, Robert E},
	month = apr,
	year = {2011},
	keywords = {Case-Control Studies, Middle Aged, Risk Factors, Aged, Female, Male, Causality, Humans, Longitudinal Studies, Prospective Studies, Diabetes Mellitus, Logistic Models, Predictive Value of Tests, Biological Markers, Cohort Studies, Biological Markers: blood, Diabetes Mellitus: blood, Diabetes Mellitus: etiology, Metabolome, Amino Acids, Branched-Chain, Amino Acids, Branched-Chain: blood, Amino Acids, Aromatic, Amino Acids, Aromatic: blood, Tandem Mass Spectrometry},
