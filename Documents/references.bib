	month = oct,
	year = {2002},
	note = {Place: HealthStat, Princeton, NJ 08543, USA},
	keywords = {11, Incidence, diagnosis, Human, therapy, Comparative Study, Support,Non-U.S.Gov't, Aged, Male, epidemiology, Time, Multicenter Studies, 10, Washington, mortality, Mass Screening, Cohort Studies, statistics \& numerical data, Biopsy, organization \& administration, Prostatic Neoplasms, Connecticut, Prostatectomy, radiotherapy},
