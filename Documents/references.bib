	keywords = {Human, drug effects, Nitric Oxide, pharmacology, physiology, Blood Flow Velocity, Brachial Artery, Male, Middle Age, Disease, Arteries, Vasodilation, England, Cardiology, Regional Blood Flow, blood supply, omega-N-Methylarginine, Exercise, Heart Rate, Enzyme Inhibitors, Random Allocation, Sweden, Arm, Hand Strength, Injections,Intra-Arterial, Sodium Chloride, Tourniquets},
