@article{faurholt-jepsen_diabetes_2011,
	title = {Diabetes {Is} a {Risk} {Factor} for {Pulmonary} {Tuberculosis}: {A} {Case}-{Control} {Study} from {Mwanza}, {Tanzania}},
	volume = {6},
	issn = {1932-6203},
	shorttitle = {Diabetes {Is} a {Risk} {Factor} for {Pulmonary} {Tuberculosis}},
	url = {https://dx.plos.org/10.1371/journal.pone.0024215},
	doi = {10.1371/journal.pone.0024215},
	abstract = {Background: Diabetes and TB are associated, and diabetes is increasingly common in low-income countries where tuberculosis (TB) is highly endemic. However, the role of diabetes for TB has not been assessed in populations where HIV is prevalent.
Methods: A case-control study was conducted in an urban population in Tanzania among culture-confirmed pulmonary TB patients and non-TB neighbourhood controls. Participants were tested for diabetes according to WHO guidelines and serum concentrations of acute phase reactants were measured. The association between diabetes and TB, and the role of HIV as an effect modifier, were examined using logistic regression. Since blood glucose levels increase during the acute phase response, we adjusted for elevated serum acute phase reactants.
Results: Among 803 cases and 350 controls the mean (SD) age was 34.8 (11.9) and 33.8 (12.0) years, and the prevalence of diabetes was 16.7\% (95\% CI: 14.2; 19.4) and 9.4\% (6.6; 13.0), respectively. Diabetes was associated with TB (OR 2.2, 95\% CI: 1.5; 3.4, p,0.001). However, the association depended on HIV status (interaction, p = 0.01) due to a stronger association among HIV uninfected (OR 4.2, 95\% CI: 1.5; 11.6, p = 0.01) compared to HIV infected (OR 0.1, 95\% CI: 0.01; 1.8, p = 0.13) after adjusting for age, sex, demographic factors and elevated serum acute phase reactants.
Conclusion: Diabetes is a risk factor for TB in HIV uninfected, whereas the association in HIV infected patients needs further study. The increasing diabetes prevalence may be a threat to TB control.},
	language = {en},
	number = {8},
	urldate = {2021-02-13},
	journal = {PLoS ONE},
	author = {Faurholt-Jepsen, Daniel and Range, Nyagosya and PrayGod, George and Jeremiah, Kidola and Faurholt-Jepsen, Maria and Aabye, Martine Grosos and Changalucha, John and Christensen, Dirk Lund and Pipper, Christian Bressen and Krarup, Henrik and Witte, Daniel Rinse and Andersen, Aase Bengaard and Friis, Henrik},
	editor = {Ahmed, Niyaz},
	month = aug,
	year = {2011},
	keywords = {Adult, Case-Control Studies, Risk Factors, Female, Male, Humans, Adolescent, Diabetes Complications, Diabetes Complications: epidemiology, Tanzania, Tuberculosis, Pulmonary, Diabetes Complications: virology, HIV-1, HIV-1: pathogenicity, HIV-2, HIV-2: pathogenicity, Tanzania: epidemiology, Tuberculosis, Pulmonary: epidemiology, Tuberculosis, Pulmonary: etiology, Tuberculosis, Pulmonary: virology},
	pages = {e24215},
	file = {Faurholt-Jepsen e.a. - 2011 - Diabetes Is a Risk Factor for Pulmonary Tuberculos.pdf:/Users/planetarium/Zotero/storage/38J7WKPK/Faurholt-Jepsen e.a. - 2011 - Diabetes Is a Risk Factor for Pulmonary Tuberculos.pdf:application/pdf},
