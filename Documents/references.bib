	journal = {Diabetes Care},
	author = {Sosenko, J M and Palmer, J P and Greenbaum, C J and Mahon, J and Cowie, C and Krischer, J P and Chase, H P and White, N H and Buckingham, B and Herold, K C and Cuthbertson, D and Skyler, J S},
	month = mar,
