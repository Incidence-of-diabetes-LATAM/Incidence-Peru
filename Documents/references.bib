	note = {Place: Division of Cardiology, Department of Internal Medicine, Buddhist Tzu Chi General Hospital, 2 Min-Sheng Road, Dalin, Chia-Yi, Taiwan, ROC. cllinmd@hcc.tcu.edu.tw},
	keywords = {blood, Blood Pressure, Cholesterol, Fasting, Glucose, Incidence, Lipids, Obesity, Risk, Sex, Triglycerides, Human, Comparative Study, drug effects, Endothelium,Vascular, pharmacology, Support,Non-U.S.Gov't, Body Weight, Hypertension, physiology, Risk Factors, Vascular Diseases, Blood Flow Velocity, Brachial Artery, Female, Male, Middle Age, Blood Glucose, Heart, Nitroglycerin, ultrasonography, Vasodilation, mortality, Cardiology, Family, history, Smoking, Vasodilator Agents, Diet, Calcium, Heart Rate, Urinalysis, Potassium, Supine Position, Taiwan, Diet,Vegetarian},
