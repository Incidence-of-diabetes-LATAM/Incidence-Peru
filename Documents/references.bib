	note = {Place: Division of Adult and Community Health, National Center for Chronic Disease Prevention and Health Promotion, Centers for Disease Control and Prevention, Atlanta, GA 30341, USA. eford@cdc.gov},
	keywords = {Adult, blood, Fasting, Glucose, Insulin, Insulin Resistance, Men, Research, Syndrome, Women, diagnosis, metabolism, Middle Aged, Aged, Female, Male, Disease, epidemiology, Humans, Blood Glucose, Metabolic Syndrome X, Sensitivity and Specificity, Predictive Value of Tests, Prevalence, Practice Guidelines, Chronic Disease, Osmolar Concentration, Health Promotion, Nutrition, Nutrition Surveys},
