@article{pasarica_infectobesity_2007-1,
	title = {Infectobesity: {Obesity} of {Infectious} {Origin}},
	volume = {52},
	issn = {0123737117},
	doi = {10.1016/S1043-4526(06)52002-9},
	abstract = {The rapid increase in obesity and the associated health care costs have prompted a search for better approaches for its prevention and management. Such efforts may be facilitated by better understanding the etiology of obesity. Of the several etiological factors, infection, an unusual causative factor, has recently started receiving greater attention. In the last two decades, 10 adipogenic pathogens were reported, including human and nonhuman viruses, scrapie agents, bacteria, and gut microflora. Some of these pathogens are associated with human obesity, but their causative role in human obesity has not been established. This chapter presents information about the natural hosts, signs and symptoms, and pathogenesis of the adipogenic microorganisms. If relevant to humans, "Infectobesity" would be a relatively novel, yet extremely significant concept. A new perspective about the infectious etiology of obesity may stimulate additional research to assess the contribution of hitherto unknown pathogens to human obesity and possibly to prevent or treat obesity of infectious origins. ?? 2006 Elsevier Inc. All rights reserved.},
	number = {06},
	journal = {Advances in Food and Nutrition Research},
	author = {Pasarica, Magdalena and Dhurandhar, Nikhil V.},
	year = {2007},
	pages = {61--102},
}

