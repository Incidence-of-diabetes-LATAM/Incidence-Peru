	keywords = {Adult, analysis, blood, Fasting, Insulin, Insulin Resistance, methods, Obesity, Research, Risk, Sex, physiology, Risk Factors, Disease, epidemiology, Humans, Longitudinal Studies, Public Health, Body Mass Index, complications, Arteries, Heart, Hyperinsulinism, Multivariate Analysis, mortality, Coronary Arteriosclerosis, history, Hand, Morbidity, genetics, Child, Research Support, Adipose Tissue, Adiposity, Hyperinsulinemia, Adolescent, Child,Preschool, Family Health, Louisiana, Parents},
