	note = {Place: Department of Medicine, University of Oulu, Finland},
	keywords = {Adult, Atherosclerosis, blood, Blood Pressure, Risk, Human, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, Risk Factors, Aged, Brachial Artery, Male, Middle Age, Disease, epidemiology, Arteries, Heart, Coronary Disease, Dilatation, ultrasonography, mortality, pathology, Tunica Intima, Tunica Media, Prevalence, Carotid Arteries, Compliance, Finland, anatomy \& histology, Sweden, Population Surveillance, Emigration and Immigration, Twins,Dizygotic, Twins,Monozygotic},
