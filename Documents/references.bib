	keywords = {blood, Human, drug effects, Support,Non-U.S.Gov't, United States, Aged, Brachial Artery, Female, Middle Age, therapeutic use, Arteries, ultrasonography, Vasodilation, mortality, Cardiology, Morbidity, Hyperemia, Double-Blind Method, Cross-Over Studies, Estrogen Replacement Therapy, Postmenopause, Estradiol, Sweden, Estrogens, Estrogens,Conjugated, Women's Health},
