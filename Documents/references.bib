	keywords = {Adult, Atherosclerosis, Risk, Human, Support,U.S.Gov't,P.H.S., Disease Progression, Risk Factors, Aged, Female, Middle Age, epidemiology, Time, Arteries, Heart, Follow-Up Studies, Arteriosclerosis, Sensitivity and Specificity, Coronary Arteriosclerosis, Calcinosis, radiography, Tomography,X-Ray Computed, Calcium, Aorta, Menopause},
