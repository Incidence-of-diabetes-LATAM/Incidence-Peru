	month = aug,
	year = {2003},
	note = {Place: Department of Epidemiology and Public Health, University College London, 1-19 Torrington Place, London WC1E 6BT, UK. kirsten.rennie@mrc-hnr.cam.ac.uk},
	keywords = {analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, methods, Odds Ratio, Pressure, Risk, Sex, Syndrome, Triglycerides, diagnosis, Middle Aged, physiology, Risk Factors, Aged, Female, Male, epidemiology, Humans, London, Public Health, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., Body Mass Index, Waist-Hip Ratio, Blood Glucose, Heart, Metabolic Syndrome X, prevention \& control, Body Constitution, Lipoproteins, Lipoproteins,HDL Cholesterol, Smoking, Cross-Sectional Studies, Exercise, Alcohol Drinking, Chi-Square Distribution, Heart Rate, Systole, Physical Endurance},
