	note = {Place: London Health Sciences Centre, London, Canada. malcolm.arnold@lhsc.on.ca},
	keywords = {Incidence, methods, Pressure, Risk, diagnosis, Support,Non-U.S.Gov't, Cardiovascular Diseases, Hypertension, drug therapy, therapeutic use, Disease, epidemiology, London, Canada, complications, Multicenter Studies, Myocardial Infarction, 10, Heart, prevention \& control, Follow-Up Studies, Coronary Disease, Double-Blind Method, Hospitalization, Death, Treatment Outcome, Enzyme Inhibitors, Angiotensin-Converting Enzyme Inhibitors, Ramipril, Heart Failure,Congestive},
