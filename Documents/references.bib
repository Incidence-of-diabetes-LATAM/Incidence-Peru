	note = {Place: Department of Clinical Neurophysiology, University Hospital of Linkoping, Sweden},
	keywords = {Adult, analysis, blood, Glucose, Insulin, Risk, Diabetic Neuropathies, diagnosis, Human, therapy, Comparative Study, metabolism, Support,Non-U.S.Gov't, Body Weight, Case-Control Studies, physiology, physiopathology, Risk Factors, Female, Male, Disease, Blood Glucose, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Regression Analysis, Child, Age of Onset, Hemoglobin A,Glycosylated, Adolescent, C-Peptide, Sweden, Neural Conduction, Median Nerve, Peroneal Nerve, Sural Nerve, Laterality, Motor Neurons, Neurons,Afferent, Patient Dropouts},
