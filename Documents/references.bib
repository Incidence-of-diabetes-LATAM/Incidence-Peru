@article{altan_new_2016,
	title = {A new approach to early diagnosis of congestive heart failure disease by using {Hilbert}–{Huang} transform},
	volume = {137},
	issn = {01692607},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0169260715301899},
	doi = {10.1016/j.cmpb.2016.09.003},
	abstract = {Congestive heart failure (CHF) is a degree of cardiac disease occurring as a result of the heart’s inability to pump enough blood for the human body. In recent studies, coronary artery disease (CAD) is accepted as the most important cause of CHF. This study focuses on the diagnosis of both the CHF and the CAD. The Hilbert–Huang transform (HHT), which is effective on nonlinear and non-stationary signals, is used to extract the features from R-R intervals obtained from the raw electrocardiogram data. The statistical features are extracted from instinct mode functions that are obtained applying the HHT to R-R intervals. Classiﬁcation performance is examined with extracted statistical features using a multilayer perceptron neural network. The designed model classiﬁed the CHF, the CAD patients and a normal control group with rates of 97.83\%, 93.79\% and 100\%, accuracy, speciﬁcity and sensitivity, respectively. Also, early diagnosis of the CHF was performed by interpretation of the CAD with a classiﬁcation accuracy rate of 97.53\%, speciﬁcity of 98.18\% and sensitivity of 97.13\%. As a result, a single system having the ability of both diagnosis and early diagnosis of CHF is performed by integrating the CAD diagnosis method to the CHF diagnosis method.},
	language = {en},
	urldate = {2021-02-13},
	journal = {Computer Methods and Programs in Biomedicine},
	author = {Altan, Gokhan and Kutlu, Yakup and Allahverdi, Novruz},
	month = dec,
	year = {2016},
	keywords = {Coronary artery disease, Congestive heart failure, ECG, Hilbert–Huang transform, HRV, Multilayer perceptron},
	pages = {23--34},
	file = {Altan e.a. - 2016 - A new approach to early diagnosis of congestive he.pdf:/Users/planetarium/Zotero/storage/MLHVKF3U/Altan e.a. - 2016 - A new approach to early diagnosis of congestive he.pdf:application/pdf;Altan e.a. - 2016 - A new approach to early diagnosis of congestive he.pdf:/Users/planetarium/Zotero/storage/9EVXXJDR/Altan e.a. - 2016 - A new approach to early diagnosis of congestive he.pdf:application/pdf},
