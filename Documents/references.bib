}

@article{dupuis_cholesterol_1999,
	title = {Cholesterol reduction rapidly improves endothelial function after acute coronary syndromes. {The} {RECIFE} (reduction of cholesterol in ischemia and function of the endothelium) trial},
	volume = {99},
	abstract = {BACKGROUND: Cholesterol lowering reduces coronary events. One mechanism could be improvement of endothelial function. In line with this hypothesis, this study investigates whether cholesterol reduction can result in rapid improvement of endothelial function after acute coronary syndromes. METHODS AND RESULTS: Patients with acute myocardial infarction or unstable angina and total cholesterol levels at admission {\textgreater}/=5.2 mmol/L or LDL {\textgreater}/=3.4 mmol/L were randomized to placebo (n=30) or pravastatin 40 mg daily (n=30) for 6 weeks. Brachial ultrasound was used to measure endothelium-dependent flow-mediated dilatation (FMD) and response to endothelium-independent nitroglycerin. Changes in the levels of markers of platelet activation, coagulation factors, and plasma endothelin levels were also assessed. Total and LDL cholesterol levels were similar at admission and before randomization in both groups. With pravastatin, but not with placebo, they decreased by 23\% (P{\textless}0.05) and 33\% (P{\textless}0.01), respectively. FMD was unchanged with placebo, 5.43+/-0.74\% (mean+/-SEM) to 5.84+/-0.81\%, but increased with pravastatin, 4.93+/-0.81\% to 7.0+/-0.79\% (P=0.02), representing a 42\% relative increase. Responses to nitroglycerin were similar during the time course of the study in the 2 groups. Markers of platelet activity, coagulation factors, and endothelin levels were not affected by pravastatin. CONCLUSIONS: Cholesterol reduction with pravastatin initiated early after acute coronary syndromes rapidly improves endothelial function after 6 weeks of therapy},
	number = {1524-4539 LA - eng PT - Clinical Trial PT - Journal Article PT - Randomized Controlled Trial},
	journal = {Circulation},
	author = {Dupuis, J and Tardif, J C and Cernacek, P and Theroux, P},
	month = jun,
	year = {1999},
	note = {Place: Department of Medicine and Research Centre, Montreal Heart Institute, Montreal, Quebec, Canada. dupuisj@icm.umontrea.ca},
	keywords = {blood, Blood Pressure, Cholesterol, Lipids, methods, Syndrome, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, Ischemia, physiopathology, Brachial Artery, Female, Male, Middle Age, therapeutic use, Confounding Factors (Epidemiology), complications, etiology, Myocardial Infarction, Coronary Disease, Nitroglycerin, ultrasonography, Vasodilation, Double-Blind Method, Anticholesteremic Agents, Heart Rate, Endothelins, Pravastatin, Stroke Volume},
