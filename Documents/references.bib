@article{nicklett_diabetes-related_2010,
	title = {Diabetes-{Related} {Support}, {Regimen} {Adherence}, and {Health} {Decline} {Among} {Older} {Adults}},
	volume = {65B},
	issn = {1079-5014, 1758-5368},
	url = {https://academic.oup.com/psychsocgerontology/article-lookup/doi/10.1093/geronb/gbp050},
	doi = {10.1093/geronb/gbp050},
	abstract = {Objectives.  Social support is generally conceptualized as health promoting; however, there is little consensus regarding the mechanisms through which support is protective. Illness support has been proposed to promote regimen adherence and subsequent prevention of health decline. We hypothesize that (a) support for regimen adherence is negatively associated with self-reported health decline among older diabetic adults and that (b) regimen adherence is negatively associated with health decline among older diabetic adults.
Methods.  We used the Health and Retirement Study data on individuals over the age of 60 years with type 2 diabetes mellitus (n = 1,788), examining change in self-reported health status over a 2-year period using binomial and cumulative ordinal logistic regression models.
Results.  Diabetic support is not significantly associated with health decline, but it is strongly associated with adherence to health-promoting activities consisting of a diabetic regimen. Therefore, the extent to which one receives illness support for a given regimen component is highly positively associated with adhering to that component, although this adherence does not necessarily translate into protection against perceived decline in health.
Conclusions. Illness-related support appears to be a mechanism through which social support matters in the diabetic population. Although this relationship did not extend to prevention of health status decline among diabetics, the relationship between support and illness management is promising.},
	language = {en},
	number = {3},
	urldate = {2021-02-14},
	journal = {The Journals of Gerontology Series B: Psychological Sciences and Social Sciences},
	author = {Nicklett, E. J. and Liang, J.},
	month = may,
	year = {2010},
	keywords = {Type 2 diabetes, Social support, Chronic illness, Health determinants, Medical regimens, Patient adherence, Self-care, Self-rated health},
	pages = {390--399},
	file = {Nicklett en Liang - 2010 - Diabetes-Related Support, Regimen Adherence, and H.pdf:/Users/planetarium/Zotero/storage/XEAR8SZY/Nicklett en Liang - 2010 - Diabetes-Related Support, Regimen Adherence, and H.pdf:application/pdf},
