	note = {Place: Immunology and Hematology Research Laboratory, Department of Anesthesiology, Rabin Medical Center, Hasharon Hospital, Petah Tiqva, Israel. hannab@clalit.org.il},
	keywords = {blood, Incidence, Men, Research, Sex, Women, Cytokines, Alleles, Female, Male, Disease, Humans, Sex Characteristics, Israel, genetics, Genotype, immunology, Homozygote, Laboratories, Pain, Interleukin 1 Receptor Antagonist Protein, Interleukin-1, Interleukin-1beta, Gene Frequency, Polymorphism,Genetic, Autoimmune Diseases, Heterozygote, Perception},
