	pages = {c1693--c1693},
	file = {Chamnan e.a. - 2010 - Estimating the population impact of screening stra.pdf:/Users/planetarium/Zotero/storage/3AGM3G9C/Chamnan e.a. - 2010 - Estimating the population impact of screening stra.pdf:application/pdf;Chamnan e.a. - 2010 - Estimating the population impact of screening stra.pdf:/Users/planetarium/Zotero/storage/UWCXKL87/Chamnan e.a. - 2010 - Estimating the population impact of screening stra.pdf:application/pdf},
