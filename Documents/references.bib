	keywords = {Adult, analysis, blood, Blood Pressure, Fasting, Glucose, Insulin, Obesity, Risk, Triglycerides, Human, Endothelium,Vascular, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, Cardiovascular Diseases, Hypertension, Inflammation, physiopathology, Risk Factors, administration \& dosage, Brachial Artery, Female, Male, Body Mass Index, etiology, Arteries, Body Constitution, Lipoproteins, Vasodilation, C-Reactive Protein, Fatty Acids, Lipoproteins,LDL, Dietary Fats, Postprandial Period, Fatty Acids,Nonesterified},
