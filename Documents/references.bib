	note = {Place: Diabetes and Genetic Epidemiology Unit, Department of Epidemiology and Health Promotion, National Public Health Institute, Kytosuontie 11, KTL/GE-Lab, FIN-00300 Helsinki, Finland. jianjun.wang@ktl.fi},
