	journal = {Atherosclerosis},
	author = {Turban, S and Fuentes, F and Ferlic, L and Brugada, R and Gotto, A M and Ballantyne, C M and Marian, A J},
	month = feb,
	year = {2001},
	note = {Place: Department of Medicine, Sections of Cardiology and Atherosclerosis, Baylor College of Medicine, Houston, TX 77030, USA},
	keywords = {Atherosclerosis, blood, Fasting, Lipids, Risk, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Case-Control Studies, Middle Aged, Disease Progression, physiology, physiopathology, Aged, drug therapy, Female, Male, therapeutic use, Disease, Arteries, Lipoproteins, Plasma, Prospective Studies, Cardiology, Coronary Angiography, Coronary Arteriosclerosis, Fatty Acids, radiography, genetics, Esterases, Genotype, Polymerase Chain Reaction, Polymorphism (Genetics), Cohort Studies, Anticholesteremic Agents, Aryldialkylphosphatase, Fatty Acids,Monounsaturated, Indoles, Severity of Illness Index, Codon},
