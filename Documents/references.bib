	note = {Place: Genetic Epidemiology Unit, Department of Epidemiology and Biostatistics, Department of Clinical Genetics, Erasmus Medical Center Rotterdam, Rotterdam, the Netherlands},
	keywords = {Insulin, Human, Support,Non-U.S.Gov't, Alleles, epidemiology, Diabetes Mellitus,Insulin-Dependent, Netherlands, genetics, Genotype, HLA-DR Antigens, Genetic Predisposition to Disease, Genome, Linkage Disequilibrium, Genetic Markers, HLA-DQ Antigens, Genetic Heterogeneity, Pedigree, Chromosomes,Human,Pair 11, Chromosomes,Human,Pair 17, Chromosomes,Human,Pair 6, Chromosomes,Human,Pair 8},
