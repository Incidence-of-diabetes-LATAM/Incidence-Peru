	note = {Place: Queen Elizabeth II Hospital, East and North Herts NHS Trust, Welwyn Garden City, UK. peter.winocour@qeii.enherts-tr.nhs.uk},
	keywords = {methods, Risk, Triglycerides, Human, therapy, Risk Factors, therapeutic use, complications, Diabetes Mellitus, Risk Assessment, mortality, Predictive Value of Tests, Morbidity, Diabetic Angiopathies, Cities, Antilipemic Agents},
	pages = {515--527},
