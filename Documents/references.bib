	note = {Place: Department of Internal Medicine, University of Innsbruck, Anichstrasse 35, 6020, Innsbruck, Austria. hannes.gaenzer@uibk.ac.at},
	keywords = {Adult, Atherosclerosis, blood, Fasting, Glucose, Insulin, Human, therapy, drug effects, Endothelium,Vascular, metabolism, pharmacology, Support,Non-U.S.Gov't, United States, physiopathology, Aged, Brachial Artery, drug therapy, Female, Male, Middle Age, therapeutic use, Arteries, Blood Glucose, Hypoglycemic Agents, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, ultrasonography, Vasodilation, pathology, C-Reactive Protein, Diet, Ultrasonography,Interventional, Metformin},
