	author = {Abbott, J. Dawn and Lombardero, Manuel S. and Barsness, Gregory W. and Pena-Sing, Ivan and Buitrón, L. Virginia and Singh, Premranjan and Woodhead, Gail and Tardif, Jean-Claude and Kelsey, Sheryl F.},
	month = oct,
