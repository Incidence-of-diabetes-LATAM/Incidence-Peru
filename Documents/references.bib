@article{evans_ciprofibrate_2000,
	title = {Ciprofibrate therapy improves endothelial function and reduces postprandial lipemia and oxidative stress in type 2 diabetes mellitus},
	volume = {101},
	abstract = {BACKGROUND: Exaggerated postprandial lipemia (PPL) is a factor in atherogenesis, involving endothelial dysfunction and enhanced oxidative stress. We examined the effect of ciprofibrate therapy on these parameters in type 2 diabetes mellitus. METHODS AND RESULTS: Twenty patients entered a 3-month, double-blind, placebo-controlled study. Each subject was studied fasting and after a fatty meal, at baseline, and after 3 months of treatment. Glucose and lipid profiles were measured over an 8-hour postprandial period. Endothelial function (flow-mediated endothelium-dependent vasodilatation [FMD]) and oxidative stress (electron paramagnetic resonance spectroscopy) were measured after fasting and 4 hours postprandially. At baseline, both groups exhibited similar PPL and deterioration in endothelial function. After ciprofibrate, fasting and postprandial FMD values were significantly higher (from 3.8+/-1. 8\% and 1.8+/-1.3\% to 4.8+/-1.1\% and 3.4+/-1.1\%; P{\textless}0.05). This was mirrored by a fall in fasting and postprandial triglycerides (3. 1+/-2.1 and 6.6+/-4.1 mmol/L to 1.5+/-0.8 and 2.8+/-1.3 mmol/L, P{\textless}0. 05). Fasting and postprandial HDL cholesterol was also elevated (0. 9+/-0.1 and 0.8+/-0.1 mmol/L and 1.2+/-0.2 and 1.2+/-0.1 mmol/L, P{\textless}0. 05). There were no changes in total or LDL cholesterol. Fasting and postprandial triglyceride enrichment of all lipoproteins was attenuated, with cholesterol depletion of VLDL and enrichment of HDL. There were similar postprandial increases in oxidative stress in both groups at baseline, which was significantly attenuated by ciprofibrate (0.3+/-0.6 versus 1.5+/-1.1 U, P{\textless}0.05). CONCLUSIONS: This study demonstrates that fibrate therapy improves fasting and postprandial endothelial function in type 2 diabetes. Attenuation of PPL and the associated oxidative stress, with increased HDL cholesterol levels, may be important},
	number = {1524-4539 LA - eng PT - Clinical Trial PT - Journal Article PT - Randomized Controlled Trial},
	journal = {Circulation},
	author = {Evans, M and Anderson, R A and Graham, J and Ellis, G R and Morris, K and Davies, S and Jackson, S K and Lewis, M J and Frenneaux, M P and Rees, A},
	month = apr,
	year = {2000},
	note = {Place: Cardiovascular Sciences Research Group, University Hospital of Wales, Cardiff, UK. morgancl@cf.ac.uk},
	keywords = {Adult, blood, Cholesterol, Fasting, Glucose, Lipids, methods, Research, Triglycerides, Human, therapy, drug effects, Endothelium,Vascular, United States, physiopathology, drug therapy, Female, Male, Middle Age, Oxidative Stress, therapeutic use, Lipoproteins, Lipoproteins,HDL Cholesterol, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Wales, analogs \& derivatives, Stress, Double-Blind Method, Analysis of Variance, Postprandial Period, Area Under Curve, Antilipemic Agents, Clofibric Acid},
	pages = {1773--1779},
	annote = {UI - 20233805},
}

@article{anan_correlations_2008,
	title = {Correlations of visceral fat accumulation and atherosclerosis in {Japanese} patients with type 2 diabetes mellitus},
	volume = {57},
	abstract = {We tested the hypothesis that increased abdominal visceral fat accumulation (VFA) is associated with insulin resistance and aortic stiffness in patients with type 2 diabetes mellitus not receiving insulin treatment. The study consisted of 22 Japanese patients with type 2 diabetes mellitus and high VFA ({\textgreater}/=100 cm(2); age, 61 +/- 7 years; high VFA group) and a control group of 18 age-matched patients with normal VFA ({\textless}100 cm(2); age, 60 +/- 8 years; normal VFA group). Brachial-ankle pulse wave velocity (BaPWV) was measured by automatic oscillometric method. The BaPWV was used as an index of atherosclerosis. The body mass index values (P {\textless} .05), waist circumferences (P {\textless} .0005), and waist-to-hip ratios (P {\textless} .05) were larger in the high VFA group than in the normal VFA group. The BaPWV was higher in the high VFA group than in the normal VFA group (P {\textless} .0001). Fasting plasma glucose (P {\textless} .05), insulin concentrations (P {\textless} .0001), and the homeostasis model assessment (HOMA) index (P {\textless} .001) were higher in the high VFA group than in the normal VFA group. Multiple regression analysis showed that the VFA level was independently predicted by BaPWV and the HOMA index. Our results indicate that the elevation of VFA in Japanese patients with type 2 diabetes mellitus is characterized by increased aortic stiffness and insulin resistance and that BaPWV and the HOMA index are independent predictors of VFA},
	number = {0026-0495 (Print) LA - eng PT - Journal Article SB - IM},
	journal = {Metabolism},
	author = {Anan, F and Masaki, T and Umeno, Y and Iwao, T and Yonemochi, H and Eshima, N and Saikawa, T and Yoshimatsu, H},
	month = feb,
	year = {2008},
	note = {Place: Department of Cardiology, Oita Red Cross Hospital, Oita 870-0033, Japan; First Department of Internal Medicine, School of Medicine, Oita University Oita 870-0033, Japan},
	keywords = {analysis, Atherosclerosis, Fasting, Glucose, Insulin, Insulin Resistance, Body Mass Index, Plasma, Diabetes Mellitus, Japan, Regression Analysis, Cardiology, Homeostasis, Pulse},
	pages = {280--284},
	annote = {DA - 20080114},
}

@article{leiter_diabetes_2001,
	title = {Diabetes {Screening} in {Canada} ({DIASCAN}) {Study}: prevalence of undiagnosed diabetes and glucose intolerance in family physician offices},
	volume = {24},
	abstract = {OBJECTIVE--To assess the prevalence of undiagnosed diabetes and glucose intolerance in individuals {\textgreater} or =40 years of age who contacted their family physician for routine care. RESEARCH DESIGN AND METHODS--The study used a stratified randomized selection of family physicians across Canada that was proportional to provincial and urban/rural populations based on Statistics Canada Census data (1996). Consecutive patients {\textgreater} or =40 years of age were screened for diabetes. If a casual fingerprick blood glucose was {\textgreater}5.5 mmol/l, the patient returned for a fasting venous blood glucose test. If the fasting blood glucose was 6.1-6.9 mmol/l, a 2-h 75-g post-glucose load venous blood glucose was obtained. Results of these tests were used to classify patients in diagnostic categories. RESULTS--Data were available for 9,042 patients. Previously undiagnosed diabetes was discovered in 2.2\% of the patients, and new glucose intolerance was found in an additional 3.5\% of patients. Overall, 16.4\% of patients had previously known diabetes. The decrease in fasting plasma glucose criterion from 7.8 to 7.0 mmol/l resulted in a 2.2\% versus a 1.6\% prevalence of new diabetes. Several risk factors were reported in a significantly greater proportion of patients with new glucose intolerance and either new and known diabetes compared with the normal glucose tolerance group of patients. CONCLUSIONS--Routine screening for diabetes by family physicians is justified in patients {\textgreater} or =40 years of age, given the finding of previously undiagnosed diabetes in 2.2\% of these patients and newly diagnosed glucose intolerance in an additional 3.5\% of these patients. Another 16.4\% of primary care patients {\textgreater} or =40 years of age have known diabetes. This has important implications regarding health resources and physician education},
	number = {0149-5992 LA - eng PT - Journal Article RN - 0 (Blood Glucose) RN - 0 (Lipoproteins, HDL Cholesterol) RN - 0 (Triglycerides) SB - IM},
	journal = {Diabetes Care},
	author = {Leiter, L A and Barr, A and Belanger, A and Lubin, S and Ross, S A and Tildesley, H D and Fontaine, N},
	month = jun,
	year = {2001},
	note = {Place: St. Michael's Hospital and University of Toronto, 61 Queen St. E., M4V 2L5 Toronto, Ontario, Canada. leiter@smh.toronto.on.ca},
	keywords = {Adult, analysis, blood, Cholesterol, Fasting, Glucose, Research, Research Design, Risk, Triglycerides, diagnosis, Human, Hypertension, Risk Factors, Female, Male, epidemiology, Canada, Blood Glucose, Lipoproteins, Lipoproteins,HDL Cholesterol, Plasma, Diabetes Mellitus, Family, Pregnancy, Prevalence, Reproducibility of Results, Glucose Intolerance, Glucose Tolerance Test, Statistics, statistics \& numerical data, Ontario, Random Allocation, False Negative Reactions, Rural Population, Urban Population, Heart Diseases, Family Practice, Diagnostic Errors, Diabetes,Gestational, Physicians,Family},
