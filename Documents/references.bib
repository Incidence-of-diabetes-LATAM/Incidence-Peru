	keywords = {blood, Glucose, Insulin, Insulin Resistance, drug effects, metabolism, pharmacology, Middle Aged, physiology, Female, Male, Humans, Research Support,U.S.Gov't,P.H.S., Body Mass Index, Blood Glucose, Diabetes Mellitus,Type 2, Diabetes Mellitus, Sex Factors, Adipose Tissue, Adiposity, Glucose Clamp Technique, Magnetic Resonance Imaging, Body Composition, Liver, Research Support,U.S.Gov't,Non-P.H.S., Abdomen, Texas},
