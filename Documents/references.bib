	keywords = {Adult, Incidence, Human, United States, physiopathology, Prospective Studies, Regression Analysis, Death, Death Certificates, Circadian Rhythm, Heart Arrest, Electrocardiography, Ambulatory Care, Urban Population, Death,Sudden},
	pages = {2935--2937},
	annote = {UI - 92260709},
}

@article{wright_acute_2002,
	title = {Acute myocardial infarction and renal dysfunction: a high-risk combination},
	volume = {137},
	abstract = {BACKGROUND: Survival is poor in patients with acute myocardial infarction (MI) who also have severe renal disease. Less is known about the outcome of acute MI in patients with mild to moderate renal insufficiency. OBJECTIVE: To compare outcomes after acute MI in patients with varying levels of renal disease and in patients without renal failure. DESIGN: Retrospective cohort study. SETTING: Academic medical center. PATIENTS: 3106 total patients admitted with acute MI and end-stage renal disease (n = 44), severe renal insufficiency (creatinine clearance {\textless} 0.59 mL/s [{\textless}35 mL/min]) (n = 391), moderate renal dysfunction (creatinine clearance {\textgreater} or = 0.59 mL/s [{\textless}35 mL/min] but {\textless} or =0.84 mL/s [{\textless} or =50 mL/min]) (n = 491), mild chronic renal insufficiency (creatinine clearance {\textgreater} 0.84 mL/s [{\textgreater}50 mL/min] but {\textless} or =1.25 mL/s [{\textless} or =75 mL/min]) (n = 860), or no renal disease (n = 1320). MEASUREMENTS: Clinical characteristics, treatment strategies, and short- and long-term survival were compared after patients were stratified by creatinine clearance. RESULTS: In-hospital mortality rates were 2\% in patients with normal renal function, 6\% in those with mild renal failure, 14\% in those with moderate renal failure, 21\% in those with severe renal failure, and 30\% in those with end-stage renal disease (P {\textless} 0.001). Compared with patients without renal disease, similar adjusted trends were present for postdischarge death in patients with end-stage renal disease (hazard ratio, 5.4 [95\% CI, 3.0 to 9.7]; P {\textless} 0.001), severe renal insufficiency (hazard ratio, 1.9 [CI, 1.2 to 3.0]; P = 0.006), moderate renal dysfunction (hazard ratio, 2.2 [CI, 1.5 to 3.3]; P {\textless} 0.001), and mild chronic renal insufficiency (hazard ratio, 2.4 [CI, 1.7 to 3.3]; P {\textless} 0.001). Patients with renal failure received adjunctive and reperfusion therapies less frequently than those with normal renal function (P {\textless} 0.001). Postdischarge death was less likely in patients who received acute reperfusion therapy (odds ratio, 0.7 [CI, 0.6 to 0.9]), aspirin (odds ratio, 0.7 [CI, 0.5 to 0.8]), and beta-blocker therapy (odds ratio, 0.7 [CI, 0.6 to 0.9]). CONCLUSION: Patients with renal failure are at increased risk for death after acute MI and receive less aggressive treatment than patients with normal renal function},
	number = {1539-3704 LA - eng PT - Journal Article RN - 0 (Adrenergic beta-Antagonists) RN - 0 (Angiotensin-Converting Enzyme Inhibitors) RN - 50-78-2 (Aspirin) RN - 60-27-5 (Creatinine) RN - 9005-49-6 (Heparin) SB - AIM SB - IM},
	journal = {Ann.Intern.Med.},
	author = {Wright, R S and Reeder, G S and Herzog, C A and Albright, R C and Williams, B A and Dvorak, D L and Miller, W L and Murphy, J G and Kopecky, S L and Jaffe, A S},
	month = oct,
