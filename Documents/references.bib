	note = {Place: Department of Surgical Sciences, Section of Clinical Physiology, Karolinska Hospital, Stockholm, Sweden},
	keywords = {Adult, blood, Blood Pressure, Glucose, Insulin, Human, drug effects, Endothelium,Vascular, metabolism, pharmacology, Support,Non-U.S.Gov't, physiology, physiopathology, Brachial Artery, Female, Male, Arteries, Blood Glucose, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Dilatation, Vasodilation, England, Regional Blood Flow, blood supply, Echocardiography, Forearm, Hemodynamics, Heart Rate, C-Peptide, Sweden, Echocardiography,Doppler},
