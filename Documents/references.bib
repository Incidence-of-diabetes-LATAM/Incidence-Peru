	keywords = {analysis, blood, Glucose, methods, Odds Ratio, Syndrome, Human, Comparative Study, Middle Aged, drug therapy, Female, Male, therapeutic use, Time Factors, London, etiology, Multicenter Studies, Blood Glucose, Coronary Disease, Multivariate Analysis, Plasma, Prospective Studies, Cardiology, Chest Pain, Prevalence, Stress, Hospitalization, Cohort Studies, Diabetic Angiopathies, Acute Disease, Adrenergic beta-Antagonists, Pain, Potassium, Hypokalemia},
