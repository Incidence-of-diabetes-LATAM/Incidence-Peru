	keywords = {blood, Risk, Endothelium, metabolism, Cardiovascular Diseases, Hypercholesterolemia, physiopathology, Risk Factors, Hyperhomocysteinemia, Disease, Humans, Arteries, Heart, Diabetes Mellitus, pathology, Biological Markers, Primary Prevention, von Willebrand Factor, Animals, France, Thrombomodulin, Signal Transduction, Endothelial Cells},
	pages = {33--47},
