	note = {Place: Department of Cardiology, Guy's, King's \& St Thomas' School of Medicine, King's College, London, UK. stephen.wheatcroft@kcl.ac.uk},
	keywords = {Atherosclerosis, blood, Insulin, Insulin Resistance, methods, Risk, Syndrome, Human, therapy, Cytokines, Endothelium, Endothelium,Vascular, Nitric Oxide, Support,Non-U.S.Gov't, Animal, physiopathology, drug therapy, Disease, London, etiology, secretion, Arteriosclerosis, Diabetes Mellitus,Non-Insulin-Dependent, Cardiology, Homeostasis, Stress, abnormalities, Diabetic Angiopathies, Adipose Tissue, Hyperinsulinemia, Endothelins, Review Literature, Renin-Angiotensin System, Hormones},
