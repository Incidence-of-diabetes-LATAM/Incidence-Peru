	note = {Place: EURODIAB, Department of Epidemiology and Public Health, University College, London, UK. harry@public-health.ucl.ac.uk},
	keywords = {analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Incidence, methods, Pressure, Risk, Triglycerides, Human, Cardiovascular Diseases, Risk Factors, Female, Male, Disease, epidemiology, London, complications, Myocardial Infarction, Blood Glucose, Multivariate Analysis, Plasma, Diabetes Mellitus,Insulin-Dependent, 12, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, mortality, Smoking, World Health Organization, Morbidity, Sex Factors, Death, Cohort Studies, Diabetic Angiopathies, Cerebrovascular Accident, International Cooperation, Proteinuria},
