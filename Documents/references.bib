	note = {Place: Internal Medicine Department, Ciutat Santiaria I Universitaria de Bellvitge, Barcelona, Spain. jfmeco@csub.scs.es},
	keywords = {Cholesterol, Risk, Triglycerides, Human, therapy, drug effects, Endothelium, Endothelium,Vascular, pharmacology, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, physiopathology, Aged, Brachial Artery, drug therapy, Male, Middle Age, therapeutic use, Arteries, Dilatation, Statistics,Nonparametric, Vasodilation, Coronary Arteriosclerosis, Hyperemia, Fibrinogen, Antilipemic Agents, Bezafibrate, Tangier Disease},
