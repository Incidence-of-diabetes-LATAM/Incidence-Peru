}

@article{obyrne_nitric_2000,
	title = {Nitric oxide synthesis and isoprostane production in subjects with type 1 diabetes and normal urinary albumin excretion},
	volume = {49},
	abstract = {The role of nitric oxide (NO) and free radicals in the development of microvascular disease in type 1 diabetes remains unclear. We have measured NO and isoprostane (a stable marker of in vivo lipid peroxidation) production in 13 type 1 diabetic subjects with normal urinary albumin excretion and 13 healthy volunteers. Whole-body NO synthesis was quantified by measuring the urinary excretion of 15N-nitrate after the intravenous administration of L-[15N]2-arginine. The urinary excretion of the major urinary metabolite of 15-F2t-isoprostane (8-iso-prostaglandin-F2alpha), 2,3-dinor-5,6-dihydro-F2t-IsoP, was quantified as a marker of in vivo lipid peroxidation. Whole-body NO synthesis was significantly higher in diabetic subjects compared with control subjects (342 vs. 216 nmol 15N-nitrate/mmol creatinine [95\% CI of the difference 45-207], P = 0.005). This increase was not explained by a difference in renal function between the 2 groups. There was no difference in 2,3-dinor-5,6-dihydro-F2t-IsoP excretion between diabetic subjects and control subjects (44.8+/-7.8 vs. 41.4+/-10.0 ng/mmol creatinine, mean +/- 95\% CI). However, there was an inverse correlation between NO synthesis and free radical activity in subjects with diabetes (r = -0.62, P = 0.012) that was not observed in control subjects (r = 0.37, P = 0.107). We conclude that whole-body NO synthesis is higher in type 1 diabetic subjects with normal urinary albumin excretion than in control subjects. The inverse correlation between isoprostane production and NO synthesis in diabetic subjects is consistent with the hypothesis that NO is being inactivated by reactive oxygen species},
	number = {0012-1797 LA - eng PT - Journal Article RN - 0 (2,3-dinor-5,6-dihydro-8-iso-prostaglandin F2(alpha)) RN - 0 (Nitrates) RN - 0 (Reactive Oxygen Species) RN - 10102-43-9 (Nitric Oxide) RN - 551-11-1 (Dinoprost) RN - 60-27-5 (Creatinine) SB - AIM SB - IM},
	journal = {Diabetes},
	author = {O'Byrne, S and Forte, P and Roberts, L J and Morrow, J D and Johnston, A and Anggard, E and Leslie, R D and Benjamin, N},
	month = may,
	year = {2000},
	note = {Place: Department of Clinical Pharmacology, St Bartholomew's and the Royal London School of Medicine and Dentistry, Charterhouse Square, UK. s.r.o'byrne@mds.qmw.ac.uk},
	keywords = {Adult, Human, biosynthesis, Lipid Peroxidation, metabolism, Nitric Oxide, pharmacology, Reactive Oxygen Species, Middle Aged, Female, Male, Disease, London, Reference Values, Diabetes Mellitus,Type I, analogs \& derivatives, Sex Characteristics, Creatinine, Albuminuria, urine, Oxygen, Nitrates, Free Radicals, Dinoprost},
