@article{yamauchi_genome-wide_2010,
	title = {A genome-wide association study in the {Japanese} population identifies susceptibility loci for type 2 diabetes at {UBE2E2} and {C2CD4A}-{C2CD4B}.},
	volume = {42},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/20818381},
	abstract = {We conducted a genome-wide association study of type 2 diabetes (T2D) using 459,359 SNPs in a Japanese population with a three-stage study design (stage 1, 4,470 cases and 3,071 controls; stage 2, 2,886 cases and 3,087 controls; stage 3, 3,622 cases and 2,356 controls). We identified new associations in UBE2E2 on chromosome 3 and in C2CD4A-C2CD4B on chromosome 15 at genome-wide significant levels (rs7612463 in UBE2E2, combined P = 2.27 × 10⁻⁹; rs7172432 in C2CD4A-C2CD4B, combined P = 3.66 × 10⁻⁹). The association of these two loci with T2D was replicated in other east Asian populations. In the European populations, the C2CD4A-C2CD4B locus was significantly associated with T2D, and a combined analysis of all populations gave P = 8.78 × 10⁻¹⁴, whereas the UBE2E2 locus did not show association to T2D. In conclusion, we identified two new loci at UBE2E2 and C2CD4A-C2CD4B associated with susceptibility to T2D.},
	number = {10},
	journal = {Nature genetics},
	author = {Yamauchi, Toshimasa and Hara, Kazuo and Maeda, Shiro and Yasuda, Kazuki and Takahashi, Atsushi and Horikoshi, Momoko and Nakamura, Masahiro and Fujita, Hayato and Grarup, Niels and Cauchi, Stephane and Ng, Daniel P K and Ma, Ronald C W and Tsunoda, Tatsuhiko and Kubo, Michiaki and Watada, Hirotaka and Maegawa, Hiroshi and Okada-Iwabu, Miki and Iwabu, Masato and Shojima, Nobuhiro and Shin, Hyoung Doo and Andersen, Gitte and Witte, Daniel R and Jørgensen, Torben and Lauritzen, Torsten and Sandbæk, Annelli and Hansen, Torben and Ohshige, Toshihiko and Omori, Shintaro and Saito, Ikuo and Kaku, Kohei and Hirose, Hiroshi and So, Wing-Yee and Beury, Delphine and Chan, Juliana C N and Park, Kyong Soo and Tai, E Shyong and Ito, Chikako and Tanaka, Yasushi and Kashiwagi, Atsunori and Kawamori, Ryuzo and Kasuga, Masato and Froguel, Philippe and Pedersen, Oluf and Kamatani, Naoyuki and Nakamura, Yusuke and Kadowaki, Takashi},
