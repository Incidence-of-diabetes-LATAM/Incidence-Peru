@article{stark_casagrande_prevalence_2013,
	title = {The {Prevalence} of {Meeting} {A1C}, {Blood} {Pressure}, and {LDL} {Goals} {Among} {People} {With} {Diabetes}, 1988-2010},
	volume = {36},
	issn = {0149-5992, 1935-5548},
	url = {http://care.diabetesjournals.org/cgi/doi/10.2337/dc12-2258},
	doi = {10.2337/dc12-2258},
	abstract = {OBJECTIVEdTo determine the prevalence of people with diabetes who meet hemoglobin A1c (A1C), blood pressure (BP), and LDL cholesterol (ABC) recommendations and their current statin use, factors associated with goal achievement, and changes in the proportion achieving goals between 1988 and 2010. RESEARCH DESIGN AND METHODSdData were cross-sectional from the National Health and Nutrition Examination Surveys (NHANES) from 1988–1994, 1999–2002, 2003–2006, and 2007–2010. Participants were 4,926 adults aged \$20 years who self-reported a previous diagnosis of diabetes and completed the household interview and physical examination (n = 1,558 for valid LDL levels). Main outcome measures were A1C, BP, and LDL cholesterol, in accordance with the American Diabetes Association recommendations, and current use of statins.
RESULTSdIn 2007–2010, 52.5\% of people with diabetes achieved A1C ,7.0\% (,53 mmol/ mol), 51.1\% achieved BP ,130/80 mmHg, 56.2\% achieved LDL ,100 mg/dL, and 18.8\% achieved all three ABCs. These levels of control were signiﬁcant improvements from 1988 to 1994 (all P , 0.05). Statin use signiﬁcantly increased between 1988–1994 (4.2\%) and 2007–2010 (51.4\%, P , 0.01). Compared with non-Hispanic whites, Mexican Americans were less likely to meet A1C and LDL goals (P , 0.03), and non-Hispanic blacks were less likely to meet BP and LDL goals (P , 0.02). Compared with non-Hispanic blacks, Mexican Americans were less likely to meet A1C goals (P , 0.01). Younger individuals were less likely to meet A1C and LDL goals.
CONCLUSIONSdDespite signiﬁcant improvement during the past decade, achieving the ABC goals remains suboptimal among adults with diabetes, particularly in some minority groups. Substantial opportunity exists to further improve diabetes control and, thus, to reduce diabetesrelated morbidity and mortality.},
	language = {en},
	number = {8},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Stark Casagrande, S. and Fradkin, J. E. and Saydah, S. H. and Rust, K. F. and Cowie, C. C.},
	month = aug,
	year = {2013},
	pages = {2271--2279},
	file = {Stark Casagrande e.a. - 2013 - The Prevalence of Meeting A1C, Blood Pressure, and.pdf:/Users/planetarium/Zotero/storage/47T8JSAH/Stark Casagrande e.a. - 2013 - The Prevalence of Meeting A1C, Blood Pressure, and.pdf:application/pdf;Stark Casagrande e.a. - 2013 - The Prevalence of Meeting A1C, Blood Pressure, and.pdf:/Users/planetarium/Zotero/storage/XIZ8L6YY/Stark Casagrande e.a. - 2013 - The Prevalence of Meeting A1C, Blood Pressure, and.pdf:application/pdf},
