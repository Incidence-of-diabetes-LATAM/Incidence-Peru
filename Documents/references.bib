@article{resnick_american_2000,
	title = {American {Diabetes} {Association} diabetes diagnostic criteria, advancing age, and cardiovascular disease risk profiles: results from the {Third} {National} {Health} and {Nutrition} {Examination} {Survey}},
	volume = {23},
	abstract = {OBJECTIVE: To evaluate age-specific effects on diabetes prevalence estimates resulting from the American Diabetes Association (ADA) recommendation against use of the oral glucose tolerance test (OGTT), we contrasted the prevalence of two mutually exclusive groups: undiagnosed diabetes according to ADA criteria (no report of diabetes and fasting glucose [FG] {\textgreater} or =126 mg/dl) and isolated postchallenge hyperglycemia (IPH) (FG {\textless}126 mg/dl and OGTT {\textgreater} or =200 mg/dl), a group designated to have diabetes by World Health Organization (WHO) criteria but not ADA criteria. RESEARCH DESIGN AND METHODS: The weighted age-specific ratios of undiagnosed diabetes:IPH were calculated for 2,844 subjects aged 40-74 years without reported diabetes who had both FG and OGTT. A ratio {\textgreater} 1.0 indicated that the proportion of undiagnosed diabetes was greater than that of IPH. Mean levels of HbA1c and cardiovascular disease (CVD) risk factors were contrasted among people with undiagnosed diabetes and IPH and those without either abnormality ("nondiabetic"). RESULTS: Both undiagnosed diabetes and IPH increased with age, but age-specific undiagnosed diabetes:IPH ratios decreased from 5.49 in the 40-44 age-group to 0.77 in the 70-74 age-group. Regression analysis showed a significant (P = 0.006) negative association between age and these ratios. Mean HbA1c was 7.1\% in the undiagnosed diabetes group and differed significantly from that of the IPH and nondiabetic groups (5.6 and 5.3\%, respectively). Individuals with undiagnosed diabetes had less favorable triglycerides, BMI, and HDL cholesterol compared with people with IPH. CONCLUSIONS: Compared with WHO criteria, the ADA criteria underestimate glucose abnormalities more with increasing age. However, compared to those with undiagnosed diabetes, individuals with IPH had a mean HbA1c level that is considered in the nondiabetic range, and this group had significantly more favorable levels of several key CVD risk factors. These findings suggest that the ADA criteria, although underestimating the abnormalities of postchallenge hyperglycemia that occur frequently with increasing age, appear to be effective at identifying a group of individuals with both unfavorable CVD risk factor profiles and evidence of long-term exposure to hyperglycemia},
	number = {0149-5992 LA - eng PT - Journal Article RN - 0 (Blood Glucose) RN - 0 (Lipoproteins, HDL Cholesterol) RN - 0 (Lipoproteins, LDL Cholesterol) RN - 57-88-5 (Cholesterol) SB - IM},
	journal = {Diabetes Care},
	author = {Resnick, H E and Harris, M I and Brock, D B and Harris, T B},
	month = feb,
	year = {2000},
	note = {Place: Epidemiology, Demography, and Biometry Program, National Institute on Aging, Bethesda, Maryland 20892, USA. resnickh@nih.gov},
	keywords = {Adult, analysis, blood, Cholesterol, Fasting, Glucose, methods, Research, Research Design, Risk, Triglycerides, diagnosis, Human, metabolism, United States, Middle Aged, Cardiovascular Diseases, Risk Factors, Aged, Age Factors, Biometry, Disease, epidemiology, World Health, Blood Glucose, prevention \& control, Hyperglycemia, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Aging, Diabetes Mellitus, Regression Analysis, Prevalence, World Health Organization, Glucose Tolerance Test, Voluntary Health Agencies, abnormalities, Demography, Maryland, Health Surveys, Nutrition, Nutrition Surveys, Physical Examination, Interviews},
	pages = {176--180},
	annote = {DA - 20001002},
}

@article{collins_p-selectin_2000,
	title = {P-{Selectin} or intercellular adhesion molecule ({ICAM})-1 deficiency substantially protects against atherosclerosis in apolipoprotein {E}-deficient mice},
	volume = {191},
	abstract = {The expression of leukocyte and endothelial cell adhesion molecules (CAMs) is essential for the emigration of leukocytes during an inflammatory response. The importance of the inflammatory response in the development of atherosclerosis is indicated by the increased expression of adhesion molecules, proinflammatory cytokines, and growth factors in lesions and lesion-prone areas and by protection in mice deficient in various aspects of the inflammatory response. We have quantitated the effect of deficiency for intercellular adhesion molecule (ICAM)-1, P-selectin, or E-selectin on atherosclerotic lesion formation at 20 wk of age in apolipoprotein (apo) E(-/-) (deficient) mice fed a normal chow diet. All mice were apo E(-/-) and CAM(+/+) or CAM(-/-) littermates, and no differences were found in body weight or cholesterol levels among the various genotypes during the study. ICAM-1(-/-) mice had significantly less lesion area than their ICAM-1(+/+) littermates: 4.08 +/- 0.70 mm(2) for -/- males vs. 5.87 +/- 0.66 mm(2) for +/+ males, and 3.95 +/- 0. 65 mm(2) for -/- females vs. 5.59 +/- 1.131 mm(2) for +/+ females, combined P {\textless} 0.0001. An even greater reduction in lesion area was observed in P-selectin(-/-) mice: 3.06 +/- 1.04 mm(2) for -/- males vs. 5.09 +/- 1.22 mm(2) for +/+ males, and 2.85 +/- 1.26 mm(2) for -/- females compared with 5.60 +/- 1.19 mm(2) for +/+ females, combined P {\textless} 0.001. The reduction in lesion area for the E-selectin null mice, although less than that seen for ICAM-1 or P-selectin, was still significant (4.54 +/- 2.14 mm(2) for -/- males vs. 5.92 +/- 0.63 mm(2) for +/+ males, and 4.38 +/- 0.85 mm(2) for -/- females compared with 5.94 +/- 1.44 mm(2) for +/+ females, combined P {\textless} 0.01). These results, coupled with the closely controlled genetics of this study, indicate that reductions in the expression of P-selectin, ICAM-1, or E-selectin provide direct protection from atherosclerotic lesion formation in this model},
	number = {0022-1007 LA - eng},
	journal = {J.Exp.Med.},
	author = {Collins, R G and Velji, R and Guevara, N V and Hicks, M J and Chan, L and Beaudet, A L},
	month = jan,
	year = {2000},
	note = {Place: Department of Molecular Genetics, Baylor College of Medicine, Houston, Texas 77030, USA},
	keywords = {analysis, blood, Cholesterol, Cell Adhesion Molecules, Cytokines, E-Selectin, Intercellular Adhesion Molecule-1, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, Animal, Leukocytes, Mice, physiology, Female, Male, etiology, prevention \& control, Arteriosclerosis, Diet, genetics, Genotype, deficiency, P-Selectin, Apolipoproteins E, Mice,Inbred C57BL},
	pages = {189--194},
	annote = {UI - 20088904},
}

@article{fox_kidney_2004,
	title = {Kidney function is inversely associated with coronary artery calcification in men and women free of cardiovascular disease: the {Framingham} {Heart} {Study}},
	volume = {66},
	abstract = {BACKGROUND: Among patients with end-stage renal disease (ESRD), the risk of cardiovascular disease is 10 to 20 times higher than the general population. Adults with ESRD have increased coronary-artery calcification (CAC) detected by electron-beam computed tomography (EBCT). Because the risk of coronary heart disease is increased even at moderate declines in kidney function, we sought to test whether high CAC scores are seen among those with mild reductions in kidney function. METHODS: Men and women free of symptomatic cardiovascular disease underwent EBCT. Coronary calcium was quantified using the method described by Agatston. Renal function was estimated by glomerular filtration rate (GFR). Spearman correlation coefficients were used to test the association between GFR and CAC. RESULTS: Three hundred nineteen subjects (162 men/157 women), mean age 60, were included. Mean GFR was 86 +/- 23 mL/min/1.73 m2 (range 31-169; 10\% with GFR {\textless}60 mL/min/1.73 m2). The median CAC scores by quartile of GFR were 85.9, 48.1, 7.9, and 2.7. Overall, the unadjusted correlation of GFR and CAC was -0.28 (P {\textless} 0.0001). This remained significant after adjustment for age and sex (-0.11, P {\textless} 0.05), and additionally after adjustment for body mass index (-0.11, P {\textless} 0.05), hypertension (-0.11, P {\textless} 0.05), or total cholesterol (-0.12, P= 0.04). A similar correlation was noted after multivariable adjustment (-0.10, P {\textless} 0.08). CONCLUSION: Mild declines in kidney function are associated with subclinical coronary artery calcification in a sample of subjects free of clinically apparent cardiovascular disease. This might help explain the increased risk of cardiovascular disease among individuals with renal dysfunction. Larger ongoing studies are needed to better quantify this finding},
	number = {0085-2538 (Print) LA - eng PT - Journal Article SB - IM},
	journal = {Kidney Int.},
	author = {Fox, C S and Larson, M G and Keyes, M J and Levy, D and Clouse, M E and Culleton, B and O'Donnell, C J},
	month = nov,
	year = {2004},
	note = {Place: NHLBI's Framingham Heart Study, Framingham, Massachusetts, USA. foxca@nhlbi.nih.gov},
	keywords = {Adult, Cholesterol, Men, methods, Risk, Sex, Women, Middle Aged, Hypertension, physiopathology, Aged, Female, Male, Disease, Humans, Time, Body Mass Index, 10, Arteries, Heart, Kidney, Coronary Disease, Massachusetts, Aged,80 and over, Calcinosis, radiography, Tomography,X-Ray Computed, Glomerular Filtration Rate, Calcium},
	pages = {2017--2021},
	annote = {DA - 20041021},
}

@article{brands_noninvasive_1998,
	title = {A noninvasive method to estimate pulse wave velocity in arteries locally by means of ultrasound},
	volume = {24},
	abstract = {Noninvasive evaluation of vessel wall properties in humans is hampered by the absence of methods to assess directly local distensibility, compliance, and Young's modulus. Contemporary ultrasound methods are capable of assessing end-diastolic artery diameter, the local change in artery diameter as a function of time, and local wall thickness. However, to assess vessel wall properties of the carotid artery, for example, the pulse pressure in the brachial artery still must be used as a substitute for local pulse pressure. The assessment of local pulse wave velocity as described in the present article provides a direct estimate of local vessel wall properties (distensibility, compliance, and Young's modulus) and, in combination with the relative change in artery cross-sectional area, an estimate of the local pulse pressure. The local pulse wave velocity is obtained by processing radio frequency ultrasound signals acquired simultaneously along two M-lines spaced at a known distance along the artery. A full derivation and mathematical description of the method to assess local pulse wave velocity, using the temporal and longitudinal gradients of the change in diameter, are presented. A performance evaluation of the method was carried out by means of experiments in an elastic tube under pulsatile pressure conditions. It is concluded that, in a phantom set-up, the assessed local pulse wave velocity provides reliable estimates for local distensibility},
	number = {0301-5629 LA - eng PT - Journal Article},
	journal = {Ultrasound Med.Biol.},
	author = {Brands, P J and Willigers, J M and Ledoux, L A and Reneman, R S and Hoeks, A P},
	month = nov,
	year = {1998},
	note = {Place: Department of Biophysics, Maastricht University, The Netherlands},
	keywords = {methods, Human, physiology, Blood Flow Velocity, Brachial Artery, Arteries, ultrasonography, Ultrasonography,Doppler, England, Netherlands, Carotid Arteries, Compliance, Pulse, Models,Cardiovascular, Signal Processing,Computer-Assisted},
	pages = {1325--1335},
	annote = {UI - 99313733},
}

