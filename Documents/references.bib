	keywords = {Adult, analysis, blood, Cholesterol, methods, Odds Ratio, Research, Risk, Triglycerides, Human, Support,Non-U.S.Gov't, Case-Control Studies, Risk Factors, Male, Middle Age, Disease, Body Mass Index, Canada, etiology, Heart, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Particle Size, Plasma, Prospective Studies, Regression Analysis, Logistic Models, Smoking, chemistry, Myocardial Ischemia, Apolipoproteins, Apolipoproteins B, Quebec},
