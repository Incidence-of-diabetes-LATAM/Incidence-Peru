	keywords = {Female, Male, Humans, Child, Adolescent, Energy Metabolism, Energy Metabolism: physiology, Muscle Strength, Muscle Strength: physiology, Safety, Weight Lifting, Weight Lifting: physiology},
	pages = {070522225912002--???},
