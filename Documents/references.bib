	keywords = {blood, Blood Pressure, Glucose, Pressure, Syndrome, Human, Body Weight, epidemiology, Humans, Time, World Health, Diabetes Mellitus,Type 2, Metabolic Syndrome X, Prevalence, standards, Homeostasis, Stress, Food, Phenotype, Switzerland, Weight Gain, Environment, Survivors, Nutrition, utilization, Anxiety},
	pages = {2--8},
	annote = {DA - 20051108},
}

@article{gillies_pharmacological_2007,
	title = {Pharmacological and lifestyle interventions to prevent or delay type 2 diabetes in people with impaired glucose tolerance: systematic review and meta-analysis},
	volume = {334},
	abstract = {OBJECTIVE: To quantify the effectiveness of pharmacological and lifestyle interventions to prevent or delay type 2 diabetes in people with impaired glucose tolerance. DATA SOURCES: Medline, Embase, and the Cochrane library searched up to July 2006. Expert opinions sought and reference lists of identified studies and any relevant published reviews checked. STUDY SELECTION: Randomised controlled trials that evaluated interventions to delay or prevent type 2 diabetes in individuals with impaired glucose tolerance. RESULTS: 21 trials met the inclusion criteria, of which 17, with 8084 participants with impaired glucose tolerance, reported results in enough detail for inclusion in the meta-analyses. From the meta-analyses the pooled hazard ratios were 0.51 (95\% confidence interval 0.44 to 0.60) for lifestyle interventions v standard advice, 0.70 (0.62 to 0.79) for oral diabetes drugs v control, 0.44 (0.28 to 0.69) for orlistat v control, and 0.32 (0.03 to 3.07) for the herbal remedy jiangtang bushen recipe v standard diabetes advice. These correspond to numbers needed to treat for benefit (NNTB) and harm (NNTH) of 6.4 for lifestyle (95\% credible interval, NNTB 5.0 to NNTB 8.4), 10.8 for oral diabetes drugs (NNTB 8.1 to NNTB 15.0), 5.4 for orlistat (NNTB 4.1 to NNTB 7.6), and 4.0 for jiangtang bushen (NNTH 16.9 to NNTB 24.8). CONCLUSIONS: Lifestyle and pharmacological interventions reduce the rate of progression to type 2 diabetes in people with impaired glucose tolerance. Lifestyle interventions seem to be at least as effective as drug treatment},
	number = {7588},
	journal = {BMJ.},
	author = {Gillies, C L and Abrams, K R and Lambert, P C and Cooper, N J and Sutton, A J and Hsu, R T and Khunti, K},
	month = feb,
	year = {2007},
	keywords = {Glucose, therapy, therapeutic use, epidemiology, Humans, Diabetes Mellitus,Type 2, Life Style, Meta-Analysis, Hypoglycemic Agents, Glucose Intolerance, Treatment Outcome, Publication Bias, Randomized Controlled Trials as Topic, Medline},
	pages = {299--299},
	annote = {Centre for Biostatistics and Genetic Epidemiology, Department of Health Sciences, University of Leicester, Leicester LE1 7RH clg13@leacukFAU - Gillies, Clare L},
}

@article{goodfellow_endothelial_1998,
	title = {Endothelial function is impaired in fit young adults of low birth weight},
	volume = {40},
	abstract = {OBJECTIVE: Non-insulin-dependent diabetes, hypertension and ischaemic heart disease, with insulin resistance, are associated with low birth weight (the 'Small Baby Syndrome'). Common to these adult clinical conditions is endothelial dysfunction. We tested the hypothesis that endothelial dysfunction could precede their development in those of low birth weight. METHODS: Endothelial function was measured by ultrasonic 'wall-tracking' of flow-related brachial artery dilatation in fit 19-20 year old subjects randomly selected (blind to the investigators throughout the study) from low ({\textless} 2.5 kg) and normal (3.0-3.8 kg) birth weight subjects in the 1975-7 cohort of the Cardiff Births Survey and with no known cause for endothelial dysfunction. RESULTS: Flow-related dilatation was impaired in low birth weight relative to normal birth weight subjects (median 0.04 mm [1.5\%] [n = 22] cf. 0.11 mm [4.1\%] [n = 17], p {\textless} 0.05; 0.04 mm [1.5\%] [n = 15] cf. 0.12 mm [4.4\%] [n = 12], p {\textless} 0.05 after exclusion of inadvertently included ever-smokers). CONCLUSION: The findings suggest that endothelial dysfunction is a consequence of foetal malnutrition, consistent with contributing to the clinical features of the 'Small Baby Syndrome' in later adult life},
	number = {0008-6363 LA - eng PT - Journal Article},
	journal = {Cardiovasc.Res.},
	author = {Goodfellow, J and Bellamy, M F and Gorman, S T and Brownlee, M and Ramsey, M W and Lewis, M J and Davies, D P and Henderson, A H},
	month = dec,
