@article{chironi_determinants_2002,
	title = {Determinants of progression of coronary artery calcifications in asymptomatic men at high cardiovascular risk},
	volume = {53},
	abstract = {Extended coronary artery calcifications (CAC) are predictive for cardiovascular complications but little is known about factors likely to influence CAC deposit. An analysis was undertaken to assess the cardiovascular risk factors that are capable of predicting CAC change over time. A retrospective analysis of CAC change was carried out in 55 asymptomatic men who underwent sequential electron beam computed tomographic measurement of CAC score a mean of 3.3 years apart. To ensure maximal accuracy in CAC change analysis, patients were included who had an initial CAC score of 10 or greater and with difference between both scores of 20\% or greater of the initial score. The annual change rate in CAC score was calculated by dividing the change in CAC score by the interval between scores. Subjects' risk factors were analyzed and included body mass index, blood pressure, blood lipids and glucose, plasma lipoprotein(a) and fibrinogen, smoking status, and family history of coronary heart disease. The annual change rate in CAC score correlated positively with lipoprotein(a) (r = 0.42, p{\textless}0.01) and with initial CAC score (r = 0.46, p{\textless}0.001) and these associations persisted in multivariate analysis (p = 0.01, p = 0.001 respectively, R2 = 0.31). In contrast, no association existed between annual CAC change and baseline values and follow-up changes of other risk factors. The association of lipoprotein(a) with CAC progression in symptom-free patients with preexisting coronary calcifications provides new insights into the progression of coronary artery disease and may be useful for planning therapy and follow-up},
	number = {0003-3197 LA - eng PT - Journal Article SB - IM},
	journal = {Angiology},
	author = {Chironi, G and Simon, A and Denarie, N and Vedie, B and Sene, V and Megnien, J L and Levenson, J},
	month = nov,
	year = {2002},
	note = {Place: Centre de Medecine Preventive Cardiovasculaire and CRI INSERM, Paris, France},
	keywords = {analysis, blood, Blood Pressure, Glucose, Lipids, Pressure, Risk, Human, therapy, Disease Progression, Risk Factors, Male, Middle Age, Time Factors, Disease, epidemiology, Time, Body Mass Index, complications, 10, Arteries, Heart, Follow-Up Studies, Coronary Disease, Multivariate Analysis, Plasma, Family, history, Predictive Value of Tests, Smoking, Calcinosis, Coronary Calcification, radiography, Tomography,X-Ray Computed, Fibrinogen, France, Retrospective Studies, Lipoprotein(a)},
	pages = {677--683},
	annote = {UI - 22351027},
}

@article{mccullough_independent_2007,
	title = {Independent components of chronic kidney disease as a cardiovascular risk state: results from the {Kidney} {Early} {Evaluation} {Program} ({KEEP})},
	volume = {167},
	abstract = {BACKGROUND: The relationships of anemia, microalbuminuria, and estimated glomerular filtration rate (eGFR) with cardiovascular disease (CVD) and subsequent death are not fully understood. We hypothesized that each of these chronic kidney disease-related measures would have an independent relationship with CVD. METHODS: A cohort of 37 153 persons screened in the National Kidney Foundation's Kidney Early Evaluation Program were followed up for a median of 16.0 months (range, 0.2-47.5 months). Participants were volunteers who completed surveys regarding past medical events and who underwent blood pressure and laboratory testing. Estimated glomerular filtration rate was computed using a 4-variable equation. Mortality was ascertained by linkage to national data systems. RESULTS: Of 37 153 persons, the mean +/- SD age was 52.9 +/- 15.9 years, and 68.7\% were female. A total of 1835 (4.9\%) had a self-reported history of myocardial infarction, 1336 (3.6\%) had a history of stroke, and 2897 (7.8\%) had a history of myocardial infarction or stroke. Multivariate analysis controlling for age demonstrated that the following were independently associated with CVD: male sex (odds ratio [OR], 1.64; P{\textless}.001), smoking (OR, 1.73; P{\textless}.001), body mass index (OR, 1.01; P = .03), diabetes mellitus (OR, 1.66; P{\textless}.001), hypertension (OR, 1.77; P{\textless}.001), eGFR of 30 to 59 mL/min per 173 m(3) (OR, 1.37; P = .001), hemoglobin level of 12.8 g/dL or less (OR, 1.45; P{\textless}.001), and microalbuminuria of greater than 30 mg/L (OR, 1.28; P = .01). Survival analysis found CVD (OR, 3.02; P = .003), chronic kidney disease (OR, 1.98; P = .05), and the combination (OR, 3.80; P{\textless}.001) to be independent predictors of mortality. Persons with a combination of all 3 chronic kidney disease measures (anemia, microalbuminuria, and eGFR of {\textless}60 mL/min per 1.73 m(2)) had the lowest survival of about 93\% by the end of 30 months. CONCLUSION: Anemia, eGFR, and microalbuminuria were independently associated with CVD, and when all 3 were present, CVD was common and survival was reduced},
	number = {0003-9926 (Print) LA - eng PT - Journal Article RN - 0 (Hemoglobins) SB - AIM SB - IM},
	journal = {Arch.Intern.Med.},
	author = {McCullough, P A and Jurkovitz, C T and Pergola, P E and McGill, J B and Brown, W W and Collins, A J and Chen, S C and Li, S and Singh, A and Norris, K C and Klag, M J and Bakris, G L},
	month = jun,
