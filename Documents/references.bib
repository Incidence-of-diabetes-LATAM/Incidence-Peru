@article{clausen_overweight_2009,
	title = {Overweight and the {Metabolic} {Syndrome} in {Adult} {Offspring} of {Women} with {Diet}-{Treated} {Gestational} {Diabetes} {Mellitus} or {Type} 1 {Diabetes}},
	volume = {94},
	issn = {0021-972X, 1945-7197},
	url = {https://academic.oup.com/jcem/article/94/7/2464/2596975},
	doi = {10.1210/jc.2009-0305},
	abstract = {Objective: The aim was to study the risk of overweight and the metabolic syndrome in adult offspring of women with diet-treated gestational diabetes mellitus (GDM) or type 1 diabetes, and additionally to study associations between estimates of maternal hyperglycemia and outcome in the offspring. Design and Setting: We conducted a follow-up study of 1066 primarily Caucasian women aged 18 –27 yr in the Center for Pregnant Women with Diabetes, Rigshospitalet, Copenhagen, Denmark. Participants: Offspring of women with diet-treated GDM (n ϭ 168) and an unexposed reference group (n ϭ 141) participated, as well as offspring of women with type 1 diabetes (n ϭ 160) and offspring from the background population representing an unexposed reference group (n ϭ 128). The follow-up rate was 56\% (597 of 1066). Main Outcome Measures: Women with body mass index of at least 25 kg/m2 were considered overweight. The metabolic syndrome was determined by the International Diabetes Federation 2006 criteria.
Results: The risk of overweight was doubled in offspring of women with diet-treated GDM or type 1 diabetes compared with offspring from the background population, whereas the risk of the metabolic syndrome was 4- and 2.5-fold increased, respectively. Offspring risk of the metabolic syndrome increased significantly with increasing maternal fasting blood glucose as well as 2-h blood glucose (during oral glucose tolerance test).
Conclusions: Adult offspring of women with diet-treated GDM or type 1 diabetes are risk groups for overweight and the metabolic syndrome. Intrauterine hyperglycemia may in addition to genetics and other factors contribute to the pathogenesis of overweight and the metabolic syndrome. (J Clin Endocrinol Metab 94: 2464 –2470, 2009)},
	language = {en},
	number = {7},
	urldate = {2021-02-13},
	journal = {The Journal of Clinical Endocrinology \& Metabolism},
	author = {Clausen, Tine D. and Mathiesen, Elisabeth R. and Hansen, Torben and Pedersen, Oluf and Jensen, Dorte M. and Lauenborg, Jeannet and Schmidt, Lone and Damm, Peter},
	month = jul,
	year = {2009},
	pages = {2464--2470},
	file = {Clausen e.a. - 2009 - Overweight and the Metabolic Syndrome in Adult Off.pdf:/Users/planetarium/Zotero/storage/PALK75MA/Clausen e.a. - 2009 - Overweight and the Metabolic Syndrome in Adult Off.pdf:application/pdf;Clausen e.a. - 2009 - Overweight and the Metabolic Syndrome in Adult Off.pdf:/Users/planetarium/Zotero/storage/4RLPE3ZR/Clausen e.a. - 2009 - Overweight and the Metabolic Syndrome in Adult Off.pdf:application/pdf},
