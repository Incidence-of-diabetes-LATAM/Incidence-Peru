@article{thompson_hemostatic_1995,
	title = {Hemostatic factors and the risk of myocardial infarction or sudden death in patients with angina pectoris. {European} {Concerted} {Action} on {Thrombosis} and {Disabilities} {Angina} {Pectoris} {Study} {Group}},
	volume = {332},
	abstract = {BACKGROUND. Increased levels of certain hemostatic factors may play a part in the development of acute coronary syndromes and may be associated with an increased risk of coronary events in patients with angina pectoris. METHODS. We conducted a prospective multicenter study of 3043 patients with angina pectoris who underwent coronary angiography and were followed for two years. Base-line measurements included the concentrations of selected hemostatic factors indicative of a thrombophilic state or endothelial injury. The results were analyzed in relation to the subsequent incidence of myocardial infarction or sudden coronary death. RESULTS. After adjustment for the extent of coronary artery disease and other risk factors, an increased incidence of myocardial infarction or sudden death was associated with higher base-line concentrations of fibrinogen (mean +/- SD, 3.28 +/- 0.74 g per liter in patients who subsequently had coronary events, as compared with 3.00 +/- 0.71 g per liter in those who did not; P = 0.01), von Willebrand factor antigen (138 +/- 49 percent vs. 125 +/- 49 percent, P = 0.05), and tissue plasminogen activator (t-PA) antigen (11.9 +/- 4.7 ng per milliliter vs. 10.0 +/- 4.2 ng per milliliter, P = 0.02). The concentration of C-reactive protein was also directly correlated with the incidence of coronary events (P = 0.05), except when we adjusted for the fibrinogen concentration. In patients with high serum cholesterol levels, the risk of coronary events rose with increasing levels of fibrinogen and C-reactive protein, but the risk remained low even given high serum cholesterol levels in the presence of low fibrinogen concentrations. CONCLUSIONS. In patients with angina pectoris, the levels of fibrinogen, von Willebrand factor antigen, and t-PA antigen are independent predictors of subsequent acute coronary syndromes. In addition, low fibrinogen concentrations characterize patients at low risk for coronary events despite increased serum cholesterol levels. Our data are consistent with a pathogenetic role of impaired fibrinolysis, endothelial-cell injury, and inflammatory activity in the progression of coronary artery disease},
	number = {0028-4793 LA - eng PT - Clinical Trial PT - Journal Article PT - Multicenter Study},
	journal = {N.Engl.J.Med.},
	author = {Thompson, S G and Kienast, J and Pyke, S D and Haverkate, F and van de Loo, J C},
	month = mar,
	year = {1995},
	note = {Place: Medical Statistics Unit, London School of Hygiene and Tropical Medicine},
	keywords = {Adult, analysis, blood, Cholesterol, Incidence, methods, Risk, Syndrome, Human, Support,Non-U.S.Gov't, United States, Hemostasis, Risk Factors, Aged, Female, Male, Middle Age, complications, etiology, Multicenter Studies, Myocardial Infarction, Arteries, Blood Coagulation, Follow-Up Studies, Prospective Studies, Regression Analysis, Coronary Angiography, C-Reactive Protein, Angina Pectoris, Thrombosis, Statistics, Fibrinogen, Death,Sudden,Cardiac, von Willebrand Factor, Fibrinolysis, Tissue Plasminogen Activator, Blood Coagulation Factors},
