@article{schroeder_influence_2000,
	title = {Influence of vessel size, age and body mass index on the flow-mediated dilatation ({FMD}\%) of the brachial artery},
	volume = {76},
	abstract = {BACKGROUND: The non-invasive determination of the endothelial dysfunction (ED) of the brachial artery is a widely used method in clinical research. It remained, however, unclear, whether the test-results are influenced by the anatomical vessel size, the patients age, body mass index (BMI) or gender. METHODS: The flow-mediated vasodilatation (FMD\%) of the brachial artery was determined in 122 consecutive (88 male, 34 female) patients. FMD\% was measured using high resolution ultrasound (13 Mhz) at rest, during reactive hyperaemia and after the sublingual administration of glycerolnitrate (GTN\%). RESULTS: Lumen diameters at rest varied from 2.48 mm to 6.33 mm (4.46+/-0.74 mm). The extent of FMD\% as well as of GTN\% showed an inverse correlation to the resting lumen diameters (r=-0.33, P{\textless}0.001/r=-0.51, P{\textless}0.001). This correlation was even more distinct in females (females: FMD\% r=-0.54, P{\textless}0.001; GTN\% r=-0.64, P{\textless}0.001 vs. males: FMD\% -0.23, P{\textless}0.001; GTN\% -0.59, P{\textless}0. 001). No significant influence of age (61+/-9 years, FMD\%: r=-0.04, P=0.68, GTN\%: r=-0.18, P=0.05) and BMI (27.03+/-3.43 kg/m(2), FMD\%: r=0.16, P=0.08, GTN\%: r=0.09, P=0.3) on the test results were found. CONCLUSIONS: FMD\% was found to be rather independent of age or BMI. The anatomical vessel size had an influence on the test results, which was more obvious in female patients. Our data indicate the necessity of further methodological studies, in larger, community-based populations. In particular, it needs to be clarified, whether vessel size or even gender-specific correction factors are required when using this technique in routine clinical practice},
	number = {0167-5273 LA - eng PT - Journal Article},
	journal = {Int.J.Cardiol.},
	author = {Schroeder, S and Enderle, M D and Baumbach, A and Ossen, R and Herdeg, C and Kuettner, A and Karsch, K R},
	month = nov,
	year = {2000},
	note = {Place: Department of Internal Medicine, Division of Cardiology, Eberhard-Karls-University, Otfried-Mueller-Str. 10, D-72076, Tuebingen, Germany. dr.schroeder@t-online.de},
	keywords = {Adult, methods, Research, Human, drug effects, Endothelium,Vascular, physiology, physiopathology, Aged, Blood Flow Velocity, Brachial Artery, Female, Male, Middle Age, Age Factors, Body Mass Index, Arteries, Coronary Disease, Prospective Studies, Dilatation, Regression Analysis, Statistics,Nonparametric, ultrasonography, Vasodilation, Cardiology, Sex Factors, Chi-Square Distribution},
	pages = {219--225},
