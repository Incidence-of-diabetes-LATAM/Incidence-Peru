@article{roulot_liver_2008,
	title = {Liver stiffness values in apparently healthy subjects: {Influence} of gender and metabolic syndrome},
	volume = {48},
	issn = {01688278},
	shorttitle = {Liver stiffness values in apparently healthy subjects},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S016882780700685X},
	doi = {10.1016/j.jhep.2007.11.020},
	abstract = {Background/Aims: Liver stiﬀness measurement by transient elastography is a very promising non-invasive method for the diagnosis of ﬁbrosis in chronic liver diseases. However, studies on normal values of liver stiﬀness in healthy subjects are still lacking. The aim of the present study was to prospectively assess liver stiﬀness values in the general population and to determine potential factors, which may inﬂuence these values.
Methods: Liver stiﬀness measurements were performed in 429 consecutive apparently healthy subjects, without overt cause of liver disease and normal liver enzymes, undergoing a free medical check-up.
Results: Mean liver stiﬀness value was 5.49 ± 1.59 kPa. Transient elastography failure was observed in 4.6\% of the cases. The failure rate increased with BMI, reaching 88\% for values above 40 kg /m2. Liver stiﬀness values were higher in men than in women (5.81 ± 1.54 vs 5.23 ± 1.59 kPa, p = 0.0002) and in subjects with BMI {\textgreater} 30 kg/m2 (6.26 ± 1.89 vs 5.37 ± 1.51 kPa, p = 0.0003). Metabolic syndrome was diagnosed in 59 (13.7\%) subjects. After adjustment for gender and BMI, liver stiﬀness values were higher in subjects with metabolic syndrome than in those without (6.51 ± 1.64 vs 5.33 ± 1.51 kPa, p {\textless} 0.0001).
Conclusions: Liver stiﬀness values in the general population are inﬂuenced independently by gender, BMI and metabolic syndrome. Ó 2007 European Association for the Study of the Liver. Published by Elsevier B.V. All rights reserved.},
	language = {en},
	number = {4},
	urldate = {2021-02-14},
	journal = {Journal of Hepatology},
	author = {Roulot, Dominique and Czernichow, Sébastien and Le Clésiau, Hervé and Costes, Jean-Luc and Vergnaud, Anne-Claire and Beaugrand, Michel},
	month = apr,
	year = {2008},
	pages = {606--613},
	file = {Roulot e.a. - 2008 - Liver stiffness values in apparently healthy subje.pdf:/Users/planetarium/Zotero/storage/LF9GEADD/Roulot e.a. - 2008 - Liver stiffness values in apparently healthy subje.pdf:application/pdf},
}

