@article{perregaux_brachial_2000,
	title = {Brachial vascular reactivity in blacks},
	volume = {36},
	abstract = {Endothelial function was studied ultrasonographically in a healthy subset of African Americans (blacks) because they have an increased risk of hypertension and vascular disease. Twenty-four healthy black and 28 well-matched white subjects were investigated. Ischemia was induced by inflating a cuff over the forearm to 40 mm Hg higher than systolic pressure for 5 minutes. Brachial artery diameter and blood flow velocity were measured at baseline and at 15, 45, and 60 seconds after deflation by use of an Acuson 128XP10 ultrasonograph with a 7.5 MHz transducer. Mean postischemic dilatation, an index of endothelial function, was 1.76+/-0.56\% in blacks and 8.79+/-1.22\% in whites (P{\textless}0.001). Median postischemic vasodilatation in black men [0\% (0\% to 2.86\%)] was not significantly different to that in black women [0.82\% (0\% to 3.14\%)], whereas white women [11.48\% (8.70\% to 14.29\%)] dilated significantly more than white men [4.20\% (2.13\% to 5.56\%)] (P{\textless}0.05). Both groups dilated significantly over baseline diameter to sublingual nitroglycerin administration 18.7+/-2.5\% (blacks) and 20.2+/-3.2\% (whites; P=NS). Mean hyperemic responses did not differ significantly between the 2 subject groups, nor did they differ between men and women of both ethnic groups. We conclude that endothelium-dependent vasodilatation is significantly impaired in healthy, young blacks compared with whites and that gender differences are not seen in blacks with regard to this phenomenon. An impairment in endothelium-dependent NO generation may be a contributing factor to future hypertension and vascular disease in healthy blacks},
	number = {1524-4563 LA - eng PT - Journal Article},
	journal = {Hypertension},
	author = {Perregaux, D and Chaudhuri, A and Rao, S and Airen, A and Wilson, M and Sung, B H and Dandona, P},
	month = nov,
	year = {2000},
	note = {Place: Divisions of Endocrinology, State University of New York at Buffalo, USA},
	keywords = {Adult, blood, Risk, Human, Comparative Study, Endothelium,Vascular, United States, Hypertension, Ischemia, physiology, physiopathology, Blood Flow Velocity, Brachial Artery, Female, Male, Middle Age, Disease, epidemiology, Arteries, Dilatation, Nitroglycerin, ultrasonography, Vasodilation, Sex Factors, genetics, Forearm, Caucasoid Race, Negroid Race},
	pages = {866--871},
	annote = {UI - 20535069},
}

@article{neunteufl_systemic_1997,
	title = {Systemic endothelial dysfunction is related to the extent and severity of coronary artery disease},
	volume = {129},
	abstract = {Flow-mediated vasodilation (FMD) of systemic arteries, a non-invasive parameter of endothelial function, is correlated with cardiovascular risk factors. The relationship between FMD and morphologically and clinically evident coronary artery disease has not been described. This study was performed to test the hypothesis that an impairment of FMD in the brachial artery is related to the presence and/or extent and severity of coronary artery disease (CAD). We examined 74 patients with angina pectoris and 14 control subjects (age 17 36 years). Angiography revealed coronary artery disease ({\textgreater} or = 30\% diameter stenosis) in 44 patients (CAD, age 32 67 years) and smooth coronary arteries in 30 patients (non-CAD, age 22-73 years). Vasodilation following reactive hyperemia and after sublingual nitroglycerin (NTG) was assessed in the brachial artery using B-mode high resolution ultrasound. CAD patients showed markedly impaired FMD compared to the non-CAD group (5.7 +/- 4.8 versus 12.6 +/- 6.7\%, P {\textless} 0.0001) and to controls (5.7 +/- 4.8 versus 15.7 +/- 3.9\%, P {\textless} 0.00001). NTG induced similar degrees of vasodilation in the CAD and non-CAD groups but less vasodilation in the CAD patients compared to controls (12.2 +/- 6.3 versus 20.4 +/- 6.9\%, P {\textless} 0.01). On univariate analysis, impaired FMD in CAD patients and non-CAD patients was related to the extent of coronary disease (1-, 2- or 3-vessel disease; r = -0.67, P {\textless} 0.0001), to the maximum percent diameter stenosis in one of the major coronary vessels (r = -0.52, P {\textless} 0.0001), brachial artery diameter (r = -0.46, P {\textless} 0.0001) and plasma cholesterol level (r = -0.34, P {\textless} 0.001). On multiple stepwise regression analysis the extent of coronary disease (r = -0.51, P {\textless} 0.0001) and the baseline brachial artery diameter (r = -0.37, P {\textless} 0.0001) were independently associated with FMD in CAD and non-CAD patients. The present findings suggest that the impairment of FMD in the brachial artery, a marker of systemic endothelial function, is closely related to the angiographic extent of CAD},
	number = {0021-9150 LA - eng PT - Journal Article},
	journal = {Atherosclerosis},
	author = {Neunteufl, T and Katzenschlager, R and Hassan, A and Klaar, U and Schwarzacher, S and Glogar, D and Bauer, P and Weidinger, F},
	month = feb,
	year = {1997},
	note = {Place: Department of Cardiology/Second Medical Department, University of Vienna Medical School, Austria},
	keywords = {Adult, analysis, Human, Comparative Study, drug effects, Endothelium,Vascular, physiology, physiopathology, Risk Factors, Aged, Blood Flow Velocity, Brachial Artery, Female, Male, Middle Age, therapeutic use, Coronary Disease, Prospective Studies, Nitroglycerin, Regression Analysis, Sensitivity and Specificity, ultrasonography, Vasodilation, Coronary Angiography, Observer Variation, radiography, Coronary Vessels, Vasodilator Agents, Adolescent},
