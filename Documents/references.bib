@article{gerich_type_2010,
	title = {Type 2 diabetes: postprandial hyperglycemia and increased cardiovascular risk},
	issn = {1178-2048},
	shorttitle = {Type 2 diabetes},
	url = {http://www.dovepress.com/type-2-diabetes-postprandial-hyperglycemia-and-increased-cardiovascula-peer-reviewed-article-VHRM},
	doi = {10.2147/VHRM.S8216},
	abstract = {Hyperglycemia is a major risk factor for both the microvascular and macrovascular complications in patients with type 2 diabetes. This review summarizes the cardiovascular results of large outcomes trials in diabetes and presents new evidence on the role of hyperglycemia, with particular emphasis on postprandial hyperglycemia, in adverse cardiovascular outcomes in patients with type 2 diabetes. Treatment options, including the new dipeptidyl peptidase-4 inhibitors and glucagon-like peptide-1 mimetics that primarily target postprandial hyperglycemia, are also discussed. Hyperglycemia increases cardiovascular mortality, and reducing hyperglycemia lowers cardiovascular risk parameters. Control of both fasting and postprandial hyperglycemia is necessary to achieve optimal glycated hemoglobin control. Therefore, antihyperglycemic agents that preferentially target postprandial hyperglycemia, along with those that preferentially target fasting hyperglycemia, are strongly suggested to optimize individual diabetes treatment strategies and reduce complications.},
	language = {en},
	urldate = {2021-02-13},
	journal = {Vascular Health and Risk Management},
	author = {{Gerich}},
	month = mar,
	year = {2010},
	pages = {145},
