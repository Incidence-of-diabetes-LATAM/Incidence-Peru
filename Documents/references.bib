@article{chan_how_2017,
	title = {How can we optimise diabetes care in real-world practice?},
	volume = {5},
	doi = {10.1016/S2213-8587(17)30356-X},
	abstract = {www.thelancet.com/diabetes-endocrinology Published online October 24, 2017 http://dx.doi.org/10.1016/S2213-8587(17)30356-X 1 How can we optimise diabetes care in real-world practice? In The Lancet Diabetes \& Endocrinology, Kohjiro Ueki and colleagues 1 report the results of J-DOIT3, a multicentre, randomised clinical trial in which 2542 Japanese patients with type 2 diabetes aged 45–69 years were randomly assigned to intensive treatment (n=1271) to achieve new targets for blood pressure ({\textless}120/75 mm Hg), LDL cholesterol ({\textless}80 mg/dL or {\textless}70 mg/dL, depending on history of cardiovascular disease), and HbA 1c (6·2\% [44·3 mmol/mol]), or targets recommended by the Japanese Diabetes Society (blood pressure {\textless}130/80 mm Hg, LDL cholesterol {\textless}120 mg/dL or {\textless}100 mg/dL, and HbA 1c {\textless}6·9\% [52·0 mmol/mol]; n=1271) for a median of 8·5 years (IQR 7·3–9·0). About 11\% of the patients had a history of cardiovascular disease. Because of a low event rate, the investigators added revascularisation into their primary outcome of myocardial infarction, stroke, and all-cause mortality halfway through the study and reduced the number of events and study power from 90\% to 80\%. During the intervention period, there was a difference between groups of 0·37\% HbA 1c , 6 mm Hg systolic blood pressure, and 18·2 mg/dL LDL cholesterol in favour of the intensive therapy group. The pattern of drug use was similar in both groups with increased use in the intensive therapy group. The most frequently used drugs were metformin, sulfonlyureas, dipeptidyl peptidase-4 (DPP-4) inhibitors, pioglitazone, α-glucosidase inhibitors, statins, renin-angiotensin-system inhibitors, and calcium-channel blockers. These differences in cardiometabolic risk factors were translated to 24 fewer primary outcome events in the intensive therapy group than in the conventional therapy group, although this difference was not significant in the intention-to-treat analysis (hazard ratio 0·81, 95\% CI 0·63–1·04; p=0·094). However, intensive treatment reduced cerebrovascular events by 58\% and renal events by 32\%, the latter mainly due to fewer patients with progression of albuminuria and no patients developing end-stage renal disease. Overall, numbers of major events were low in both groups, including all-cause death (49 in the intensive therapy group vs 48 in the conventional therapy group), myo-cardial infarction (five vs 11), stroke (15 vs 37), renal events (181 vs 257), cancer (119 vs 137), and severe hypoglycaemia (seven vs four). During the trial period, patients in the intensive therapy group were given blood glucose monitoring machines and sphygmomanometers and attended an average of 70 visits compared with 63 visits for patients in the conventional therapy group. Patients in the intensive therapy group were treated to achieve the HbA 1c target or a reduction in HbA 1c of at least 1\% within 3 months and target blood pressure within 3–6 months of randomisation. Both groups had access to similar medications but the treatment targets were pre-assigned. The base therapy consisted of various drug combinations: insulin; metformin plus pioglitazone plus glucagon-like peptide 1 receptor agonist; sulfonlyureas or glinides; or α-glucosidase inhibi tors, DPP-4 inhibitors, or sodium-glucose cotransporter-2 inhibitors depending on age, HbA 1c , bodyweight, and complications, but the final decision remained with the investigators. The results of the J-DOIT3 trial demonstrate the feasibility of using conventional therapies to treat low-risk middle-aged patients with type 2 diabetes to new targets of cardiometabolic risk factors safely and effectively. The low event rates in most diabetes cardiovascular outcome trials, even in patients with previous cardiovascular events, might be confounded by the Hawthorne effect, whereby experimental conditions (eg, information feedback, protocol, or incentives) might influence behaviour of both investigators and participants. 2},
	number = {12},
	journal = {The Lancet Diabetes and Endocrinology},
	author = {Chan, Juliana C.N.},
	year = {2017},
	pages = {927--929},
}

