	month = jun,
	year = {2003},
	note = {Place: Karolinska Institute, Stockholm, Sweden. janovej@hotmail.com},
	keywords = {Adult, Atherosclerosis, blood, Blood Pressure, Glucose, Pressure, Risk, Human, metabolism, Support,Non-U.S.Gov't, Hemostasis, physiology, physiopathology, Risk Factors, Brachial Artery, Female, Male, etiology, Arteries, Blood Glucose, prevention \& control, Lipoproteins, Plasma, Diabetes Mellitus,Insulin-Dependent, Arteriosclerosis, Diabetes Mellitus, pathology, Tunica Intima, Tunica Media, Carotid Artery Diseases, Fibrinogen, Carotid Arteries, Diabetic Angiopathies, Sweden},
