	keywords = {Adult, blood, Blood Pressure, Cholesterol, methods, Pressure, Research, Risk, physiology, Risk Factors, Female, Male, Disease, epidemiology, Humans, Longitudinal Studies, Heart, Life Style, Follow-Up Studies, Coronary Disease, Smoking, Netherlands, Diet, Research Support, Adolescent, Alcohol Drinking, Cluster Analysis, Health Behavior, Physical Fitness, Cholesterol,HDL},
