	note = {Place: Internal Medicine and Cardiovascular Diseases Unit, Department of Medicina Sperimentale e Clinica "G. Salvatore," University of Catanzaro Magna Graecia, Catanzaro, Italy. perticone@unicz.it},
	keywords = {Adult, blood, Blood Pressure, methods, Risk, diagnosis, Human, drug effects, Endothelium,Vascular, United States, Cardiovascular Diseases, Disease Progression, Hypertension, physiopathology, Risk Factors, administration \& dosage, Blood Flow Velocity, drug therapy, Female, Male, Middle Age, therapeutic use, Myocardial Infarction, Follow-Up Studies, Prospective Studies, Risk Assessment, Vasodilation, Predictive Value of Tests, Acetylcholine, blood supply, Vasodilator Agents, Prognosis, Forearm, Antihypertensive Agents, Nitroprusside, Proportional Hazards Models, Dose-Response Relationship,Drug, Infusions,Intra-Arterial, Disease-Free Survival},
