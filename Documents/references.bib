	note = {Place: Division of Geriatric Medicine, University of Pittsburgh, Pa 15213, USA. anewman@pitt.edu},
	keywords = {Adult, Atherosclerosis, methods, Human, Support,U.S.Gov't,P.H.S., Cardiovascular Diseases, Risk Factors, Aged, Female, Male, Disease, epidemiology, Multicenter Studies, Arteries, Coronary Disease, Sensitivity and Specificity, pathology, Coronary Arteriosclerosis, Tunica Intima, Tunica Media, Prevalence, Aged,80 and over, Calcinosis, Tomography,X-Ray Computed, Sex Factors, Carotid Arteries, Demography, Calcium, Cohort Studies, Carotid Stenosis},
