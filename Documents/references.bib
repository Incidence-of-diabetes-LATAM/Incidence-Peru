	keywords = {Obesity, Risk Factors, Female, Male, Humans, Prevalence, Child, China, Adolescent, Socioeconomic Factors, Retrospective Studies, Overweight, Overweight: epidemiology, Obesity: epidemiology, Urban Population, Nutrition Surveys, China: epidemiology},
	pages = {1--10},
