	pages = {200--207},
	file = {Forouhi e.a. - 2007 - Incidence of Type 2 diabetes in England and its as.pdf:/Users/planetarium/Zotero/storage/5HVJECTV/Forouhi e.a. - 2007 - Incidence of Type 2 diabetes in England and its as.pdf:application/pdf},
}

