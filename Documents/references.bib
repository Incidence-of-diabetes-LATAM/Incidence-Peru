	keywords = {Adult, blood, Cholesterol, Fasting, Glucose, Insulin, Lipids, Research, Risk, Syndrome, Human, metabolism, Support,U.S.Gov't,P.H.S., United States, Cardiovascular Diseases, Risk Factors, Aged, Female, Male, epidemiology, Body Mass Index, etiology, Blood Glucose, Epidemiologic Studies, Vascular Resistance, Body Composition, Models,Theoretical, Florida},
	pages = {765--776},
