@article{gordon-larsen_longitudinal_2010,
	title = {Longitudinal trends in obesity in the {United} {States} from adolescence to the third decade of life.},
	volume = {18},
	url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=2929301&tool=pmcentrez&rendertype=abstract},
	doi = {10.1038/oby.2009.451},
	abstract = {No longitudinal analyses using national data have evaluated the increase in obesity from adolescence into early adulthood. We examined obesity incidence, persistence, and reversal in a nationally representative cohort of US teens followed into their early 30s, using measured height and weight data, in individuals enrolled in wave II (1996; 12-21 years), wave III (2001; 17-26 years), and wave IV (2008 early release data; 24-32 years) of the National Longitudinal Study of Adolescent Health (N = 8,675). Obesity was defined as a BMI {\textgreater}or=95th percentile of the 2000 Centers for Disease Control/National Center for Health Statistics growth charts or {\textgreater}or=30 kg/m(2) for individuals {\textless}20 years and {\textgreater}or=30 kg/m(2) in individuals {\textgreater}or=20 years. In 1996, 13.3\% of adolescents were obese. By 2008, obesity prevalence increased to 36.1\%, and was highest among non-Hispanic black females (54.8\%). Ninety percent of the obese adolescents remained obese in 2008. While annual obesity incidence did not decline in the total sample across the two study intervals (2.3\% per year 1996-2001 vs. 2.2\% per year 2001-2008), rates among white females declined (2.7 to 1.9\% per year) and were highest among non-Hispanic black and Hispanic females (3.8 and 2.7\% per year, 1996-2001 vs. 3.0 and 2.6\% per year, 2002-2008, respectively). Obesity prevalence doubled from adolescence to the early 20s, and doubled again from the early to late 20s or early 30s, with strong tracking from adolescence into adulthood. This trend is likely to continue owing to high rates of pediatric obesity. Effective preventive and treatment efforts are critically needed.},
	number = {9},
	journal = {Obesity (Silver Spring, Md.)},
	author = {Gordon-Larsen, Penny and The, Natalie S and Adair, Linda S},
	month = sep,
	year = {2010},
	keywords = {Adult, Obesity, United States, Female, Male, Humans, Longitudinal Studies, Body Mass Index, Prevalence, Sex Distribution, Child, Adolescent, European Continental Ancestry Group, Young Adult, Obesity: epidemiology, African Americans, Obesity: ethnology, United States: epidemiology},
	pages = {1801--4},
}

@article{wennberg_self-rated_2013,
	title = {Self-rated health and type 2 diabetes risk in the {European} {Prospective} {Investigation} into {Cancer} and {Nutrition}-{InterAct} study: a case-cohort study.},
	volume = {3},
	url = {http://www.pubmedcentral.nih.gov/articlerender.fcgi?artid=3612773&tool=pmcentrez&rendertype=abstract},
	doi = {10.1136/bmjopen-2012-002436},
	abstract = {OBJECTIVES: To investigate the association between self-rated health and risk of type 2 diabetes and whether the strength of this association is consistent across five European centres.

DESIGN: Population-based prospective case-cohort study.

SETTING: Enrolment took place between 1992 and 2000 in five European centres (Bilthoven, Cambridge, Heidelberg, Potsdam and Umeå).

PARTICIPANTS: Self-rated health was assessed by a baseline questionnaire in 3399 incident type 2 diabetic case participants and a centre-stratified subcohort of 4619 individuals from the European Prospective Investigation into Cancer and Nutrition (EPIC)-InterAct study which was drawn from a total cohort of 340 234 participants in the EPIC.

PRIMARY OUTCOME MEASURE: Prentice-weighted Cox regression was used to estimate centre-specific HRs and 95\% CIs for incident type 2 diabetes controlling for age, sex, centre, education, body mass index (BMI), smoking, alcohol consumption, energy intake, physical activity and hypertension. The centre-specific HRs were pooled across centres by random effects meta-analysis.

RESULTS: Low self-rated health was associated with a higher hazard of type 2 diabetes after adjusting for age and sex (pooled HR 1.67, 95\% CI 1.48 to 1.88). After additional adjustment for health-related variables including BMI, the association was attenuated but remained statistically significant (pooled HR 1.29, 95\% CI 1.09 to 1.53). I(2) index for heterogeneity across centres was 13.3\% (p=0.33).

CONCLUSIONS: Low self-rated health was associated with a higher risk of type 2 diabetes. The association could be only partly explained by other health-related variables, of which obesity was the strongest. We found no indication of heterogeneity in the association between self-rated health and type 2 diabetes mellitus across the European centres.},
	number = {3},
	journal = {BMJ open},
	author = {Wennberg, Patrik and Rolandsson, Olov and van der A, Daphne L and Spijkerman, Annemieke M W and Kaaks, Rudolf and Boeing, Heiner and Feller, Silke and Bergmann, Manuela M and Langenberg, Claudia and Sharp, Stephen J and Forouhi, Nita and Riboli, Elio and Wareham, Nicholas},
	month = jan,
	year = {2013},
	pages = {1--8},
}

@article{malik_global_2013,
	title = {Global obesity: trends, risk factors and policy implications.},
	volume = {9},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/23165161},
	doi = {10.1038/nrendo.2012.199},
	abstract = {The worldwide increase in obesity and related chronic diseases has largely been driven by global trade liberalization, economic growth and rapid urbanization. These factors continue to fuel dramatic changes in living environments, diets and lifestyles in ways that promote positive energy balance. Nutritional transitions in low-income and middle-income countries are typically characterized by increases in the consumption of animal fat and protein, refined grains, and added sugar. This change is coupled with reductions in physical activity owing to more mechanized and technologically driven lifestyles. Given the high costs of obesity and comorbidities in terms of health-care expenditure and quality of life, prevention strategies are paramount, particularly in low-income and middle-income countries that must manage coexisting infectious diseases and undernutrition in addition to the obesity epidemic. As countries become increasingly urbanized, undernutrition and obesity can exist side by side within the same country, community or household, which is a particular challenge for health systems with limited resources. Owing to the scope and complexity of the obesity epidemic, prevention strategies and policies across multiple levels are needed in order to have a measurable effect. Changes should include high-level global policies from the international community and coordinated efforts by governments, organizations, communities and individuals to positively influence behavioural change.},
	number = {1},
	journal = {Nature reviews. Endocrinology},
	publisher = {Nature Publishing Group},
	author = {Malik, Vasanti S and Willett, Walter C and Hu, Frank B},
	month = jan,
	year = {2013},
	keywords = {Obesity, Risk Factors, Humans, World Health, Life Style, Obesity: epidemiology, Health Promotion},
	pages = {13--27},
}

