	note = {Place: Department of Human Biology, Nutrition and Toxicology Research Institute Maastricht (NUTRIM), Maastricht University, P.O. Box 616, 6200 MD Maastricht, Netherlands. m.mensink@hb.unimaas.nl},
	keywords = {blood, Fasting, Glucose, methods, Research, Risk, Human, metabolism, Middle Aged, Risk Factors, Female, Male, epidemiology, Humans, Research Support,Non-U.S.Gov't, Blood Glucose, Diabetes Mellitus,Type 2, Life Style, prevention \& control, Family, history, Prevalence, Netherlands, Homeostasis, Glucose Intolerance, Glucose Tolerance Test, Mass Screening, Diet, psychology, Exercise Test, Energy Metabolism, Nutrition, Intervention Studies, Physical Examination},
