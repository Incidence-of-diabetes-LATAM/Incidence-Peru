	year = {2000},
	note = {Place: Department of Statistics, University of Auckland, Private Bag 92019, 1, Auckland, New Zealand. p.metcalf@auckland.ac.nz},
	keywords = {Adult, analysis, blood, Blood Pressure, Fasting, Glucose, Men, Pressure, Risk, Women, diagnosis, Comparative Study, United States, Middle Aged, Cardiovascular Diseases, Hypertension, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, Research Support,Non-U.S.Gov't, Ethnic Groups, World Health, Blood Glucose, Diabetes Mellitus, Reference Values, Prevalence, World Health Organization, 1998, Glucose Intolerance, Glucose Tolerance Test, New Zealand, Statistics, Voluntary Health Agencies},
