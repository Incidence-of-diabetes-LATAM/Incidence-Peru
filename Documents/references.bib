	note = {Place: British Heart Foundation Laboratories, Department of Medicine, Centre for Cardiovascular Genetics, Rayne Building, University College London, 5 University Street, London WC1E 6JF, UK. p.talmud@ucl.ac.uk},
	keywords = {Adult, Cholesterol, Incidence, Men, Odds Ratio, Risk, Middle Aged, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, London, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., Myocardial Infarction, Heart, Coronary Disease, Plasma, Prospective Studies, Smoking, Prevalence, Aged,80 and over, genetics, Genotype, Cohort Studies, Homozygote, Laboratories, Apolipoproteins, Apolipoproteins E},
