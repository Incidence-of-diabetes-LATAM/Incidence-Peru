	author = {Yoon, H C and Emerick, A M and Hill, J A and Gjertson, D W and Goldin, J G},
	month = jul,
	year = {2002},
	note = {Place: Department of Diagnostic Imaging, Kaiser Moanalua Medical Center, 3288 Moanalua Rd, Honolulu, HI 96819, USA. Hyo-Chun.Yoon@kp.org},
	keywords = {11, Adult, methods, Risk, Sex, Human, metabolism, Disease Progression, Hypertension, Risk Factors, Aged, Female, Male, Middle Age, Age Factors, Arteries, Heart, Aged,80 and over, Calcinosis, Tomography,X-Ray Computed, Coronary Vessels, Sex Factors, Calcium, Retrospective Studies, Models,Theoretical, Diagnostic Imaging},
