	keywords = {Adult, blood, Blood Pressure, methods, Sex, Human, Endothelium,Vascular, Support,Non-U.S.Gov't, Hypertension, physiology, physiopathology, Brachial Artery, Female, Male, Middle Age, Arteries, Heart, Follow-Up Studies, Prospective Studies, Dilatation, Reference Values, Vasodilation, England, Cardiology, Hyperemia, Postoperative Period, surgery, Endothelin-1, Heart Rate, Osmolar Concentration, Liver, Blood Pressure Determination, Blood Pressure Monitoring,Ambulatory, Office Visits, Liver Failure, Liver Transplantation},
	pages = {1359--1367},
