	month = may,
	year = {2003},
	note = {Place: Endocrine Unit, Division of Endocrinology, Diabetes and Nutrition, Department of Internal Medicine, University Hospital Geneva, 24 rue Micheli-du-Crest, CH-1211 Geneva 14, Switzerland},
