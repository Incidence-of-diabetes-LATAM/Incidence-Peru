}

@article{anan_correlations_2007,
	title = {Correlations of urinary albumin excretion and atherosclerosis in {Japanese} type 2 diabetic patients},
	volume = {77},
	abstract = {Microalbuminuria and aortic stiffness are associated with high mortality in type 2 diabetic patients. We tested the hypothesis that the presence of microalbuminuria correlates with aortic stiffness and insulin resistance in type 2 diabetic patients. The study consisted of 36 Japanese patients with type 2 diabetes and microalbuminuria (age: 56+/-9 years, mean+/-S.D.) and a control group of 44 age-matched patients with normoalbuminuria (56+/-7 years). Brachial-ankle pulse wave velocity (BaPWV) was measured by automatic oscillometric method. BaPWV was used as an index of atherosclerosis. The BaPWV was higher in the microalbuminuria group than in the normoalbuminuria group (p{\textless}0.005). Fasting plasma glucose (p{\textless}0.05) and insulin concentrations (p{\textless}0.005), and the homeostasis model assessment (HOMA) index (p{\textless}0.0005), were higher in the microalbuminuria group than in the normoalbuminuria group. Multiple regression analysis showed that urinary albumin excretion was independently predicted by BaPWV and HOMA index. Our results indicate that the presence of microalbuminuria in Japanese patients with type 2 diabetes is characterized by increased aortic stiffness and insulin resistance, and that the BaPWV, HOMA index are independent predictors of urine albumin excretion},
	number = {0168-8227 (Print) LA - eng PT - Journal Article SB - IM},
	journal = {Diabetes Res.Clin.Pract.},
	author = {Anan, F and Masaki, T and Umeno, Y and Fukunaga, N and Teshima, Y and Iwao, T and Kaneda, K and Yonemochi, H and Eshima, N and Saikawa, T and Yoshimatsu, H},
	month = sep,
	year = {2007},
	note = {Place: Department of Cardiology, Oita Red Cross Hospital, Oita, Japan. anan-f@med.oita-u.ac.jp},
	keywords = {analysis, Atherosclerosis, Fasting, Glucose, Insulin, Insulin Resistance, diagnosis, Middle Aged, Female, Male, Humans, complications, etiology, Diabetes Mellitus,Type 2, Plasma, Japan, Regression Analysis, mortality, Cardiology, Predictive Value of Tests, Homeostasis, Albuminuria, urine, Plethysmography, Pulse, Diabetes Complications, Pulsatile Flow},
