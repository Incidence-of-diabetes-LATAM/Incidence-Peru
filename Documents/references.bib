@article{chandie_shaw_central_2007,
	title = {Central obesity is an independent risk factor for albuminuria in nondiabetic {South} {Asian} subjects},
	volume = {30},
	abstract = {OBJECTIVE: South Asians have a high prevalence of central obesity. When the diagnosis of diabetes is made, they have a very high risk of developing renal failure. In the current study, we explored the hypothesis that central obesity is associated with the development of renal injury, before the manifestation of diabetes. RESEARCH DESIGN AND METHODS: We invited first-degree nondiabetic relatives of South Asian type 2 diabetic patients for investigation of microalbuminuria and diabetes. Subjects who used antihypertensive or antidiabetic medication were excluded. We performed a glucose tolerance test according to the classic World Health Organization criteria. A total of 205 subjects were normoglycemic; we excluded 25 subjects because of impaired glucose tolerance, and 30 subjects were excluded because of de novo diabetes. Central obesity was measured by waist-to-hip ratio (WHR). Albuminuria was measured as albumin-to-creatinine ratio (ACR) in the early-morning urine. RESULTS: Central obesity was independently related with albuminuria in the 205 normoglycemic subjects. We found no relation of fasting blood glucose or systolic blood pressure with albuminuria. Multivariate analysis for the presence of increased albuminuria (median ACR {\textgreater}0.31 mg/mmol) showed a relative risk of 4.1 for the highest versus the lowest tertile of WHR (P = 0.002). CONCLUSIONS: Central obesity is an early and independent risk factor for increased albuminuria in normoglycemic South Asian subjects. This could explain the high incidence of diabetic renal disease in South Asians, probably by the mechanism of insulin resistance and endothelial dysfunction in the pre-diabetic state},
	number = {1935-5548 (Electronic) LA - eng PT - Journal Article PT - Research Support, Non-U.S. Gov't SB - IM},
	journal = {Diabetes Care},
	author = {Chandie Shaw, P K and Berger, S P and Mallat, M and Frolich, M and Dekker, F W and Rabelink, T J},
	month = jul,
	year = {2007},
	note = {Place: Department of Nephrology, Medical Center Haaglanden, Lijnbaan 32, P.O. Box 432, The Hague 2501 CK, The Netherlands. p.chandie@mchaaglanden.nl},
	keywords = {Adult, analysis, blood, Blood Pressure, Fasting, Glucose, Incidence, Insulin, Insulin Resistance, methods, Obesity, Pressure, Research, Research Design, Risk, diagnosis, Middle Aged, Risk Factors, Female, Male, Disease, Humans, complications, etiology, Waist-Hip Ratio, World Health, Blood Glucose, Diabetes Mellitus,Type 2, Kidney Diseases, Multivariate Analysis, Prevalence, Netherlands, World Health Organization, Glucose Tolerance Test, Research Support, Albuminuria, urine, Adiposity, injuries, Prediabetic State, Asian Continental Ancestry Group, Abdominal Fat, Nephrology},
	pages = {1840--1844},
