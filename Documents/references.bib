	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Fasting, Incidence, Insulin, Insulin Resistance, methods, Pressure, Research, Research Design, Risk, Triglycerides, diagnosis, Human, Support,Non-U.S.Gov't, Risk Factors, administration \& dosage, Aged, drug therapy, Middle Age, Disease, epidemiology, London, complications, Body Constitution, Follow-Up Studies, Diabetes Mellitus,Insulin-Dependent, Europe, Logistic Models, Smoking, Biological Markers, Fibrinogen, Diabetic Retinopathy, von Willebrand Factor, Albuminuria, Hemoglobin A,Glycosylated, Adolescent, gamma-Glutamyltransferase},
