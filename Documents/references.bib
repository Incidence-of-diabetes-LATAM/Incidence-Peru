	note = {Place: Diabetes and Arthritis Epidemiology Section, National Institute of Diabetes and Digestive and Kidney Diseases, Phoenix, Arizona 85014, USA. rhanson@phx.niddk.nih.gov},
	keywords = {Adult, analysis, blood, Blood Pressure, Incidence, Insulin, Insulin Resistance, Lipids, Obesity, Pressure, Syndrome, Human, metabolism, Hypertension, Risk Factors, Female, Male, Disease, epidemiology, Humans, 10, Diabetes Mellitus,Type 2, Metabolic Syndrome X, Arizona, Body Constitution, Follow-Up Studies, Hyperglycemia, Hyperinsulinism, Indians,North American, Kidney, Kidney Diseases, Diabetes Mellitus,Type II},
	pages = {3120--3127},
