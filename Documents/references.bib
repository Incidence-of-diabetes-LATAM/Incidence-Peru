	keywords = {Cholesterol, Risk, Sex, Human, Endothelium,Vascular, Support,Non-U.S.Gov't, physiology, Blood Flow Velocity, Brachial Artery, Female, Male, Middle Age, Disease, Linear Models, Body Mass Index, Arteries, Dilatation, Nitroglycerin, ultrasonography, Vasodilation, England, Vasodilator Agents, diagnostic use, urine, Image Processing,Computer-Assisted, Australia, Single-Blind Method, Ultrasonography,Doppler,Pulsed, Tea, F2-Isoprostanes, Chromatography,Gas, Spectrum Analysis,Mass},
