@article{rossing_risk_2002,
	title = {Risk {Factors} for {Development} of {Incipient} and {Overt} {Diabetic} {Nephropathy} in {Type} 1 {Diabetic} {Patients}: {A} 10-year prospective observational study},
	volume = {25},
	issn = {0149-5992, 1935-5548},
	shorttitle = {Risk {Factors} for {Development} of {Incipient} and {Overt} {Diabetic} {Nephropathy} in {Type} 1 {Diabetic} {Patients}},
	url = {http://care.diabetesjournals.org/cgi/doi/10.2337/diacare.25.5.859},
	doi = {10.2337/diacare.25.5.859},
	abstract = {OBJECTIVE — To evaluate prospectively putative risk factors for development of microalbuminuria and macroalbuminuria in type 1 diabetes. RESEARCH DESIGN AND METHODS — Prospective observational study of a cohort of type 1 diabetic patients followed in the outpatient clinic at Steno Diabetes Center for Յ10 years (median 9 years). We followed 537 patients aged Ն18 years with type 1 diabetes, with duration of diabetes Ն5 years, with normoalbuminuria (urinary albumin excretion rate Յ30 mg/24 h), and who were not taking antihypertensive medication. Risk factors for development of microalbuminuria and macroalbuminuria were evaluated.
RESULTS — The mean progression of urinary albumin excretion rate was 7.6\% (SE 0.8) per year. During follow-up, 134 patients (25\%) progressed to persistent microalbuminuria or macroalbuminuria (Ͼ30 mg/24 h in two of three consecutive urine samples). Cox multiple regression analysis using baseline values of putative predictors of progression showed the following signiﬁcant predictors of progression from normoalbuminuria to microalbuminuria or macroalbuminuria: baseline log urinary albumin excretion rate 2.63 (relative risk; 95\% CI 1.65–4.19), HbA1c 1.13\% (1.04 –1.23), presence of any retinopathy 1.90 (1.26 –2.88), and smoking 1.61 (1.11–2.33). Sex, duration of diabetes, arterial blood pressure, serum creatinine, height, and social class were not risk factors.
CONCLUSIONS — Our study suggests that several potentially modiﬁable risk factors predict the development of microalbuminuria and macroalbuminuria in type 1 diabetic patients.},
	language = {en},
	number = {5},
	urldate = {2021-02-14},
	journal = {Diabetes Care},
	author = {Rossing, P. and Hougaard, P. and Parving, H.-H.},
	month = may,
	year = {2002},
	pages = {859--864},
	file = {Rossing e.a. - 2002 - Risk Factors for Development of Incipient and Over.pdf:/Users/planetarium/Zotero/storage/F8XECFYC/Rossing e.a. - 2002 - Risk Factors for Development of Incipient and Over.pdf:application/pdf},
}

@article{ross_mendelian_2015,
	title = {Mendelian randomization analysis supports the causal role of dysglycaemia and diabetes in the risk of coronary artery disease},
	volume = {36},
	issn = {0195-668X, 1522-9645},
	url = {https://academic.oup.com/eurheartj/article-lookup/doi/10.1093/eurheartj/ehv083},
	doi = {10.1093/eurheartj/ehv083},
	abstract = {Introduction Type 2 diabetes is a strong risk factor for coronary artery disease (CAD). However, the absence of a clear reduction in CAD by intensive glucose lowering in randomized controlled trials has fuelled uncertainty regarding the causal role of dysglycaemia and CAD. .....................................................................................................................................................................................
Objective To assess whether Mendelian randomization supports a causal role of dysglycaemia and diabetes for risk of CAD. .....................................................................................................................................................................................
Methods Effect size estimates of common genetic variants associated with fasting glucose (FG), glycated haemoglobin (HbA1c), and diabetes were obtained from the Meta-Analyses of Glucose and Insulin-Related Traits Consortium and Diabetes Genetics Replication and Meta-Analysis consortia. The corresponding effect estimates of these single nucleotide polymorphisms (SNPs) on the risk of CAD were then evaluated in CARDIOGRAMplusC4D. .....................................................................................................................................................................................
Results SNPs associated with HbA1c and diabetes were associated with an increased risk of CAD. Using information from 59 genetic variants associated with diabetes, the causal effect of diabetes on the risk of CAD was estimated at an odds ratio (OR) of 1.63 (95\% Conﬁdence Interval (CI): 1.23–2.07; P ¼ 0.002). On the other hand, nine genetic variants associated with HbA1c were associated with an OR of 1.53 per 1\% HbA1c increase (95\% CI: 1.14–2.05; P ¼ 0.023) in the risk of CAD while this effect was non-signiﬁcant among 30 genetic variants associated with FG per mmol/L (OR: 1.18, 95\% CI: 0.97–1.42; P ¼ 0.102). No signiﬁcant differences were observed when categorizing genetic loci according to their effect on either b-cell dysfunction or insulin resistance. .....................................................................................................................................................................................
Conclusions},
	language = {en},
	number = {23},
	urldate = {2021-02-14},
	journal = {European Heart Journal},
	author = {Ross, Stephanie and Gerstein, Hertzel C. and Eikelboom, John and Anand, Sonia S. and Yusuf, Salim and Paré, Guillaume},
	month = jun,
	year = {2015},
	pages = {1454--1462},
	file = {Ross e.a. - 2015 - Mendelian randomization analysis supports the caus.pdf:/Users/planetarium/Zotero/storage/5INXP5RL/Ross e.a. - 2015 - Mendelian randomization analysis supports the caus.pdf:application/pdf},
}

@article{ross_pre-motor_2012-1,
