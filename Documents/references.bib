	month = mar,
	year = {2003},
	note = {Place: Department of Medicine, Division of Nephrology, Helsinki University Central Hospital, Helsinki, Finland},
	keywords = {Adult, Human, Cardiovascular Diseases, Female, Male, Disease, complications, etiology, Myocardial Infarction, Heart, Diabetes Mellitus, genetics, Genotype, Polymerase Chain Reaction, Polymorphism (Genetics), Diabetic Nephropathies, Glycosylation, Albuminuria, Homozygote, Finland, Non-U.S.Gov't, Support, Insulin-Dependent, Promoter Regions (Genetics), Proteinuria, Receptors, Immunologic},
