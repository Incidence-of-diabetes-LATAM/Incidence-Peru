@article{aviram_human_2000,
	title = {Human serum paraoxonases ({PON1}) {Q} and {R} selectively decrease lipid peroxides in human coronary and carotid atherosclerotic lesions: {PON1} esterase and peroxidase-like activities},
	volume = {101},
	abstract = {BACKGROUND: Human serum paraoxonase (PON1) exists in two polymorphic forms: one that differs in the amino acid at position 192 (glutamine and arginine, Q and R, respectively) and the second one that differs in the amino acid at position 55 (methionine and leucine, M and L, respectively). PON1 protects LDL from oxidation, and during LDL oxidation, PON1 is inactivated. METHODS AND RESULTS: The present study compared PON1 isoforms Q and R for their effect on lipid peroxide content in human coronary and carotid lesions. After 24 hours of incubation with PON1Q or PON1R (10 arylesterase units/mL), lipid peroxides content in both coronary and carotid lesion homogenates (0.1 g/mL) was reduced up to 27\% and 16\%, respectively. The above incubation was associated with inactivation of PON1Q and PON1R by 15\% and 45\%, respectively. Lesion cholesteryl linoleate hydroperoxides and cholesteryl linoleate hydroxides were hydrolyzed by PON1 to yield linoleic acid hydroperoxides and linoleic acid hydroxides. Furthermore, lesion and pure linoleic acid hydroperoxides were reduced to yield linoleic acid hydroxides. These results thus indicate that PON1 demonstrates esterase-like and peroxidase-like activities. Recombinant PON1 mutants in which the PON1-free sulfhydryl group at cysteine-284 was replaced with either alanine or serine were no longer able to reduce lipid peroxide content in carotid lesions. CONCLUSIONS: We conclude that PON1 may be antiatherogenic because it hydrolyzes lipid peroxides in human atherosclerotic lesions},
