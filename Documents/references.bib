	note = {Place: Department of Epidemiology, School of Public Health and Community Medicine, University of Washington, Seattle 98195-7236, USA},
	keywords = {blood, Cholesterol, Risk, Triglycerides, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Cardiovascular Diseases, Risk Factors, Female, Male, Disease, epidemiology, complications, Arteries, Community Medicine, Coronary Disease, Epidemiologic Studies, Hypertriglyceridemia, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Meta-Analysis, Multivariate Analysis, Particle Size, Plasma, Prospective Studies, Washington},
