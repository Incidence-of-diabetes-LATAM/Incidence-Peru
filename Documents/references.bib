	month = dec,
	year = {1999},
	note = {Place: Department of Public Health and Clinical Medicine, Umea University, Sweden. bernt.lindahl@medicin.umu.se},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Men, methods, Obesity, Pressure, Research, Research Design, Risk, Triglycerides, Women, Middle Aged, Cardiovascular Diseases, Risk Factors, Aged, Female, Male, Humans, Research Support,Non-U.S.Gov't, Body Mass Index, etiology, Blood Glucose, Lipoproteins, Lipoproteins,HDL Cholesterol, Plasma, Glucose Intolerance, Glucose Tolerance Test, Mass Screening, Cross-Sectional Studies, Sweden, Clinical Medicine, Physical Examination},
