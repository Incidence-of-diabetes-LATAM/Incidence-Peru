	keywords = {Adult, blood, Blood Pressure, Cholesterol, Human, therapy, Comparative Study, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, physiology, administration \& dosage, Aged, Brachial Artery, drug therapy, Male, Middle Age, Disease, Linear Models, Arteries, Coronary Disease, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Multivariate Analysis, Dilatation, Reference Values, ultrasonography, pathology, Coronary Angiography, radiography, Coronary Vessels, Cross-Sectional Studies, Analysis of Variance, Finland, Hydroxymethylglutaryl-CoA Reductase Inhibitors, Vascular Patency},
