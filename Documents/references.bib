}

@article{gnecchi-ruscone_morning_1994,
	title = {Morning and {Monday}: critical periods for the onset of acute myocardial infarction. {The} {GISSI} 2 {Study} experience},
	volume = {15},
	abstract = {The onset of acute myocardial infarction (AMI) is unevenly distributed over the 24 h and the week. While presence of a morning peak is generally agreed upon, contrasting results had been obtained regarding other periods of the day, probably due to differences of origin, size and composition of the populations. The 24 h and weekly distributions were studied within 6 h from the beginning of the symptoms in a population following a Latin life-style, who were enrolled in the GISSI 2 Study (n = 11472). Subgroups (smokers, the elderly ({\textgreater} 65 years), diabetics, hypertensives) were also considered. Six hour periods starting at midnight were tested for uniformity. Circadian non-uniformity was found. Events increased in the morning hours and reduced during the night regardless of the day of the week. The night and day difference was attenuated in smokers and diabetics. Non-uniformity of the events was also found among the days of the week. AMI significantly increased in non-smokers on Monday. We suggest that there is a night-day gradient (characterized by the short time interval between the two frequency extremes) in the time of onset of AMI. The different distribution in smokers stresses the possible unfavourable and masking effect of a heightened sympathetic tone during the day while the general protective role of the night hours is preserved. Moreover, the increased incidence of events on Monday may suggest the importance of the shift from a period of non-scheduled to scheduled activity},
	number = {0195-668X LA - eng PT - Clinical Trial PT - Journal Article PT - Multicenter Study PT - Randomized Controlled Trial},
	journal = {Eur.Heart J.},
	author = {Gnecchi-Ruscone, T and Piccaluga, E and Guzzetti, S and Contini, M and Montano, N and Nicolis, E},
	month = jul,
	year = {1994},
	note = {Place: Servizio di Cardiologia, Ospedale S. Leopoldo Mandic, Merate (Co), Italy},
	keywords = {Incidence, Human, Hypertension, Risk Factors, Aged, drug therapy, Female, Male, Middle Age, therapeutic use, Time Factors, epidemiology, Time, Multicenter Studies, Myocardial Infarction, Life Style, Diabetes Mellitus, England, Smoking, Prevalence, Stress, Italy, Circadian Rhythm, Retrospective Studies, Fibrinolytic Agents},
	pages = {882--887},
	annote = {UI - 95010181},
}

@article{kahn_metabolic_2003,
	title = {Metabolic risks identified by the combination of enlarged waist and elevated triacylglycerol concentration},
	volume = {78},
	abstract = {BACKGROUND: Abdominal fat and circulating triacylglycerols increase with age, which indicates lipid overaccumulation. Enlarged waist (EW) with elevated triacylglycerols (ET) could identify adults at metabolic risk. OBJECTIVE: Using thresholds for EW and ET observed among the youngest adults, we estimated for all adults the prevalence of combined EW and ET (EWET) and described the metabolic risks associated with EWET. DESIGN: In a cross-sectional, weighted sample of 9183 adults, we used two-dimensional displays to provide thresholds for EW (men: {\textgreater} or = 95 cm; women: {\textgreater} or = 88 cm) and fasting ET ({\textgreater} or = 1.45 mmol/L) and estimated the characteristics of EWET among adults of all ages. RESULTS: The population prevalence of EWET in 18-24-y-olds was 6\%; it rose with age until age 55-74 y (prevalence: 43\%) and then was lower among the elderly. Persons with EWET were more likely (P {\textless} 0.0001) to have adverse mean (+/- SEE) concentrations of risk variables in adjusted analyses (fasting insulin: 43 +/- 3 pmol/L; HDL cholesterol: -0.27 +/- 0.02 mmol/L; apolipoprotein B: 0.20 +/- 0.01 g/L; fasting glucose: 0.71 +/- 0.07 mmol/L; uric acid: 50 +/- 2 micromol/L) and to have diabetes (relative risk: 3.2) than were persons without EWET. Compared with a similar-size subpopulation with high body mass index, persons with EWET were older and had more dyslipidemia, hyperglycemia, and hyperuricemia. Compared with "metabolic syndrome," EWET identified more persons who were younger and had greater LDL-cholesterol and apolipoprotein B concentrations. Compared with "prediabetes," EWET identified more persons with hyperinsulinemia, dyslipidemia, and hyperuricemia. CONCLUSIONS: EWET identifies a syndrome of lipid overaccumulation associated with metabolic risk and accelerated mortality after middle age. Prospective studies should evaluate this simple indicator},
	number = {0002-9165 LA - eng PT - Journal Article RN - 0 (Apolipoproteins B) RN - 0 (Blood Glucose) RN - 0 (Hepatitis B Antigens) RN - 0 (Lipoproteins, HDL Cholesterol) RN - 0 (Lipoproteins, LDL Cholesterol) RN - 0 (Triglycerides) RN - 11061-68-0 (Insulin) RN - 69-},
	journal = {Am.J.Clin.Nutr.},
	author = {Kahn, H S and Valdez, R},
	month = nov,
	year = {2003},
	note = {Place: Division of Diabetes Translation, National Center for Chronic Disease Prevention and Health Promotion, Centers for Disease Control and Prevention, Atlanta, GA 30341-3717, USA. hkahn@cdc.gov},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Insulin, Men, Risk, Syndrome, Triglycerides, Women, Human, Middle Aged, Risk Factors, Aged, Female, Male, Middle Age, Disease, epidemiology, Body Mass Index, Blood Glucose, Metabolic Syndrome X, Body Constitution, Hyperglycemia, Lipoproteins, Lipoproteins,HDL Cholesterol, Lipoproteins,LDL Cholesterol, Prospective Studies, Diabetes Mellitus, mortality, Prevalence, Aged,80 and over, Glucose Tolerance Test, Uric Acid, Chronic Disease, Cross-Sectional Studies, Hyperinsulinemia, Antigens, Adolescent, Apolipoproteins, Health Promotion, Apolipoproteins B, Nutrition Surveys, Hepatitis B Antigens},
