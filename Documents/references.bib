	pages = {903--914},
	file = {Mackenbach e.a. - 2011 - Sharp upturn of life expectancy in the Netherlands.pdf:/Users/planetarium/Zotero/storage/FMR528EG/Mackenbach e.a. - 2011 - Sharp upturn of life expectancy in the Netherlands.pdf:application/pdf},
}

