	keywords = {blood, methods, Sex, Human, Comparative Study, metabolism, Support,U.S.Gov't,P.H.S., Middle Aged, physiopathology, Female, Male, Age Factors, Disease, Humans, Research Support,U.S.Gov't,P.H.S., Ethnic Groups, Regression Analysis, Statistics,Nonparametric, England, Chronic Disease, Creatinine, Cross-Sectional Studies, Diet, diet therapy, Glomerular Filtration Rate, Kidney Failure,Chronic, Serum Albumin, Sex Factors, Urea},
