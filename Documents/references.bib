	journal = {Diabetes},
	author = {Schalkwijk, C G and Ligtvoet, N and Twaalfhoven, H and Jager, A and Blaauwgeers, H G and Schlingemann, R O and Tarnow, L and Parving, H H and Stehouwer, C D and van Hinsbergh, V W},
	month = dec,
	year = {1999},
	note = {Place: Department of Clinical Chemistry, Academic Hospital Vrije Universiteit, Amsterdam, The Netherlands. c.schalkwijk@azvu.nl},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Glucose, Odds Ratio, Pressure, Sex, Triglycerides, Human, E-Selectin, Endothelium,Vascular, Support,Non-U.S.Gov't, Vascular Cell Adhesion Molecule-1, Cell Adhesion, cytology, physiopathology, Aged, Middle Age, Disease, complications, Plasma, Diabetes Mellitus,Insulin-Dependent, Reference Values, pathology, Biological Markers, Netherlands, Aged,80 and over, chemistry, Creatinine, Serum Albumin, Enzyme-Linked Immunosorbent Assay, Antibodies, Capillaries, Diabetic Nephropathies, Diabetic Retinopathy, Glycosylation, Proteins, Retina, Retinal Vessels, von Willebrand Factor},
