@article{kim_separate_2010,
	title = {The separate and joint effects of prolonged {QT} interval and heart rate on mortality},
	volume = {209},
	issn = {00219150},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0021915009007795},
	doi = {10.1016/j.atherosclerosis.2009.09.026},
	abstract = {Objectives: Understanding why prolonged Bazett-corrected QT interval (QTc) is a risk factor for mortality is difﬁcult, because QTc is positively correlated with heart rate. To optimally distinguish the effects of QT interval and heart rate on mortality, QT interval and heart rate were modeled separately and jointly in Pima Indians.
Methods: The effects of QT and heart rate on all-cause and cause-speciﬁc mortality were assessed in the overall study population and according to the presence or absence of diabetes using multivariable time-dependent proportional hazards models.
Results: Among 1488 nondiabetic and 990 diabetic subjects ≥25 years old, 81 nondiabetic and 149 diabetic subjects died during a median follow-up of 7.3 years. When included in the same regression model, QT and heart rate each predicted all-cause mortality [hazard ratios per standard deviation (SD) (95\% conﬁdence interval) = 1.31 (1.10–1.57) and 1.57 (1.32–1.87) respectively]. In nondiabetic subjects, hazard ratios for all-cause mortality were 1.54 (1.19–1.99) for QT and 1.86 (1.46–2.37) for heart rate. In diabetic subjects, hazard ratios for all-cause mortality were lower, 1.27 (1.00–1.62) for QT and 1.41 (1.12–1.78) for heart rate. In the overall study population, neither QT nor heart rate signiﬁcantly predicted cardiovascular disease (CVD) mortality [hazard ratios = 1.13 (0.77–1.64) and 1.46 (0.98–2.19)] when adjusted for each other. Heart rate unadjusted for QT, however, predicted CVD mortality [hazard ratio = 1.34 (1.00–1.79)] in a separate model.
Conclusions: QT prolongation and high heart rate both predict all-cause mortality in Pima Indians, but heart rate was consistently the stronger predictor of the two.},
	language = {en},
	number = {2},
	urldate = {2021-02-13},
	journal = {Atherosclerosis},
	author = {Kim, Nan Hee and Pavkov, Meda E. and Nelson, Robert G. and Hanson, Robert L. and Bennett, Peter H. and Curtis, Jeffrey M. and Sievers, Maurice L. and Knowler, William C.},
	month = apr,
	year = {2010},
	keywords = {Mortality, Cardiovascular disease, Heart rate, QT interval},
	pages = {539--544},
	file = {Kim e.a. - 2010 - The separate and joint effects of prolonged QT int.pdf:/Users/planetarium/Zotero/storage/HP4I6RG5/Kim e.a. - 2010 - The separate and joint effects of prolonged QT int.pdf:application/pdf},
}

@article{kim_association_2010,
	title = {Association {Between} {Iron} {Deficiency} and {A1C} {Levels} {Among} {Adults} {Without} {Diabetes} in the {National} {Health} and {Nutrition} {Examination} {Survey}, 1999-2006},
	volume = {33},
	issn = {0149-5992, 1935-5548},
	url = {http://care.diabetesjournals.org/cgi/doi/10.2337/dc09-0836},
	doi = {10.2337/dc09-0836},
	abstract = {OBJECTIVE — Iron deﬁciency has been reported to elevate A1C levels apart from glycemia. We examined the inﬂuence of iron deﬁciency on A1C distribution among adults without diabetes. RESEARCH DESIGN AND METHODS — Participants included adults without selfreported diabetes or chronic kidney disease in the National Health and Nutrition Examination Survey 1999 –2006 who were aged Ն18 years of age and had complete blood counts, iron studies, and A1C levels. Iron deﬁciency was deﬁned as at least two abnormalities including free erythrocyte protoporphyrin Ͼ70 ␮g/dl erythrocytes, transferrin saturation Ͻ16\%, or serum ferritin Յ15 ␮g/l. Anemia was deﬁned as hemoglobin Ͻ13.5 g/dl in men and Ͻ12.0 g/dl in women.
RESULTS — Among women (n ϭ 6,666), 13.7\% had iron deﬁciency and 4.0\% had iron deﬁciency anemia. Whereas 316 women with iron deﬁciency had A1C Ն5.5\%, only 32 women with iron deﬁciency had A1C Ն6.5\%. Among men (n ϭ 3,869), only 13 had iron deﬁciency and A1C Ն5.5\%, and only 1 had iron deﬁciency and A1C Ն6.5\%. Among women, iron deﬁciency was associated with a greater odds of A1C Ն5.5\% (odds ratio 1.39 [95\% CI 1.11–1.73]) after adjustment for age, race/ethnicity, and waist circumference but not with a greater odds of A1C Ն6.5\% (0.79 [0.33–1.85]).
CONCLUSIONS — Iron deﬁciency is common among women and is associated with shifts in A1C distribution from Ͻ5.5 to Ն5.5\%. Further research is needed to examine whether iron deﬁciency is associated with shifts at higher A1C levels.},
	language = {en},
	number = {4},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Kim, C. and Bullard, K. M. and Herman, W. H. and Beckles, G. L.},
	month = apr,
	year = {2010},
	pages = {780--785},
	file = {Kim e.a. - 2010 - Association Between Iron Deficiency and A1C Levels.pdf:/Users/planetarium/Zotero/storage/KRPLJ8AI/Kim e.a. - 2010 - Association Between Iron Deficiency and A1C Levels.pdf:application/pdf},
}

@article{kim_plasma_2008,
	title = {Plasma {Glucose} {Regulation} and {Mortality} in {Pima} {Indians}},
	volume = {31},
	issn = {0149-5992, 1935-5548},
	url = {http://care.diabetesjournals.org/cgi/doi/10.2337/dc07-1850},
	doi = {10.2337/dc07-1850},
	abstract = {OBJECTIVE — To evaluate whether impaired fasting glucose (IFG) and/or impaired glucose tolerance (IGT) are associated with increased risk of mortality and prevalent ischemic heart disease (IHD) and to analyze if the increased risk of death is dependent on subsequent development of diabetes in Pima Indians. RESEARCH DESIGN AND METHODS — A total of 2,993 Pima Indians aged Ն35 years were included. Prevalent IHD, deﬁned by major ischemic electrocardiogram changes, was evaluated according to the following glucose/diabetes categories: normal glucose regulation (NGR), IFG and/or IGT, and diabetic groups by duration. During a median follow-up of 10.4 years, 780 subjects died from natural causes and 156 of these died from IHD. Mortality was analyzed according to the same glucose/diabetes categories at baseline and then as timedependent variables.
RESULTS — Only subjects with diabetes Ն15 years of duration have a higher prevalence of IHD (odds ratio 1.9 [95\% CI 1.4 –2.5]) relative to NGR. In baseline and time-dependent models, age- and sex-adjusted death rates from natural causes and from IHD were similar among the nondiabetic groups. Among diabetic subjects, natural mortality was higher in those with Ն15 years diabetes duration (death rate ratio [DRR] relative to NGR ϭ 2.6 [95\% CI 2.1–3.3]). IHD mortality was higher in subjects with long diabetes duration (DRR for diabetes 10 –15 years ϭ 3.8 [1.5–9.5]; DRR for diabetes Ն15 years ϭ 8.6 [3.8 –19.4]) in the time-dependent model. tality might be overestimated in these studies. Development of diabetes is reported to confound the relationship between baseline IFG and mortality (8) but not the relationship between baseline IGT and mortality (9). In Pima Indians, diabetes has a major impact on mortality and causes of death, and the death rate from IHD has increased in recent years in those with diabetes (10). Sufﬁcient numbers of follow-up examinations permit us to account precisely for the future development of diabetes. The speciﬁc purposes of this study are to assess the association between prevalent IHD based on major ischemic electrocardiogram (ECG) changes and plasma glucose and diabetes duration categories, to compare death rates from natural causes and from IHD among these plasma glucose and diabetes duration categories, and to determine whether risk of mortality in IFG and/or IGT groups is dependent on development of diabetes during follow-up.
CONCLUSIONS — Natural and IHD mortality are not increased in Pima Indians with IFG and/or IGT. Only after the onset of diabetes do the rates of these events increase relative to NGR.},
	language = {en},
	number = {3},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Kim, N. H. and Pavkov, M. E. and Looker, H. C. and Nelson, R. G. and Bennett, P. H. and Hanson, R. L. and Curtis, J. M. and Sievers, M. L. and Knowler, W. C.},
	month = mar,
	year = {2008},
	pages = {488--492},
	file = {Kim e.a. - 2008 - Plasma Glucose Regulation and Mortality in Pima In.pdf:/Users/planetarium/Zotero/storage/SVNCW494/Kim e.a. - 2008 - Plasma Glucose Regulation and Mortality in Pima In.pdf:application/pdf},
}

