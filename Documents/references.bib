	month = mar,
	year = {2002},
	note = {Place: Department of Medicine, University of Western Australia, Royal Perth Hospital, Perth, Australia. gfwatts@cyllene.uwa.edu.au},
	keywords = {blood, Blood Pressure, Cholesterol, methods, Triglycerides, Human, Antioxidants, drug effects, Endothelium,Vascular, Nitric Oxide, Support,Non-U.S.Gov't, physiopathology, Brachial Artery, Female, Male, Middle Age, Oxidative Stress, therapeutic use, Arteries, prevention \& control, Lipoproteins, Plasma, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Dilatation, Vasodilation, Regional Blood Flow, analogs \& derivatives, Stress, Hyperemia, Diabetic Angiopathies, Oxygen, Australia, Germany, Placebos, Ubiquinone},
