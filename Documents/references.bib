	keywords = {Adult, Incidence, Middle Aged, Risk Factors, Female, Male, Humans, Body Mass Index, Blood Glucose, Life Style, Hypoglycemic Agents, Diabetes Mellitus, Double-Blind Method, Exercise, Weight Loss, Type 2, Hypoglycemic Agents: therapeutic use, Metformin, Hypoglycemic Agents: adverse effects, Type 2: epidemiology, Blood Glucose: metabolism, Patient Compliance, Energy Intake, Metformin: adverse effects, Metformin: therapeutic use, Type 2: prevention \& control},
