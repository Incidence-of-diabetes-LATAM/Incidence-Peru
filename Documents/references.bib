	note = {Place: Department of Medicine, Division of Cardiology, The Helsinki University Central Hospital, Meilahti 15krs, Haartmaninkatu 4, FIN-00290, Helsinki, Finland. juha.sinisalo@huch.fi},
	keywords = {analysis, blood, Glucose, Risk, diagnosis, Human, Endothelium, Endothelium,Vascular, Support,Non-U.S.Gov't, Inflammation, physiology, physiopathology, Risk Factors, Aged, Male, Middle Age, Heart, Coronary Disease, Reference Values, Regression Analysis, Vasodilation, C-Reactive Protein, Acetylcholine, Infection, Prognosis, Forearm, Plethysmography, Finland, Vasoconstriction, Vascular Patency, Inflammation Mediators},
