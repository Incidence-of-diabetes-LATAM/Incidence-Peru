	keywords = {Adult, analysis, blood, methods, Syndrome, diagnosis, Human, Endothelium,Vascular, metabolism, Support,Non-U.S.Gov't, Case-Control Studies, Aged, Female, Male, Middle Age, Disease, Myocardial Infarction, Arteries, Plasma, Prospective Studies, Biological Markers, Angina Pectoris, In Vitro, Antibodies, injuries, Angina,Unstable, Laboratories, Apoptosis, Flow Cytometry, Antigens,CD31, Integrin alphaV, Platelet Glycoprotein GPIb-IX Complex},
