@article{gastaldelli_fatty_2009,
	title = {Fatty liver is associated with insulin resistance, risk of coronary heart disease, and early atherosclerosis in a large {European} population},
	volume = {49},
	abstract = {Patients with fatty liver (FL) disease have a high risk of developing diabetes and cardiovascular diseases. The aim was to evaluate the association between FL, insulin resistance (IR), coronary heart disease (CHD) risk, and early atherosclerosis in a large European population (RISC Study). In 1,307 nondiabetic subjects (age 30-60 years) recruited at 19 centers, we evaluated liver enzymes, lipids, insulin sensitivity (by euglycemic-hyperinsulinemic clamp), glucose tolerance (by 75 g oral glucose tolerance test), carotid atherosclerosis as intima media thickness (IMT), CHD risk by the Framingham Heart study prediction score, and physical activity (by accelerometer). The presence of FL was estimated using the fatty liver index (FLI; {\textgreater}60, likelihood {\textgreater}78\% presence FL; FLI {\textless}20 likelihood {\textgreater}91\% absence of FL). Subjects were divided into three groups: G1: FLI {\textless}20 (n = 608); G3: FLI {\textgreater}60 (n = 234), G2: intermediate group (n = 465). Compared to G1, G3 included more men (70\% versus 24\%) and people with impaired glucose tolerance (23\% versus 5\%). IMT increased with FLI (G3 = 0.64 +/- 0.08 versus G1 = 0.58 +/- 0.08 mm, P {\textless} 0.0001). FLI was associated with increased CHD risk (r = 0.48), low-density lipoprotein cholesterol (r = 0.33), alanine aminotransferase (r = 0.48), aspartate aminotransferase (r = 0.25), systolic blood pressure (r = 0.39) and IMT (r = 0.30), and reduced insulin sensitivity (r = -0.43), high-density lipoprotein cholesterol (r = -0.50), adiponectin (r = -0.42), and physical activity (r = -0.16, all P {\textless} 0.0001). The correlations hold also in multivariate analysis after adjusting for age, gender, and recruiting center. Conclusion: In middle-age nondiabetic subjects, increased IMT, CHD risk, and reduced insulin sensitivity are associated with high values of FLI},
	number = {5},
	journal = {Hepatology.},
	author = {Gastaldelli, A and Kozakova, M and Hojlund, K and Flyvbjerg, A and Favuzzi, A and Mitrakou, A and Balkau, B},
	month = may,
	year = {2009},
	keywords = {analysis, Atherosclerosis, blood, Blood Pressure, Cholesterol, Glucose, Insulin, Insulin Resistance, Lipids, Men, Pressure, Risk, Cardiovascular Diseases, physiology, Middle Age, Disease, Heart, Multivariate Analysis, Glucose Tolerance Test, Italy, Liver, Adiponectin, Fatty Liver},
	pages = {1537--1544},
