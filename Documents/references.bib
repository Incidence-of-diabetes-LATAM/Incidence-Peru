@article{buterin_liberal_2018,
	title = {Liberal {Radicalism}: {Formal} {Rules} for a {Society} {Neutral} {Among} {Communities}},
	issn = {1556-5068},
	shorttitle = {Liberal {Radicalism}},
	url = {https://www.ssrn.com/abstract=3243656},
	doi = {10.2139/ssrn.3243656},
	abstract = {We propose a design for philanthropic or publicly-funded seeding to allow (near) optimal provision of a decentralized, self-organizing ecosystem of public goods. The concept extends ideas from Quadratic Voting to a funding mechanism for endogenous community formation. Citizens make public goods contributions to projects of value to them. The amount received by the project is (proportional to) the square of the sum of the square roots of contributions received. Under the “standard model” this yields ﬁrst best public goods provision. Variations can limit the cost, help protect against collusion and aid coordination. We discuss applications to campaign ﬁnance, open source software ecosystems, news media ﬁnance and urban public projects. More broadly, we relate our mechanism to political theory, discussing how this solution to the public goods problem may furnish neutral and non-authoritarian rules for society that nonetheless support collective organization.},
	language = {en},
	urldate = {2021-02-13},
	journal = {SSRN Electronic Journal},
	author = {Buterin, Vitalik and Hitzig, Zoë and Weyl, Eric Glen},
	year = {2018},
	file = {Buterin e.a. - 2018 - Liberal Radicalism Formal Rules for a Society Neu.pdf:/Users/planetarium/Zotero/storage/2YHBJFGH/Buterin e.a. - 2018 - Liberal Radicalism Formal Rules for a Society Neu.pdf:application/pdf;Buterin e.a. - 2018 - Liberal Radicalism Formal Rules for a Society Neu.pdf:/Users/planetarium/Zotero/storage/CBT77RBN/Buterin e.a. - 2018 - Liberal Radicalism Formal Rules for a Society Neu.pdf:application/pdf},
}

