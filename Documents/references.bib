@article{nooyens_age_2009,
	title = {Age, period and cohort effects on body weight and body mass index in adults: {The} {Doetinchem} {Cohort} {Study}},
	volume = {12},
	issn = {1368-9800, 1475-2727},
	shorttitle = {Age, period and cohort effects on body weight and body mass index in adults},
	url = {https://www.cambridge.org/core/product/identifier/S1368980008003091/type/journal_article},
	doi = {10.1017/S1368980008003091},
	abstract = {Objective: To study the development of body weight with ageing, in a general adult population, taking into account possible period and cohort effects. Design: A prospective cohort study with 11 years of follow-up. At baseline and after 6 and 11 years, body weight and height were measured. Setting: The Doetinchem Cohort Study, consisting of inhabitants of Doetinchem, a town in a rural area of The Netherlands. Subjects: In total, 4070 healthy men and women aged 20–59 years at baseline.
Results: Increase in BMI with ageing was less profound based on cross-sectional data than based on longitudinal data. More recent-born cohorts had a higher BMI at a given age than cohorts who were born earlier. Increase in mean BMI with ageing was observed in all age groups and was similar for groups with a different educational level. Highest increase in BMI over 11 years was observed in the youngest group, aged 20–29 years at baseline (2?2 [95 \% CL 2?0, 2?3] kg/m2), and lowest increase in the oldest group, aged 50–59 years at baseline (1?1 [1?0, 1?3] kg/m2).
Conclusions: Findings of the present study using longitudinal data suggest that increase in BMI with ageing is underestimated in all age groups by studying crosssectional data only. Further, weight gain is present in all educational levels and does not stop at middle age.},
	language = {en},
	number = {6},
	urldate = {2021-02-14},
	journal = {Public Health Nutrition},
	author = {Nooyens, Astrid CJ and Visscher, Tommy LS and Verschuren, WM Monique and Schuit, A Jantine and Boshuizen, Hendriek C and van Mechelen, Willem and Seidell, Jacob C},
	month = jun,
	year = {2009},
	keywords = {Adult, Obesity, Body Weight, Middle Aged, Female, Male, Age Factors, Humans, Longitudinal Studies, Body Mass Index, Follow-Up Studies, Prospective Studies, Aging, Netherlands, Cross-Sectional Studies, Cohort Studies, Weight Gain, Educational Status, Young Adult, Netherlands: epidemiology, Obesity: epidemiology, Aging: physiology},
	pages = {862--870},
	file = {Nooyens e.a. - 2009 - Age, period and cohort effects on body weight and .pdf:/Users/planetarium/Zotero/storage/4LB6AEWM/Nooyens e.a. - 2009 - Age, period and cohort effects on body weight and .pdf:application/pdf;Nooyens e.a. - 2009 - Age, period and cohort effects on body weight and .pdf:/Users/planetarium/Zotero/storage/RYNTGM4V/Nooyens e.a. - 2009 - Age, period and cohort effects on body weight and .pdf:application/pdf},
