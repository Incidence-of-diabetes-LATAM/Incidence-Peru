	month = aug,
	year = {2000},
	note = {Place: Norwegian University of Science and Technology (NTNU), Faculty of Chemistry and Biology, N-7491 Trondheim, Norway. Tone.F.Bathen@unimed.sintef.no},
	keywords = {Adult, analysis, blood, Cholesterol, Lipids, methods, Triglycerides, Human, Support,Non-U.S.Gov't, Aged, Female, Male, Middle Age, Time, Magnetic Resonance Spectroscopy, Lipoproteins, Multivariate Analysis, Plasma, Regression Analysis, Aged,80 and over, chemistry, Lipoproteins,VLDL, Lipoproteins,HDL, Lipoproteins,LDL, Apolipoproteins, Neoplasms, Algorithms, Neural Networks (Computer)},
