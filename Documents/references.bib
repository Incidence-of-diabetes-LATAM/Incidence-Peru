	keywords = {ogtt, fasting glucose, one-hour glucose, prediction of},
	pages = {336--340},
	file = {Strandberg e.a. - 2013 - Comparison of normal fasting and one-hour glucose .pdf:/Users/planetarium/Zotero/storage/YN7GBGAC/Strandberg e.a. - 2013 - Comparison of normal fasting and one-hour glucose .pdf:application/pdf},
