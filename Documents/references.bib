	keywords = {Adult, blood, Human, Nitric Oxide, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, Hypertension, Risk Factors, Aged, Female, Male, Middle Age, epidemiology, Arteriosclerosis, Japan, Regression Analysis, pathology, Tunica Intima, Biological Markers, analogs \& derivatives, Arginine, Carotid Artery,Common, Enzyme Inhibitors, Nitric-Oxide Synthase, antagonists \& inhibitors},
