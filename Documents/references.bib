	keywords = {Adult, blood, Cholesterol, Research, Risk, Sex, Human, Support,Non-U.S.Gov't, Cardiovascular Diseases, physiology, Risk Factors, adverse effects, Aged, Brachial Artery, Female, Male, Age Factors, Linear Models, etiology, Arteries, Vasodilation, England, Child, Cohort Studies, Infant, Work, Infant,Newborn, Breast Feeding},
	pages = {643--647},
