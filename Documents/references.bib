	title = {Age-{Specific} {Trends} {From} 2000-2011 in {All}-{Cause} and {Cause}-{Specific} {Mortality} in {Type} 1 and {Type} 2 {Diabetes}: {A} {Cohort} {Study} of {More} {Than} {One} {Million} {People}},
