	keywords = {Adult, analysis, blood, methods, Odds Ratio, Research, Research Design, Risk, Triglycerides, Middle Aged, physiopathology, Aged, Disease, Humans, Diabetes Mellitus,Type 2, Heart, Hyperglycemia, Multivariate Analysis, Reference Values, Regression Analysis, Risk Assessment, mortality, pathology, Predictive Value of Tests, Biological Markers, Netherlands, Stress, Hyperlipidemia, Glycosylation, Diabetic Angiopathies, Research Support, Hemoglobin A,Glycosylated, Glycosylation End Products,Advanced, Diabetes Mellitus,Type 1, Skin, Heart Diseases, Fluorescence},
