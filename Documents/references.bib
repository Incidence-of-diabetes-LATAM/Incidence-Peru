	file = {Nyeland e.a. - 2015 - Evaluation of the effectiveness of liraglutide and.pdf:/Users/planetarium/Zotero/storage/DU6G5ZVA/Nyeland e.a. - 2015 - Evaluation of the effectiveness of liraglutide and.pdf:application/pdf},
