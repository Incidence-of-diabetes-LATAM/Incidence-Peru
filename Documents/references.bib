@article{kinlay_endothelium-derived_2001,
	title = {Endothelium-derived nitric oxide regulates arterial elasticity in human arteries in vivo},
	volume = {38},
	abstract = {Arterial elasticity is determined by structural characteristics of the artery wall and by vascular smooth muscle tone. The identity of endogenous vasoactive substances that regulate elasticity has not been defined in humans. We hypothesized that NO, a vasodilator released constitutively by the endothelium, augments arterial elasticity. Seven healthy young men were studied. A 20-MHz intravascular ultrasound catheter was introduced through an arterial sheath to measure brachial artery cross-sectional area, wall thickness, and intra-arterial pressure. After control was established, indices of elasticity (pressure-area relationship, instantaneous compliance, and stress-strain, pressure-incremental elastic modulus (E(inc)), and pressure-pulse wave velocity relationships) were examined over 0 to 100 mm Hg transmural pressure obtained by inflation of an external cuff. Thereafter, the basal production of endothelium-derived NO was inhibited by N(G)-monomethyl-L-arginine (L-NMMA) (4 and 8 mg/min). Finally, nitroglycerin (2.5 and 12.5 microgram/min), an exogenous donor of NO, was given to relax the vascular smooth muscle. Elasticity was measured under all of these conditions. L-NMMA (8 mg/min) decreased brachial artery area (P=0.016) and compliance (P{\textless}0.0001) and increased E(inc) (P{\textless}0.01) and pulse wave velocity (P{\textless}0.0001). Nitroglycerin (12.5 microgram/min) increased brachial artery area (P{\textless}0.001) and compliance (P{\textless}0.001) and decreased pulse wave velocity (P=0.02). NO, an endothelium-derived vasodilator, augments arterial elasticity in the human brachial artery. Loss of constitutively released NO associated with cardiovascular risk factors may adversely affect arterial elasticity in humans},
	number = {1524-4563 LA - eng},
	journal = {Hypertension},
	author = {Kinlay, S and Creager, M A and Fukumoto, M and Hikita, H and Fang, J C and Selwyn, A P and Ganz, P},
	month = nov,
	year = {2001},
	note = {Place: Cardiovascular Division, Brigham and Women's Hospital, Boston, Massachusetts, USA. skinlay@rics.bwh.harvard.edu},
	keywords = {Adult, Blood Pressure, Risk, Human, drug effects, Endothelium, Endothelium,Vascular, metabolism, Nitric Oxide, pharmacology, Support,U.S.Gov't,P.H.S., United States, Cardiovascular Diseases, physiology, Risk Factors, Brachial Artery, Male, etiology, Arteries, Nitroglycerin, omega-N-Methylarginine, Massachusetts, Compliance, Elasticity, Pulse, anatomy \& histology, Anatomy,Cross-Sectional, Enzyme Inhibitors, Nitric Oxide Donors, Stress,Mechanical},
