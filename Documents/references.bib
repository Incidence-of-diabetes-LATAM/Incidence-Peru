	note = {Place: Genetic Epidemiology Division, Department of Medical Informatics, University of Utah, 391 Chipeta Way, Suite D, Salt Lake City, UT 84108-1266, USA. benjamin@genepi.med.utah.edu},
	keywords = {analysis, methods, Risk, United States, Disease, epidemiology, Heart, genetics, Death, Death Certificates, Mitral Valve, Cities, Aortic Diseases},
	pages = {3143--3148},
