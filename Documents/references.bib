	year = {2012},
	keywords = {Genetic, Blood pressure, Diabetes complications, Glycemia, Nephropathy, Retinopathy},
	pages = {388--398},
	file = {Paterson en Bull - 2012 - Does Familial Clustering of Risk Factors for Long-.pdf:/Users/planetarium/Zotero/storage/GLH8X4ZQ/Paterson en Bull - 2012 - Does Familial Clustering of Risk Factors for Long-.pdf:application/pdf},
}

