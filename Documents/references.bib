	keywords = {Adult, analysis, Atherosclerosis, Risk, Sex, Human, metabolism, Support,Non-U.S.Gov't, Alleles, Hypertension, Aged, Female, Male, Middle Age, Arteries, Arteriosclerosis, Diabetes Mellitus, Regression Analysis, pathology, Smoking, chemistry, Lipid Peroxides, genetics, Esterases, Genotype, Polymorphism (Genetics), Homozygote, Finland, Laboratories, Aorta, Mesenteric Arteries, Severity of Illness Index, Constriction,Pathologic, Heterozygote, Aorta,Abdominal, Iliac Artery},
