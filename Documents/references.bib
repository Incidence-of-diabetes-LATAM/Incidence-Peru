	keywords = {Glucose, Men, methods, Risk, Women, diagnosis, Comparative Study, metabolism, Middle Aged, Cardiovascular Diseases, physiology, physiopathology, Aged, Female, Male, Causality, epidemiology, Humans, London, Public Health, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., complications, Diabetes Mellitus,Type 2, Hyperglycemia, Hyperinsulinism, Prospective Studies, Glucose Tolerance Test, Sex Factors, Cohort Studies, Comorbidity, Questionnaires, Alcohol Drinking, Diabetes Complications, Cognition, Neuropsychological Tests, psychology, Research Support,N.I.H.,Extramural, Cognition Disorders, Brain, Physical Fitness},
	pages = {1597--1603},
