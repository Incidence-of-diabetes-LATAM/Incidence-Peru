	number = {3},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Christensen, D. L. and Witte, D. R. and Kaduka, L. and Jorgensen, M. E. and Borch-Johnsen, K. and Mohan, V. and Shaw, J. E. and Tabak, A. G. and Vistisen, D.},
