	file = {Chen e.a. - 2015 - Effect of lifestyle intervention in patients with .pdf:/Users/planetarium/Zotero/storage/VAXHXGQI/Chen e.a. - 2015 - Effect of lifestyle intervention in patients with .pdf:application/pdf;Chen e.a. - 2015 - Effect of lifestyle intervention in patients with .pdf:/Users/planetarium/Zotero/storage/GN9N8HGJ/Chen e.a. - 2015 - Effect of lifestyle intervention in patients with .pdf:application/pdf},
