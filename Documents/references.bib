	month = may,
	year = {2002},
	note = {Place: University of Helsinki, Finland. hans.akerblom@helsinki.fi},
	keywords = {Insulin, Risk, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Animal, physiopathology, adverse effects, Causality, Disease, complications, etiology, Prospective Studies, Diabetes Mellitus,Insulin-Dependent, genetics, Infection, Proteins, Finland, T-Lymphocytes, Antibiotics,Macrolide, deficiency, Enterovirus Infections, Environment, Genetic Predisposition to Disease, Genome, Gluten, Immune System, Milk, Vitamin D Deficiency},
	pages = {18--29},
