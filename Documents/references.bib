	note = {Place: Larry L. Hillblom Islet Research Center, Departments of Medicine, UCLA, Los Angeles, CA 90095-7345, USA},
	keywords = {Glucose, Insulin, Research, Cytokines, Animal, Inflammation, Mice, Hyperglycemia, secretion, 12, Fatty Acids, Diet, Los Angeles, Leptin, Animals, Sucrose, Apoptosis, Interleukin-1, Adiponectin, Resistin},
