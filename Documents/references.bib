	note = {Place: Cardiology, Gachon Medical School, Inchon, South Korea 405-760. kwangk@ghil.com},
	keywords = {Atherosclerosis, blood, methods, Human, therapy, Endothelium,Vascular, metabolism, Nitric Oxide, Cardiovascular Diseases, Inflammation, Brachial Artery, Female, Male, Middle Age, Age Factors, Disease, Plasma, ultrasonography, Cardiology, Sex Factors, Hyperemia, Monocyte Chemoattractant Protein-1, Analysis of Variance, Hormone Replacement Therapy, Postmenopause, Progesterone, Estrogens, Estrogens,Conjugated, Menopause, Premenopause},
	pages = {43--50},
