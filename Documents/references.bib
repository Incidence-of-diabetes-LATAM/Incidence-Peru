@article{noauthor_proceedings_2011,
	title = {{PROCEEDINGS} {FROM} {THE} {20TH} {WORLD} {CONGRESS} {OF} {SEXUAL} {HEALTH} {GLASGOW}, {UNITED} {KINGDOM}, {JUNE} 12–16 2011},
	volume = {8},
