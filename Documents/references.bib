	keywords = {Adult, blood, Cholesterol, methods, Risk, Triglycerides, Human, drug effects, pharmacology, Support,Non-U.S.Gov't, United States, physiology, physiopathology, Risk Factors, Brachial Artery, Male, Time Factors, Disease, etiology, Arteries, Heart, Coronary Disease, Hypertriglyceridemia, Dilatation, Nitroglycerin, Reference Values, ultrasonography, Vasodilation, Regional Blood Flow, Fatty Acids, Vasodilator Agents, Vasomotor System, Constriction, Sweden, Fatty Acids,Nonesterified, Fat Emulsions,Intravenous},
