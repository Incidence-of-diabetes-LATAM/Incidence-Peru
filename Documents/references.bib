	author = {Smith, S M and Holohan, J and McAuliffe, A and Firth, R G},
	month = sep,
	year = {2003},
	note = {Place: UCD Department of Community Health and General Practice, Trinity College Dublin, Dublin, Ireland. susmith@tcd.ie},
	keywords = {Adult, analysis, blood, Fasting, Glucose, methods, Risk, diagnosis, Human, Support,Non-U.S.Gov't, Middle Aged, Risk Factors, Aged, Female, Male, epidemiology, etiology, Blood Glucose, Plasma, 12, Diabetes Mellitus, Diabetes Mellitus,Type II, Prevalence, Glucose Intolerance, Glucose Tolerance Test, Mass Screening, Questionnaires, Ireland, Family Practice},
