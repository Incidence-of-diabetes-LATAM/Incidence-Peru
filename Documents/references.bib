	month = sep,
	year = {2001},
	note = {Place: Department of Epidemiology and Medical Statistics, Institute of Community Medicine, University of Tromso, Tromso, Norway. tom.wilsgaard@ism.uit.no},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Lipids, Men, methods, Pressure, Research, Risk, Sex, Triglycerides, Women, Middle Aged, Cardiovascular Diseases, physiology, physiopathology, Risk Factors, Aged, Female, Male, epidemiology, Humans, Linear Models, Body Mass Index, etiology, Community Medicine, Risk Assessment, Predictive Value of Tests, Statistics, Research Support, Questionnaires, Health Surveys, Population Surveillance, Norway},
