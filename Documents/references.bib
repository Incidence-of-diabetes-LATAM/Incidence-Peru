	keywords = {Humans, Diabetic Retinopathy, Genome-Wide Association Study, Diabetic Retinopathy: genetics, Twin Studies as Topic, Genetic Linkage, Heritable, Molecular Biology, Quantitative Trait, Transcriptome},
	pages = {96},
	file = {Kuo e.a. - 2014 - Challenges in Elucidating the Genetics of Diabetic.pdf:/Users/planetarium/Zotero/storage/82P75Z3N/Kuo e.a. - 2014 - Challenges in Elucidating the Genetics of Diabetic.pdf:application/pdf},
