	author = {Kametas, N A and Savvidou, M D and Donald, A E and McAuliffe, F and Nicolaides, K H},
	month = aug,
	year = {2002},
	note = {Place: Harris Birthright Research Centre for Fetal Medicine, King's College Hospital, Denmark Hill, London SE5 9RS, UK},
