	month = sep,
	year = {2003},
	note = {Place: American Cardiovascular Research Institute, Atlanta, GA, USA},
	keywords = {Adult, analysis, methods, Research, Risk, Human, Hypercholesterolemia, Hypertension, Risk Factors, Aged, Female, Male, Middle Age, Disease, 10, Arteries, Follow-Up Studies, Coronary Disease, mortality, Family, history, Smoking, Aged,80 and over, chemistry, Tomography,X-Ray Computed, Coronary Vessels, Death, Calcium, Prognosis, Proportional Hazards Models, Heart Diseases},
