	pages = {e1892},
	file = {Lozano e.a. - 2008 - Mesoscopic Structure Conditions the Emergence of C.pdf:/Users/planetarium/Zotero/storage/9HPXM3K6/Lozano e.a. - 2008 - Mesoscopic Structure Conditions the Emergence of C.pdf:application/pdf},
}

