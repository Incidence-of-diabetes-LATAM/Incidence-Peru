	keywords = {blood, Blood Pressure, Men, Pressure, Risk, Women, Cardiovascular Diseases, therapeutic use, Disease, epidemiology, Humans, complications, etiology, prevention \& control, Hyperglycemia, Epidemiologic Studies, Hypoglycemic Agents, Diabetes Mellitus, mortality, Netherlands, Aspirin, Coronary Calcification, Morbidity, Diabetic Nephropathies, Antihypertensive Agents, Diabetes Mellitus,Type 1, Antilipemic Agents, Platelet Aggregation, Platelet Aggregation Inhibitors},
