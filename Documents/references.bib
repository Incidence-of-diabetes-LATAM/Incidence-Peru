	journal = {J.Clin.Endocrinol.Metab},
	author = {Kopprasch, S and Pietzsch, J and Kuhlisch, E and Graessler, J},
	month = apr,
	year = {2003},
	note = {Place: Department of Internal Medicine 3, Carl Gustav Carus Medical School, University of Technology Dresden, Germany. Steffi.Kopprasch@mailbox.tu-dresden.de},
	keywords = {Adult, analysis, Atherosclerosis, blood, Glucose, Insulin, Human, metabolism, Support,Non-U.S.Gov't, Aged, Female, Male, Middle Age, Disease, complications, Lipoproteins, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Homeostasis, Glucose Intolerance, Esterases, In Vitro, Phenotype, Hemoglobin A,Glycosylated, Paraoxon, Phenylacetates, Lipoproteins,LDL, Germany, C-Peptide, Prediabetic State, Substrate Specificity},
