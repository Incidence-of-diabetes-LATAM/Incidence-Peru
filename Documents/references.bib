	keywords = {Adult, analysis, blood, Cholesterol, methods, Human, Comparative Study, Support,Non-U.S.Gov't, Middle Aged, Female, Male, Lipoproteins, 12, Netherlands, Lipoproteins,LDL, Ultracentrifugation, Electrophoresis,Polyacrylamide Gel, Centrifugation,Density Gradient, Freezing},
