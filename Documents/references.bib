	keywords = {blood, Blood Pressure, methods, Risk, Human, drug effects, Endothelium, Endothelium,Vascular, Nitric Oxide, pharmacology, Denmark, Hypertension, physiopathology, Risk Factors, Brachial Artery, Male, Middle Age, Disease, complications, Arteries, Heart, Vasodilation, omega-N-Methylarginine, Vasodilator Agents, Exercise, Nitroprusside, Heart Rate, Enzyme Inhibitors, Nitric-Oxide Synthase, antagonists \& inhibitors, Heart Transplantation, Exercise Therapy},
