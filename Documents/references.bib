	note = {Place: First Department of Internal Medicine, Faculty of Medicine, Kagoshima University, Sakuragaoka, Kagoshima, Japan},
	keywords = {Adult, methods, Risk, Human, therapy, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, Hypercholesterolemia, Hypertension, physiopathology, Risk Factors, Brachial Artery, Male, therapeutic use, epidemiology, Arteries, Heart, Diabetes Mellitus, Japan, Nitroglycerin, Vasodilation, Coronary Arteriosclerosis, Smoking, Hyperemia, Biomechanics, Heat, Retreatment, Steam Bath},
