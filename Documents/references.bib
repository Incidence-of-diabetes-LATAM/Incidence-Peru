	month = nov,
	year = {2001},
	note = {Place: Department of Medicine, Monash University, Dandenong Hospital, Victoria, Australia. h.teede@southernhealth.org.au},
	keywords = {analysis, methods, Human, therapy, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, physiology, administration \& dosage, Female, Middle Age, Vasodilation, England, analogs \& derivatives, Double-Blind Method, Vascular Resistance, Analysis of Variance, Compliance, Australia, Estrogen Replacement Therapy, Hormone Replacement Therapy, Postmenopause, Pulse, Estradiol, Progesterone, Drug Combinations, Estriol, Lipoprotein(a), Norethindrone},
