@article{empana_are_2003,
	title = {Are the {Framingham} and {PROCAM} coronary heart disease risk functions applicable to different {European} populations? {The} {PRIME} {Study}},
	volume = {24},
	abstract = {AIMS: To assess whether the Framingham and PROCAM risk functions were applicable to men in Belfast and France. METHODS AND RESULTS: We performed an external validation study within the PRIME (Prospective Epidemiological Study of Myocardial Infarction) cohort study. It comprised men recruited in Belfast (2399) and France (7359) who were aged 50 to 59 years, free of CHD at baseline (1991 to 1993) and followed over 5 years for CHD events (coronary death, myocardial infarction, angina pectoris). We compared the relative risks of CHD associated with the classic risk factors in PRIME with those in Framingham and PROCAM cohorts. We then compared the number of predicted and observed 5-year CHD events (calibration). Finally, we estimated the ability of the risk functions to separate high risk from low risk subjects (discrimination).The relative risk of CHD calculated for the various factors in the PRIME population were not statistically different from those published in the Framingham and PROCAM risk functions. The number of CHD events predicted by these risk functions however clearly overestimated those observed in Belfast and France. The two risk functions had a similar ability to separate high risk from low risk subjects in Belfast and France (c-statistic range: 0.61-0.68). CONCLUSION: The Framingham and PROCAM risk functions should not be used to estimate the absolute CHD risk of middle-aged men in Belfast and France without any CHD history because of a clear overestimation. Specific population risk functions are needed},
	number = {0195-668X LA - eng PT - Evaluation Studies PT - Journal Article PT - Multicenter Study PT - Validation Studies SB - IM},
	journal = {Eur.Heart J.},
	author = {Empana, J P and Ducimetiere, P and Arveiler, D and Ferrieres, J and Evans, A and Ruidavets, J B and Haas, B and Yarnell, J and Bingham, A and Amouyel, P and Dallongeville, J},
	month = nov,
	year = {2003},
	note = {Place: Lille MONICA Project, INSERM U508, Institut Pasteur de Lille, Lille, France. empana@vjf.inserm.fr},
	keywords = {Adult, Men, methods, Risk, Human, Comparative Study, Support,Non-U.S.Gov't, Middle Aged, Risk Factors, Aged, Male, Disease, epidemiology, etiology, Multicenter Studies, Myocardial Infarction, Heart, Coronary Disease, Prospective Studies, Risk Assessment, Sensitivity and Specificity, mortality, history, Predictive Value of Tests, standards, Angina Pectoris, Death, Cohort Studies, Prognosis, Evaluation Studies, Proportional Hazards Models, France, Northern Ireland},
