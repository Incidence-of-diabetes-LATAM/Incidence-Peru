@article{petrie_implications_2011-1,
	title = {Implications of genome wide association studies for the understanding of type 2 diabetes pathophysiology.},
	volume = {81},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/21111713},
	doi = {10.1016/j.bcp.2010.11.010},
	abstract = {The rapid rise in prevalence of type 2 diabetes mellitus (T2DM) has been driven by changes in environmental factors - primarily increased caloric intake and reduced energy expenditure - resulting in reduced whole body insulin sensitivity (often termed insulin resistance). Insulin resistance has been proposed to be a major driver of progression to T2DM. However, of 38 individual susceptibility loci for T2DM recently identified by genome wide association studies, by far the majority code for proteins involved in β-cell function. In this review, we discuss the possible reasons for the paucity of insulin resistance genes and ask whether the new genetic susceptibility data should focus attention on β-cell targets in the development of therapies for T2DM.},
	number = {4},
	journal = {Biochemical pharmacology},
	publisher = {Elsevier Inc.},
	author = {Petrie, John R and Pearson, Ewan R and Sutherland, Calum},
	month = feb,
	year = {2011},
	keywords = {Insulin Resistance, Humans, Genetic Predisposition to Disease, Insulin-Secreting Cells, Diabetes Mellitus, Type 2, Diabetes Mellitus, Type 2: drug therapy, Genome-Wide Association Study, Insulin Resistance: genetics, Diabetes Mellitus, Type 2: genetics, Diabetes Mellitus, Type 2: physiopathology, Insulin-Secreting Cells: drug effects, Insulin-Secreting Cells: chemistry},
	pages = {471--7},
}

@article{stears_metabolic_2012-1,
	title = {Metabolic insights from extreme human insulin resistance phenotypes.},
	volume = {26},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/22498245},
	doi = {10.1016/j.beem.2011.09.003},
	abstract = {As well as improving diagnostic and clinical outcomes for affected patients, understanding the genetic basis of rare human metabolic disorders has resulted in several fundamental biological insights. In some cases understanding extreme phenotypes has also informed thinking about more prevalent metabolic diseases. Insulin resistance underpins the twin epidemics of obesity and type 2 diabetes as well as accounting for many of the metabolic problems encompassed by the term metabolic syndrome. This review provides a brief update on current understanding of human severe insulin resistance syndromes, before highlighting recent insights provided by studies in these rare syndromes into the molecular pathogenesis of elements of the metabolic syndrome.},
	number = {2},
	journal = {Best practice \& research. Clinical endocrinology \& metabolism},
	publisher = {Elsevier Ltd},
	author = {Stears, Anna and O'Rahilly, Stephen and Semple, Robert K and Savage, David B},
	month = apr,
	year = {2012},
	keywords = {Insulin Resistance, Obesity, Female, Humans, Dyslipidemias, Metabolic Syndrome X, Hyperinsulinism, Phenotype, Hypoglycemia, Diabetes Mellitus, Type 2, Metabolic Syndrome X: genetics, Insulin Resistance: genetics, Obesity: genetics, Diabetes Mellitus, Type 2: genetics, Adiponectin, Adiponectin: blood, Fatty Liver, Signal Transduction, Polycystic Ovary Syndrome, Dyslipidemias: diagnosis, Metabolic Syndrome X: metabolism, Acanthosis Nigricans, Acanthosis Nigricans: diagnosis, Hyperinsulinism: physiopathology, Hypoglycemia: diagnosis, Lipogenesis, Lipogenesis: physiology, Mitochondrial Diseases, Mitochondrial Diseases: genetics, Mitochondrial Diseases: physiopathology, Phosphatidylinositol 3-Kinase, Phosphatidylinositol 3-Kinase: metabolism, Polycystic Ovary Syndrome: diagnosis, Proto-Oncogene Proteins c-akt, Proto-Oncogene Proteins c-akt: physiology, Receptor, IGF Type 1, Receptor, IGF Type 1: physiology, Signal Transduction: physiology},
