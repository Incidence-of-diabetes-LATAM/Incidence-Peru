@article{cabrera_cohort_nodate,
	title = {Cohort differences in obesity-related health indicators among 70-year olds with special reference to gender and education},
	abstract = {Abstract. The aim of this study was to describe cohort diﬀerences in health indicators among four birth cohorts of 70-year old men and women from Go¨ teborg, Sweden, born in 1901/2, 1905/6, 1911/12, and 1922. With special reference to gender, education, and obesity, it is hypothesized that changes in health among elderly men and women may not be occurring in a uniform manner. The variables studied were: systolic and diastolic blood pressures, triglycerides, cholesterol, height, weight, body mass index, waist–hip ratio, physical inactivity, current smoking, and alcohol consumption, plus selected prevalent diseases. Logistic and linear regression models were used to test for secular trends and eﬀect modiﬁcation by gender. Most trends in metabolic and lifestyle indicators varied in relation to gender as well as education. For instance, later-born male cohorts were more overweight than earlier-born groups while the later-born female cohorts had similar relative weights but a more centralized fat patterning. These cohort diﬀerences further varied by education where later-born men with less education and later-born women with higher education tended to be more overweight, compared to earlier-born cohorts. Finally, signiﬁcant cohort differences in previously diagnosed myocardial infarction, stroke, and diabetes mellitus at age 70 were observed in men only. Interaction terms revealed that the gender diﬀerence was statistically signiﬁcant only in the case of diabetes mellitus. In conclusion, secular trends in many obesity-related health indicators among 70-year old Swedish cohorts were dependent on both gender and socio-economic factors.},
	language = {en},
	author = {Cabrera, Claudia and Wilhelmson, Katarina and Allebeck, Peter and Wedel, Hans and Steen, Bertil and Lissner, Lauren},
	keywords = {Blood Pressure, Lipids, Obesity, Cardiovascular Diseases, Risk Factors, Aged, Female, Male, Humans, Body Mass Index, Diabetes Mellitus, Smoking, Prevalence, Sex Factors, Exercise, Cohort Studies, Alcohol Drinking, Educational Status, Health Status Indicators, Diabetes Complications, Sweden, Diabetes Mellitus: epidemiology, Obesity: epidemiology, Obesity: complications, Cardiovascular Diseases: epidemiology, Cardiovascular Diseases: complications, Obesity: blood, Smoking: epidemiology, Sweden: epidemiology, Alcohol Drinking: epidemiology, Cohort Effect},
	pages = {8},
	file = {Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:/Users/planetarium/Zotero/storage/C6D8MCBY/Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:application/pdf;Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:/Users/planetarium/Zotero/storage/SR9AA8YP/Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:application/pdf;Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:/Users/planetarium/Zotero/storage/FMQFI4BL/Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:application/pdf;Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:/Users/planetarium/Zotero/storage/Y3BW4YCQ/Cabrera e.a. - Cohort differences in obesity-related health indic.pdf:application/pdf},
}

@article{di_angelantonio_body-mass_2016,
	title = {Body-mass index and all-cause mortality: individual-participant-data meta-analysis of 239 prospective studies in four continents},
	volume = {388},
