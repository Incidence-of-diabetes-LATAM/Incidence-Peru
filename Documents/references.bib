@article{peters_interaction_1999,
	title = {Interaction of septadian and circadian rhythms in life-threatening ventricular arrhythmias in patients with implantable cardioverter-defibrillators},
	volume = {84},
	abstract = {Previous studies have shown that life-threatening ventricular arrhythmias display both circadian and septadian (day of the week) periodicity. We hypothesized that assessing the relation between these circadian and septadian rhythms may provide important pathophysiologic information about the mechanism of sudden cardiac death. Using the database from a population of 683 consecutive patients with a third-generation implantable cardioverter-defibrillator (ICD), we examined the time pattern of ICD activations for rapid (prospectively defined as cycle length {\textless}280 ms) tachycardias for each day of the week. A total of 5,270 arrhythmic episodes were analyzed. Despite the fact that event distribution was significantly nonuniform (p {\textless}0.001) for both circadian and septadian analyses, the circadian pattern was strikingly similar for each day of the week with a relatively broad peak between 9 A.M. and 6 P.M. and a long nadir between 9 P.M. and 6 A.M. We conclude that the trigger factors responsible for the daily circadian distribution of life-threatening ventricular arrhythmias in a population with ICDs are similar throughout the week and may thus be unrelated to the standard work week. These data suggest that the physiologic modulators of circadian and septadian rhythms may be different},
	number = {0002-9149 LA - eng PT - Journal Article},
	journal = {Am.J.Cardiol.},
	author = {Peters, R W and McQuillan, S and Gold, M R},
	month = sep,
	year = {1999},
	note = {Place: Department of Medicine, The University of Maryland School of Medicine, Baltimore, USA. RobertW@Baltimore.VA.GOV},
	keywords = {Risk, Human, therapy, United States, physiopathology, Aged, Female, Male, Middle Age, epidemiology, Time, etiology, prevention \& control, mortality, Death, Death,Sudden,Cardiac, Circadian Rhythm, Work, Arrhythmia, Maryland, Recurrence, Ventricular Fibrillation, Electrocardiography, Atrioventricular Node, Biological Clocks, Defibrillators,Implantable},
	pages = {555--557},
