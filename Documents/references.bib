@article{ulmer_long-term_2003,
	title = {Long-term tracking of cardiovascular risk factors among men and women in a large population-based health system: the {Vorarlberg} {Health} {Monitoring} \& {Promotion} {Programme}},
	volume = {24},
	abstract = {AIMS: To document tracking patterns, if any, over time, of classical cardiovascular risk factors in men and women participants in the Vorarlberg Health Monitoring and Promotion Programme (VHM\&PP) METHODS AND RESULTS: 67,413 men and 82,237 women underwent a total of 45,4448 standardised examinations in the 15 year period 1985-1999. Measures included were systolic and diastolic blood pressure, height, weight and fasting sample for total cholesterol, triglycerides, gamma-gt and blood glucose. Tracking coefficients were calculated by multivariable regression models using the GEE estimation method. All variables showed evidence of significant tracking over time, whether estimated in 10-year age bands or among individuals categorized as being at high risk using cut-points proposed by international guidelines. Effects were most marked for body mass index (0.87, SE0.005 in men and 0.89, SE0.003 in women), and were also associated with increasing age. Women who died during follow-up showed stronger tracking patterns for triglycerides and gamma-gt and weaker effects for blood pressure, but there was no effect on patterns according to survival in men. Tracking coefficients were weaker among initially high-risk individuals. CONCLUSIONS: This is the largest study yet of adults to demonstrate significant tracking effects of cardiovascular risk factors over time. The strength of this effect should be considered in assessing effectiveness of risk factor modification programmes. The study is novel too in highlighting more fully differences according to gender and social circumstances and in taking account of the impact on long-term survival},
	number = {0195-668X (Print) LA - eng PT - Journal Article PT - Research Support, Non-U.S. Gov't SB - IM},
	journal = {Eur.Heart J.},
	author = {Ulmer, H and Kelleher, C and Diem, G and Concin, H},
	month = jun,
	year = {2003},
	note = {Place: Institute of Biostatistics and Documentation, Leopold Franzens University of Innsbruck, Innsbruck, Austria. Hanno.Ulmer@uibk.ac.at},
	keywords = {Adult, blood, Blood Pressure, Cholesterol, Fasting, Glucose, Men, methods, Obesity, Pressure, Research, Risk, Triglycerides, Women, Middle Aged, Cardiovascular Diseases, physiology, Risk Factors, Aged, Female, Male, epidemiology, Humans, Time, Body Mass Index, complications, etiology, Blood Glucose, mortality, Age Distribution, Aged,80 and over, Sex Distribution, Guidelines, Austria, Research Support, Socioeconomic Factors, Epidemiologic Methods, Documentation},
