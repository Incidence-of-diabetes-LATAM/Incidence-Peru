	pages = {10},
	file = {Landon e.a. - 2009 - A Multicenter, Randomized Trial of Treatment for M.pdf:/Users/planetarium/Zotero/storage/I4UNNHZ8/Landon e.a. - 2009 - A Multicenter, Randomized Trial of Treatment for M.pdf:application/pdf;Landon e.a. - 2009 - A Multicenter, Randomized Trial of Treatment for M.pdf:/Users/planetarium/Zotero/storage/UJUK3JXR/Landon e.a. - 2009 - A Multicenter, Randomized Trial of Treatment for M.pdf:application/pdf},
