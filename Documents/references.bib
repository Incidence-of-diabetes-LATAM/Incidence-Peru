	keywords = {Adult, blood, Blood Pressure, Cholesterol, Glucose, Insulin, Insulin Resistance, methods, Syndrome, Triglycerides, Human, Support,Non-U.S.Gov't, physiology, Aged, Female, Middle Age, epidemiology, Body Mass Index, Arteries, Body Constitution, Lipoproteins, Lipoproteins,HDL Cholesterol, Netherlands, Carotid Arteries, Biomechanics, Carotid Artery,Common, Plasminogen Activator Inhibitor 1},
