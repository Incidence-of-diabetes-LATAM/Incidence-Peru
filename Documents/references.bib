	year = {2005},
	note = {Place: Division of Cardiovascular and Medical Sciences, University of Glasgow, Glasgow, UK. gdl1j@clinmed.gla.ac.uk},
	keywords = {blood, methods, Risk, Syndrome, diagnosis, Cardiovascular Diseases, Inflammation, Risk Factors, Causality, Disease, Humans, Research Support,Non-U.S.Gov't, Heart, Epidemiologic Studies, Prospective Studies, Biological Markers, C-Reactive Protein, Mass Screening, Fibrinogen, Genotype, Prognosis, Randomized Controlled Trials, Clinical Trials, Models,Biological, Cell Count},
