	journal = {Hypertension},
	author = {De, Angelis L and Millasseau, S C and Smith, A and Viberti, G and Jones, R H and Ritter, J M and Chowienczyk, P J},
	month = jul,
	year = {2004},
	note = {Place: Department of Diabetes and Endocrinology, Guy's and St Thomas' Hospital, Center for Cardiovascular Biology and Medicine, King's College, London, UK},
	keywords = {Adult, blood, Blood Pressure, Men, Pressure, Risk, Sex, Women, Middle Aged, Hypertension, physiology, physiopathology, Aged, Blood Flow Velocity, Female, Male, Humans, London, Time, Diabetes Mellitus,Type 2, Sex Characteristics, Vascular Resistance, Elasticity, Pulse, Aorta, Matched-Pair Analysis},
