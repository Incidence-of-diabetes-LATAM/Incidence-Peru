	month = nov,
	year = {2001},
	note = {Place: Departments of Radiology, University of California San Francisco, San Francisco, California, USA},
	keywords = {analysis, Atherosclerosis, California, methods, Necrosis, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Time, Sensitivity and Specificity, pathology, Tunica Media, Thrombosis, Calcinosis, Carotid Artery Diseases, Evaluation Studies, Support,U.S.Gov't,Non-P.H.S., Magnetic Resonance Imaging, Imaging,Three-Dimensional, ultrastructure, Endarterectomy, Collagen, Hemorrhage},
