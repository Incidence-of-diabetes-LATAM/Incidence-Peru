@article{veglio_prevalence_2002,
	title = {Prevalence of {Q}-{T} interval dispersion in type 1 diabetes and its relation with cardiac ischemia : the {EURODIAB} {IDDM} {Complications} {Study} {Group}},
	volume = {25},
	abstract = {OBJECTIVE: The interlead variation in duration of the Q-T interval on the surface electrocardiogram (Q-T interval dispersion [QTd]) has been shown to predict mortality in type 2 diabetic patients. We evaluated the prevalence of QTd prolongation in the EURODIAB population and its relation to corrected Q-T interval (QTc), sex, age, duration of diabetes, blood glucose control, and complications. RESEARCH DESIGN AND METHODS; A total of 3,042 type 1 diabetic patients were studied. QTc was calculated according to the Bazett's formula; QTc {\textgreater} 0.44 s was considered abnormally prolonged. QTd was calculated using the difference between the maximum and the minimum QTc in any thoracic lead. QTd {\textgreater}0.080 s was considered abnormally prolonged. RESULTS: The prevalence of an increased QTd was 7\%. A significant relation was observed between QTd prolongation and diastolic blood pressure (P {\textless} 0.05). A higher prevalence of QTd prolongation was observed in patients with ischemic heart disease (P = 0.004), whereas no relationship was observed with retinopathy, albumin excretion rate, or measures of somatic and autonomic neuropathy. QTc and QTd were significantly related (P = 0.001); however, a proportion of patients with normal QTd showed a prolonged QTc ({\textgreater}0.44 s). CONCLUSIONS: In patients with type 1 diabetes, QTd is associated with ischemic heart disease and diastolic blood pressure but not neuropathy. Although QTd is statistically related to duration of QTc, increased QTd and increased QTc identify different patients, and their predictive value deserves prospective evaluation},
	number = {0149-5992 (Print) LA - eng PT - Journal Article PT - Multicenter Study SB - IM},
	journal = {Diabetes Care},
	author = {Veglio, M and Giunti, S and Stevens, L K and Fuller, J H and Perin, P C},
	month = apr,
	year = {2002},
	note = {Place: Evangelico Valdese Hospital, Turin, Italy. veglio@onw.net},
	keywords = {Adult, blood, Blood Pressure, Glucose, methods, Pressure, Research, Research Design, Sex, Diabetic Neuropathies, Ischemia, physiopathology, Disease, epidemiology, Humans, Body Mass Index, complications, Multicenter Studies, Blood Glucose, Heart, Body Constitution, mortality, Prevalence, Italy, Diabetic Nephropathies, Diabetic Retinopathy, Diabetic Angiopathies, Albuminuria, chemically induced, Myocardial Ischemia, Diabetes Mellitus,Type 1, Long QT Syndrome},
