@article{gibbs_medicine_2014,
	title = {Medicine gets up close and personal.},
	volume = {506},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/24522582},
	doi = {10.1038/506144a},
	abstract = {Some 38,000 people killed themselves in the United States in 2010. That’s more than were killed in traffic accidents (34,000) or by prostate cancer (29,000), and more than twice the number murdered (16,000). Shocking though that is, many other countries monitored by the Organisation for Economic Co-operation and Development have even higher suicide rates. So why do public-health authorities put less effort into preventing death from suicide than they do death from accidents or diseases such as prostate cancer?... There is no standard way to define and so recognize what it means to be suicidal.},
