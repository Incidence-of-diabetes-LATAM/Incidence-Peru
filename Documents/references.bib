@article{cahn_prediction_2020,
	title = {Prediction of progression from pre‐diabetes to diabetes: {Development} and validation of a machine learning model},
	volume = {36},
	issn = {1520-7552, 1520-7560},
	shorttitle = {Prediction of progression from pre‐diabetes to diabetes},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/dmrr.3252},
	doi = {10.1002/dmrr.3252},
	abstract = {Methods: A machine-learning model predicting the progression from pre-diabetes to diabetes was developed using a gradient boosted trees model. The model was trained on data from The Health Improvement Network (THIN) database cohort, internally validated on THIN data not used for training, and externally validated on the Canadian AppleTree and the Israeli Maccabi Health Services (MHS) data sets. The model's predictive ability was compared with that of a logistic-regression model within each data set.
Results: A cohort of 852 454 individuals with pre-diabetes (glucose ≥ 100 mg/dL and/or HbA1c ≥ 5.7) was used for model training including 4.9 million time points using 900 features. The full model was eventually implemented using 69 variables, generated from 11 basic signals. The machine-learning model demonstrated superiority over the logistic-regression model, which was maintained at all sensitivity levels –comparing AUC [95\% CI] between the models; in the THIN data set (0.865 [0.860,0.869] vs 0.778 [0.773,0.784] P {\textless} .05), the AppleTree data set (0.907 [0.896, 0.919] vs 0.880 [0.867, 0.894] P {\textless} .05) and the MHS data set (0.925 [0.923, 0.927] vs 0.876 [0.872, 0.879] P {\textless} .05).
Conclusions: Machine-learning models preserve their performance across populations in diabetes prediction, and can be integrated into large clinical systems, leading to judicious selection of persons for interventional programmes.},
	language = {en},
	number = {2},
	urldate = {2021-02-13},
	journal = {Diabetes/Metabolism Research and Reviews},
	author = {Cahn, Avivit and Shoshan, Avi and Sagiv, Tal and Yesharim, Rachel and Goshen, Ran and Shalev, Varda and Raz, Itamar},
	month = feb,
	year = {2020},
	file = {Cahn e.a. - 2020 - Prediction of progression from pre‐diabetes to dia.pdf:/Users/planetarium/Zotero/storage/69V2UAAQ/Cahn e.a. - 2020 - Prediction of progression from pre‐diabetes to dia.pdf:application/pdf;Cahn e.a. - 2020 - Prediction of progression from pre‐diabetes to dia.pdf:/Users/planetarium/Zotero/storage/GA982MA3/Cahn e.a. - 2020 - Prediction of progression from pre‐diabetes to dia.pdf:application/pdf},
