	keywords = {Risk, Human, therapy, drug effects, pharmacology, Support,U.S.Gov't,P.H.S., United States, Cardiovascular Diseases, physiopathology, Risk Factors, administration \& dosage, Aged, Brachial Artery, Female, epidemiology, Longitudinal Studies, Arteries, Heart, prevention \& control, ultrasonography, Vasodilation, Cardiology, Aged,80 and over, Primary Prevention, Hyperemia, Analysis of Variance, Drug Therapy,Combination, Estrogen Replacement Therapy, Hormone Replacement Therapy, Estrogens, Progestational Hormones},
