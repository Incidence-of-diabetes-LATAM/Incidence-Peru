	journal = {Radiology},
	author = {Hunold, P and Vogt, F M and Schmermund, A and Debatin, J F and Kerkhoff, G and Budde, T and Erbel, R and Ewen, K and Barkhausen, J},
	month = jan,
	year = {2003},
	note = {Place: Department of Diagnostic and Interventional Radiology, University Hospital Essen, Germany},
