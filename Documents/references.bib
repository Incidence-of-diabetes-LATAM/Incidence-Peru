	note = {Place: Department of Preventive Medicine, University of Tennessee, Memphis 38105, USA. mpahor@utmem1.utmem.edu},
	keywords = {blood, Lipids, Risk, diagnosis, Human, Endothelium,Vascular, metabolism, United States, Cardiovascular Diseases, Inflammation, physiopathology, Risk Factors, Homocysteine, Oxidative Stress, Myocardial Infarction, Blood Coagulation, Predictive Value of Tests, Biological Markers, Sex Factors, Infection, microbiology, Fibrinolysis, Racial Stocks},
	pages = {237--245},
