@article{banack_does_2015,
	title = {Does selection bias explain the obesity paradox among individuals with cardiovascular disease?},
	volume = {25},
	issn = {10472797},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S104727971500054X},
	doi = {10.1016/j.annepidem.2015.02.008},
	abstract = {Objectives: The objectives of this paper are to demonstrate that the obesity paradox may be explained by collider stratification bias and to estimate the biasing effects of unmeasured common causes of cardiovascular disease (CVD) and mortality on the observed obesitymortality relationship.
Methods: We use directed acyclic graphs, regression modeling and sensitivity analyses to explore whether the observed protective effect of obesity among individuals with CVD can be plausibly attributed to selection bias. Data from the third National Health and Examination Survey was used for the analyses.
Results: The adjusted total effect of obesity on mortality was a risk difference (RD) of 0.03 (95\% CI 0.02, 0.05). However, the controlled direct effect of obesity on mortality among individuals without CVD was RD=0.03 (95\% CI 0.01, 0.05) and RD= -0.12 (95\% CI -0.20, 0.04) among individuals with CVD. The adjusted total effect estimate demonstrates an increased number of deaths among obese individuals relative to non-obese counterparts, while the controlled direct effect shows a paradoxical decrease in morality among obese individuals with CVD.
Conclusion: Sensitivity analysis demonstrates unmeasured confounding of the mediatoroutcome relationship provides a sufficient explanation for the observed protective effect of obesity on mortality among individuals with CVD.},
	language = {en},
	number = {5},
	urldate = {2021-02-13},
	journal = {Annals of Epidemiology},
	author = {Banack, Hailey R. and Kaufman, Jay S.},
	month = may,
	year = {2015},
	pages = {342--349},
	file = {Banack en Kaufman - 2015 - Does selection bias explain the obesity paradox am.pdf:/Users/planetarium/Zotero/storage/PSMF5VAS/Banack en Kaufman - 2015 - Does selection bias explain the obesity paradox am.pdf:application/pdf;Banack en Kaufman - 2015 - Does selection bias explain the obesity paradox am.pdf:/Users/planetarium/Zotero/storage/I8KLWD8X/Banack en Kaufman - 2015 - Does selection bias explain the obesity paradox am.pdf:application/pdf},
