	note = {Place: Department of Medicine, Section of Cardiology, University of Illinois at Chicago College of Medicine, 60612, USA. jahoff@uic.edu},
	keywords = {Adult, analysis, Atherosclerosis, methods, Odds Ratio, Risk, Human, Hypercholesterolemia, Hypertension, Risk Factors, Aged, Female, Male, Middle Age, Disease, etiology, Arteries, Regression Analysis, Cardiology, Coronary Arteriosclerosis, history, Biological Markers, Aged,80 and over, chemistry, Tomography,X-Ray Computed, Coronary Vessels, Mass Screening, Calcium, Illinois},
