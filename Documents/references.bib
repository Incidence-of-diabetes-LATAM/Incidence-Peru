	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Pressure, Risk, Sex, Triglycerides, Case-Control Studies, Middle Aged, physiology, physiopathology, Risk Factors, Aged, Blood Flow Velocity, Female, Male, Disease, Humans, complications, etiology, Arteries, Arteriosclerosis, Diabetes Mellitus, Regression Analysis, Aged,80 and over, Glomerular Filtration Rate, Carotid Arteries, Analysis of Variance, Adolescent, Hemodynamics, Pulse, Diabetes Complications, France, Radial Artery, Kidney Failure, Electrocardiography, Paris},
