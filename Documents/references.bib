@article{kramer_prospective_2009,
	title = {A {Prospective} {Study} of {Abdominal} {Obesity} and {Coronary} {Artery} {Calcium} {Progression} in {Older} {Adults}},
	volume = {94},
	issn = {0021-972X, 1945-7197},
	url = {https://academic.oup.com/jcem/article/94/12/5039/2597215},
	doi = {10.1210/jc.2009-1497},
	abstract = {Objective: Little is known about obesity measurements and coronary artery calcium (CAC) progression in older adults. We examined the sex-specific association between measures of body size and fat distribution with CAC progression. Subjects and Methods: Participants were 156 men and 182 women (mean age 67 yr) without known heart disease who had electron-beam computed tomography for CAC at baseline and again 4.5 yr later. Obesity assessments were weight, height, body mass index, waist and hip circumference, waist to hip ratio, waist to height ratio, sc and visceral adipose tissue (SAT, VAT), and SAT to VAT ratio based on abdominal electron-beam computed tomography. CAC progression was defined as categorical (square root increased on total CAC volume score Ն2.5 mm3) and continuous variables.
Results: During the follow-up, 55\% of men and 38.5\% of women had CAC progression. Increased waist to hip ratio (Ն0.9 for men, Ն0.85 for women) and waist to height ratio (Ն0.55 for men, Ն0.54 for women) were positively and independently associated with CAC progression [median (interquartile range)] [60.8 (145) vs. 10.8 (56) mm3, P ϭ 0.002 and 50 (153) vs. 22(84) mm3, P ϭ 0.03, respectively]. In women but not men, an increased waist circumference (Ͼ88 cm) independently predicted CAC progression (odds ratio 3.0 95\% confidence interval 1.03– 8.0, P ϭ 0.04), whereas VAT to SAT ratio predicted CAC progression in men but not women (odds ratio 2.8 95\% confidence interval 1.01–7.8, P ϭ 0.04).
Conclusion: In this study of older adults without known heart disease, abdominal obesity was an independent predictor of CAC progression. These results point to the importance of using clinical measurements of abdominal obesity to identify individuals at increased risk for atherosclerosis. (J Clin Endocrinol Metab 94: 5039 –5044, 2009)},
	language = {en},
	number = {12},
	urldate = {2021-02-13},
	journal = {The Journal of Clinical Endocrinology \& Metabolism},
	author = {Kramer, Caroline K. and von Mühlen, Denise and Gross, Jorge L. and Barrett-Connor, Elizabeth},
	month = dec,
	year = {2009},
	keywords = {Obesity, Body Weight, Middle Aged, Disease Progression, Aged, Female, Male, Humans, Body Mass Index, Waist-Hip Ratio, Blood Glucose, Follow-Up Studies, Prospective Studies, Logistic Models, Calcinosis, Body Height, Waist Circumference, Obesity: complications, Abdominal Fat, Blood Glucose: metabolism, Coronary Artery Disease, Abdominal Fat: pathology, Calcinosis: complications, Calcinosis: pathology, Coronary Artery Disease: complications, Coronary Artery Disease: pathology, Lipoproteins, HDL, Lipoproteins, HDL: blood, Obesity: pathology},
	pages = {5039--5044},
	file = {Kramer e.a. - 2009 - A Prospective Study of Abdominal Obesity and Coron.pdf:/Users/planetarium/Zotero/storage/XGTZS4LJ/Kramer e.a. - 2009 - A Prospective Study of Abdominal Obesity and Coron.pdf:application/pdf},
