	note = {Place: Assistance Publique-Hopitaux de Paris, Hopital Europeen Georges Pompidou (site Broussais), Centre de Medecine Preventive Cardiovasculaire, Universite Rene Descartes-Faculte de Medecine Paris, Paris 5, France. alain.simon@brs.ap-hop-paris.fr},
	keywords = {Adult, Atherosclerosis, Incidence, Pressure, Risk, diagnosis, metabolism, Middle Aged, Risk Factors, Vascular Diseases, Aged, Disease, epidemiology, Humans, Arteries, Heart, prevention \& control, Follow-Up Studies, Coronary Disease, Meta-Analysis, Prospective Studies, ultrasonography, Coronary Angiography, Tunica Intima, Tunica Media, standards, Coronary Calcification, Tomography,X-Ray Computed, Coronary Vessels, Mass Screening, Carotid Arteries, Calcium, Pulse, Evaluation Studies, France, Paris},
