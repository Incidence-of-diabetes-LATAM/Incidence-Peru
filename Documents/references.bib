	keywords = {Adult, analysis, blood, Cholesterol, Lipids, Triglycerides, Human, metabolism, Support,Non-U.S.Gov't, Female, Male, Middle Age, Multicenter Studies, Lipoproteins, Lipoproteins,LDL Cholesterol, Multivariate Analysis, Particle Size, Plasma, Regression Analysis, Family, Statistics, Hyperlipidemia, genetics, Finland, Lipase, Carrier Proteins, Membrane Proteins, Lipoprotein Lipase, Hyperlipidemia,Familial Combined},
