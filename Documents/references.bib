	note = {Place: Department of Neurology, Institute for Clinical Chemistry, University of Heidelberg, Klinikum Mannheim, Mannheim, Germany},
	keywords = {blood, methods, diagnosis, Human, Comparative Study, E-Selectin, Intercellular Adhesion Molecule-1, United States, Leukocytes, Risk Factors, Aged, Female, Male, Middle Age, complications, etiology, Arteries, Follow-Up Studies, pathology, Biological Markers, blood supply, Aged,80 and over, chemistry, radiography, Tomography,X-Ray Computed, Magnetic Resonance Imaging, Spectrophotometry, Brain Ischemia, Central Nervous System, Brain, Arterial Occlusive Diseases, Ultrasonography,Doppler,Transcranial},
