	note = {Place: Department of Medicine, Section of Cardiology, University of Illinois College of Medicine, 840 S. Wood Street (m/c 715), Chicago, IL 60612, USA. jahoff@uic.edu},
	keywords = {Adult, Atherosclerosis, methods, Research, Risk, Human, Support,Non-U.S.Gov't, Risk Factors, Aged, Female, Male, Middle Age, Age Factors, Disease, epidemiology, complications, etiology, Arteries, Diabetes Mellitus, Risk Assessment, mortality, Cardiology, Coronary Arteriosclerosis, Prevalence, Aged,80 and over, Calcinosis, radiography, Tomography,X-Ray Computed, Morbidity, Sex Factors, Calcium, Cohort Studies, Illinois},
