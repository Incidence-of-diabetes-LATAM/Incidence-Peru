	number = {10},
	urldate = {2021-02-14},
	journal = {Circulation},
	author = {Mora, Samia and Rifai, Nader and Buring, Julie E. and Ridker, Paul M},
	month = sep,
	year = {2008},
	keywords = {Fasting, Middle Aged, Cardiovascular Diseases, Female, Humans, Follow-Up Studies, Prospective Studies, Predictive Value of Tests, Double-Blind Method, Apolipoproteins, Cholesterol, HDL, Cholesterol, HDL: blood, Fasting: blood, Apolipoproteins: blood, Cardiovascular Diseases: blood, Cholesterol, LDL, Cholesterol, LDL: blood, Guidelines as Topic, Randomized Controlled Trials as Topic},
	pages = {993--1001},
