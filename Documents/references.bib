	note = {Place: Department of Primary Care and Population Sciences, Royal Free Hospital and University College Medical School, London, United Kingdom. s.ramsay@pcps.ucl.ac.uk},
	keywords = {Men, Odds Ratio, Research, Middle Aged, Cardiovascular Diseases, physiopathology, Aged, Male, Disease, epidemiology, Humans, London, Body Mass Index, Life Style, Follow-Up Studies, Prospective Studies, mortality, Prevalence, Morbidity, Roc Curve, Cross-Sectional Studies, Research Support, statistics \& numerical data, Adiposity, Weight Gain, Body Composition, Socioeconomic Factors, Overweight, Health Status, Health Behavior, Disabled Persons},
