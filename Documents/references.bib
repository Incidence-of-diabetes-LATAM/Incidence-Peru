	keywords = {Adult, Glucose, Incidence, Men, Obesity, Women, diagnosis, Human, Support,U.S.Gov't,P.H.S., Middle Aged, Risk Factors, Aged, Female, Male, epidemiology, Longitudinal Studies, Body Mass Index, Life Style, Arizona, Follow-Up Studies, Indians,North American, Statistics,Nonparametric, Diabetes Mellitus,Type II, Glucose Tolerance Test, Sex Factors, ethnology, statistics \& numerical data, Adolescent, Obesity in Diabetes, Occupations, Motor Activity},
