	keywords = {Adult, Risk Factors, Humans, Prospective Studies, Risk Assessment, Smoking, Prevalence, Adolescent, Genetic Predisposition to Disease, Attitude to Health, Smoking Cessation, Smoking: genetics, Crohn Disease, Genetic Testing, Clinical Protocols, Colitis, Ulcerative, Colitis, Ulcerative: epidemiology, Colitis, Ulcerative: genetics, Crohn Disease: epidemiology, Crohn Disease: genetics, DNA Mutational Analysis, Nod2 Signaling Adaptor Protein, Nod2 Signaling Adaptor Protein: genetics, Smoking Cessation: psychology, Smoking: epidemiology},
