	month = dec,
	year = {2002},
	note = {Place: Division of Human Nutrition and Epidemiology, Wageningen University, Wageningen, The Netherlands},
	keywords = {Adult, blood, Cholesterol, Risk, Human, pharmacology, administration \& dosage, adverse effects, Aged, Female, Male, Middle Age, Disease, epidemiology, Lipoproteins, Lipoproteins,HDL Cholesterol, Netherlands, chemistry, Fatty Acids, Diet, Esterases, Cross-Over Studies, Dietary Fats, Nutrition},
	pages = {1534--1537},
