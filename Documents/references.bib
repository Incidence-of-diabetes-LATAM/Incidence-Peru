	keywords = {Glucose, Human, Cell Membrane, drug effects, Endothelium,Vascular, pharmacology, Support,U.S.Gov't,P.H.S., Animal, cytology, Mice, physiology, physiopathology, complications, genetics, Amino Acid Sequence, Glycosylation, Proteins, Diabetic Angiopathies, Antigens, Antigens,CD59, Cells,Cultured, Complement, Cho Cells, Hamsters, Laboratories, Rats, Umbilical Veins, Transfection, Erythrocytes, Cloning,Molecular, Complement Membrane Attack Complex, Guinea Pigs, K562 Cells, Ribose, Sequence Alignment},
