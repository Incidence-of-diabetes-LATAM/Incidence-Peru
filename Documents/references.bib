	month = may,
	year = {2003},
	note = {Place: Nuklearmedizinische Klinik und Poliklinik, Klinikum rechts der Isar, der Technischen Universitat Munchen, Germany},
	keywords = {blood, methods, Human, metabolism, Support,Non-U.S.Gov't, Middle Aged, physiopathology, Female, Male, Heart, Diabetes Mellitus,Type I, diagnostic use, Germany, radionuclide imaging, innervation, Iron, Rest, Cold, 3-Iodobenzylguanidine, Radiopharmaceuticals, Chelating Agents, Deferoxamine, Iron Chelating Agents},
	pages = {375--381},
