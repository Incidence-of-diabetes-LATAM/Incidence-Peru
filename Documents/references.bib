	note = {Place: Cardiac Unit, Massachusetts General Hospital, Harvard University, Boston, Massachusetts 02114, USA. wwhang@partners.org},
	keywords = {diagnosis, Human, Comparative Study, United States, Female, Male, Middle Age, epidemiology, Longitudinal Studies, Multicenter Studies, Myocardial Infarction, Heart, Follow-Up Studies, Multivariate Analysis, Diabetes Mellitus, Regression Analysis, mortality, Predictive Value of Tests, Massachusetts, Death, Prognosis, Comorbidity, Survival Analysis, Heart Rate, Arrhythmia, Survivors, Electrocardiography, Stroke Volume, Ventricular Premature Complexes},
	pages = {247--251},
