	keywords = {Epidemiology, Diabetes complications, Retinopathy, Diabetic kidney disease, Neuropathy, Type 1 diabetes mellitus},
	pages = {393--399},
	file = {Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:/Users/planetarium/Zotero/storage/X3NU3LKB/Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:application/pdf;Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:/Users/planetarium/Zotero/storage/IUDFS82E/Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:application/pdf;Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:/Users/planetarium/Zotero/storage/7B7CFQPY/Bjerg e.a. - 2018 - Clustering of microvascular complications in Type .pdf:application/pdf},
