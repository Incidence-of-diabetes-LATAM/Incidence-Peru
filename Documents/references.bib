@article{mor_modifiable_2014,
	title = {Modifiable clinical and lifestyle factors are associated with elevated alanine aminotransferase levels in newly diagnosed type 2 diabetes patients: results from the nationwide {DD2} study: {Markers} of {Elevated} {ALT} in {Type} 2 {Diabetes} {Patients}},
	volume = {30},
	issn = {15207552},
	shorttitle = {Modifiable clinical and lifestyle factors are associated with elevated alanine aminotransferase levels in newly diagnosed type 2 diabetes patients},
	url = {http://doi.wiley.com/10.1002/dmrr.2539},
	doi = {10.1002/dmrr.2539},
	abstract = {Background Current literature lacks data on markers of non-alcoholic fatty liver disease (NAFLD) in newly diagnosed type 2 diabetes mellitus (T2DM) patients. We therefore, conducted a cross-sectional study to examine modiﬁable clinical and lifestyle factors associated with elevated alanine aminotransferase (ALT) levels as a marker of NAFLD in new T2DM patients.
Methods Alanine aminotransferase levels were measured in 1026 incident T2DM patients enrolled in the nationwide Danish Centre for Strategic Research in Type 2 Diabetes (DD2) cohort. We examined prevalence of elevated ALT ({\textgreater}38 IU/L for women and {\textgreater}50 IU/L for men) and calculated prevalence ratios associated with clinical and lifestyle factors using Poisson regression. We examined the association with other biomarkers by linear regression.
Results The median value of ALT was 24 IU/L (interquartile range: 18–32 IU/L) in women and 30 IU/L (interquartile range: 22–41 IU/L) in men. Elevated ALT was found in 16\% of incident T2DM patients. The risk of elevated ALT was increased in patients who were {\textless}40 years old at diabetes debut [adjusted prevalence ratio (aPR): 1.96, 95\% conﬁdence interval (CI): 1.15–3.33], in those with alcohol overuse ({\textgreater}14/{\textgreater}21 drinks per week for women/men) (aPR: 1.60, 95\% CI: 1.03-2.50), and in those with no regular physical activity (aPR: 1.42, 95\% CI: 1.04–1.93). Obesity and metabolic syndrome per se showed no association with elevated ALT when adjusted for other markers, whereas we found positive associations of ALT with increased C-peptide (β = 0.14, 95\% CI: 0.06–0.21) and fasting blood glucose (β = 0.07, 95\% CI: 0.03–0.11).
Conclusions Among newly diagnosed T2DM patients, several modiﬁable clinical and lifestyle factors are independent markers of elevated ALT levels. Copyright © 2014 John Wiley \& Sons, Ltd.},
	language = {en},
	number = {8},
	urldate = {2021-02-14},
	journal = {Diabetes/Metabolism Research and Reviews},
	author = {Mor, Anil and Svensson, Elisabeth and Rungby, Jørgen and Ulrichsen, Sinna Pilgaard and Berencsi, Klara and Nielsen, Jens Steen and Stidsen, Jacob Volmer and Friborg, Søren and Brandslund, Ivan and Christiansen, Jens Sandahl and Beck-Nielsen, Henning and Sørensen, Henrik Toft and Thomsen, Reimar Wernich},
	month = nov,
	year = {2014},
	pages = {707--715},
	file = {Mor e.a. - 2014 - Modifiable clinical and lifestyle factors are asso.pdf:/Users/planetarium/Zotero/storage/8ABAXBZM/Mor e.a. - 2014 - Modifiable clinical and lifestyle factors are asso.pdf:application/pdf},
}

