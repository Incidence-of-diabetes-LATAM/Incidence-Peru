	month = dec,
	year = {2001},
	note = {Place: Department of Obstetrics and Gynaecology, The Chinese University of Hong Kong, The Prince of Wales Hospital, New Territories, Hong Kong. cjhaines@cuhk.edu.hk},
	keywords = {methods, Risk, diagnosis, Human, therapy, Comparative Study, drug effects, Endothelium, Endothelium,Vascular, Support,Non-U.S.Gov't, physiology, Aged, Brachial Artery, drug therapy, Female, Middle Age, therapeutic use, Disease, Heart, Reference Values, Sensitivity and Specificity, Statistics,Nonparametric, ultrasonography, Ultrasonography,Doppler, Wales, analogs \& derivatives, Angina Pectoris, Double-Blind Method, Hemodynamics, Hormone Replacement Therapy, Estradiol, Drug Administration Schedule, Drug Combinations, Norethindrone},
