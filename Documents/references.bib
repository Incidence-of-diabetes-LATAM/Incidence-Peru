	note = {Place: EURODIAB, Department of Epidemiology and Public Health, University College London, London, UK. n.chaturvedi@ic.ac.uk},
	keywords = {Adult, blood, Cholesterol, Lipids, methods, Research, Research Design, Risk, Human, metabolism, Support,Non-U.S.Gov't, Case-Control Studies, Cardiovascular Diseases, Hypercholesterolemia, Middle Age, Disease, epidemiology, London, complications, etiology, Hypertriglyceridemia, Lipoproteins, Lipoproteins,LDL Cholesterol, Particle Size, Diabetes Mellitus,Insulin-Dependent, abnormalities, Hyperlipidemia, Cohort Studies, Diabetic Angiopathies, Albuminuria, Adolescent, Lipoproteins,LDL, Apolipoproteins, Apolipoproteins B},
