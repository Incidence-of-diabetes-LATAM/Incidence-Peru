@article{schram_markers_2005,
	title = {Markers of inflammation are cross-sectionally associated with microvascular complications and cardiovascular disease in type 1 diabetes--the {EURODIAB} {Prospective} {Complications} {Study}},
	volume = {48},
	abstract = {AIMS/HYPOTHESIS: The pathogenesis of vascular complications in type 1 diabetes is poorly understood, but may involve chronic, low-grade inflammation. We investigated the association of markers of inflammation with vascular complications in type 1 diabetes. METHODS: A cross-sectional nested case-control study of the follow-up data of the EURODIAB Prospective Complications Study. This study included 543 individuals (278 men) with type 1 diabetes diagnosed at {\textless}36 years of age. Cases (n=348) had complications of diabetes, controls (n=195) had no complications. RESULTS: C-reactive protein, interleukin-6 and tumour necrosis factor-alpha levels, which were combined in an inflammatory marker Z-score, were associated with albuminuria, retinopathy and cardiovascular disease. Calculated means (95\% confidence intervals) of the marker Z-score were -0.15 (-0.22 to -0.07), 0.10 (-0.05 to 0.25), and 0.28 (0.15 to 0.41), p for trend {\textless}0.0001, in individuals with normo-, micro- and macroalbuminuria; -0.23 (-0.33 to -0.13), 0.14 (0.02 to 0.25) and 0.20 (0.07 to 0.32), p for trend {\textless}0.0001, in individuals with no, non-proliferative and proliferative retinopathy; and -0.28 (-0.39 to -0.18) and 0.06 (-0.08 to 0.20), p{\textless}0.001, in individuals without and with cardiovascular disease. Per 1 SD increase of the inflammatory marker Z-score, GFR decreased by -4.6 (-6.6 to -2.6) ml per min per 1.73 m(2) (p{\textless}0.001). CONCLUSIONS/INTERPRETATION: We have shown that markers of inflammation are strongly and independently associated with microvascular complications and cardiovascular disease in type 1 diabetes. These data suggest that strategies to decrease inflammatory activity may help to prevent the development of vascular complications in type 1 diabetes},
	number = {0012-186X LA - eng PT - Journal Article SB - IM},
	journal = {Diabetologia},
	author = {Schram, M T and Chaturvedi, N and Schalkwijk, C G and Fuller, J H and Stehouwer, C D},
	month = feb,
	year = {2005},
	note = {Place: Department of Internal Medicine, VU University Medical Center, Amsterdam, The Netherlands},
	keywords = {Men, methods, Necrosis, Case-Control Studies, Inflammation, Disease, complications, C-Reactive Protein, Netherlands, Albuminuria, Confidence Intervals, Interleukin-6},
	pages = {370--378},
	annote = {DA - 20050307},
}

@article{wolfe_coronary_2002,
	title = {Coronary artery calcification at electron beam computed tomography is increased in asymptomatic type 2 diabetics independent of traditional risk factors},
	volume = {9},
	abstract = {BACKGROUND: The risk of cardiovascular disease (CVD) is two- to fourfold greater in type 2 diabetics than in non-diabetics and cannot be accounted for by traditional risk factors alone. Coronary artery calcification (CAC) at electron beam computed tomography (EBCT) is a non-invasive index of coronary atherosclerosis. We hypothesized that the presence and extent of CAC would be greater in asymptomatic type 2 diabetics than in non-diabetics independent of traditional risk factors. METHODS: We reviewed CAC data of all asymptomatic subjects referred for EBCT between 1996-1999 and compared CAC scores in type 2 diabetics ( n= 71) to all non-diabetics ( n= 1481) and to a randomly selected group of non-diabetics matched for all traditional CVD risk factors ( n= 71). RESULTS: CAC scores were greater in type 2 diabetics (272 +/- 472, median 41) than in all non-diabetics (104 +/- 288, median 4; {\textless} 0.01) and matched non-diabetics (188 +/- 354; {\textless} 0.05, median 12; {\textless} 0.05). The odds ratio (OR) for the presence of CAC (scores {\textgreater} 0) in type 2 diabetics was 2.9 [95\% confidence intervals (CI) 1.1-7.8] after adjustment for traditional CVD risk factors. Type 2 diabetes was also associated (adjusted OR 2.15, 95\%CI 1.3-3.6) with the extent of CAC when categorized as an ordinal outcome (CAC scores 0, 1-79, 80-399 and {\textgreater} 400). In type 2 diabetics, age, sex and body mass index were associated with extent of CAC. CONCLUSIONS: CAC scores at EBCT are greater in type 2 diabetics than non-diabetic subjects, cannot be accounted for by traditional risk factors alone and may be useful for identifying novel factors for coronary atherosclerosis in type 2 diabetes},
	number = {1350-6277 LA - eng PT - Journal Article RN - 0 (Lipoproteins, LDL Cholesterol) RN - 0 (Triglycerides) SB - IM},
	journal = {J.Cardiovasc.Risk},
	author = {Wolfe, M L and Iqbal, N and Gefter, W and Mohler III, E R and Rader, D J and Reilly, M P},
	month = dec,
	year = {2002},
	note = {Place: Department of Medicine, University of Pennsylvania, 421 Curie Boulevard, 815 BRB2/3, Philadelphia, PA 19104, USA},
	keywords = {Atherosclerosis, blood, Cholesterol, methods, Odds Ratio, Risk, Sex, Triglycerides, Human, Support,U.S.Gov't,P.H.S., Case-Control Studies, Hypertension, Risk Factors, Female, Male, Middle Age, Age Factors, Disease, epidemiology, Body Mass Index, Arteries, Lipoproteins, Lipoproteins,LDL Cholesterol, Multivariate Analysis, 12, Diabetes Mellitus,Non-Insulin-Dependent, pathology, Coronary Arteriosclerosis, Logistic Models, Smoking, Calcinosis, radiography, Tomography,X-Ray Computed, Coronary Vessels, Sex Factors, Diabetic Angiopathies, Confidence Intervals},
