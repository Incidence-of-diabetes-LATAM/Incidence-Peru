	note = {Place: Department of Clinical Medicine, University of Trieste, Ospedale di Cattinara, 34149 Trieste, Italy},
	keywords = {Adult, blood, Blood Pressure, Human, drug effects, pharmacology, physiopathology, administration \& dosage, Blood Flow Velocity, Male, Arteries, Heart, England, Carotid Arteries, Elasticity, Heart Rate, Stress,Mechanical, Ethanol, Administration,Oral, Pulsatile Flow, Blood Viscosity, Viscosity, Infusions,Intravenous, Baroreflex, Phenylephrine},
