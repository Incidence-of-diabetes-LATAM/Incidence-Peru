@article{nielsen_spousal_2018-1,
	title = {Spousal cardiometabolic risk factors and incidence of type 2 diabetes: a prospective analysis from the {English} {Longitudinal} {Study} of {Ageing}},
	volume = {61},
	issn = {0012-186X, 1432-0428},
	shorttitle = {Spousal cardiometabolic risk factors and incidence of type 2 diabetes},
	url = {http://link.springer.com/10.1007/s00125-018-4587-1},
	doi = {10.1007/s00125-018-4587-1},
	abstract = {Methods We analysed data from 3649 men and 3478 women from the English Longitudinal Study of Ageing with information on their own and their spouse’s diabetes status and cardiometabolic risk factors. We modelled incidence rates and incidence rate ratios with Poisson regression, using spousal diabetes status or cardiometabolic risk factors (i.e. BMI, waist circumference, systolic and diastolic BP, HDL- and LDL-cholesterol and triacylglycerols) as exposures and type 2 diabetes incidence in the index individual as the outcome. Models were adjusted for two nested sets of covariates.
Results Spousal BMI and waist circumference were associated with incident type 2 diabetes, but with different patterns for men and women. A man’s risk of type 2 diabetes increased more steeply with his wife’s obesity level, and the association remained statistically significant even after adjustment for the man’s own obesity level. Having a wife with a 5 kg/m2 higher BMI (30 kg/m2 vs 25 kg/m2) was associated with a 21\% (95\% CI 11\%, 33\%) increased risk of type 2 diabetes. In contrast, the association between incident type 2 diabetes in a woman and her husband’s BMI was attenuated after adjusting for the woman’s own obesity level. Findings for waist circumference were similar to those for BMI. Regarding other risk factors, we found a statistically significant association only between the risk of type 2 diabetes in women and their husbands’ triacylglycerol levels.
Conclusions/interpretation The main finding of this study is the sex-specific effect of spousal obesity on the risk of type 2 diabetes. Having an obese spouse increases an individual’s risk of type 2 diabetes over and above the effect of the individual’s own obesity level among men, but not among women. Our results suggest that a couples-focused approach may be beneficial for the early detection of type 2 diabetes and individuals at high risk of developing type 2 diabetes, especially in men, who are less likely than women to attend health checks.},
	language = {en},
	number = {7},
	urldate = {2021-02-14},
	journal = {Diabetologia},
	author = {Nielsen, Jannie and Hulman, Adam and Witte, Daniel R.},
	month = jul,
	year = {2018},
	pages = {1572--1580},
	file = {Nielsen e.a. - 2018 - Spousal cardiometabolic risk factors and incidence.pdf:/Users/planetarium/Zotero/storage/VFC2PRST/Nielsen e.a. - 2018 - Spousal cardiometabolic risk factors and incidence.pdf:application/pdf},
}

@article{nielsen_cross-sectional_2011,
	title = {A cross-sectional study on \textit{trans-} fatty acids and risk markers of {CHD} among middle-aged men representing a broad range of {BMI}},
	volume = {106},
	issn = {0007-1145, 1475-2662},
	url = {https://www.cambridge.org/core/product/identifier/S0007114511001474/type/journal_article},
	doi = {10.1017/S0007114511001474},
	abstract = {Intake of trans-fatty acids (TFA), especially industrially produced TFA (I-TFA), has been associated with the risk of CHD through inﬂuence on serum lipid levels. Other causal pathways remain less investigated. In the present cross-sectional study of middle-aged men representing a broad range of BMI, the association between intake of TFA, I-TFA and ruminant TFA (R-TFA) and obesity-associated risk markers of CHD was assessed. The study comprised 393 Danish men (median age 49 years) with a median BMI of 28·4 kg/m2. Intake of TFA was estimated based on 7 d dietary records, whereas outcomes of interest (waist circumference, sagittal abdominal diameter, percentage of truncal fat, C-reactive protein, IL-6, blood lipids, blood pressure, HbA1c and insulin sensitivity index) were obtained through clinical examination. The associations were assessed by linear regression analysis. The median intake of total TFA among the 393 men was 1·3 g/d, covering a daily I-TFA intake of 0·4 g (10– 90th percentile 0·0 –1·0) and R-TFA intake of 0·9 g (10 – 90th percentile 0·4– 1·8). Intake of these amounts of TFA showed no signiﬁcant associations with abdominal fatness, inﬂammatory markers, blood lipids, blood pressure and insulin homeostasis. Among middle-aged men with a generally low intake of TFA, neither I-TFA nor R-TFA was signiﬁcantly related to obesity-associated risk markers of CHD. The decreased average intake of I-TFA in Denmark since 1995 is suggested to effectively prevent occurrence of the adverse metabolic changes and health consequences, which have formerly been observed in relation to, especially, I-TFA intake.},
	language = {en},
	number = {8},
	urldate = {2021-02-14},
	journal = {British Journal of Nutrition},
	author = {Nielsen, Birgit M. and Nielsen, Marie M. and Jakobsen, Marianne U. and Nielsen, Carina J. and Holst, Claus and Larsen, Thomas M. and Bendsen, Nathalie T. and Bysted, Anette and Leth, Torben and Hougaard, David M. and Skogstrand, Kristin and Astrup, Arne and Sørensen, Thorkild I. A. and Jess, Tine},
	month = oct,
	year = {2011},
	keywords = {Adult, Blood Pressure, Lipids, Obesity, Denmark, Middle Aged, Risk Factors, Male, Humans, Body Mass Index, Blood Glucose, Coronary Disease, Cross-Sectional Studies, Denmark: epidemiology, Inflammation Mediators, Inflammation Mediators: blood, Lipids: blood, Blood Glucose: metabolism, Coronary Disease: epidemiology, Coronary Disease: etiology, Abdominal, Abdominal: complications, Trans Fatty Acids, Trans Fatty Acids: administration \& dosage, Trans Fatty Acids: adverse effects},
	pages = {1245--1252},
	file = {Nielsen e.a. - 2011 - A cross-sectional study on trans- fatty aci.pdf:/Users/planetarium/Zotero/storage/XVBDIY88/Nielsen e.a. - 2011 - A cross-sectional study on trans- fatty aci.pdf:application/pdf},
