	keywords = {11, Adult, blood, Blood Pressure, methods, Pressure, Research, Research Design, Risk, Human, metabolism, Case-Control Studies, Denmark, Middle Aged, Female, Male, Disease, complications, 10, Plasma, ultrasonography, mortality, Diabetes Mellitus,Type I, abnormalities, Echocardiography, Morbidity, Creatinine, Death, Diabetic Nephropathies, Albuminuria, Immunoenzyme Techniques, Hypertrophy,Left Ventricular, Echocardiography,Doppler,Pulsed, Renin-Angiotensin System},
	pages = {1534--1539},
