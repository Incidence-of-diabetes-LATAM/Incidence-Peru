	month = jan,
	year = {2001},
	note = {Place: Endocrinology and Diabetology Division, Lausanne, Switzerland},
	keywords = {Fasting, Insulin, Insulin Resistance, Lipids, methods, Obesity, Risk, Human, metabolism, Support,Non-U.S.Gov't, Case-Control Studies, Risk Factors, Female, Male, Disease, Body Mass Index, Heart, Multivariate Analysis, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Family, Logistic Models, enzymology, genetics, Esterases, Polymerase Chain Reaction, Diabetic Nephropathies, Homozygote, Linkage Disequilibrium, Multigene Family, Polymorphism,Restriction Fragment Length},
