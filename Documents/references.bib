	note = {Issue: 1046-6673 LA - eng PT - Clinical Trial PT - Journal Article PT - Randomized Controlled Trial SB - IM
Publication Title: Journal of the American Society of Nephrology : JASN
Volume: 14},
	keywords = {Adult, analysis, Glucose, Incidence, Men, methods, Obesity, Risk, Women, therapy, Comparative Study, Middle Aged, Female, Male, epidemiology, Humans, Time, Body Mass Index, Life Style, prevention \& control, Follow-Up Studies, Diabetes Mellitus, Reference Values, Risk Assessment, Glucose Tolerance Test, Primary Prevention, Diet, Research Support, Weight Loss, Treatment Outcome, Finland, Non-U.S.Gov't, Confidence Intervals, Type 2, Severity of Illness Index, Intervention Studies},
