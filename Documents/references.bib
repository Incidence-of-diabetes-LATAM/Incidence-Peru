	note = {Place: Department of Cardiology, Odense University Hospital, Odense, Denmark. olemay@dadlnet.dk},
	keywords = {Adult, blood, Blood Pressure, Fasting, Glucose, methods, Pressure, Risk, diagnosis, Human, Comparative Study, Support,Non-U.S.Gov't, Denmark, Cardiovascular Diseases, Risk Factors, Aged, Female, Male, Middle Age, Disease, epidemiology, Myocardial Infarction, Blood Glucose, Heart, Coronary Disease, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Statistics,Nonparametric, Cardiology, Prevalence, Death, Exercise, Prognosis, statistics \& numerical data, Heart Rate, C-Peptide, Random Allocation, Autonomic Nervous System Diseases, Exercise Test},
	pages = {483--491},
