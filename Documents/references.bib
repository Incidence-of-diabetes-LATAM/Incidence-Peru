	note = {Place: Department of Epidemiology, Erasmus University Medical School, Rotterdam, The Netherlands},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Insulin, Insulin Resistance, Obesity, Syndrome, Triglycerides, Human, metabolism, Support,Non-U.S.Gov't, United States, Body Weight, physiology, physiopathology, Female, Middle Age, epidemiology, Body Mass Index, Arteries, Arteriosclerosis, Regression Analysis, pathology, Smoking, Tunica Intima, Tunica Media, C-Reactive Protein, Netherlands, Carotid Arteries, Carotid Artery,Common, Postmenopause, Plasminogen Activator Inhibitor 1, Body Height, Premenopause},
