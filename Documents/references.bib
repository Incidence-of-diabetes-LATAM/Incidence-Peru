	note = {Place: Institute for Research in Extramural Medicine, Vrije Universiteit, Amsterdam, The Netherlands},
	keywords = {analysis, blood, Cholesterol, Glucose, Research, Risk, Sex, Human, Comparative Study, metabolism, Support,Non-U.S.Gov't, United States, Hypertension, Risk Factors, Aged, Female, Male, Middle Age, Heart, Follow-Up Studies, Coronary Disease, Multivariate Analysis, Prospective Studies, Diabetes Mellitus,Non-Insulin-Dependent, mortality, Smoking, C-Reactive Protein, Netherlands, Cohort Studies, von Willebrand Factor, Survival Analysis, Acute-Phase Reaction},
