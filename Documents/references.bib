	note = {Place: Institute of Microbiology and Pathology, University of Turku, Finland. jorma-ilonen@utu.fi},
	keywords = {analysis, blood, methods, Risk, Human, Support,Non-U.S.Gov't, Alleles, epidemiology, Time, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Risk Assessment, pathology, genetics, Genotype, microbiology, Infant, Finland, HLA-DR Antigens, Haplotypes, Linkage Disequilibrium, Genetic Markers, Histocompatibility Testing, HLA-DQ Antigens},
