	month = feb,
	year = {2003},
	note = {Place: Department of Metabolism, Endocrinology and Molecular Medicine, Osaka City University Graduate School of Medicine, Japan},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Pressure, Sex, metabolism, Middle Aged, physiopathology, Risk Factors, Aged, Female, Male, epidemiology, Humans, Arteries, Lipoproteins, Diabetes Mellitus, Japan, Reference Values, Regression Analysis, mortality, Smoking, Sex Characteristics, Diabetic Angiopathies, Cities, Pulse, HDL, Type 2, Arterial Occlusive Diseases, Systole, HDL Cholesterol, LDL, LDL Cholesterol},
