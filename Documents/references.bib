	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Glucose, Insulin, Men, methods, Pressure, Research, Research Design, Sex, Women, diagnosis, Human, Support,Non-U.S.Gov't, Middle Aged, physiology, drug therapy, Female, Male, therapeutic use, Disease, complications, Blood Glucose, prevention \& control, Follow-Up Studies, Prospective Studies, Hypoglycemic Agents, 12, Predictive Value of Tests, Smoking, Diabetes Mellitus,Type I, Diabetic Nephropathies, Hemoglobin A,Glycosylated, Neural Conduction, Peroneal Nerve, Sural Nerve, Motor Neurons, Neurons,Afferent},
