@article{li_relation_2012,
	title = {Relation of childhood obesity/cardiometabolic phenotypes to adult cardiometabolic profile: the {Bogalusa} {Heart} {Study}.},
	volume = {176 Suppl},
	url = {http://www.ncbi.nlm.nih.gov/pubmed/23035138},
	doi = {10.1093/aje/kws236},
	abstract = {Not all obese adults have cardiometabolic abnormalities. It is unknown whether this is true in children and, if true, whether children who have metabolically healthy overweight/obesity (MHO) will also have favorable cardiometabolic profiles in adulthood. These aspects were examined in 1,098 individuals who participated as both children (aged 5-17 years) and adults (aged 24-43 years) in the Bogalusa Heart Study between 1997 and 2002 in Bogalusa, Louisiana. MHO was defined as being in the top body mass index quartile, while low density lipoprotein cholesterol, triglycerides, mean arterial pressure, and glucose were in the bottom 3 quartiles, and high density lipoprotein cholesterol was in the top 3 quartiles. Forty-six children (4.2\%) had MHO, and they were more likely to retain MHO status in adulthood compared with children in other categories (P {\textless} 0.0001). Despite markedly increased obesity in childhood and in adulthood, these same MHO children and adults showed a cardiometabolic profile generally comparable to that of nonoverweight/obese children (P {\textgreater} 0.05 in most cases). Moreover, there was no difference in carotid intima-media thickness in adulthood between MHO children and nonoverweight/obese children. Further, carotid intima-media thickness in adulthood was lower in MHO children than in metabolically abnormal, overweight/obese children (P = 0.003). In conclusion, the MHO phenotype starts in childhood and continues into adulthood.},
	number = {7},
	journal = {American journal of epidemiology},
	author = {Li, Shengxu and Chen, Wei and Srinivasan, Sathanur R and Xu, Jihua and Berenson, Gerald S},
	month = oct,
	year = {2012},
	keywords = {Adult, Blood Pressure, Obesity, Triglycerides, Risk Factors, Female, Male, Age Factors, Humans, Longitudinal Studies, Blood Glucose, Coronary Disease, Cross-Sectional Studies, Child, Carotid Arteries, Phenotype, Adolescent, Young Adult, Blood Glucose: analysis, Obesity: epidemiology, Obesity: complications, Cholesterol, LDL, Cholesterol, LDL: blood, Coronary Disease: blood, Louisiana, Triglycerides: blood, Coronary Disease: epidemiology, Carotid Arteries: ultrasonography, Child, Preschool, Coronary Disease: etiology, Louisiana: epidemiology},
	pages = {S142--9},
}

