	pages = {140--146},
	file = {Zaninotto e.a. - 2008 - Trends in obesity among adults in England from 199.pdf:/Users/planetarium/Zotero/storage/CK8654AJ/Zaninotto e.a. - 2008 - Trends in obesity among adults in England from 199.pdf:application/pdf},
