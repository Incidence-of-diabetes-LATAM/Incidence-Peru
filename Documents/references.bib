	journal = {Thorax},
	author = {Faurholt-Jepsen, Daniel and Range, Nyagosya and Praygod, George and Jeremiah, Kidola and Faurholt-Jepsen, Maria and Aabye, Martine G and Grewal, Harleen M S and Changalucha, John and Witte, Daniel R and Andersen, Aase B and Friis, Henrik},
	month = mar,
