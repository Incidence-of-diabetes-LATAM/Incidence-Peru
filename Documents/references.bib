	keywords = {Adult, blood, Blood Pressure, Diabetic Neuropathies, Human, Support,Non-U.S.Gov't, Animal, cytology, physiopathology, Female, Male, Middle Age, Time Factors, Disease, London, complications, Diabetes Mellitus,Insulin-Dependent, Diabetes Mellitus, Reference Values, Prevalence, Child, immunology, Antibodies, Adolescent, Child,Preschool, Heart Rate, Autoantibodies, Immune System, Autonomic Nervous System, Rabbits, Adrenal Glands, Fluorescent Antibody Technique, Ganglia,Sympathetic, Haplorhini, innervation, Nerve Fibers, Vagus Nerve, Valsalva's Maneuver},
