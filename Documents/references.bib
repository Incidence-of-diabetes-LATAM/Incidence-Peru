	keywords = {Adult, blood, Fasting, Glucose, methods, diagnosis, metabolism, Aged, epidemiology, Humans, Body Mass Index, Multicenter Studies, Blood Glucose, Plasma, Diabetes Mellitus, Probability, Reference Values, Prevalence, Reproducibility of Results, Glucose Tolerance Test, Mass Screening, Research Support, Adolescent, Australia, Non-U.S.Gov't, North Carolina, European Continental Ancestry Group},
