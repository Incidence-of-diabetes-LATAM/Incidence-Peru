	note = {Place: Department of Cardiology, Rigshospitalet Heart Center, Copenhagen, Denmark. he@heart.dk},
	keywords = {methods, Risk, Syndrome, diagnosis, Human, therapy, drug effects, United States, Denmark, Cardiovascular Diseases, Hypertension, physiology, physiopathology, adverse effects, Disease, epidemiology, complications, etiology, Heart, Diabetes Mellitus, Risk Assessment, mortality, Cardiology, Death, Death,Sudden,Cardiac, Prognosis, Arrhythmia, Electrocardiography, Pharmaceutical Preparations, Long QT Syndrome, Ventricular Function, Tachycardia,Ventricular},
	pages = {289--294},
	annote = {DA - 20020712},
}

@article{ludewig_arterial_2002,
	title = {Arterial inflammation and atherosclerosis},
	volume = {12},
	abstract = {Arterial inflammation is a significant component of atherosclerotic disease and it has been suggested that specific immune responses directed against autoantigens or pathogen-derived antigens presented in the vascular wall could initiate and/or maintain atherosclerotic processes. Atherogenic cofactors such as altered cholesterol metabolism may not only impact locally on inflammatory responses in atherosclerotic lesions, but may also alter general immune-responsiveness. The evidence to date suggests that the mutual chronic perpetuation of immune mediated vascular inflammation and cholesterol-induced atherosclerosis is a key step in atherogenesis},
