	keywords = {Adult, Obesity, Female, Male, Humans, Canada, Weight Loss, Canada: epidemiology, Obesity: epidemiology, Delivery of Health Care, Evidence-Based Medicine, Health Promotion, Outcome Assessment (Health Care), Risk Reduction Behavior, Health Promotion: methods, Obesity: prevention \& control},
	pages = {178--185},
	file = {Kirk e.a. - 2012 - Effective weight management practice a review of .pdf:/Users/planetarium/Zotero/storage/R52DC6XN/Kirk e.a. - 2012 - Effective weight management practice a review of .pdf:application/pdf},
