@article{bauer_dual-energy_2012,
	title = {Dual-energy {X}-ray absorptiometry prediction of adipose tissue depots in children and adolescents},
	volume = {72},
	issn = {0031-3998, 1530-0447},
	url = {http://www.nature.com/articles/pr2012100},
	doi = {10.1038/pr.2012.100},
	abstract = {Background: The measurement of adipose tissue (AT) depots in vivo requires expensive imaging methods not accessible to most clinicians and researchers. The study aim was to derive mathematical models to predict total AT (TAT) and subdepots from total body fat derived from a dual-energy X-ray absorptiometry (DXA) scan.
Methods: Models were developed to predict magnetic resonance imaging–derived TAT and subdepots subcutaneous AT, visceral AT, and intermuscular AT from DXA total body fat (FatDXA) using cross-sectional data (time 0 (T0)) and validated results using 1 (T1) and 2 (T2) y follow-up data. Subjects were 176 multiethnic healthy children ages 5–17 y at T0. Twenty-two were measured at T1 and T2. TAT was compared with FatDXA.
Results: At T0, TAT was greater than FatDXA (12.5 ± 8.4 vs.12.0 ± 9.4 kg; P {\textless} 0.0001), with a quadratic relationship between TAT and FatDXA that varied by sex. Predicted mean TATs were not different from measured TATs: T1: (9.84 ± 4.45 kg vs. 9.50 ± 4.37 kg; P = 0.11); T2: (12.94 ± 6.75 kg vs. 12.89 ± 7.09 kg; P = 0.76). The quadratic relationship was not influenced by race or age.
Conclusion: In general, the prediction equations for TAT and subdepots were consistent with the measured values using T1 and T2 data.},
	language = {en},
	number = {4},
	urldate = {2021-02-13},
	journal = {Pediatric Research},
	author = {Bauer, Jacqueline and Thornton, John and Heymsfield, Steven and Kelly, Kim and Ramirez, Alexander and Gidwani, Sonia and Gallagher, Dympna},
	month = oct,
	year = {2012},
	pages = {420--425},
	file = {Bauer e.a. - 2012 - Dual-energy X-ray absorptiometry prediction of adi.pdf:/Users/planetarium/Zotero/storage/8MKEV77T/Bauer e.a. - 2012 - Dual-energy X-ray absorptiometry prediction of adi.pdf:application/pdf;Bauer e.a. - 2012 - Dual-energy X-ray absorptiometry prediction of adi.pdf:/Users/planetarium/Zotero/storage/ESDDIQ8N/Bauer e.a. - 2012 - Dual-energy X-ray absorptiometry prediction of adi.pdf:application/pdf},
