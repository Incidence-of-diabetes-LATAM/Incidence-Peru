	note = {Place: Diabetes Research Center/Department of Pediatrics, Ullevaal University Hospital, Oslo, Norway. j.r.larsen@ioks.uio.no},
	keywords = {Adult, analysis, blood, Blood Pressure, Cholesterol, Glucose, Research, Risk, Triglycerides, Human, metabolism, Support,Non-U.S.Gov't, Risk Factors, Female, Male, Disease, epidemiology, Body Mass Index, complications, Arteries, Coronary Stenosis, Blood Glucose, Heart, prevention \& control, Hyperglycemia, Coronary Disease, Diabetes Mellitus,Insulin-Dependent, ultrasonography, mortality, Coronary Angiography, Smoking, Prevalence, Biological Markers, radiography, Angiography, Death, Exercise, Diabetic Angiopathies, Albuminuria, Hemoglobin A,Glycosylated},
