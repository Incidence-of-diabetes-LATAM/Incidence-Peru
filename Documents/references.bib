}

@article{gokce_long-term_1999,
	title = {Long-term ascorbic acid administration reverses endothelial vasomotor dysfunction in patients with coronary artery disease},
	volume = {99},
	abstract = {BACKGROUND: Loss of endothelium-derived nitric oxide (EDNO) contributes to the clinical expression of coronary artery disease (CAD). Increased oxidative stress has been linked to impaired endothelial vasomotor function in atherosclerosis, and recent studies demonstrated that short-term ascorbic acid treatment improves endothelial function. METHODS AND RESULTS: In a randomized, double-blind, placebo-controlled study, we examined the effects of single-dose (2 g PO) and long-term (500 mg/d) ascorbic acid treatment on EDNO-dependent flow-mediated dilation of the brachial artery in patients with angiographically established CAD. Flow-mediated dilation was examined by high-resolution vascular ultrasound at baseline, 2 hours after the single dose, and 30 days after long-term treatment in 46 patients with CAD. Flow-mediated dilation improved from 6.6+/-3.5\% to 10.1+/-5.2\% after single-dose treatment, and the effect was sustained after long-term treatment (9. 0+/-3.7\%), whereas flow-mediated dilation was 8.6+/-4.7\% at baseline and remained unchanged after single-dose (7.8+/-4.4\%) and long-term (7.9+/-4.5\%) treatment with placebo (P=0.005 by repeated-measures ANOVA). Plasma ascorbic acid concentrations increased from 41.4+/-12. 9 to 115.9+/-34.2 micromol/L after single-dose treatment and to 95. 0+/-36.1 micromol/L after long-term treatment (P{\textless}0.001). CONCLUSIONS: In patients with CAD, long-term ascorbic acid treatment has a sustained beneficial effect on EDNO action. Because endothelial dysfunction may contribute to the pathogenesis of cardiovascular events, this study indicates that ascorbic acid treatment may benefit patients with CAD},
	number = {1524-4539 LA - eng},
	journal = {Circulation},
	author = {Gokce, N and Keaney Jr., J F and Frei, B and Holbrook, M and Olesiak, M and Zachariah, B J and Leeuwenburgh, C and Heinecke, J W and Vita, J A},
	month = jun,
	year = {1999},
	note = {Place: Evans Memorial Department of Medicine, Cardiology Section, and Whitaker Cardiovascular Institute, Boston University School of Medicine, Boston, MA, USA},
	keywords = {Adult, Atherosclerosis, blood, Glucose, Lipids, methods, Human, Antioxidants, drug effects, Endothelium,Vascular, metabolism, Nitric Oxide, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., United States, physiopathology, Aged, Ascorbic Acid, Brachial Artery, drug therapy, Female, Male, Middle Age, Oxidative Stress, therapeutic use, Time Factors, Disease, Arteries, Blood Glucose, Coronary Disease, Plasma, Cardiology, Biological Markers, Expression, Stress, Double-Blind Method, Treatment Outcome, Hemodynamics, Glutathione, Free Radical Scavengers},
