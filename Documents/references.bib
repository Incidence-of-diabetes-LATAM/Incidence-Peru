	journal = {J.Am.Coll.Cardiol.},
	author = {Gokce, N and Keaney, J F and Hunter, L M and Watkins, M T and Nedeljkovic, Z S and Menzoian, J O and Vita, J A},
	month = may,
	year = {2003},
	note = {Place: Evans Department of Medicine and Whitaker Cardiovascular Institute, Boston University School of Medicine, Boston, Massachusetts, USA},
	keywords = {Atherosclerosis, Odds Ratio, Risk, Risk Factors, Brachial Artery, Disease, Myocardial Infarction, 10, Nitroglycerin, Vasodilation, Massachusetts, Death, surgery, Endarterectomy},
	pages = {1769--1775},
