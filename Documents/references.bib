	keywords = {blood, methods, Risk, Triglycerides, Human, drug effects, Endothelium,Vascular, metabolism, pharmacology, Support,Non-U.S.Gov't, Leukocytes, physiopathology, adverse effects, Brachial Artery, Female, Male, Middle Age, Oxidative Stress, etiology, Arteries, Hypertriglyceridemia, Arteriosclerosis, Vasodilation, Postmenopause, Acute Disease, Hemorheology, Dietary Fats, Eating, Anthropometry, Diet,Fat-Restricted, Respiratory Burst, Superoxides, Tetradecanoylphorbol Acetate, ultrastructure},
