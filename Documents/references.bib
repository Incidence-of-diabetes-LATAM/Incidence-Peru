	month = feb,
	year = {2007},
	note = {Place: Department of Social and Preventive Medicine, School of Public Health and Health Professions, State University of New York at Buffalo, 35 Main Street, Buffalo, NY 14214, USA. rpd1@buffalo.edu},
	keywords = {blood, Fasting, Glucose, Insulin, Men, methods, Research, Research Design, Risk, Sex, Women, E-Selectin, Endothelium,Vascular, Middle Aged, Cardiovascular Diseases, Disease Progression, Hypertension, Inflammation, physiology, Risk Factors, Aged, Female, Male, Time Factors, Disease, epidemiology, Humans, Public Health, Body Mass Index, Heart, Biological Markers, C-Reactive Protein, Thrombosis, Sex Characteristics, Research Support, Plasminogen Activator Inhibitor 1, Prediabetic State, Preventive Medicine, Adiponectin, Fibrinolysis, New York},
