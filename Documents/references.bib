	doi = {10.3109/14653249.2012.677820},
	abstract = {Mesenchymal stromal cells (MSC) are being used to treat and prevent a variety of clinical conditions. To be readily available, MSC must be cryopreserved until infusion. However, the optimal cryopreservation methods, cryoprotector solutions and MSC sensitivity to dimethyl sulfoxide (DMSO) exposure are unknown. This study investigated these issues.},
