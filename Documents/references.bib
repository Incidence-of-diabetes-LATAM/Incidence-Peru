@article{koh_vascular_1999-1,
	title = {Vascular effects of estrogen and cholesterol-lowering therapies in hypercholesterolemic postmenopausal women},
	volume = {99},
	abstract = {BACKGROUND: Lipoproteins affect endothelium-dependent vasomotor responsiveness. Because lipoprotein effects of estrogen and cholesterol-lowering therapies differ, we studied the vascular responses to these therapies in hypercholesterolemic postmenopausal women. METHODS AND RESULTS: We randomly assigned 28 women to conjugated equine estrogen (CE) 0.625 mg, simvastatin 10 mg, and their combination daily for 6 weeks. Compared with respective baseline values, simvastatin alone and combined with CE reduced LDL cholesterol to a greater extent than CE alone (both P{\textless}0.05). CE alone and combined with simvastatin raised HDL cholesterol and lowered lipoprotein(a) to a greater extent than simvastatin alone (all P{\textless}0.05). Flow-mediated dilation of the brachial artery (by ultrasonography) improved (all P{\textless}0.001 versus baseline values) on CE (4.0+/-2.6\% to 10.2+/-3.9\%), simvastatin (4.3+/-2.4\% to 10.0+/-3.9\%), and CE combined with simvastatin (4.6+/-2.0\% to 9.8+/-2.6\%), but similarly among therapies (P=0.507 by ANOVA). None of the therapies improved the dilator response to nitroglycerin (all P{\textgreater}/=0.184). Only therapies including CE lowered levels of plasminogen activator inhibitor type 1 and the cell adhesion molecule E-selectin (all P{\textless}0. 05 versus simvastatin). CONCLUSIONS: Although estrogen and statin therapies have differing effects on lipoprotein levels, specific improvement in endothelium-dependent vasodilator responsiveness is similar. However, only therapies including estrogen improved markers of fibrinolysis and vascular inflammation. Thus, estrogen therapy appears to have unique properties that may benefit the vasculature of hypercholesterolemic postmenopausal women, even if they are already on cholesterol-lowering therapy},
	number = {0009-7322 LA - eng PT - Clinical Trial PT - Journal Article PT - Randomized Controlled Trial},
	journal = {Circulation},
	author = {Koh, K K and Cardillo, C and Bui, M N and Hathaway, L and Csako, G and Waclawiw, M A and Panza, J A and Cannon III, R O},
	month = jan,
	year = {1999},
	note = {Place: Cardiology Branch National Heart, Lung, and Blood Institute, National Institutes of Health, Bethesda, Maryland 20892-1650, USA},
	keywords = {blood, Cholesterol, methods, Human, therapy, drug effects, E-Selectin, Endothelium,Vascular, Intercellular Adhesion Molecule-1, metabolism, United States, Vascular Cell Adhesion Molecule-1, Cell Adhesion, Hypercholesterolemia, Inflammation, physiology, Vasculitis, administration \& dosage, Aged, Brachial Artery, drug therapy, Female, Middle Age, Arteries, Heart, Lung, Lipoproteins, Lipoproteins,LDL Cholesterol, Nitroglycerin, ultrasonography, Vasodilation, Cardiology, Vasomotor System, Anticholesteremic Agents, Drug Therapy,Combination, Simvastatin, Hormone Replacement Therapy, Postmenopause, Estrogens, Maryland, Lipoprotein(a), Plasminogen Activator Inhibitor 1, Fibrinolysis},
