@article{kramer_concordance_2013-1,
	title = {Concordance of retinopathy and nephropathy over time in {Type} 1 diabetes: an analysis of data from the {Diabetes} {Control} and {Complications} {Trial}},
	volume = {30},
	issn = {07423071},
	shorttitle = {Concordance of retinopathy and nephropathy over time in {Type} 1 diabetes},
	url = {http://doi.wiley.com/10.1111/dme.12296},
	doi = {10.1111/dme.12296},
	abstract = {Methods This analysis was conducted in patients with Type 1 diabetes participating in the Diabetes Control and Complications Trial. Only participants with urinary albumin excretion rate {\textless} 40 mg/24 h were included in the analysis (n = 1365). We evaluated the relationship between the progression of retinopathy and the development of nephropathy over a mean 6.5 years of follow-up. Progression of retinopathy was deﬁned by 3-step change in Early Treatment Diabetic Retinopathy Study score on consecutive annual evaluations. Development of nephropathy was deﬁned as incidence of urinary albumin excretion rate ≥ 40 mg/24 h on annual evaluation.
Results Over a mean 6.5 years of follow-up, the incidence of progression of retinopathy was higher in those who developed nephropathy than in those who did not (36.2 vs. 13.4\%; P {\textless} 0.001). The development of nephropathy independently increased the risk for progression of retinopathy (hazard ratio 1.62, 95\% CI 1.23–2.13, P = 0.001), after adjustment for age, gender, diabetes duration, treatment, HbA1c, BMI, HDL cholesterol and blood pressure. Similarly, the incidence of nephropathy was higher in participants who had progression of retinopathy than in those who did not (40.7 vs. 15.7\%; P {\textless} 0.001). Furthermore, progression of retinopathy independently increased the risk for development of nephropathy (hazard ratio 1.72, 95\% CI 1.30–2.27, P {\textless} 0.001).
Conclusions Progression of retinopathy and development of nephropathy each increase the risk for incidence of the other, independent of established risk factors for microvascular complications, supporting the notion of a shared aetiologic basis.},
	language = {en},
	number = {11},
	urldate = {2021-02-13},
	journal = {Diabetic Medicine},
	author = {Kramer, C. K. and Retnakaran, R.},
	month = nov,
	year = {2013},
	pages = {1333--1341},
	file = {Kramer en Retnakaran - 2013 - Concordance of retinopathy and nephropathy over ti.pdf:/Users/planetarium/Zotero/storage/N7CFRFF4/Kramer en Retnakaran - 2013 - Concordance of retinopathy and nephropathy over ti.pdf:application/pdf},
}

@article{kramer_diabetic_2011,
	title = {Diabetic {Retinopathy} {Predicts} {All}-{Cause} {Mortality} and {Cardiovascular} {Events} in {Both} {Type} 1 and 2 {Diabetes}: {Meta}-analysis of observational studies},
	volume = {34},
	issn = {0149-5992, 1935-5548},
	shorttitle = {Diabetic {Retinopathy} {Predicts} {All}-{Cause} {Mortality} and {Cardiovascular} {Events} in {Both} {Type} 1 and 2 {Diabetes}},
	url = {http://care.diabetesjournals.org/cgi/doi/10.2337/dc11-0079},
	doi = {10.2337/dc11-0079},
	abstract = {OBJECTIVE—The prognostic signiﬁcance of diabetic retinopathy (DR) for death and cardiovascular (CV) outcomes is debated. We investigated the association of DR with all-cause mortality and CV events in patients with diabetes by a systematic review and meta-analysis. RESEARCH DESIGN AND METHODS—The electronic databases Medline and Embase were searched for cohort studies that evaluated DR in type 2 or type 1 diabetic patients and reported total mortality and/or fatal and nonfatal CV events, including myocardial infarction, angina pectoris, coronary artery bypass graft, ischemic changes on a conventional 12-lead electrocardiogram, transient ischemic attack, nonfatal stroke, or lower leg amputation. Data extraction was performed by two reviewers independently. Pooled effect estimates were obtained by using random-effects meta-analysis.
RESULTS—The analysis included 20 studies that fulﬁlled the inclusion criteria, providing data from 19,234 patients. In patients with type 2 diabetes (n = 14,896), the presence of any degree of DR increased the chance for all-cause mortality and/or CV events by 2.34 (95\% CI 1.96–2.80) compared with patients without DR. In patients with type 1 diabetes (n = 4,438), the corresponding odds ratio was 4.10 (1.50–11.18). These associations remained after adjusting for traditional CV risk factors. DR was also predictive of all-cause mortality in type 2 diabetes (odds ratio 2.41 [1.87–3.10]) and type 1 diabetes (3.65 [1.05–12.66]).
CONCLUSIONS—The presence of DR was associated with an increased risk of all-cause mortality and CV events in both type 2 and type 1 diabetic patients.},
	language = {en},
	number = {5},
	urldate = {2021-02-13},
	journal = {Diabetes Care},
	author = {Kramer, C. K. and Rodrigues, T. C. and Canani, L. H. and Gross, J. L. and Azevedo, M. J.},
	month = may,
	year = {2011},
	pages = {1238--1244},
