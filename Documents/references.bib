@article{chang_separate_2014,
	title = {Separate and {Joint} {Effects} of {Diabetes} {Mellitus} and {Chronic} {Kidney} {Disease} on the {Risk} of {Acute} {Coronary} {Syndrome}},
	volume = {93},
	issn = {0000000000000},
