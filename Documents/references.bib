	doi = {10.1007/s00125-010-1741-9},
	abstract = {Aims/hypothesis Real-life glycaemic profiles of healthy individuals are poorly studied. Our aim was to analyse to what extent individuals without diabetes exceed OGTT thresholds for impaired glucose tolerance (IGT) and diabetes. Methods In the A1C-Derived Average Glucose (ADAG) study, 80 participants without diabetes completed an intensive glucose monitoring period of 12 weeks. From these data, we calculated the average 24 h glucose exposure as time spent above different plasma glucose thresholds. We also derived indices of postprandial glucose levels, glucose variability and HbA1c.},
