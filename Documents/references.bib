	month = may,
	year = {2003},
	note = {Place: Department of Microbiology and Immunology, University of Western Ontario, London, Ontario, Canada N6A 5C1},
	keywords = {blood, Case-Control Studies, Disease, Humans, London, Canada, etiology, Family, enzymology, genetics, Immunoglobulin G, immunology, In Vitro, Proteins, microbiology, Autoantibodies, Ontario, Glutamic Acid, Autoimmunity, Diabetes Mellitus,Type 1, Heat, Islets of Langerhans, Glutamate Decarboxylase, Autoantigens, HSP90 Heat-Shock Proteins, Immunoglobulin Isotypes, Th1 Cells, Th2 Cells},
