	note = {Place: Department of Epidemiology and Public Health, International Centre for Health and Society, University College London, 1-19 Torrington Place, London WC1E 6BT, UK. tarani@public-health.ucl.ac.uk},
	keywords = {Adult, Men, Research, Women, Middle Aged, Risk Factors, Female, Male, Disease, epidemiology, Humans, London, Research Support,Non-U.S.Gov't, Research Support,U.S.Gov't,P.H.S., Heart, Coronary Disease, Family, Sex Factors, Questionnaires, Work, Health Status Indicators, Socioeconomic Factors, psychology, Great Britain, Family Characteristics, Government Agencies, Internal-External Control, Power (Psychology), Women's Health},
