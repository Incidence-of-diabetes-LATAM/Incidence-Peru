	note = {Place: Division of Endocrinology, Department of Internal Medicine, West China Hospital, SiChuan University, 37 Guo Xue Lane, ChengDu 610041, PR China},
	keywords = {analysis, Risk, Disease, Diabetes Mellitus, Regression Analysis, ultrasonography, Lipid Peroxides, Genotype, China},
