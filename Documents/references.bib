@article{orchard_lipid_2001,
	title = {Lipid and blood pressure treatment goals for type 1 diabetes: 10-year incidence data from the {Pittsburgh} {Epidemiology} of {Diabetes} {Complications} {Study}},
	volume = {24},
	abstract = {OBJECTIVE--Subjects with type 1 diabetes are at high risk for many long-term complications, including early mortality and coronary artery disease (CAD). Few data are available on which to base goal levels for two major risk factors, namely blood pressure and lipid/lipoproteins. The objective of this study was to determine at which levels of LDL and HDL cholesterol, triglycerides, and blood pressure the relative risks of type 1 diabetic complications increase significantly. RESEARCH DESIGN AND METHODS--Observational prospective study of 589 patients with childhood-onset type 1 diabetes ({\textless}17 years) aged {\textgreater} or =18 years at baseline; 10-year incidence of mortality, CAD, lower-extremity arterial disease, proliferative retinopathy, distal symmetric polyneuropathy, and overt nephropathy. Relative risks were determined using traditional groupings of blood pressure and lipid/lipoproteins, measured at baseline, using the lowest groupings ({\textless}100 mg/dl [2.6 mmol/l] LDL cholesterol, {\textless}45 mg/dl [1.1 mmol/l] HDL cholesterol, {\textless}100 mg/dl [1.1 mmol/l] triglycerides, {\textless}110 mmHg systolic blood pressure, and {\textless}80 mmHg diastolic blood pressure) as reference. Adjustments for age, sex, and glycemic control were examined. RESULTS--Driven mainly by strong relationships (RR range 1.8-12.1) with mortality, CAD, and overt nephropathy, suggested goal levels are as follows: LDL cholesterol {\textless}100 mg/dl (2.6 mmol/l), HDL cholesterol {\textgreater}45 mg/dl (1.1 mmol/l), triglycerides {\textless}150 mg/dl (1.7 mmol/l), systolic blood pressure {\textless}120 mmHg, and diastolic blood pressure {\textless}80 mmHG: Age, sex, and glycemic control had little influence on these goals. CONCLUSIONS--Although observational in nature, these data strongly support the case for vigorous control of lipid levels and blood pressure in patients with type 1 diabetes},
	number = {0149-5992 LA - eng PT - Journal Article RN - 0 (Hemoglobin A, Glycosylated) RN - 0 (Lipoproteins, HDL Cholesterol) RN - 0 (Triglycerides) SB - IM},
	journal = {Diabetes Care},
