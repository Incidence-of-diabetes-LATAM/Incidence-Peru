	keywords = {methods, Risk, Human, Aged, Female, Male, Middle Age, Disease, epidemiology, Myocardial Infarction, Heart, Coronary Disease, Meta-Analysis, Washington, Risk Assessment, mortality, Predictive Value of Tests, radiography, Tomography,X-Ray Computed, Death, Calcium, Prognosis},
