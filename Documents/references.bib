	keywords = {epidemiology, diabetes},
	pages = {679--687},
	file = {Breeze e.a. - 2016 - A statistical model to describe longitudinal and c.pdf:/Users/planetarium/Zotero/storage/2SLY5UTH/Breeze e.a. - 2016 - A statistical model to describe longitudinal and c.pdf:application/pdf;Breeze e.a. - 2016 - A statistical model to describe longitudinal and c.pdf:/Users/planetarium/Zotero/storage/B4T9RAIR/Breeze e.a. - 2016 - A statistical model to describe longitudinal and c.pdf:application/pdf},
