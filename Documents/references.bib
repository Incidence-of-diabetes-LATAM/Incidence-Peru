	keywords = {analysis, methods, Risk, Sex, diagnosis, Human, Comparative Study, Risk Factors, Aged, Female, Male, Middle Age, Disease, etiology, Multicenter Studies, Arteries, Follow-Up Studies, Coronary Disease, Multivariate Analysis, Coronary Angiography, Reproducibility of Results, Aged,80 and over, Calcinosis, Coronary Calcification, radiography, Tomography,X-Ray Computed, Angiography, Roc Curve, Calcium, Retrospective Studies},
