	author = {Brull, D J and Serrano, N and Zito, F and Jones, L and Montgomery, H E and Rumley, A and Sharma, P and Lowe, G D and World, M J and Humphries, S E and Hingorani, A D},
	month = nov,
	year = {2003},
	note = {Place: Centre for Cardiovascular Genetics, BHF Laboratories at UCL, Royal Free and UCL Medical School, London, UK},
	keywords = {methods, Human, metabolism, Middle Aged, physiology, Female, Male, Disease, Humans, London, Research Support,Non-U.S.Gov't, Time, Arteries, Heart, Coronary Disease, C-Reactive Protein, genetics, Fibrinogen, Genotype, Exercise, Homozygote, Postoperative Period, surgery, Laboratories, Interleukin-6, Great Britain, Genetic Markers, Military Personnel, Acute-Phase Reaction, Coronary Artery Bypass, Polymorphism,Genetic},
