	month = jul,
	year = {2003},
	note = {Place: Metabolic Laboratory, Department of Clinical Chemistry, VU University Medical Centre, Amsterdam, The Netherlands. p.scheffer@vumc.nl},
	keywords = {analysis, Atherosclerosis, blood, Glucose, methods, Human, metabolism, Oxidation-Reduction, Aged, Female, Male, Blood Glucose, Lipoproteins, Particle Size, Plasma, Diabetes Mellitus,Non-Insulin-Dependent, Netherlands, chemistry, Enzyme-Linked Immunosorbent Assay, In Vitro, Hemoglobin A,Glycosylated, Lipoproteins,LDL, Laboratories},
