	keywords = {Adult, Atherosclerosis, blood, Cholesterol, Lipids, Risk, Human, Endothelium,Vascular, metabolism, Support,Non-U.S.Gov't, United States, physiopathology, Risk Factors, Blood Flow Velocity, Brachial Artery, drug therapy, Male, Middle Age, therapeutic use, Disease, Arteries, Lipoproteins, Lipoproteins,HDL Cholesterol, Plasma, Arteriosclerosis, Vasodilation, mortality, pathology, Morbidity, Carotid Arteries, deficiency, Lipoprotein(a), Human Growth Hormone, Insulin-Like Growth Factor I, Growth Hormone, Insulin-Like Growth Factor Binding Protein 3},
