	month = feb,
	year = {1999},
	note = {Place: Division of Epidemiology, School of Public Health, University of Minnesota, Minneapolis 55454, USA. arnett@epivax.epi.umn.edu},
	keywords = {blood, Blood Pressure, Risk, Human, physiology, Risk Factors, Female, Male, Middle Age, epidemiology, Longitudinal Studies, Multicenter Studies, Arteries, Prospective Studies, Arteriosclerosis, ultrasonography, Reproducibility of Results, Carotid Artery Diseases, Carotid Arteries, Cohort Studies, statistics \& numerical data, Vascular Resistance, Compliance, Minnesota, Carotid Artery,Common, North Carolina, Maryland, Mississippi},
