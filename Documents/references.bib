	note = {Place: GSF National Research Center for Environment and Health, Institute of Epidemiology, Neuherberg, Germany},
	keywords = {Adult, Atherosclerosis, blood, Incidence, Men, methods, Research, Risk, Women, E-Selectin, Endothelium,Vascular, Intercellular Adhesion Molecule-1, metabolism, Middle Aged, physiopathology, Risk Factors, Aged, Female, Male, Disease, epidemiology, Humans, etiology, Diabetes Mellitus,Type 2, Plasma, Diabetes Mellitus, Predictive Value of Tests, Biological Markers, C-Reactive Protein, Cohort Studies, von Willebrand Factor, Research Support, Germany, trends, Environment, Solubility},
