	note = {Place: Department of Medical Genetics, Cambridge University, Level 4, Cambridge Institute for Medical Research, Addenbrooke's Hospital, Hills Road, CB2 2QQ, Cambridge, UK. david.clayton@cimr.cam.ac.uk},
	keywords = {methods, Research, Risk, Human, Support,Non-U.S.Gov't, Support,U.S.Gov't,P.H.S., Case-Control Studies, Risk Factors, Female, Disease, epidemiology, etiology, genetics, Genotype, Cohort Studies, Genome, Environmental Exposure, Genetics,Medical, Venous Thrombosis},
