	pages = {84--92},
	file = {Narayan e.a. - 2012 - Global Prevention And Control Of Type 2 Diabetes W.pdf:/Users/planetarium/Zotero/storage/94ID6PUT/Narayan e.a. - 2012 - Global Prevention And Control Of Type 2 Diabetes W.pdf:application/pdf},
}

@article{nam_social_2015,
	title = {Social networks and future direction for obesity research: {A} scoping review},
	volume = {63},
	issn = {00296554},
	shorttitle = {Social networks and future direction for obesity research},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0029655414002504},
	doi = {10.1016/j.outlook.2014.11.001},
	abstract = {Despite signiﬁcant efforts to decrease obesity rates, the prevalence of obesity continues to increase in the United States. Obesity risk behaviors including physical inactivity, unhealthy eating, and sleep deprivation are intertwined during daily life and are difﬁcult to improve in the current social environment. Studies show that social networksdthe thick webs of social relations and interactionsdinﬂuence various health outcomes, such as HIV risk behaviors, alcohol consumption, smoking, depression, and cardiovascular mortality; however, there is limited information on the inﬂuences of social networks on obesity and obesity risk behaviors. Given the complexities of the biobehavioral pathology of obesity and the lack of clear evidence of effectiveness and sustainability of existing interventions that are usually focused on an individual approach, targeting change in an individual’s health behaviors or attitude may not take sociocontextual factors into account; there is a pressing need for a new perspective on this problem. In this review, we evaluate the literature on social networks as a potential approach for obesity prevention and treatment (i.e., how social networks affect various health outcomes), present two major social network data analyses (i.e., egocentric and sociometric analysis), and discuss implications and the future direction for obesity research using social networks. Cite this article: Nam, S., Redeker, N., \& Whittemore, R. (2015, JUNE). Social networks and future direction for obesity research: A scoping review. Nursing Outlook, 63(3), 299-317. http://dx.doi.org/10.1016/ j.outlook.2014.11.001.},
	language = {en},
	number = {3},
	urldate = {2021-02-14},
	journal = {Nursing Outlook},
	author = {Nam, Soohyun and Redeker, Nancy and Whittemore, Robin},
	month = may,
	year = {2015},
	pages = {299--317},
	file = {Nam e.a. - 2015 - Social networks and future direction for obesity r.pdf:/Users/planetarium/Zotero/storage/AUQIX9YZ/Nam e.a. - 2015 - Social networks and future direction for obesity r.pdf:application/pdf},
}

@article{nakanishi_haematocrit_2004,
	title = {Haematocrit and risk of development of {Type} 2 diabetes mellitus in middle-aged {Japanese} men},
	volume = {21},
	issn = {0742-3071, 1464-5491},
	url = {http://doi.wiley.com/10.1111/j.1464-5491.2004.01152.x},
	doi = {10.1111/j.1464-5491.2004.01152.x},
	abstract = {Methods The study enrolled 2953 normoglycaemic [fasting plasma glucose (FPG) {\textless} 6.1 mmol /l and taking no hypoglycaemic medication] Japanese men aged 35–59 years and free of medication for hypertension and history of cardiovascular disease. FPG was measured at periodic annual health examinations from May 1994 through May 2001. Men in whom Type 2 diabetes mellitus (FPG ≥ 7.0 mmol /l or receiving hypoglycaemic medication) was found during repeated surveys were classified as having Type 2 diabetes.
Results The estimated incidence rates for Type 2 diabetes during 7 years of follow-up were 3.1\% [95\% confidence interval (CI) 1.6, 4.6], 4.6\% (2.8, 6.4), 5.0\% (3.2, 6.9), 6.4\% (4.4, 8.5), and 11.5\% (8.9, 14.2) for respective haematocrit levels of {\textless} 42.6, 42.6–44.0, 44.1–45.3, 45.4 –46.8, and ≥ 46.9\% (the logrank test: P {\textless} 0.001). After controlling for potential predictors of diabetes, the respective relative risks for Type 2 diabetes were 1.0 (reference), 1.52 (95\% CI 0.81, 2.86), 1.24 (0.66, 2.31), 1.57 (0.86, 2.88), and 2.30 (1.30, 4.08) (P for trend = 0.002). From stratified analyses by presence or absence of a risk factor, a linear association of haematocrit level with risk of development of Type 2 diabetes was also observed.
Conclusion These results indicate that haematocrit contributes to the risk of developing Type 2 diabetes.},
	language = {en},
	number = {5},
	urldate = {2021-02-14},
	journal = {Diabetic Medicine},
	author = {Nakanishi, N. and Suzuki, K. and Tatara, K.},
	month = may,
	year = {2004},
	pages = {476--482},
	file = {Nakanishi e.a. - 2004 - Haematocrit and risk of development of Type 2 diab.pdf:/Users/planetarium/Zotero/storage/MAQZBCV2/Nakanishi e.a. - 2004 - Haematocrit and risk of development of Type 2 diab.pdf:application/pdf},
}

