	month = feb,
	year = {2002},
	note = {Place: Department of Applied Chemistry and Microbiology (Nutrition), University of Helsinki, PO Box 27, FW-00014 Helsinki, Finland},
	keywords = {Adult, blood, Human, Lipid Peroxidation, metabolism, Oxidation-Reduction, Female, Male, Middle Age, Oxidative Stress, Lipoproteins, chemistry, Stress, Diet, Esterases, In Vitro, microbiology, Food, Lipoproteins,LDL, Finland, Thiobarbituric Acid Reactive Substances, Nutrition, Malondialdehyde, beta Carotene},
