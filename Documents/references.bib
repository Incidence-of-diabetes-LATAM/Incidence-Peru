	keywords = {Adult, analysis, blood, Cholesterol, Triglycerides, Human, metabolism, Alleles, administration \& dosage, Female, Male, Middle Age, 10, Lipoproteins, Lipoproteins,HDL Cholesterol, Diabetes Mellitus,Insulin-Dependent, Regression Analysis, history, Smoking, Netherlands, Fatty Acids, Diet, diet therapy, genetics, Genotype, Polymorphism (Genetics), Proteins, Homozygote, Dietary Fats, Carrier Proteins, Apolipoprotein A-I, Cholesterol,Dietary, Heterozygote, Linoleic Acid, Dietary Fats,Unsaturated},
