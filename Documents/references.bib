	keywords = {Human, Dna, Support,Non-U.S.Gov't, Ethnic Groups, genetics, Genotype, Polymorphism (Genetics), Germany, Continental Population Groups, Genetics,Population, Variation (Genetics), Gene Frequency, Geography},
	pages = {1679--1685},
	annote = {DA - 20040902},
}

@article{pettigrew_mri_1999,
	title = {{MRI} techniques for cardiovascular imaging},
	volume = {10},
	abstract = {Over the last several years, cardiovascular MRI has benefited from a number of technical advances which have improved routine clinical imaging techniques. As a result, MRI is now well positioned to realize its longstanding promise of becoming the comprehensive cardiac imaging test of choice in many clinical settings. This may be achieved using a combination of basic advanced techniques. In this overview, the basic cardiac MRI techniques which are clinically useful are reviewed, and the recent technical advances which are clinically promising are described. These advances include routine black blood and cine bright blood techniques that are high speed ({\textless}10s per black blood image or cine slice), multislice whole heart perfusion imaging methods, and recently emerging real-time imaging methodologies. J Magn. Reson. Imaging 1999;10:590-601},
