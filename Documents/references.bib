	keywords = {11, Adult, analysis, blood, Fasting, Glucose, methods, Research, Research Design, Risk, diagnosis, Human, metabolism, Support,U.S.Gov't,P.H.S., United States, Female, Male, epidemiology, Body Mass Index, Blood Glucose, Prospective Studies, Diabetes Mellitus, Family, history, Prevalence, Glucose Intolerance, Glucose Tolerance Test, abnormalities, ethnology, Exercise, statistics \& numerical data, Support,U.S.Gov't,Non-P.H.S., Military Personnel, Nutrition, Physical Examination, Carbohydrates},
