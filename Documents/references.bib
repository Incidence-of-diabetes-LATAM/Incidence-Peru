	keywords = {Adult, Middle Aged, Cardiovascular Diseases, Aged, Female, Male, Humans, Risk Assessment, England, Disease Management, Cardiovascular Diseases: epidemiology, Cardiovascular Diseases: prevention \& control, Cardiovascular Diseases: diagnosis, National Health Programs, Program Evaluation, England: epidemiology, Diagnostic Tests, Routine, State Medicine, State Medicine: standards},
	pages = {129--134},
