@article{hashimoto_correlation_1999,
	title = {Correlation between flow-mediated vasodilatation of the brachial artery and intima-media thickness in the carotid artery in men},
	volume = {19},
	abstract = {Endothelial dysfunction has been reported to be the initial step in atherosclerosis. A noninvasive technique that uses ultrasound to measure the intima-media thickness of the carotid artery has been applied to evaluate localized atherosclerosis. This study was undertaken to elucidate whether endothelial dysfunction in the brachial artery is related to the intima-media thickness of the carotid artery. Thirty-four men with atherosclerosis (mean+/-SE age 61+/-2 years) and 33 age-matched men without clinical atherosclerosis were examined. The intima-media thickness and plaque formation of the common carotid artery were assessed by B-mode ultrasonography. We also noninvasively measured brachial artery diameter by the same ultrasound machine when the subjects were at rest, during reactive hyperemia, which causes endothelium-dependent vasodilatation, and after sublingual administration of nitroglycerin, which causes endothelium-independent vasodilatation. The atherosclerosis group had a significantly greater intima-media thickness of the common carotid artery than did the control group (1. 02+/-0.04 versus 0.91+/-0.03 mm, P{\textless}0.05). The flow-mediated diameter (FMD) increase (percent FMD=DeltaD/D x 100) in the atherosclerosis group was significantly smaller than that in the control group (2. 8+/-0.4\% versus 5.1+/-0.6\%, P{\textless}0.01). A significant negative correlation between the intima-media thickness of the carotid artery and percent FMD was found in all of the subjects. On multiple regression analysis, percent FMD showed a significant negative correlation with the intima-media thickness of the common carotid artery. These findings support the concept that endothelial dysfunction is significantly related to atherogenesis},
	number = {1079-5642 LA - eng PT - Clinical Trial PT - Journal Article},
	journal = {Arterioscler.Thromb.Vasc.Biol.},
	author = {Hashimoto, M and Eto, M and Akishita, M and Kozaki, K and Ako, J and Iijima, K and Kim, S and Toba, K and Yoshizumi, M and Ouchi, Y},
	month = nov,
	year = {1999},
	note = {Place: Department of Geriatric Medicine, Graduate School of Medicine, University of Tokyo, Tokyo, Japan},
	keywords = {analysis, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, physiopathology, Blood Flow Velocity, Brachial Artery, Male, Middle Age, Linear Models, Arteries, Arteriosclerosis, Japan, Nitroglycerin, Regression Analysis, ultrasonography, Vasodilation, pathology, Predictive Value of Tests, Tunica Intima, Vasodilator Agents, diagnostic use, Hyperemia, Carotid Arteries, Carotid Artery,Common},
