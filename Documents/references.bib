	keywords = {Adult, Diabetic Neuropathies, Human, Comparative Study, Case-Control Studies, Aged, Female, Male, Middle Age, Disease, Heart, Diabetes Mellitus,Insulin-Dependent, 12, Diabetes Mellitus, abnormalities, immunology, Sympathetic Nervous System, Germany, Heart Rate, Autoantibodies, Autonomic Nervous System Diseases, Autoimmunity, innervation, Nutrition, Fluorescent Antibody Technique,Indirect, Antibody Specificity, Ganglia,Autonomic, Ganglia,Parasympathetic},
