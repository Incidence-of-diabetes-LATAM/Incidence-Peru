	note = {Place: Department of Epidemiology, University of Pittsburgh Graduate School of Public Health, Pittsburgh, Pa 15261, USA. kuller@ pitt.edu},
	keywords = {analysis, blood, Cholesterol, methods, Risk, Triglycerides, Human, Support,U.S.Gov't,P.H.S., Case-Control Studies, Risk Factors, Aged, Female, Male, Disease, epidemiology, Myocardial Infarction, Magnetic Resonance Spectroscopy, Heart, Coronary Disease, Lipoproteins, Aging, Sex Factors, Cohort Studies, Lipoproteins,VLDL, Lipoproteins,HDL, Lipoproteins,LDL, Cardiovascular System, Health Status, Nuclear Magnetic Resonance,Biomolecular},
