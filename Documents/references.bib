@article{chen_inflammatory_2016,
	title = {Inflammatory bowel disease on the risk of acute pancreatitis: {A} population-based cohort study: {Inflammatory} bowel disease and acute pancreatitis},
	volume = {31},
	issn = {08159319},
	shorttitle = {Inflammatory bowel disease on the risk of acute pancreatitis},
	url = {http://doi.wiley.com/10.1111/jgh.13171},
	doi = {10.1111/jgh.13171},
	abstract = {Background and Aims: To determine whether inﬂammatory bowel disease (IBD) inﬂuences the risk of acute pancreatitis.
Methods: We identiﬁed 11 909 patients diagnosed with IBD between 2000 and 2010 from Taiwan National Health Insurance Research Database as the study cohort. A comparison cohort comprised 47 636 age-matched patients without IBD. Both cohorts were followed-up until the end of 2010 or until being censored. Cox proportional hazards regression models were used to study the effects of IBD on the risks of acute pancreatitis.
Results: The overall incidence of acute pancreatitis was 3.56-fold higher in the study cohort than in the comparison cohort (31.8 vs 8.91 per 10 000 person-years, crude hazard ratio [HR] = 3.56, 95\% conﬁdence interval [CI] = 2.96–4.28). After adjustment for age, sex, and comorbidities, namely alcohol-related disease, biliary stone, hypertension, hyperlipidemia, diabetes mellitus, obesity, hepatitis B, hepatitis C, hypertriglyceridemia, cardiovascular diseases, chronic kidney disease, chronic obstructive pulmonary disease, and hypercalcemia, the adjusted HR for acute pancreatitis was 2.93-fold higher (95\% CI = 2.40–3.58) in the study cohort than in the comparison cohort.
Conclusions: IBD is a risk factor for acute pancreatitis. Introduction Inﬂammatory bowel disease (IBD) is a group of inﬂammatory conditions affecting the colon and small intestine. Two major types of IBD are Crohn’s disease and ulcerative colitis (UC). UC causes inﬂammation and ulceration of the colon and rectum, either in segments or completely. Crohn’s disease shares many factors with UC, but can affect any part of the gastrointestinal tract, from the mouth to the anus.1 Environmental factors (geography, cigarette smoking, sanitation, and hygiene), infectious microbes, ethnic origin, genetic susceptibility, and a dysregulated immune system are predisposing factors for mucosal inﬂammation.2,3 Treatment of IBD includes lifestyle alterations, medical management, and surgical intervention.4 Acute pancreatitis refers to sudden inﬂammation of the pancreas. Most patients with acute pancreatitis recover with conservative treatment, such as fasting and aggressive intravenous ﬂuid rehydration. Although the number of patients with a severe form of the disease is small, the severe form requires intensive medical care, and even surgery is required to resolve complications.5 The most crucial risk factors are gallstones and alcohol consumption. Other causes include metabolic disorders, biliary duct obstruction, medication, and trauma.6},
	language = {en},
	number = {4},
	urldate = {2021-02-13},
	journal = {Journal of Gastroenterology and Hepatology},
	author = {Chen, Yu-Tso and Su, Jiann-Sheng and Tseng, Chih-Wei and Chen, Chia-Chang and Lin, Cheng-Li and Kao, Chia-Hung},
	month = apr,
	year = {2016},
	pages = {782--787},
	file = {Chen e.a. - 2016 - Inflammatory bowel disease on the risk of acute pa.pdf:/Users/planetarium/Zotero/storage/IJLUFYCR/Chen e.a. - 2016 - Inflammatory bowel disease on the risk of acute pa.pdf:application/pdf;Chen e.a. - 2016 - Inflammatory bowel disease on the risk of acute pa.pdf:/Users/planetarium/Zotero/storage/G9U7MPJB/Chen e.a. - 2016 - Inflammatory bowel disease on the risk of acute pa.pdf:application/pdf},
}

