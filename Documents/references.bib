	note = {Place: Institute of Clinical Medicine, University of Tsukuba, Ibaraki, Japan},
	keywords = {Adult, Odds Ratio, Risk, Human, Risk Factors, Aged, Female, Male, Middle Age, Disease, epidemiology, Heart, Coronary Disease, Diabetes Mellitus, Diabetes Mellitus,Non-Insulin-Dependent, Japan, Aged,80 and over, Lipid Peroxides, genetics, Esterases, Glutamine, Polymorphism (Genetics)},
