	month = feb,
	year = {2003},
	note = {Place: Hanson Institute and the Department of Cardiology, Royal Adelaide Hospital, Adelaide, Australia. p.barter@hri.org.au},
	keywords = {Atherosclerosis, blood, Cholesterol, Risk, Human, metabolism, Animal, Mice, physiology, therapeutic use, Confounding Factors (Epidemiology), Disease, complications, etiology, Heart, prevention \& control, Lipoproteins, Lipoproteins,HDL Cholesterol, Arteriosclerosis, Cardiology, genetics, Australia, deficiency, antagonists \& inhibitors, Rabbits, Carrier Proteins, Cholesterol Esters, Apolipoproteins, Lipid Metabolism,Inborn Errors, Sulfhydryl Compounds},
