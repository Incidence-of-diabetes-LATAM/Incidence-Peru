	note = {Place: Cardiovascular Sciences Research Group, Wales Heart Research Institute, Cardiff, United Kingdom},
	keywords = {Adult, blood, methods, Research, Human, drug effects, Endothelium,Vascular, Support,Non-U.S.Gov't, United States, physiology, administration \& dosage, Aged, Brachial Artery, Female, Homocysteine, Male, Middle Age, Disease, Arteries, Heart, Plasma, Reference Values, Wales, Diet, genetics, Genotype, Double-Blind Method, Folic Acid, von Willebrand Factor, Vascular Resistance, Adolescent, Cross-Over Studies, Homozygote, Dose-Response Relationship,Drug, Mutation, Oxidoreductases, Amine Oxidoreductases, Nutritional Requirements},
	pages = {1799--1805},
